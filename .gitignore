# Track everything except generated, local and historical files.

# Python
__pycache__/
*.py[cod]
.venv/
.env
.env.*

# Agent notes
**/AGENTS.md
**/.agents/

# Local work and outputs at the top level
/.cache/
/calibration/
/diagnostics/
/output/
/releases/
/repair-backups/
/tmp/
/debug.log

# Archive: only its README is tracked
/archive/*
!/archive/README.md

# Disk Builder working folders
/disk-builder/.cache/
/disk-builder/Backups/
/disk-builder/Installers/
/disk-builder/Logs/

# Test leftovers
/tests/.cache/
/tests/windows-builder-tests-*/
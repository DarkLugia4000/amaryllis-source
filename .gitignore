# Track maintained project inputs; generated and historical local files stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/project.py
!/requirements-dev.txt
!/source/
!/tests/
!/docs/
!/disk-builder/

__pycache__/
*.py[cod]
.venv/
.env
.env.*
**/AGENTS.md
**/.agents/
**/.git/
!/.gitignore
/disk-builder/Backups/
/disk-builder/Installers/


!/tools/
!/archive/
/archive/*
!/archive/README.md

/disk-builder/.cache/

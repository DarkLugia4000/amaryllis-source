# Track maintained project inputs; generated and historical local files stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/project.py
!/requirements-dev.txt
!/source/
!/tests/
!/docs/
!/Amaryllis Installer Builder/
!/NAVIGATOR-INFORMATION-PLAN.md
!/UI-PRESENTATION-PLAN.md
!/Amaryllis-Maintenance-Catalogue.md
!/Amaryllis-Core-File-Responsibilities.md

__pycache__/
*.py[cod]
.venv/
.env
.env.*
**/AGENTS.md
**/.agents/
**/.git/
!/.gitignore
/Amaryllis Installer Builder/Backups/
/Amaryllis Installer Builder/Installers/


!/tools/
!/archive/
/archive/*
!/archive/README.md

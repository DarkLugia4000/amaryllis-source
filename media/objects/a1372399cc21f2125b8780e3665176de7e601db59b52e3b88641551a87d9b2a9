    "        nodeBoot=message.nodeBoot,bootToken=message.bootToken,requestId=message.requestId,\013\010",
    "        targetLabel=message.targetLabel,accepted=true,detail=\"RESTARTING\"}\013\010",
    "    local ok,result=pcall(sendAck,context.coreId,ack,\"amaryllis.v1\")\013\010",
    "    if not ok or result~=true then return false end\013\010",
    "    if type(context.getSession)==\"function\" then\013\010",
    "        local sessionOk,currentSession=pcall(context.getSession)\013\010",
    "        if not sessionOk or currentSession~=message.session then return false end\013\010",
    "    end\013\010",
    "    context.seen[message.requestId]=true\013\010",
    "    context.order[#context.order+1]=message.requestId\013\010",
    "    if #context.order>32 then context.seen[table.remove(context.order,1)]=nil end\013\010",
    "    reboot()\013\010",
    "    return true\013\010",
    "end\013\010",
    "local function currentSessionFresh(receiver,timeout,now)\013\010",
    "    return type(receiver)==\"table\" and type(receiver.session)==\"string\" and receiver.session~=\"\" and\013\010",
    "        finite(receiver.at) and finite(timeout) and finite(now) and now>=receiver.at and now-receiver.at<=timeout\013\010",
    "end\013\010",
    "-- Summary: Match a navigator command acknowledgement to its active request.\010",
    "local function bridgeAckMatches(sender,protocol,message,coreId,expectedProtocol,receiver,pending,timeout,now)\013\010",
    "    return sender==coreId and protocol==expectedProtocol and type(message)==\"table\" and\013\010",
    "        message.v==1 and message.kind==\"bridge_ack\" and type(pending)==\"table\" and\013\010",
    "        (pending.status==\"PENDING\" or pending.status==\"UNKNOWN\") and finite(now) and finite(pending.at) and now>=pending.at and\013\010",
    "        type(receiver)==\"table\" and (not receiver.managed or receiver.registryIdentity~=nil) and\013\010",
    "        message.boot==pending.boot and\013\010",
    "        pending.session==receiver.session and message.session==pending.session and message.seq==pending.seq\013\010",
    "end\013\010",
    "\013\010",
    "-- Bounded volatile outbox. A retry keeps its original identity and deadline;\013\010",
    "-- only a matching core result confirms acceptance. No disk I/O or polling.\013\010",
    "local Requests={};Requests.__index=Requests\013\010",
    "local priority={emergency_kill_lift=true,systems_stop=true,systems_stop_confirm=true,\013\010",
    "    altitude_disengage=true,ap_disengage=true,anchor_cancel=true,tuning_stop=true,\013\010",
    "    propulsion_disable=true,tuning_cancel=true,maintenance_cancel=true,systems_stop_cancel=true}\013\010",
    "local shortLife={emergency_kill_lift=true,disarm_lift_kill=true,restart_systems=true,\013\010",
    "    start_systems=true,recover_systems=true,level_reset=true,systems_stop=true,systems_stop_confirm=true,\013\010",
    "    maintenance_confirm=true,maintenance_override=true,tuning_confirm=true,altitude_engage=true,\013\010",
    "    anchor_engage=true,ap_engage=true,propulsion_enable=true,ap_current=true,destination_save=true}\013\010",
    "local function coalesceKey(action)\013\010",
    "    if action.type==\"setting_update\" and type(action.key)==\"string\" then return \"setting:\"..action.key end\013\010",
    "    if action.type==\"cockpit_mode\" and type(action.axis)==\"string\" then return \"mode:\"..action.axis end\013\010",
    "    if action.type==\"destination_select\" then return \"destination_select\" end\013\010",
    "end\013\010",
    "function Requests.new(coreID,protocol,boot,timeout)\013\010",
    "    return setmetatable({coreID=coreID,protocol=protocol,boot=boot,timeout=timeout,\013\010",
    "        queue={},records={},order={},sequence=0,limit=8},Requests)\013\010",
    "end\013\010",
    "function Requests:remember(entry)\013\010",
    "    self.records[entry.seq]=entry;self.order[#self.order+1]=entry.seq\013\010",
    "    if #self.order>32 then self.records[table.remove(self.order,1)]=nil end\013\010",
    "end\013\010",
    "function Requests:synchronize(session)\013\010",
    "    if session==self.session then return end\013\010",
    "    if self.active then self.active.status=\"CANCELLED\";self.active.reason=\"CORE SESSION CHANGED\" end\013\010",
    "    for _,e in ipairs(self.queue) do e.status=\"CANCELLED\";e.reason=\"CORE SESSION CHANGED\" end\013\010",
    "    self.queue,self.records,self.order,self.active={}, {}, {},nil\013\010",
    "    self.session=session\013\010",
    "end\013\010",
    "-- Summary: Queue a pilot action and supersede older replaceable requests.\010",
    "function Requests:enqueue(action,receiver,now,epoch)\013\010",
    "    self:synchronize(receiver.session)\013\010",
    "    if not self.session or receiver.managed and not receiver.registryIdentity then return false,\"WAITING FOR CURRENT CORE SESSION\" end\013\010",
    "    if type(action)~=\"table\" or type(action.type)~=\"string\" or not finite(now) or not finite(epoch) then return false,\"INVALID COMMAND\" end\013\010",
    "    local copiedOK,candidate=pcall(copy,action,0,{n=0,max=128})\013\010",
    "    if not copiedOK then return false,\"COMMAND TOO LARGE\" end\013\010",
    "    local key=coalesceKey(candidate)\013\010",
    "    -- Replace unsent settings only. Relative adjustments retain their order.\013\010",
    "    for i=#self.queue,1,-1 do\013\010",
    "        local old=self.queue[i]\013\010",
    "        if priority[candidate.type] or key and old.key==key then\013\010",
    "            old.status=\"SUPERSEDED\";old.reason=\"REPLACED BY NEWER COMMAND\";table.remove(self.queue,i)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.active and key and self.active.key==key and self.active.attempts==0 then\013\010",
    "        self.active.status=\"SUPERSEDED\";self.active.reason=\"REPLACED BY NEWER COMMAND\";self.active=nil\013\010",
    "    end\013\010",
    "    if priority[candidate.type] and self.active then\013\010",
    "        self.active.status=\"SUPERSEDED\";self.active.reason=\"PRIORITY COMMAND SENT NEXT\";self.active=nil\013\010",
    "    end\013\010",
    "    if #self.queue+(self.active and 1 or 0)>=self.limit then return false,\"COMMAND QUEUE FULL\" end\013\010",
    "    local entry={action=candidate,actionType=candidate.type,key=key,session=self.session,boot=self.boot,\013\010",
    "        at=now,expiresAt=epoch+(shortLife[candidate.type] and 10 or 30),status=\"QUEUED\",attempts=0}\013\010",
    "    self.queue[#self.queue+1]=entry;self.latest=entry\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Send or retry the active navigator command within its session and expiry.\010",
    "function Requests:step(receiver,now,epoch,send)\013\010",
    "    self:synchronize(receiver.session)\013\010",
    "    if not finite(now) or not finite(epoch) then return end\013\010",
    "    for i=#self.queue,1,-1 do\013\010",
    "        local e=self.queue[i]\013\010",
    "        if epoch>=e.expiresAt then e.status=\"CANCELLED\";e.reason=\"UNSENT COMMAND EXPIRED\";table.remove(self.queue,i) end\013\010",
    "    end\013\010",
    "    local e=self.active\013\010",
    "    if e and epoch>=e.expiresAt then\013\010",
    "        e.status=e.attempts>0 and \"UNKNOWN\" or \"CANCELLED\"\013\010",
    "        e.reason=e.attempts>0 and \"NOT CONFIRMED; CHECK CORE\" or \"UNSENT COMMAND EXPIRED\";self.active=nil;e=nil\013\010",
    "    end\013\010",
    "    if not e then\013\010",
    "        e=table.remove(self.queue,1)\013\010",
    "        if not e then return end\013\010",
    "        if self.sequence>=2147483647 then e.status=\"CANCELLED\";e.reason=\"REQUEST SEQUENCE EXHAUSTED\";return end\013\010",
    "        self.sequence=self.sequence+1;e.seq=self.sequence;self.active=e;self:remember(e)\013\010",
    "    end\013\010",
    "    if not currentSessionFresh(receiver,self.timeout,now) then\013\010",
    "        e.reason=\"WAITING FOR CORE\";return\013\010",
    "    end\013\010",

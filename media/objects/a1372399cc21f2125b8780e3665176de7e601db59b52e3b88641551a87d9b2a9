    "end\013\010",
    "\013\010",
    "-- Test hook exposes receipt logic without starting peripherals or events.\013\010",
    "if rawget(_G,\"__AMARYLLIS_BRIDGE_TEST\") then\013\010",
    "    Receiver.validateRestart=validateRestart\013\010",
    "    Receiver.handleRestart=handleRestart\013\010",
    "    Receiver.currentSessionFresh=currentSessionFresh\013\010",
    "    Receiver.bridgeAckMatches=bridgeAckMatches\013\010",
    "    Receiver.Requests=Requests\013\010",
    "    return Receiver\013\010",
    "end\013\010",
    "local Storage=require(\"avionics.storage\")\013\010",
    "local UI=require(\"avionics.ui\")\013\010",
    "local Console=require(\"avionics.common.console\")\013\010",
    "local config,issue=Storage.loadConfig(\"/avionics/config.json\")\013\010",
    "if not config then error(issue,0) end\013\010",
    "local install=config.install\013\010",
    "local function validID(value) return type(value)==\"number\" and value>=0 and value==math.floor(value) and value<math.huge end\013\010",
    "if config.role~=\"navigator\" or not validID(config.core_id) or os.getComputerID()~=config.computer_id or os.getComputerLabel()~=config.label then\013\010",
    "    error(\"Navigator identity does not match its installed registry entry\",0)\013\010",
    "end\013\010",
    "if type(install)~=\"table\" or install.packageId~=\"amaryllis.navigator\" or install.role~=\"navigator\" or\013\010",
    "    install.computerID~=os.getComputerID() or not validID(install.coreID) or install.coreID~=config.core_id or\013\010",
    "    type(install.version)~=\"number\" or install.version<2 or install.version~=math.floor(install.version) then\013\010",
    "    error(\"Navigator install receipt is invalid\",0)\013\010",
    "end\013\010",
    "-- A missing core registry is transient. Render stale data while the event\013\010",
    "-- loop waits for a valid binding; live data and commands remain registry-gated.\013\010",
    "local settings,notice=Storage.loadSettings(\"/avionics/data/settings.json\")\013\010",
    "if not settings then error(notice,0) end\013\010",
    "if notice then print(notice) end\013\010",
    "local page=settings.display_page\013\010",
    "local receiver=Receiver.new(config.core_id,config.status_timeout_seconds,config.status_max_entries)\013\010",
    "local receiveIssue\013\010",
    "-- Summary: Reconcile the current role identity with a trusted registry announcement.\010",
    "local function syncRegistry()\013\010",
    "    local registry=os.__amaryllisFleetRegistry\013\010",
    "    local entry=type(registry)==\"table\" and registry.coreID==config.core_id and\013\010",
    "        type(registry.computers)==\"table\" and registry.computers[config.role] or nil\013\010",
    "    if type(entry)==\"table\" and entry.id==os.getComputerID() and entry.label==config.label and\013\010",
    "        os.getComputerLabel()==config.label then\013\010",
    "        receiver:setRegistry(registry.session,config.role,entry.id,entry.label)\013\010",
    "    else receiver:setRegistry(nil,nil,nil,nil) end\013\010",
    "end\013\010",
    "local renderer,monitorName,lastIssue\013\010",
    "-- Role health reports travel over onboard rednet, independently of diagnostics.\013\010",
    "local heartbeatSeq,nextHeartbeat=0,0\013\010",
    "local heartbeatBoot=tostring(config.computer_id)..\"-\"..string.format(\"%.0f\",os.epoch and os.epoch(\"utc\") or os.clock()*1000)\013\010",
    "local requests=Requests.new(config.core_id,config.protocol,heartbeatBoot,config.status_timeout_seconds)\013\010",
    "local function requestEpoch() return os.epoch(\"utc\")/1000 end\013\010",
    "local restartContext={coreId=config.core_id,targetLabel=os.getComputerLabel(),nodeBoot=heartbeatBoot,\013\010",
    "    getSession=function()\013\010",
    "        if receiver.at and os.clock()>=receiver.at and os.clock()-receiver.at<=config.status_timeout_seconds then return receiver.session end\013\010",
    "        return nil\013\010",
    "    end,seen={},order={}}\013\010",
    "-- Summary: Resolve the current monitor or network attachment for the role.\010",
    "local function bind()\013\010",
    "    renderer,monitorName=nil,nil\013\010",
    "    local monitors={}\013\010",
    "    for _,name in ipairs(peripheral.getNames()) do\013\010",
    "        if peripheral.hasType(name,\"modem\") then\013\010",
    "            local modem=peripheral.wrap(name)\013\010",
    "            if modem and type(modem.isWireless)==\"function\" then\013\010",
    "                local ok,wireless=pcall(modem.isWireless)\013\010",

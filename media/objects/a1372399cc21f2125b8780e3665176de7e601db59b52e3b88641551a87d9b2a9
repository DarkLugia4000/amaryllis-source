    "    requests:synchronize(receiver.session)\013\010",
    "    snapshot.bridgeRequest=requests:feedback()\013\010",
    "    snapshot.displaySettings=settings\013\010",
    "    if renderer then renderer.config.trendFilterAlpha=settings.speed_trend_filter_alpha or .3;renderer.config.trendDeadband=settings.speed_trend_deadband or .025 end\013\010",
    "    os.__amaryllisRuntime={publishedAt=os.clock(),snapshot=snapshot,running=true,hardwareAvailable=renderer~=nil,faultSummary=lastIssue or receiveIssue}\013\010",
    "    if renderer then\013\010",
    "        local ok,result,reason=pcall(renderer.draw,renderer,snapshot)\013\010",
    "        local fault=(not ok and tostring(result)) or (result==false and tostring(reason)) or nil\013\010",
    "        if fault and fault~=lastIssue then print(\"Bridge display: \"..fault) end\013\010",
    "        lastIssue=fault\013\010",
    "        if fault then renderer=nil end\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Validate and dispatch received packets for the current role and session.\010",
    "local function dispatch(action)\013\010",
    "    if type(action)~=\"table\" then return end\013\010",
    "    if action.type==\"page\" or action.type==\"display_setting\" then\013\010",
    "        local candidate={};for k,v in pairs(settings) do candidate[k]=v end\013\010",
    "        if action.type==\"page\" then candidate.display_page=action.page\013\010",
    "        elseif action.key==\"speed_trend_filter_alpha\" or action.key==\"speed_trend_deadband\" then candidate[action.key]=action.value\013\010",
    "        else return end\013\010",
    "        local ok,reason=Storage.saveSettings(candidate,\"/avionics/data/settings.json\")\013\010",
    "        if ok then settings=candidate;page=settings.display_page\013\010",
    "        elseif action.type==\"page\" then page=action.page end\013\010",
    "        if renderer then renderer.settingsNotice=ok and \"DISPLAY PREFERENCE SAVED\" or (\"NOT SAVED: \"..tostring(reason)) end\013\010",
    "        if not ok then print(\"Bridge preferences: \"..tostring(reason)) end\013\010",
    "    else\013\010",
    "        local ok,reason=requests:enqueue(action,receiver,os.clock(),requestEpoch())\013\010",
    "        if renderer then renderer.settingsNotice=not ok and reason or nil end\013\010",
    "        requests:step(receiver,os.clock(),requestEpoch(),rednet.send)\013\010",
    "    end\013\010",
    "end\013\010",
    "local function touch(side,x,y)\013\010",
    "    if side~=monitorName or not renderer then return end\013\010",
    "    dispatch(renderer:touch(x,y,receiver:snapshot(os.clock(),page)))\013\010",
    "end\013\010",
    "\013\010",
    "syncRegistry();pcall(bind); print(\"Amaryllis navigator waiting for current core data.\")\013\010",
    "local timer=os.startTimer(0.2)\013\010",
    "while true do\013\010",
    "    local event,a,b,c=os.pullEventRaw()\013\010",
    "    if event==\"terminate\" then return\013\010",
    "    elseif event==\"rednet_message\" then\013\010",
    "        restartContext.session=restartContext.getSession()\013\010",
    "        if Console.acceptRegistry(a,b,c,config.role,os.getComputerID(),config.core_id) then\013\010",
    "            syncRegistry()\013\010",
    "        elseif handleRestart(a,b,c,restartContext,rednet.send,os.reboot) then\013\010",
    "            -- Accepted restart requests reboot after their acknowledgement.\013\010",
    "        else\013\010",
    "            syncRegistry()\013\010",
    "            local accepted,why=receiver:accept(a,b,c,os.clock())\013\010",
    "            if accepted then\013\010",
    "                if receiveIssue then print(\"Core data restored.\") end\013\010",
    "                receiveIssue=nil\013\010",
    "            elseif why and why~=receiveIssue then\013\010",
    "                receiveIssue=why; print(\"Core data: \"..why)\013\010",
    "            end\013\010",
    "        end\013\010",
    "        requests:synchronize(receiver.session)\013\010",
    "        if requests:ack(a,b,c,receiver,os.clock()) then\013\010",
    "            print(\"Core request: \"..(b.accepted==true and \"ACCEPTED\" or \"REJECTED\")..\" \"..tostring(b.reason or \"\"))\013\010",
    "        end\013\010",
    "    elseif event==\"monitor_touch\" then touch(a,b,c)\013\010",
    "    elseif (event==\"char\" or event==\"key\") and renderer and receiver.at and os.clock()-receiver.at<=config.status_timeout_seconds then dispatch(renderer:input(event,a))\013\010",
    "    elseif event==\"peripheral\" or event==\"peripheral_detach\" or event==\"monitor_resize\" then pcall(bind)\013\010",
    "    elseif event==\"timer\" and a==timer then\013\010",
    "        if not renderer then pcall(bind) end\013\010",
    "        requests:step(receiver,os.clock(),requestEpoch(),rednet.send)\013\010",
    "        draw(); timer=os.startTimer(0.2)\013\010",
    "        if receiver.session and os.clock()>=nextHeartbeat then\013\010",
    "            heartbeatSeq=math.min(heartbeatSeq+1,2147483647)\013\010",
    "            pcall(rednet.send,config.core_id,{v=1,kind=\"subsystem_status\",session=receiver.session,\013\010",
    "                boot=heartbeatBoot,seq=heartbeatSeq,label=config.label,role=\"bridge\",\013\010",
    "                coreDataFresh=not receiver:snapshot(os.clock(),page).displayStale,\013\010",
    "                monitorAttached=renderer~=nil},config.protocol)\013\010",
    "            nextHeartbeat=os.clock()+1\013\010",
    "        end\013\010",
    "    end\013\010",
    "end\013\010",
    "\013\010",
}),
["/avionics/storage.lua"]=([=[
-- Section: Navigator preferences | Validated display configuration and JSON persistence.
-- JSON configuration and persistent settings for computer 17.
-- Keep disk access here so control and display code never silently invents defaults.
local Storage = {}

local SETTINGS_SCHEMA = 1
local MAX_JSON_BYTES = 262144

local function finite(value)
    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function object(value)
    return type(value) == "table"
end

function Storage.finite(value)
    return finite(value)
end

-- Section: Navigator preferences | Validated display configuration and JSON persistence.
-- Summary: Construct the supported initial local display settings.
function Storage.defaultSettings()
    return {
        schema_version = SETTINGS_SCHEMA,
        display_page = "FLIGHT",
        -- Stored selected targets are intentionally absent. A restart never
        -- restores active control authority or starts an actuator.
    }
end

-- Summary: Validate the stored display-settings schema and selected page.
function Storage.validateSettings(settings)
    if not object(settings) then return false, "settings must be a JSON object" end
    if settings.schema_version ~= SETTINGS_SCHEMA then return false, "unsupported settings schema_version" end
    local pages = { FLIGHT = true, NAV = true, SHIP = true, SETTINGS = true }
    if not pages[settings.display_page] then return false, "display_page must be FLIGHT, NAV, SHIP, or SETTINGS" end
    for key,bounds in pairs({speed_trend_filter_alpha={.05,1},speed_trend_deadband={0,1}}) do
        if settings[key]~=nil and (not finite(settings[key]) or settings[key]<bounds[1] or settings[key]>bounds[2]) then return false,key.." out of range" end
    end
    return true
end

-- Summary: Validate required configuration objects, frequency pairs and numeric bounds.
function Storage.validateConfig(config)
    if not object(config) or config.schema_version ~= 1 or config.role ~= "navigator" or
        not finite(config.computer_id) or config.computer_id < 0 or config.computer_id ~= math.floor(config.computer_id) or
        not finite(config.core_id) or config.core_id < 0 or config.core_id ~= math.floor(config.core_id) or
        config.protocol ~= "amaryllis.v1" then return false, "navigator identity/core binding is invalid" end
    if not finite(config.status_timeout_seconds) or config.status_timeout_seconds <= 0 or config.status_timeout_seconds > 60 then
        return false, "bridge status timeout must be greater than zero and at most 60 seconds"
    end
    if not object(config.hardware) or type(config.hardware.main_monitor) ~= "string" or #config.hardware.main_monitor > 128 then
        return false, "bridge monitor binding must be an exact name or empty string"
    end
    return true
end

local function api(dependencies)
    dependencies = dependencies or {}
    return dependencies.fs or fs, dependencies.textutils or textutils
end

-- Summary: Read and decode a JSON document through the configured filesystem dependency.
function Storage.readJson(path, dependencies)
    local fsApi, jsonApi = api(dependencies)
    if not fsApi or type(fsApi.open) ~= "function" or not jsonApi or type(jsonApi.unserializeJSON) ~= "function" then
        return nil, "ComputerCraft filesystem or JSON support is unavailable"

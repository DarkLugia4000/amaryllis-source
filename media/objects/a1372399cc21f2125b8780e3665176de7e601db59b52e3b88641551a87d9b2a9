    "    e.status=\"PENDING\";e.attempts=e.attempts+1\013\010",
    "    e.reason=e.attempts>1 and \"WAITING FOR CORE; RETRYING\" or \"WAITING FOR CORE\"\013\010",
    "    e.nextSend=now+math.min(5,2^(e.attempts-1))\013\010",
    "    local ok,sent=pcall(send,self.coreID,{v=1,kind=\"bridge_request\",session=e.session,boot=e.boot,\013\010",
    "        seq=e.seq,expiresAt=e.expiresAt,action=e.action},self.protocol)\013\010",
    "    if not ok or sent~=true then e.reason=\"WAITING FOR CORE LINK\" end\013\010",
    "end\013\010",
    "function Requests:ack(sender,message,protocol,receiver,now)\013\010",
    "    local e=type(message)==\"table\" and self.records[message.seq] or nil\013\010",
    "    if not bridgeAckMatches(sender,protocol,message,self.coreID,self.protocol,receiver,e,self.timeout,now) then return false end\013\010",

    "    elseif #monitors==1 then monitorName=monitors[1] end\013\010",
    "    if monitorName then renderer=UI.new(peripheral.wrap(monitorName),config) end\013\010",
    "end\013\010",
    "-- Summary: Render the current view into its configured terminal or monitor.\010",
    "local function draw()\013\010",

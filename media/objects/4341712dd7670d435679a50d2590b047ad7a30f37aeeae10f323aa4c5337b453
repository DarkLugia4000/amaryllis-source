    "-- Reads absolute speed and sample time, resets after stale data and applies the configured smoothing and deadband.\013\010",
    "-- Summary: Filter successive speed observations into an increasing/decreasing trend marker.\010",
    "function UI:speedTrend(s)\013\010",
    "    local speed=vessel(s,'forwardSpeed')\013\010",
    "    local at=(s.vessel or {}).at or s.updatedAt\013\010",
    "    if not finite(speed) or not finite(at) then\013\010",
    "        self.speedSample=nil;self.speedSlope=nil;return '--','gray'\013\010",
    "    end\013\010",
    "    local prior=self.speedSample\013\010",
    "    if prior and at==prior.at then\013\010",
    "        -- Repainting one receipt retains its trend until another observation arrives.\013\010",
    "    elseif prior and at>prior.at and at-prior.at<=10 then\013\010",
    "        local slope=(math.abs(speed)-prior.speed)/(at-prior.at)\013\010",
    "        local alpha=math.max(.05,math.min(1,self.config.trendFilterAlpha or .3))\013\010",
    "        self.speedSlope=finite(self.speedSlope) and self.speedSlope*(1-alpha)+slope*alpha or slope\013\010",
    "    else self.speedSlope=nil end\013\010",
    "    self.speedSample={at=at,speed=math.abs(speed)}\013\010",
    "    local threshold=self.config.trendDeadband or .025\013\010",
    "    if not finite(self.speedSlope) then return '--','gray' end\013\010",
    "    if self.speedSlope>threshold then return 'UP','green' end\013\010",
    "    if self.speedSlope< -threshold then return 'DOWN','yellow' end\013\010",
    "    return 'STEADY','gray'\013\010",
    "end\013\010",

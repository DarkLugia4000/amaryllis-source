    "-- Stop, cancellation and the emergency kill remain available during fleet faults.\013\010",
    "-- Summary: Validate whether the current identity has permission for the selected operation.\010",
    "local function allowed(s,a)\013\010",
    "    if not live(s) then return false end\013\010",
    "    local stop={emergency_kill_lift=true,disarm_lift_kill=true,systems_stop=true,systems_stop_confirm=true,\013\010",
    "        systems_stop_cancel=true,ap_disengage=true,anchor_cancel=true,tuning_stop=true,tuning_cancel=true,\013\010",
    "        maintenance_cancel=true,propulsion_disable=true}\013\010",
    "    local kill=s.emergencyLift or {}\013\010",
    "    if (a.type=='emergency_kill_lift' or a.type=='disarm_lift_kill') and (kill.pending or kill.disarming or kill.phase=='KILLING' or kill.phase=='RECHECKING AFTER REBOOT') then return false end\013\010",
    "    if stop[a.type] then return true end\013\010",
    "    if a.type=='start_systems' and ((s.systemsStartup or {}).available~=true or (s.systemsStartup or {}).active) then return false end\013\010",
    "    if a.type=='restart_systems' and (s.systemsRestart or {}).available~=true then return false end\013\010",
    "    if a.type=='level_reset' and (s.systemsStartup or {}).phase~='READY' then return false end\013\010",
    "    if a.type=='manual_trim_adjust' or a.type=='manual_trim_reset' then\013\010",
    "        if (s.trimControl or {}).manualTrimAvailable~=true then return false end\013\010",
    "    end\013\010",
    "    if a.type=='cockpit_mode' and ((s.cockpitControl or {}).available~=true or (s.autopilot or {}).active or (s.anchorControl or {}).active) then return false end\013\010",
    "    if disassembled(s) and a.type~='setting_update' and a.type~='debug_mode' then return false end\013\010",
    "    local fleet=s.fleetBoot or s.fleetStartup or {}\013\010",
    "    if (fleet.blocked or fleet.ready==false) and not ({setting_update=true,debug_mode=true,maintenance_probe_cycle=true})[a.type] then return false end\013\010",
    "    if (s.emergencyLift or {}).latched and ({start_systems=true,restart_systems=true,ap_engage=true,ap_route_engage=true})[a.type] then return false end\013\010",
    "    return true\013\010",
    "end\013\010",

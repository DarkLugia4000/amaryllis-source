    "-- Sums provider flow and targets; reads the representative balloon gas amount in m3 and lift, with separate readiness and control states.\013\010",
    "-- Summary: Sums provider flow and targets; reads the representative balloon gas amount in m3 and lift, with separate readiness and control states.\010",
    "local function chamber(s,id)\013\010",
    "    local node=(s.nodes or {})[id] or {};local status=node.status or node\013\010",
    "    local balloon=status.balloon or node.balloon or {};local gas,target=0,0\013\010",
    "    local validGas,validTarget,count=true,true,0\013\010",
    "    for _,p in pairs(status.providers or node.providers or {}) do\013\010",
    "        count=count+1\013\010",
    "        if p.gasOutputValid==true and finite(p.gasOutput) then gas=gas+p.gasOutput else validGas=false end\013\010",
    "        if p.targetValid==true and finite(p.targetAmount) then target=target+p.targetAmount else validTarget=false end\013\010",
    "    end\013\010",
    "    local current=live(s) and node.online==true\013\010",
    "    -- Balloon inventory is a single representative reading, independent of provider flow in m3/tick.\013\010",
    "    local gasAmount=current and balloon.hasBalloonValid==true and balloon.hasBalloon==true and\013\010",
    "        balloon.gasMixValid==true and finite(balloon.gasMixAmount) and balloon.gasMixAmount>=0 and balloon.gasMixAmount or nil\013\010",
    "    return {online=current,gasAmount=gasAmount,gas=current and validGas and count>0 and gas or nil,target=current and validTarget and count>0 and target or nil,\013\010",
    "        lift=current and balloon.liftValid==true and balloon.lift or nil,\013\010",
    "        state=current and ((status.ready or node.ready) and next(status.faults or node.faults or {})==nil and 'RDY' or 'FAULT') or 'OFFLINE',\013\010",
    "        thrustState=chamberControl(status,node,'thrustControlState',current),\013\010",
    "        liftState=chamberControl(status,node,'liftControlState',current)}\013\010",
    "end\013\010",
    "-- Reads endpoint freshness and per-field validity before returning the signed speedRaw observation.\013\010",
    "-- Summary: Reads endpoint freshness and per-field validity before returning the signed speedRaw observation.\010",
    "local function rpm(s,side)\013\010",
    "    local endpoint=((s.thrust or {}).units or {})['primary-'..side] or {}\013\010",
    "    if not live(s) or endpoint.online~=true or endpoint.statusFresh~=true then return nil end\013\010",
    "    local readings=endpoint.readings or endpoint\013\010",
    "    if (endpoint.validity or readings.validity or {}).speedRaw==true and finite(readings.speedRaw) then return readings.speedRaw end\013\010",
    "    for _,sample in ipairs(readings) do\013\010",
    "        if (sample.validity or {}).speedRaw==true and finite(sample.speedRaw) then return sample.speedRaw end\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Reads discovery and fresh sensor inventory; a lost core or stale sample stays yellow rather than declaring hardware missing.\013\010",
    "-- Summary: Reads discovery and fresh sensor inventory; a lost core or stale sample stays yellow rather than declaring hardware missing.\010",
    "function UI:engineTone(s,side)\013\010",
    "    if not live(s) then return 'yellow','WAITING' end\013\010",
    "    local endpoint=((s.thrust or {}).units or {})['primary-'..side]\013\010",
    "    if not endpoint or endpoint.discovered==false then return 'red','MISSING' end\013\010",
    "    if endpoint.online~=true or endpoint.statusFresh~=true then return 'yellow','WAITING' end\013\010",
    "    if endpoint.available==false and #(endpoint.readings or {})==0 then return 'red','MISSING' end\013\010",
    "    if not finite(rpm(s,side)) then return 'yellow','WAITING' end\013\010",
    "    return 'white','READY'\013\010",
    "end\013\010",
    "-- Unavailable RPM freezes the angle in the supplied health colour; the capped visual rate preserves legibility.\013\010",
    "-- Summary: Unavailable RPM freezes the angle in the supplied health colour; the capped visual rate preserves legibility.\010",
    "function UI:propeller(f,cx,cy,side,value,now,size,tone)\013\010",

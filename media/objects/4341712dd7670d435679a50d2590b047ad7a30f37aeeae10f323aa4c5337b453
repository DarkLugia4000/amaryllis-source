    "        a=a+(value<0 and -1 or 1)*math.min(math.abs(value)/60,.8)*2*math.pi*dt\013\010",
    "        self.propellerAngles[side]=a\013\010",
    "    end\013\010",
    "    for i=0,3 do\013\010",

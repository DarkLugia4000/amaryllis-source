    "end\013\010",
    "Thrust.statusPacket = statusPacket\013\010",
    "\013\010",
    "-- Summary: Revalidate the pending reboot against its request age, session and local boot.\010",
    "local function restartStillAuthorized(state, command, now)\013\010",
    "    return state.pendingSystemRestart == command and\013\010",
    "        state.coreId == command.coreId and state.coreId == command.sender and\013\010",
    "        state.session == command.session and state.role == command.role and\013\010",
    "        state.nodeBoot == command.nodeBoot and state.writerToken == command.writerToken and\013\010",
    "        finite(state.lastSessionAt) and now >= state.lastSessionAt and\013\010",
    "        now - state.lastSessionAt <= SYSTEM_RESTART_MAX_AGE and\013\010",
    "        now >= command.receivedAt and now - command.receivedAt <= SYSTEM_RESTART_MAX_AGE\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Write verified zero demand to each configured propulsion drive.\010",
    "local function forceZeroConfiguredDrives(state, bindings, stillAuthorized, wait)\013\010",
    "    if state.endpointKind == \"sensor\" then return true, \"READ_ONLY_SENSOR\" end\013\010",
    "    bindings = bindings or {}\013\010",
    "    wait = wait or function(seconds) sleep(seconds) end\013\010",
    "    local verifiedAll, faults = true, {}\013\010",
    "    if #state.drives == 0 then return false, \"NO_CONFIGURED_TRANSMISSIONS\" end\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        if not stillAuthorized() then return nil, \"RESTART_AUTHORITY_EXPIRED_DURING_ZERO\" end\013\010",
    "        local binding = bindings[drive]\013\010",
    "        if not binding or not binding.object then\013\010",
    "            verifiedAll = false\013\010",
    "            faults[#faults + 1] = \"UNBOUND:\" .. tostring(drive)\013\010",
    "        else\013\010",
    "            local wrote, writeReason = Hardware.writeSafeZero(binding, stillAuthorized)\013\010",
    "            if not stillAuthorized() then return nil, \"RESTART_AUTHORITY_EXPIRED_DURING_ZERO\" end\013\010",
    "            local driveVerified, lastReason = false, writeReason\013\010",
    "            for attempt = 1, 10 do\013\010",
    "                if not stillAuthorized() then return nil, \"RESTART_AUTHORITY_EXPIRED_DURING_ZERO\" end\013\010",
    "                local level, readReason = Hardware.readShift(binding, stillAuthorized)\013\010",
    "                if level == 0 then driveVerified = true; break end\013\010",
    "                lastReason = readReason or (\"ZERO_READBACK:\" .. tostring(level))\013\010",
    "                if attempt < 10 then\013\010",
    "                    local waited, waitReason = pcall(wait, 0.1)\013\010",
    "                    if not waited then lastReason = \"ZERO_SETTLE_WAIT_FAILED:\" .. tostring(waitReason); break end\013\010",
    "                end\013\010",
    "            end\013\010",
    "            if not driveVerified then\013\010",
    "                verifiedAll = false\013\010",
    "                faults[#faults + 1] = tostring(drive) .. \":\" .. tostring(lastReason or \"ZERO_NOT_VERIFIED\")\013\010",
    "            elseif not wrote and writeReason then\013\010",
    "                -- A verified zero is authoritative even if a setter reported\013\010",
    "                -- a late error, but retain that hardware detail in the ACK.\013\010",
    "                faults[#faults + 1] = tostring(drive) .. \":\" .. tostring(writeReason)\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local detail = verifiedAll and \"ALL_CONFIGURED_TRANSMISSIONS_ZERO_VERIFIED\" or table.concat(faults, \"; \")\013\010",
    "    return verifiedAll, wireText(detail, 160)\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Send the correlated restart acceptance or rejection to core.\010",
    "local function sendSystemRestartAck(state, reply, rednetApi)\013\010",
    "    if state.coreId ~= reply.sender or state.session ~= reply.session or\013\010",
    "        state.nodeBoot ~= reply.currentNodeBoot then return false end\013\010",
    "    local network = rednetApi or rednet\013\010",
    "    if not network or type(network.send) ~= \"function\" then return false end\013\010",
    "    local packet = {\013\010",
    "        v = 1, kind = \"system_restart_ack\", session = reply.session,\013\010",
    "        requestId = reply.requestId, targetLabel = reply.targetLabel,\013\010",
    "        nodeBoot = reply.nodeBoot, bootToken = reply.bootToken,\013\010",
    "        accepted = reply.accepted == true, zeroVerified = reply.zeroVerified == true,\013\010",
    "        detail = wireText(reply.detail, 160),\013\010",
    "    }\013\010",
    "    local ok, sent = pcall(network.send, reply.sender, packet, Thrust.PROTOCOL)\013\010",
    "    return ok and sent == true\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Acknowledge and execute a fresh authorized reboot after writer completion.\010",
    "local function processPendingSystemRestart(state, bindings, now, rednetApi, wait, reboot)\013\010",
    "    now = now or os.clock()\013\010",
    "    local errorReply = state.pendingSystemRestartAck\013\010",
    "    if errorReply then\013\010",
    "        if not sendSystemRestartAck(state, errorReply, rednetApi) then\013\010",
    "            state.systemRestartRetryAt = now + 0.5\013\010",
    "            return false\013\010",
    "        end\013\010",
    "        if state.pendingSystemRestartAck == errorReply then state.pendingSystemRestartAck = nil end\013\010",
    "        state.systemRestartRetryAt = nil\013\010",
    "        return true\013\010",
    "    end\013\010",
    "\013\010",
    "    local command = state.pendingSystemRestart\013\010",
    "    if not command or (state.systemRestartRetryAt and now < state.systemRestartRetryAt) then return false end\013\010",
    "    if not restartStillAuthorized(state, command, now) then\013\010",
    "        if state.coreId == command.coreId and state.session == command.session and\013\010",
    "            state.nodeBoot == command.nodeBoot then\013\010",
    "            state.pendingSystemRestartAck = {\013\010",
    "                sender = command.sender, session = command.session,\013\010",
    "                requestId = command.requestId, targetLabel = command.targetLabel,\013\010",
    "                nodeBoot = command.nodeBoot, currentNodeBoot = state.nodeBoot,\013\010",
    "                bootToken = command.bootToken, accepted = false, zeroVerified = false,\013\010",
    "                detail = \"RESTART_REQUEST_EXPIRED_OR_SUPERSEDED\",\013\010",
    "            }\013\010",
    "            state.pendingSystemRestart = nil\013\010",
    "            return processPendingSystemRestart(state, bindings, now, rednetApi, wait, reboot)\013\010",
    "        end\013\010",
    "        state.pendingSystemRestart = nil\013\010",
    "        return false\013\010",
    "    end\013\010",
    "\013\010",
    "    local stillAuthorized = function() return restartStillAuthorized(state, command, os.clock()) end\013\010",
    "    local zeroVerified, detail = forceZeroConfiguredDrives(state, bindings or state.bindings, stillAuthorized, wait)\013\010",
    "    if zeroVerified == nil then\013\010",
    "        if state.pendingSystemRestart == command then\013\010",
    "            state.pendingSystemRestartAck = {\013\010",
    "                sender = command.sender, session = command.session,\013\010",
    "                requestId = command.requestId, targetLabel = command.targetLabel,\013\010",
    "                nodeBoot = command.nodeBoot, currentNodeBoot = state.nodeBoot,\013\010",
    "                bootToken = command.bootToken, accepted = false, zeroVerified = false,\013\010",
    "                detail = detail,\013\010",
    "            }\013\010",
    "            state.pendingSystemRestart = nil\013\010",
    "            return processPendingSystemRestart(state, bindings, os.clock(), rednetApi, wait, reboot)\013\010",
    "        end\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    if not stillAuthorized() then\013\010",
    "        state.pendingSystemRestart = nil\013\010",
    "        return false\013\010",
    "    end\013\010",
    "\013\010",
    "    local reply = {\013\010",
    "        sender = command.sender, session = command.session,\013\010",
    "        requestId = command.requestId, targetLabel = command.targetLabel,\013\010",
    "        nodeBoot = command.nodeBoot, currentNodeBoot = state.nodeBoot,\013\010",
    "        bootToken = command.bootToken, accepted = true,\013\010",
    "        zeroVerified = zeroVerified, detail = detail,\013\010",
    "    }\013\010",
    "    if not sendSystemRestartAck(state, reply, rednetApi) then\013\010",
    "        state.systemRestartRetryAt = os.clock() + 0.5\013\010",
    "        state.lastApplyFault = \"SYSTEM_RESTART_ACK_SEND_FAILED\"\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    if not stillAuthorized() then\013\010",
    "        if state.pendingSystemRestart == command then state.pendingSystemRestart = nil end\013\010",
    "        state.reason = \"SYSTEM RESTART AUTHORITY EXPIRED AFTER ACK\"\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    state.pendingSystemRestart = nil\013\010",
    "    state.systemRestartRetryAt = nil\013\010",
    "    state.systemRestarted = true\013\010",
    "    if zeroVerified then state.reason = nil else state.reason = detail end\013\010",
    "    state.phase = zeroVerified and \"SYSTEM RESTART ACCEPTED; ZERO VERIFIED\" or \"SYSTEM RESTART ACCEPTED; ZERO FAULT\"\013\010",
    "    local restart = reboot or os.reboot\013\010",
    "    if type(restart) == \"function\" then restart() end\013\010",
    "    return true\013\010",
    "end\013\010",
    "Thrust.processSystemRestart = processPendingSystemRestart\013\010",
    "\013\010",
    "-- Summary: Validate the installed core, role and local computer identity.\010",
    "local function validInstalledIdentity(config, role)\013\010",
    "    local expected = role == \"primary-left\" and { role = \"primary_l\", packageId = \"amaryllis.primary.l\" }\013\010",
    "        or role == \"primary-right\" and { role = \"primary_r\", packageId = \"amaryllis.primary.r\" }\013\010",
    "    local install = config and config.install\013\010",
    "    local computerID = type(os.getComputerID) == \"function\" and os.getComputerID() or nil\013\010",
    "    if not expected or type(install) ~= \"table\" or install.protocol ~= \"amaryllis.install.v1\"\013\010",
    "        or install.role ~= expected.role or config.role ~= expected.role\013\010",
    "        or install.packageId ~= expected.packageId or not integer(install.version, 2, 2147483647)\013\010",
    "        or not integer(install.coreID, 0, 65535) or config.coreId ~= install.coreID\013\010",
    "        or not boundedText(install.coreSession, 128)\013\010",
    "        or install.computerID ~= computerID or config.computerId ~= computerID or install.label ~= config.label\013\010",
    "        or config.telemetryRole ~= role or config.protocol ~= Thrust.PROTOCOL then\013\010",
    "        return false, \"INSTALLED ROLE OR COMPUTER IDENTITY MISMATCH\"\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "Thrust.validInstalledIdentity = validInstalledIdentity\013\010",
    "-- Summary: Initialize the role's runtime context and start its supervised workers.\010",
    "local function runtime()\013\010",
    "    local config, configError = readConfig()\013\010",
    "    if not config then error(configError, 0) end\013\010",
    "    local role = (config.telemetryRole or config.role)\013\010",
    "    local kind = roleKind(role)\013\010",
    "    local configValid, validationReason = validateConfig(config, role, kind)\013\010",
    "    local identityValid, identityReason = validInstalledIdentity(config, role)\013\010",

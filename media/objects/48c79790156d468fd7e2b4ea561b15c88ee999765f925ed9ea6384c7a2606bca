    "        state.reason = nil\013\010",
    "        state.phase = \"COMMAND ACTIVE\"\013\010",
    "    elseif state.reason and state.reason:find(\"TRANSMISSION MODE CHANGED\", 1, true) then\013\010",
    "        local allIncremental = true\013\010",

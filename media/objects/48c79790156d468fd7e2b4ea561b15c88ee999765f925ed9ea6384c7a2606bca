    "    if protocol ~= Thrust.PROTOCOL or type(message) ~= \"table\" or not finite(now) then return false end\013\010",
    "    if message.kind == \"system_restart\" then return queueSystemRestart(state, sender, message, now) end\013\010",
    "    if message.kind == \"thrust_session\" then\013\010",
    "        if not integer(sender, 0, 65535) or sender ~= state.authorizedCoreId or message.v ~= 1 or message.role ~= state.role or\013\010",
    "            message.nodeBoot ~= state.nodeBoot or not boundedText(message.session, 128) then return false end\013\010",
    "        local newSessionKey = coreSessionKey(sender, message.session)\013\010",
    "        if (state.session ~= message.session or state.coreId ~= sender) and\013\010",
    "            state.retiredCoreSessions and state.retiredCoreSessions[newSessionKey] then return false end\013\010",
    "        if state.coreId and state.coreId ~= sender then\013\010",
    "            if not finite(state.lastSessionAt) or now - state.lastSessionAt <= SESSION_TIMEOUT then return false end\013\010",
    "            invalidate(state, \"CORE CONNECTION REPLACED\", nil, false)\013\010",
    "        end\013\010",
    "        if state.session ~= message.session or state.coreId ~= sender then\013\010",
    "            retireCoreSession(state, state.coreId, state.session)\013\010",
    "        end\013\010",
    "        if state.session ~= message.session or state.coreId ~= sender then\013\010",
    "            invalidate(state, \"NEW CORE SESSION\", nil, false)\013\010",
    "            state.lastReceivedSeq, state.lastAppliedSeq = -1, -1\013\010",
    "            state.ackSeq, state.ackAccepted, state.pendingAppliedSeq = -1, false, nil\013\010",
    "            state.pendingSystemRestart = nil\013\010",
    "            state.pendingSystemRestartAck = nil\013\010",
    "            state.systemRestartRetryAt = nil\013\010",
    "        end\013\010",
    "        state.coreId, state.session, state.lastSessionAt = sender, message.session, now\013\010",
    "        state.phase = \"SESSION ACTIVE\"\013\010",
    "        return true\013\010",
    "    end\013\010",
    "    if message.kind ~= \"thrust_command\" and message.kind ~= \"thrust_stop\" then return false end\013\010",
    "    if state.pendingSystemRestart then return false end\013\010",
    "    if state.endpointKind ~= \"controller\" or not integer(sender, 0, 65535) or sender ~= state.coreId or\013\010",
    "        message.v ~= 1 or message.role ~= state.role or message.nodeBoot ~= state.nodeBoot or\013\010",
    "        message.session ~= state.session or not finite(state.lastSessionAt) or now - state.lastSessionAt > SESSION_TIMEOUT or\013\010",
    "        not integer(message.seq, 1, MAX_SEQUENCE) or message.seq <= state.lastReceivedSeq then return false end\013\010",
    "\013\010",
    "    state.lastReceivedSeq = message.seq\013\010",
    "    state.hasCommand = true\013\010",
    "    if message.kind == \"thrust_stop\" then\013\010",
    "        invalidate(state, type(message.reason) == \"string\" and message.reason or \"CORE STOP\", message.seq, true)\013\010",
    "        state.pendingAppliedSeq = message.seq\013\010",
    "        return true\013\010",
    "    end\013\010",
    "\013\010",
    "    local ttl = message.ttlSeconds\013\010",
    "    if not finite(ttl) or ttl <= 0 or ttl > (state.config.maxCommandTtlSeconds or 1) or ttl > 3 then\013\010",
    "        invalidate(state, \"COMMAND TTL OUT OF RANGE\", message.seq, false)\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    if state.config.enabled ~= true or state.config.bindingsVerified ~= true then\013\010",
    "        invalidate(state, \"WRITER DISABLED OR BINDINGS UNVERIFIED\", message.seq, false)\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    local targets, reason = Thrust.validateTargets(state.role, state.drives, message.targets)\013\010",
    "    if not targets then\013\010",
    "        invalidate(state, reason, message.seq, false)\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    state.writerToken = state.writerToken + 1\013\010",
    "    state.desiredTargets, state.requestedTargets = targets, copyMap(targets)\013\010",
    "    state.leaseUntil, state.pendingAppliedSeq = now + ttl, message.seq\013\010",
    "    state.ackSeq, state.ackAccepted = message.seq, true\013\010",
    "    state.reason, state.phase = nil, \"COMMAND ACCEPTED\"\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "function Thrust.targetsAt(state, now)\013\010",
    "    if state.leaseUntil and (not finite(now) or now > state.leaseUntil) then\013\010",
    "        if state.leaseUntil ~= false then invalidate(state, \"COMMAND LEASE EXPIRED; RAMPING TO ZERO\", nil, false) end\013\010",
    "        state.leaseUntil = false -- one-shot expiry marker; no repeated token bumps\013\010",
    "    end\013\010",
    "    return state.leaseUntil and copyMap(state.desiredTargets) or zeroMap(state.drives)\013\010",
    "end\013\010",
    "\013\010",
    "local function settingMatches(definition, demand, shift)\013\010",
    "    local maximum = definition and definition.maxLevel\013\010",
    "    if not integer(maximum, 1, 256) then return demand == 0 and shift == 0 end\013\010",
    "    local expected = Hardware.expectedShift(demand, 0, maximum)\013\010",
    "    return expected ~= nil and shift == expected\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Read and cache the configured endpoint drive levels.\010",
    "function Thrust.updateReadbacks(state, readbacks, now)\013\010",
    "    state.rawShifts = copyMap(readbacks)\013\010",
    "    state.readbacks, state.applied = {}, {}\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        local raw = readbacks[drive]\013\010",
    "        local def = state.config.drives and state.config.drives[drive] or {}\013\010",
    "        if raw and raw.mode == \"incremental\" and integer(raw.level, 0, 256) then\013\010",
    "            state.readbacks[drive] = { shiftLevel = raw.level, valid = true }\013\010",
    "            local maxLevel = def.maxLevel\013\010",
    "            if integer(maxLevel, 1, 256) then state.applied[drive] = clamp(raw.level / maxLevel, 0, 1) end\013\010",
    "        else\013\010",
    "            state.readbacks[drive] = { valid = false }\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local targets = Thrust.targetsAt(state, now)\013\010",
    "    local pending = state.pendingAppliedSeq\013\010",
    "    if pending then\013\010",
    "        local allSettled = true\013\010",
    "        for _, drive in ipairs(state.drives) do\013\010",
    "            local raw = readbacks[drive]\013\010",
    "            local definition = state.config.drives and state.config.drives[drive] or {}\013\010",
    "            if not raw or raw.mode ~= \"incremental\" or not integer(raw.level, 0, 256) or\013\010",
    "                not settingMatches(definition, targets[drive] or 0, raw.level) then\013\010",
    "                allSettled = false\013\010",
    "                break\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if allSettled then\013\010",
    "            state.lastAppliedSeq = pending\013\010",
    "            local active = false\013\010",
    "            for _, value in pairs(targets) do if value > 0 then active = true end end\013\010",
    "            state.phase = active and \"APPLIED\" or \"ZERO READBACK CONFIRMED\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "end\013\010",
    "\013\010",
    "function Thrust.shouldWrite(state)\013\010",
    "    return state.endpointKind == \"controller\" and state.writerEnabled == true and\013\010",
    "        state.hasCommand == true and state.pendingSystemRestart == nil and state.systemRestarted ~= true\013\010",
    "end\013\010",
    "\013\010",
    "-- Age is for the last completed readback pass across every bound drive. A\013\010",
    "-- status heartbeat cannot make cached hardware observations look fresh.\013\010",
    "-- Summary: Build the bounded endpoint drive-readback view.\010",
    "function Thrust.readbackSnapshot(state, now, staleAfter)\013\010",
    "    local age = finite(state.readbackSampleAt) and finite(now) and now >= state.readbackSampleAt and\013\010",
    "        (now - state.readbackSampleAt) or nil\013\010",
    "    local fresh = age ~= nil and finite(staleAfter) and staleAfter > 0 and age <= staleAfter\013\010",
    "    local readbacks, applied = {}, {}\013\010",
    "    if not fresh then\013\010",
    "        -- Invalidate cached observations locally as well as on the wire. A\013\010",
    "        -- later completed getter pass repopulates these maps.\013\010",
    "        state.readbacks, state.applied = {}, {}\013\010",
    "        for _, drive in ipairs(state.drives or {}) do state.readbacks[drive] = { valid = false } end\013\010",
    "    end\013\010",
    "    for _, drive in ipairs(state.drives or {}) do\013\010",
    "        local readback = state.readbacks and state.readbacks[drive]\013\010",
    "        if fresh and readback and readback.valid == true then\013\010",
    "            readbacks[drive] = { shiftLevel = readback.shiftLevel, valid = true }\013\010",
    "            if state.applied and finite(state.applied[drive]) then applied[drive] = state.applied[drive] end\013\010",
    "        else\013\010",
    "            readbacks[drive] = { valid = false }\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return age, fresh == true, readbacks, applied\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Validate the role's required configuration fields and operating bounds.\010",
    "local function validateConfig(config, role, endpointKind)\013\010",
    "    local configRole = type(config) == \"table\" and (config.telemetryRole or config.role) or nil\013\010",
    "    local roleMatches = type(config) == \"table\" and (configRole == role or\013\010",
    "        (config.role == \"auto\" and endpointKind == \"sensor\" and roleKind(role) == \"sensor\"))\013\010",
    "    if type(config) ~= \"table\" or config.version ~= 1 or config.protocol ~= \"amaryllis.v1\" or not roleMatches or\013\010",
    "        config.endpointKind ~= endpointKind then return false, \"ROLE OR CONFIG VERSION MISMATCH\" end\013\010",
    "    if endpointKind == \"sensor\" then return true end\013\010",
    "    if type(config.enabled) ~= \"boolean\" or type(config.bindingsVerified) ~= \"boolean\" or\013\010",
    "        type(config.drives) ~= \"table\" or type(config.bindings) ~= \"table\" then\013\010",
    "        return false, \"CONTROLLER CONFIGURATION IS INCOMPLETE\"\013\010",
    "    end\013\010",
    "    if config.commissionZeroOnStartup ~= nil and type(config.commissionZeroOnStartup) ~= \"boolean\" then\013\010",
    "        return false, \"commissionZeroOnStartup MUST BE A BOOLEAN\"\013\010",
    "    end\013\010",
    "    if config.commissionZeroOnStartup == true and\013\010",
    "        (config.enabled ~= true or config.bindingsVerified ~= true or type(config.bindingFingerprint) ~= \"string\" or\013\010",
    "            config.bindingFingerprint == \"\") then\013\010",
    "        return false, \"STARTUP COMMISSIONING REQUIRES AN ENABLED, VERIFIED BINDING\"\013\010",
    "    end\013\010",
    "    local expected = Thrust.ROLE_DRIVES[role] or {}\013\010",
    "    for key in pairs(config.drives) do if not inList(expected, key) then return false, \"UNEXPECTED DRIVE: \" .. tostring(key) end end\013\010",
    "    for key in pairs(config.bindings) do if not inList(expected, key) then return false, \"UNEXPECTED BINDING: \" .. tostring(key) end end\013\010",
    "    for _, drive in ipairs(expected) do\013\010",
    "        local definition = config.drives[drive]\013\010",
    "        local binding = config.bindings[drive]\013\010",
    "        if type(definition) ~= \"table\" or type(binding) ~= \"table\" then return false, \"DRIVE CONFIG MISSING: \" .. drive end\013\010",
    "        if not integer(definition.maxLevel, 0, 256) or (config.enabled and definition.maxLevel == 0) then\013\010",
    "            return false, \"INVALID VERIFIED LIMIT FOR \" .. drive\013\010",
    "        end\013\010",
    "        if not finite(definition.rampPerSecond) or definition.rampPerSecond <= 0 or definition.rampPerSecond > 1 then\013\010",
    "            return false, \"INVALID RAMP LIMIT FOR \" .. drive\013\010",
    "        end\013\010",
    "        if definition.commissionModeOnCommand ~= nil then\013\010",
    "            return false, \"MODE COMMISSIONING IS MANUAL; REMOVE commissionModeOnCommand\"\013\010",
    "        end\013\010",
    "        if type(binding.peripheral) ~= \"string\" then return false, \"PERIPHERAL NAME MISSING FOR \" .. drive end\013\010",
    "    end\013\010",
    "    local ttl = config.maxCommandTtlSeconds\013\010",
    "    if not finite(ttl) or ttl <= 0 or ttl > 3 then return false, \"INVALID MAXIMUM COMMAND TTL\" end\013\010",
    "    local readbackStale = config.readbackStaleSeconds\013\010",
    "    if not finite(readbackStale) or readbackStale <= 0 or readbackStale > 3 then\013\010",
    "        return false, \"INVALID READBACK FRESHNESS LIMIT\"\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "Thrust.validateConfig = validateConfig\013\010",
    "\013\010",
    "-- Summary: Discover and open role-network modems through rednet.\010",
    "local function connectRednet()\013\010",
    "    local opened = {}\013\010",
    "    if type(peripheral) ~= \"table\" or type(peripheral.getNames) ~= \"function\" or type(rednet) ~= \"table\" then\013\010",
    "        return opened, \"REDNET OR PERIPHERAL API UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local ok, names = pcall(peripheral.getNames)\013\010",
    "    if not ok or type(names) ~= \"table\" then return opened, \"COULD NOT ENUMERATE MODEMS\" end\013\010",
    "    table.sort(names)\013\010",
    "    for _, name in ipairs(names) do\013\010",
    "        local isModem = false\013\010",
    "        if type(peripheral.hasType) == \"function\" then\013\010",
    "            local good, yes = pcall(peripheral.hasType, name, \"modem\")\013\010",
    "            isModem = good and yes == true\013\010",
    "        end\013\010",
    "        if not isModem and type(peripheral.getType) == \"function\" then\013\010",
    "            local good, kind = pcall(peripheral.getType, name)\013\010",
    "            isModem = good and (kind == \"modem\" or (type(kind) == \"table\" and inList(kind, \"modem\")))\013\010",
    "        end\013\010",
    "        if isModem then\013\010",
    "            local good = pcall(rednet.open, name)\013\010",
    "            if good then opened[#opened + 1] = name end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if #opened == 0 then return opened, \"NO MODEM PERIPHERAL FOUND\" end\013\010",
    "    return opened\013\010",
    "end\013\010",
    "\013\010",
    "local function sendBroadcast(packet)\013\010",
    "    if not rednet or type(rednet.broadcast) ~= \"function\" then return false end\013\010",
    "    local ok, result = pcall(rednet.broadcast, packet, Thrust.PROTOCOL)\013\010",
    "    return ok and result ~= false\013\010",
    "end\013\010",
    "local function sendDirect(id, packet)\013\010",
    "    if not rednet or type(rednet.send) ~= \"function\" then return false end\013\010",
    "    local ok, result = pcall(rednet.send, id, packet, Thrust.PROTOCOL)\013\010",
    "    return ok and result ~= false\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Load and validate the role's configuration file.\010",
    "local function readConfig()\013\010",
    "    if not fs or not fs.exists(\"/avionics/config.json\") then return nil, \"MISSING /avionics/config.json\" end\013\010",
    "    local handle, reason = fs.open(\"/avionics/config.json\", \"r\")\013\010",
    "    if not handle then return nil, \"CONFIG OPEN FAILED: \" .. tostring(reason) end\013\010",
    "    local raw = handle.readAll(); handle.close()\013\010",
    "    local ok, value = pcall(textutils.unserializeJSON, raw)\013\010",
    "    if not ok or type(value) ~= \"table\" then return nil, \"CONFIG JSON IS INVALID\" end\013\010",
    "    return value\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Create this boot's node token from the current clock and a per-computer random value.\010",
    "local function bootToken()\013\010",
    "    local epoch = type(os.epoch) == \"function\" and os.epoch(\"utc\") or math.floor(os.clock() * 1000)\013\010",
    "    -- Do not call math.randomseed here. rednet draws its message IDs from the same generator and\013\010",
    "    -- silently drops IDs it has recently seen, so two computers that boot a few milliseconds\013\010",
    "    -- apart with seed epoch+id would send identical IDs and one would be dropped. ComputerCraft\013\010",
    "    -- already seeds the generator independently on each computer.\013\010",
    "    return tostring(epoch or 0) .. \"-\" .. tostring(math.random(100000, 999999))\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Rediscover role hardware and update its binding identity and availability.\010",
    "local function refreshBindings(config, role)\013\010",
    "    local found, reason = Hardware.discover()\013\010",
    "    if not found then return {}, false, reason, nil end\013\010",
    "    local bindings, reasons = Hardware.controllerBindings(config, found)\013\010",
    "    local currentFingerprint = Hardware.inventoryFingerprint(role, config.bindings)\013\010",
    "    if config.bindingsVerified ~= true then reasons[#reasons + 1] = \"BINDINGS_NOT_COMMISSIONED\" end\013\010",
    "    if type(config.bindingFingerprint) ~= \"string\" or config.bindingFingerprint ~= currentFingerprint then\013\010",
    "        reasons[#reasons + 1] = \"BINDING_FINGERPRINT_MISMATCH\"\013\010",
    "    end\013\010",
    "    local ready = #reasons == 0\013\010",
    "    return bindings, ready, table.concat(reasons, \"; \"), found\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Refresh the endpoint's configuration, hardware and drive readback status.\010",
    "local function refreshStatus(state, config, configValid, bindingReady, bindingReason, networkReady)\013\010",
    "    state.configValid = configValid == true\013\010",
    "    state.bindingReady = bindingReady == true\013\010",
    "    local commissioningReady = config.commissionZeroOnStartup ~= true or state.commissioningStatus == \"READY\"\013\010",
    "    state.writerEnabled = state.endpointKind == \"controller\" and state.configValid and\013\010",
    "        state.bindingReady and config.enabled == true and commissioningReady\013\010",
    "    state.enabled = state.endpointKind == \"sensor\" or config.enabled == true\013\010",
    "    state.ready = state.endpointKind == \"sensor\" and networkReady == true or state.writerEnabled and networkReady == true\013\010",
    "    if not state.configValid then state.reason = state.configReason or \"CONFIG INVALID\"\013\010",
    "    elseif state.endpointKind == \"controller\" and not state.bindingReady then state.reason = bindingReason or \"BINDINGS NOT READY\"\013\010",
    "    elseif state.endpointKind == \"controller\" and config.commissionZeroOnStartup == true and not commissioningReady then\013\010",
    "        state.reason = state.commissioningReason or \"STARTUP ZERO/INCREMENTAL COMMISSIONING NOT COMPLETE\"\013\010",
    "    elseif state.endpointKind == \"controller\" and not state.writerEnabled then state.reason = \"WRITER DISABLED IN CONFIG\"\013\010",
    "    elseif not networkReady then state.reason = \"NETWORK UNAVAILABLE\"\013\010",
    "    elseif state.reason == \"CONFIG INVALID\" or state.reason == \"BINDINGS NOT READY\" or state.reason == \"WRITER DISABLED IN CONFIG\" or\013\010",
    "        state.reason == \"NETWORK UNAVAILABLE\" or state.reason == \"STARTUP ZERO/INCREMENTAL COMMISSIONING NOT COMPLETE\" then state.reason = nil end\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Advance endpoint control authority and the current requested drive operation.\010",
    "local function controllerTick(state, config, hardwareBindings, now, dt)\013\010",
    "    if state.stopping or state.endpointKind ~= \"controller\" or state.pendingSystemRestart then return end\013\010",
    "    state.phase = state.phase or \"READY\"\013\010",
    "    local liveTargets = Thrust.targetsAt(state, now)\013\010",
    "    local token = state.writerToken\013\010",
    "    local function jobCurrent() return not state.stopping and state.writerToken == token end\013\010",
    "    local rawReadbacks = {}\013\010",
    "    local hardwareFault\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        local binding = hardwareBindings[drive]\013\010",
    "        if binding then\013\010",
    "            local level, reason, mode = Hardware.readShift(binding, jobCurrent)\013\010",
    "            if level ~= nil then rawReadbacks[drive] = { level = level, mode = mode }\013\010",
    "            else\013\010",
    "                rawReadbacks[drive] = { reason = reason }\013\010",
    "                hardwareFault = hardwareFault or reason\013\010",
    "            end\013\010",
    "        else\013\010",
    "            rawReadbacks[drive] = { reason = \"TRANSMISSION UNBOUND\" }\013\010",
    "        end\013\010",
    "        if not jobCurrent() then return end\013\010",
    "    end\013\010",
    "    state.rawShifts = rawReadbacks\013\010",
    "    local gatedTargets, waiting = Thrust.interlockTargets(state.drives, liveTargets, rawReadbacks)\013\010",
    "    state.interlockWaiting = waiting\013\010",
    "\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        if not jobCurrent() then return end\013\010",
    "        local binding = hardwareBindings[drive]\013\010",
    "        local raw = rawReadbacks[drive]\013\010",
    "        local definition = config.drives[drive]\013\010",
    "        if binding and raw and raw.level ~= nil and Thrust.shouldWrite(state) then\013\010",
    "            local wanted = gatedTargets[drive] or 0\013\010",
    "            local activeCommand = state.leaseUntil and state.leaseUntil ~= false and now <= state.leaseUntil\013\010",
    "            if wanted > 0 and raw.mode ~= \"incremental\" then\013\010",
    "                hardwareFault = hardwareFault or \"TRANSMISSION NOT IN INCREMENTAL MODE; MANUAL COMMISSIONING REQUIRED\"\013\010",
    "                state.phase = \"MODE NOT READY\"\013\010",
    "                -- A mode changed while thrust was requested. Revoke the lease;\013\010",
    "                -- the next sole-writer pass can command verified zero in the\013\010",
    "                -- observed mode, then readiness remains false until repaired.\013\010",
    "                if state.hasCommand then invalidate(state, \"TRANSMISSION MODE CHANGED; RAMPING TO ZERO\", nil, false) end\013\010",
    "            elseif raw.mode == \"incremental\" and integer(raw.level, 0, 256) then\013\010",
    "                local current = definition.maxLevel > 0 and clamp(raw.level / definition.maxLevel, 0, 1) or 0\013\010",
    "                local nextValue = Thrust.ramp(current, wanted, definition.rampPerSecond, dt)\013\010",
    "                local nextLevel = nextValue and Hardware.expectedShift(nextValue, 0, definition.maxLevel)\013\010",
    "                if nextLevel ~= nil and nextLevel ~= raw.level then\013\010",
    "                    local stillAuthorized = activeCommand and wanted > 0\013\010",
    "                    local allowed = stillAuthorized and function()\013\010",
    "                        return jobCurrent() and state.leaseUntil and state.leaseUntil ~= false and os.clock() <= state.leaseUntil\013\010",
    "                    end or jobCurrent\013\010",
    "                    local ok, reason\013\010",
    "                    if not stillAuthorized and nextLevel == 0 then\013\010",
    "                        ok, reason = Hardware.writeShift(binding, 0, allowed)\013\010",
    "                    else\013\010",
    "                        ok, reason = Hardware.writeShift(binding, nextLevel, allowed)\013\010",
    "                    end\013\010",
    "                    if not ok then hardwareFault = hardwareFault or reason end\013\010",
    "                elseif nextLevel == nil then state.reason = \"INVALID SHIFT LIMIT: \" .. drive end\013\010",
    "            elseif raw.mode == \"direct\" and raw.level > 0 and state.hasCommand and wanted == 0 then\013\010",
    "                -- Direct-mode readback has different units. A zero command is\013\010",
    "                -- safe in either mode; no direct-mode intermediate is inferred.\013\010",
    "                local ok, reason = Hardware.writeSafeZero(binding, jobCurrent)\013\010",
    "                if not ok then hardwareFault = hardwareFault or reason end\013\010",
    "            elseif raw.reason and state.hasCommand and liveTargets[drive] == 0 then\013\010",
    "                hardwareFault = hardwareFault or raw.reason\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if not jobCurrent() then return end\013\010",
    "    end\013\010",
    "\013\010",
    "    -- A separate fresh readback pass provides ACK only after the librarys\013\010",
    "    -- scheduled transmission update becomes visible through getShiftLevel.\013\010",
    "    local settled = {}\013\010",
    "    local completeReadback = true\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        local binding = hardwareBindings[drive]\013\010",
    "        if binding then\013\010",
    "            local level, _, mode = Hardware.readShift(binding, jobCurrent)\013\010",
    "            if level ~= nil then settled[drive] = { level = level, mode = mode } end\013\010",
    "            if level == nil then completeReadback = false end\013\010",
    "        else\013\010",
    "            completeReadback = false\013\010",

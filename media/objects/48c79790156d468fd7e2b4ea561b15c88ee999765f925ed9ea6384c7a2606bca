    "            if not settled[drive] or settled[drive].mode ~= \"incremental\" then allIncremental = false end\013\010",
    "        end\013\010",
    "        if allIncremental then state.reason = nil; state.phase = \"READY\" end\013\010",
    "    elseif state.reason and state.reason:find(\"TRANSMISSION NOT IN\", 1, true) then\013\010",
    "        state.reason = nil\013\010",
    "    end\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Build the bounded current-session endpoint status packet.\010",
    "local function statusPacket(state, now)\013\010",
    "    state.statusSeq = math.min(MAX_SEQUENCE, state.statusSeq + 1)\013\010",
    "    if state.endpointKind == \"sensor\" then\013\010",
    "        local readings, _, usefulData = Hardware.readBearings(state.inventory)\013\010",
    "        local available = usefulData == true and state.configValid == true\013\010",
    "        state.sensorAvailable = available\013\010",
    "        state.sensorReason = not available and (state.configReason or \"NO VALID SPEED, THRUST, OR VECTOR READBACK\") or nil\013\010",
    "        return {\013\010",
    "            v = 1, kind = \"thrust_status\", session = state.session,\013\010",
    "            role = state.role, endpointKind = \"sensor\", nodeBoot = state.nodeBoot,\013\010",
    "            seq = state.statusSeq, available = available,\013\010",
    "            reason = not available and state.sensorReason or nil,\013\010",
    "            faults = {}, readings = readings,\013\010",
    "        }\013\010",
    "    end\013\010",
    "    local reason = state.reason and wireText(state.reason, 160) or nil\013\010",
    "    local age, fresh, readbacks, applied = Thrust.readbackSnapshot(state, now or os.clock(), state.config.readbackStaleSeconds)\013\010",
    "    local allValid = fresh\013\010",
    "    for _, drive in ipairs(state.drives) do\013\010",
    "        if not readbacks[drive] or readbacks[drive].valid ~= true then allValid = false end\013\010",
    "    end\013\010",
    "    local ready = state.ready == true and allValid\013\010",
    "    if not fresh then reason = reason or \"TRANSMISSION READBACK STALE\" end\013\010",
    "    if fresh and not allValid then reason = reason or \"TRANSMISSION MODE OR READBACK INVALID\" end\013\010",
    "    state.readbackAgeSeconds, state.readbackFresh = age, fresh\013\010",
    "    state.statusReady = ready\013\010",
    "    state.statusCommandReady = state.commandReady == true and ready\013\010",
    "    return {\013\010",
    "        v = 1, kind = \"thrust_status\", session = state.session,\013\010",
    "        role = state.role, endpointKind = \"controller\", nodeBoot = state.nodeBoot,\013\010",
    "        seq = state.statusSeq, ready = ready, enabled = state.enabled == true,\013\010",
    "        configValid = state.configValid == true, bindingReady = state.bindingReady == true,\013\010",
    "        writerEnabled = state.writerEnabled == true, commandReady = state.statusCommandReady,\013\010",
    "        readbackAgeSeconds = age,\013\010",
    "        bindingFingerprint = state.configFingerprint,\013\010",
    "        phase = state.phase, reason = reason,\013\010",
    "        faults = reason and { reason:sub(1, 128) } or {},\013\010",
    "        requestedTargets = copyMap(state.requestedTargets), applied = applied,\013\010",

    "        bindings, bindingReady, bindingReason, found = refreshBindings(config, role)\013\010",
    "    else\013\010",
    "        bindings, bindingReady, bindingReason, found = {}, false, validationReason, nil\013\010",
    "    end\013\010",
    "    state.bindings, state.bindingReady, state.bindingReason = bindings, bindingReady, bindingReason\013\010",
    "    if kind == \"sensor\" then\013\010",
    "        local inventory, reason = Hardware.discover()\013\010",
    "        state.inventory = inventory\013\010",
    "        if not inventory then state.reason = reason end\013\010",
    "        local _, _, usefulData = Hardware.readBearings(inventory)\013\010",
    "        state.sensorAvailable = usefulData == true and configValid == true\013\010",
    "        state.sensorReason = not state.sensorAvailable and (reason or validationReason or \"BEARING_DATA_UNAVAILABLE\") or nil\013\010",
    "    end\013\010",
    "    state.configFingerprint = configFingerprint\013\010",
    "    if kind == \"controller\" and config.commissionZeroOnStartup == true then\013\010",
    "        state.commissioningStatus = \"PENDING\"\013\010",
    "        if not configValid then\013\010",
    "            state.commissioningStatus = \"FAULT\"\013\010",
    "            state.commissioningReason = validationReason or \"CONTROLLER CONFIGURATION IS INVALID\"\013\010",
    "        elseif not bindingReady then\013\010",
    "            state.commissioningStatus = \"FAULT\"\013\010",
    "            state.commissioningReason = bindingReason or \"BOUND TRANSMISSIONS ARE NOT READY\"\013\010",
    "        else\013\010",
    "            -- This runs before any network or control task. The helper checks\013\010",
    "            -- every configured peripheral first, writes only bounded zeros,\013\010",
    "            -- verifies every zero, then changes only non-incremental modes.\013\010",
    "            local commissioned, commissionReason = Hardware.commissionZeroAndIncremental(\013\010",
    "                bindings, state.drives, nil, function(seconds) sleep(seconds) end)\013\010",
    "            if commissioned then\013\010",
    "                state.commissioningStatus = \"READY\"\013\010",
    "                state.commissioningReason = nil\013\010",
    "                state.phase = \"STARTUP ZERO/INCREMENTAL VERIFIED\"\013\010",
    "            else\013\010",
    "                state.commissioningStatus = \"FAULT\"\013\010",
    "                state.commissioningReason = \"STARTUP COMMISSIONING FAULT: \" .. tostring(commissionReason)\013\010",
    "                state.phase = \"STARTUP COMMISSIONING FAULT\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    refreshStatus(state, config, configValid, bindingReady, bindingReason or networkError, networkReady)\013\010",
    "    local runtimeState = os.__amaryllisRuntime or {}\013\010",
    "    runtimeState.components = runtimeState.components or {}\013\010",
    "    runtimeState.running = true\013\010",
    "    runtimeState.startedAt = runtimeState.startedAt or os.clock()\013\010",
    "    runtimeState.snapshot = state\013\010",
    "    -- Summary: Publish the role's current cached state to the local runtime context.\010",
    "    local function updateRuntime(now)\013\010",
    "        runtimeState = os.__amaryllisRuntime or runtimeState\013\010",
    "        runtimeState.components = runtimeState.components or {}\013\010",
    "        local component = runtimeState.components.primary or {}\013\010",
    "        runtimeState.components.primary = component\013\010",
    "        local faults = {}\013\010",
    "        if not identityValid then faults[#faults+1] = tostring(identityReason or \"INSTALLED_IDENTITY_INVALID\") end\013\010",
    "        if state.sensorAvailable ~= true then faults[#faults+1] = tostring(state.sensorReason or \"BEARING_DATA_UNAVAILABLE\") end\013\010",
    "        if not networkReady then faults[#faults+1] = tostring(networkError or \"NETWORK_UNAVAILABLE\") end\013\010",
    "        component.running = true\013\010",
    "        component.hardwareAvailable = state.sensorAvailable == true\013\010",
    "        component.faults = faults\013\010",
    "        component.faultSummary = #faults > 0 and table.concat(faults, \"; \"):sub(1, 256) or nil\013\010",
    "        component.snapshot = state\013\010",
    "        component.publishedAt = now or os.clock()\013\010",
    "        runtimeState.running = true\013\010",
    "        runtimeState.hardwareAvailable = component.hardwareAvailable\013\010",
    "        runtimeState.faults = faults\013\010",
    "        runtimeState.faultSummary = component.faultSummary\013\010",
    "        runtimeState.snapshot = state\013\010",
    "        runtimeState.publishedAt = component.publishedAt\013\010",
    "        os.__amaryllisRuntime = runtimeState\013\010",
    "    end\013\010",
    "    updateRuntime(os.clock())\013\010",
    "    print(\"Amaryllis thrust role: \" .. tostring(role) .. \" (\" .. tostring(kind) .. \")\")\013\010",
    "    if kind == \"controller\" then\013\010",
    "        print(\"Writer is \" .. (state.writerEnabled and \"enabled by config and binding check\" or \"disabled; no startup output write\"))\013\010",
    "        if config.commissionZeroOnStartup == true then\013\010",
    "            print(\"Startup zero/incremental commissioning: \" .. state.commissioningStatus ..\013\010",
    "                (state.commissioningReason and (\" (\" .. state.commissioningReason .. \")\") or \"\"))\013\010",
    "        else\013\010",
    "            print(\"Startup commissioning is disabled; no output write was requested.\")\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if not networkReady then print(networkError or \"Network unavailable; no remote command accepted.\") end\013\010",
    "\013\010",
    "    -- Summary: Validate and dispatch received packets for the current role and session.\010",
    "    local function dispatch(sender, message, protocol)\013\010",
    "        if protocol ~= Thrust.PROTOCOL or type(message) ~= \"table\" then return end\013\010",
    "        if message.kind == \"system_restart\" then\013\010",
    "            local accepted = Thrust.processPacket(state, sender, message, protocol, os.clock())\013\010",
    "            if accepted or state.pendingSystemRestartAck then os.queueEvent(SYSTEM_RESTART_EVENT) end\013\010",
    "        elseif message.kind == \"thrust_session\" or message.kind == \"thrust_command\" or message.kind == \"thrust_stop\" then\013\010",
    "            local accepted = Thrust.processPacket(state, sender, message, protocol, os.clock())\013\010",
    "            if accepted and message.kind == \"thrust_session\" then print(\"Core session accepted from dynamic sender #\" .. tostring(sender)) end\013\010",
    "        end\013\010",
    "        updateRuntime(os.clock())\013\010",

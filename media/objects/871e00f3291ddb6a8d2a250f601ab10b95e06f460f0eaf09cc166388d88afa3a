    "            thrust.speed_output_slew_per_second<0.01 or thrust.speed_output_slew_per_second>1) then\013\010",
    "            return false,\"thrust.speed_output_slew_per_second must be in [0.01,1]\"\013\010",
    "        end\013\010",
    "        if thrust.speed_overspeed_release_per_second~=nil and (not finite(thrust.speed_overspeed_release_per_second) or\013\010",
    "            thrust.speed_overspeed_release_per_second<0.01 or thrust.speed_overspeed_release_per_second>1) then\013\010",
    "            return false,\"thrust.speed_overspeed_release_per_second must be in [0.01,1]\"\013\010",
    "        end\013\010",
    "        if thrust.speed_pid~=nil then\013\010",
    "            local gains=thrust.speed_pid\013\010",
    "            if not object(gains) then return false,\"thrust.speed_pid must be an object\" end\013\010",
    "            for _,key in ipairs({\"kp\",\"ki\",\"kd\",\"integral_limit\",\"derivative_filter_seconds\"}) do\013\010",
    "                if not finite(gains[key]) or gains[key]<0 or gains[key]>100 then return false,\"thrust.speed_pid.\"..key..\" invalid\" end\013\010",
    "            end\013\010",
    "            if gains.derivative_filter_seconds<=0 then return false,\"thrust.speed_pid requires a positive derivative filter\" end\013\010",
    "        end\013\010",
    "        if thrust.manual_acceleration_pid~=nil then\013\010",
    "            local gains=thrust.manual_acceleration_pid\013\010",
    "            if not object(gains) then return false,\"thrust.manual_acceleration_pid must be an object\" end\013\010",
    "            for _,key in ipairs({\"kp\",\"ki\",\"kd\",\"integral_limit\",\"derivative_filter_seconds\"}) do\013\010",
    "                if not finite(gains[key]) or gains[key]<0 or gains[key]>100 then\013\010",
    "                    return false,\"thrust.manual_acceleration_pid.\"..key..\" invalid\"\013\010",
    "                end\013\010",
    "            end\013\010",
    "            if gains.derivative_filter_seconds<=0 then\013\010",
    "                return false,\"thrust.manual_acceleration_pid requires a positive derivative filter\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if thrust.heading_control~=nil then\013\010",
    "            local control=thrust.heading_control\013\010",
    "            if not object(control) or not finite(control.maximum_yaw_rate_degrees_per_second) or\013\010",
    "                control.maximum_yaw_rate_degrees_per_second<0.1 or control.maximum_yaw_rate_degrees_per_second>90 or\013\010",
    "                not finite(control.heading_rate_per_degree) or control.heading_rate_per_degree<=0 or\013\010",
    "                control.heading_rate_per_degree>10 or not finite(control.rate_filter_seconds) or\013\010",
    "                control.rate_filter_seconds<0.05 or control.rate_filter_seconds>5 or\013\010",
    "                not finite(control.output_slew_per_second) or control.output_slew_per_second<0.01 or\013\010",
    "                control.output_slew_per_second>1 or not object(control.rate_pid) then\013\010",
    "                return false,\"thrust.heading_control requires bounded yaw rate, heading gain, filters, slew, and PID\"\013\010",
    "            end\013\010",
    "            local gains=control.rate_pid\013\010",
    "            for _,key in ipairs({\"kp\",\"ki\",\"kd\",\"integral_limit\",\"derivative_filter_seconds\"}) do\013\010",
    "                if not finite(gains[key]) or gains[key]<0 or gains[key]>100 then\013\010",
    "                    return false,\"thrust.heading_control.rate_pid.\"..key..\" invalid\"\013\010",
    "                end\013\010",
    "            end\013\010",
    "            if gains.derivative_filter_seconds<=0 then\013\010",
    "                return false,\"thrust.heading_control.rate_pid requires a positive derivative filter\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if thrust.lateral_mixer~=nil then\013\010",
    "            local mixer=thrust.lateral_mixer\013\010",
    "            if not object(mixer) then return false,\"thrust.lateral_mixer must be an object\" end\013\010",
    "            for _,quad in ipairs({\"lb\",\"rb\",\"ls\",\"rs\"}) do\013\010",
    "                local item=mixer[quad]\013\010",
    "                if not object(item) or not finite(item.side_gain) or item.side_gain<0 or item.side_gain>1 or\013\010",
    "                    (item.side_sign~=1 and item.side_sign~=-1) or not finite(item.yaw_gain) or\013\010",
    "                    item.yaw_gain<0 or item.yaw_gain>1 or\013\010",
    "                    item.yaw_sign~=((quad==\"lb\" or quad==\"rb\") and 1 or -1) then\013\010",
    "                    return false,\"thrust.lateral_mixer requires bounded side/yaw gains and signs for \"..quad\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if thrust.enabled then\013\010",
    "            if thrust.limits_verified~=true or thrust.mapping_verified~=true or\013\010",
    "                not finite(thrust.command_ttl_seconds) then return false,\"enabled thrust requires verified limits/mapping and a command TTL\" end\013\010",
    "            if not finite(thrust.direct_max_request) then\013\010",
    "                return false,\"enabled thrust requires direct_max_request; RPM limits do not set controller maxLevel\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if thrust.direct_rpm_verified and not thrust.primary_rpm_limits then\013\010",
    "            return false,\"direct RPM requires verified primary_rpm_limits\"\013\010",
    "        end\013\010",
    "        if (thrust.manual_acceleration_verified or thrust.manual_acceleration_enabled) and (not thrust.manual_acceleration or\013\010",
    "            not thrust.manual_acceleration_pid) then\013\010",
    "            return false,\"manual acceleration requires signed setpoint bounds and PID gains\"\013\010",
    "        end\013\010",
    "        if thrust.speed_control_verified or thrust.speed_control_enabled then\013\010",
    "            if not thrust.speed_target_rate_bps2 or not thrust.speed_pid or\013\010",
    "                config.geometry.velocity_frame_verified~=true then\013\010",
    "                return false,\"speed control requires verified signed speed, target rate, and gains\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if thrust.mixer_verified and not thrust.lateral_mixer then\013\010",
    "            return false,\"verified side/yaw mixing requires per-quadrant lateral_mixer values\"\013\010",
    "        end\013\010",
    "        if (thrust.heading_control_verified or thrust.heading_control_enabled) and (not thrust.heading_control or\013\010",
    "            config.geometry.orientation_verified~=true) then\013\010",
    "            return false,\"heading control requires an orientation measurement and configured feedback limits\"\013\010",
    "        end\013\010",
    "        if thrust.reverse_verified and (thrust.direct_rpm_verified~=true or\013\010",
    "            not finite(thrust.reverse_speed_raw_deadband) or thrust.reverse_speed_raw_deadband<0) then\013\010",
    "            return false,\"reverse requires verified direct RPM, gearshift, and raw-speed rundown bound\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local control=config.altitude_control\013\010",
    "    if control~=nil then\013\010",
    "        if not object(control) or type(control.enabled)~=\"boolean\" or type(control.tuning_confirmed)~=\"boolean\" then\013\010",
    "            return false,\"altitude_control requires explicit enabled and tuning_confirmed booleans\"\013\010",
    "        end\013\010",
    "        local limits={minimum_world_y={-2048,2048},altitude_ceiling={-2048,2048},\013\010",
    "            max_vertical_speed={0.01,5},\013\010",
    "            max_feed_fraction={0.001,0.25},hover_capture_seconds={1,60},hover_max_vertical_speed={0.01,0.5},\013\010",
    "            trim_deadband_blocks={0,10},trim_ceiling_per_block={0,50},max_trim_ceiling_change={0,100},\013\010",
    "            trim_slew_ceiling_per_second={0.01,10},lift_balance_tolerance_fraction={0.01,0.25}}\013\010",
    "        for name,bounds in pairs(limits) do\013\010",
    "            if not finite(control[name]) or control[name]<bounds[1] or control[name]>bounds[2] then\013\010",
    "                return false,\"altitude_control.\"..name..\" is outside its documented bounds\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        -- These fields were added for the faster MAIN_LIFT phase. Older\013\010",
    "        -- schema-1 configurations inherit the former max-vertical-speed\013\010",
    "        -- target and its former max+1 hard guard; the READY hold keeps its own limits.\013\010",
    "        local startupTarget=control.startup_max_vertical_speed\013\010",
    "        if startupTarget==nil then startupTarget=control.max_vertical_speed end\013\010",
    "        local startupLimit=control.startup_vertical_speed_limit\013\010",
    "        if startupLimit==nil then startupLimit=control.max_vertical_speed+1 end\013\010",
    "        if not finite(startupTarget) or startupTarget<0.01 or startupTarget>20 then\013\010",
    "            return false,\"altitude_control.startup_max_vertical_speed must be finite and between 0.01 and 20\"\013\010",
    "        end\013\010",
    "        if not finite(startupLimit) or startupLimit<0.01 or startupLimit>20 then\013\010",
    "            return false,\"altitude_control.startup_vertical_speed_limit must be finite and between 0.01 and 20\"\013\010",
    "        end\013\010",
    "        if startupTarget>startupLimit then\013\010",
    "            return false,\"altitude_control.startup_max_vertical_speed cannot exceed startup_vertical_speed_limit\"\013\010",
    "        end\013\010",
    "        local startupShaping={startup_acceleration_seconds={5,600},startup_braking_lookahead_seconds={5,120},\013\010",
    "            ceiling_soft_start_rate={0.0005,0.05},ceiling_rise_rate={0.005,0.1},ceiling_fast_rate={0.02,0.25},\013\010",
    "            climb_trim_boost={1,20},level_damping_gain={0,10},level_lead_seconds={0,60},\013\010",
    "            level_boost_start_blocks={0.05,10},level_boost_max={1,20}}\013\010",
    "        for name,bounds in pairs(startupShaping) do\013\010",
    "            local value=control[name]\013\010",
    "            if value~=nil and (not finite(value) or value<bounds[1] or value>bounds[2]) then\013\010",
    "                return false,\"altitude_control.\"..name..\" must be between \"..bounds[1]..\" and \"..bounds[2]\013\010",
    "            end\013\010",
    "        end\013\010",
    "        local startupGasTarget=control.startup_gas_target_m3_per_chamber\013\010",
    "        if control.launch_settle_seconds~=nil and (not finite(control.launch_settle_seconds) or\013\010",
    "            control.launch_settle_seconds<0 or control.launch_settle_seconds>60 or control.launch_settle_seconds%1~=0) then\013\010",
    "            return false,\"altitude_control.launch_settle_seconds must be an integer between 0 and 60 seconds\"\013\010",
    "        end\013\010",
    "        if startupGasTarget~=nil and\013\010",
    "            (not finite(startupGasTarget) or startupGasTarget<0 or startupGasTarget>100000 or startupGasTarget%1~=0) then\013\010",
    "            return false,\"altitude_control.startup_gas_target_m3_per_chamber must be an integer between 0 and 100000 m3 per chamber\"\013\010",
    "        end\013\010",
    "        if control.manual_fore_aft_trim_blocks~=nil and\013\010",
    "            (not finite(control.manual_fore_aft_trim_blocks) or\013\010",
    "             control.manual_fore_aft_trim_blocks< -2 or control.manual_fore_aft_trim_blocks>2) then\013\010",
    "            return false,\"altitude_control.manual_fore_aft_trim_blocks must be between -2 and 2 blocks\"\013\010",
    "        end\013\010",
    "        if control.altitude_ceiling<=control.minimum_world_y then return false,\"altitude_control.altitude_ceiling must be above minimum_world_y\" end\013\010",
    "        -- Optional for older installations; Flight supplies conservative\013\010",
    "        -- defaults, which the existing settings writer persists as JSON.\013\010",
    "        if control.trim_pid~=nil then\013\010",
    "            if not object(control.trim_pid) then return false,\"altitude_control.trim_pid invalid\" end\013\010",
    "            for _,key in ipairs({\"ki\",\"kd\",\"integral_limit\",\"derivative_filter_seconds\"}) do\013\010",
    "                local value=control.trim_pid[key]\013\010",
    "                if not finite(value) or value<0 or value>100 then return false,\"trim_pid.\"..key..\" invalid\" end\013\010",
    "            end\013\010",
    "            if control.trim_pid.derivative_filter_seconds<=0 then return false,\"trim_pid requires positive derivative filter seconds\" end\013\010",
    "        end\013\010",
    "        for _,name in ipairs({\"altitude_pid\",\"vertical_speed_pid\"}) do\013\010",
    "            local gains=control[name]\013\010",
    "            if not object(gains) then return false,\"altitude_control.\"..name..\" is missing\" end\013\010",
    "            for _,key in ipairs({\"kp\",\"ki\",\"kd\",\"integral_limit\",\"derivative_filter_seconds\"}) do\013\010",
    "                if not finite(gains[key]) or gains[key]<0 or gains[key]>100 then return false,name..\".\"..key..\" invalid\" end\013\010",
    "            end\013\010",
    "            if gains.derivative_filter_seconds<=0 then return false,name..\" requires positive derivative filter seconds\" end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "local function api(dependencies)\013\010",
    "    dependencies = dependencies or {}\013\010",
    "    return dependencies.fs or fs, dependencies.textutils or textutils\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Read and decode JSON through the configured filesystem.\010",
    "local function readDocument(path, dependencies)\013\010",
    "    local fsApi, jsonApi = api(dependencies)\013\010",
    "    if not fsApi or type(fsApi.open) ~= \"function\" or not jsonApi or type(jsonApi.unserializeJSON) ~= \"function\" then\013\010",
    "        return nil, \"ComputerCraft filesystem or JSON support is unavailable\", \"unavailable\"\013\010",
    "    end\013\010",
    "    local okOpen, handle = pcall(fsApi.open, path, \"r\")\013\010",
    "    if not okOpen or not handle then return nil, \"could not open \" .. path .. \": \" .. tostring(handle), \"open\" end\013\010",
    "    local okRead, text = pcall(handle.readAll)\013\010",
    "    pcall(handle.close)\013\010",
    "    if not okRead or type(text) ~= \"string\" then return nil, \"could not read \" .. path .. \": \" .. tostring(text), \"read\" end\013\010",
    "    if #text > MAX_JSON_BYTES then return nil, path .. \" exceeds the JSON size limit\", \"size\" end\013\010",
    "    local okDecode, value = pcall(jsonApi.unserializeJSON, text)\013\010",
    "    if not okDecode or type(value) ~= \"table\" then\013\010",
    "        return nil, \"invalid JSON in \" .. path .. \": \" .. tostring(value), \"decode\"\013\010",
    "    end\013\010",
    "    return value\013\010",
    "end\013\010",
    "\013\010",
    "local LEGACY_STATE_PATH = \"/avionics/data/persistent-state.json\"\013\010",
    "local PILOT_STATE_PATH = \"/avionics/data/pilot-presets.json\"\013\010",
    "local VESSEL_STATE_PATH = \"/avionics/data/vessel-state.json\"\013\010",
    "\013\010",
    "local function sectionPath(key)\013\010",
    "    return key == \"controlPresets\" and PILOT_STATE_PATH or VESSEL_STATE_PATH\013\010",
    "end\013\010",
    "local STATE_SECTIONS = {\013\010",
    "    [\"/avionics/data/control-presets.json\"] = \"controlPresets\",\013\010",
    "    [\"/avionics/data/navigation.json\"] = \"navigation\",\013\010",
    "    [\"/avionics/data/hover-offset.json\"] = \"hoverOffset\",\013\010",
    "    [\"/avionics/data/level-bias.json\"] = \"levelBias\",\013\010",
    "    [\"/avionics/data/sensor-fallback.json\"] = \"sensorFallback\",\013\010",
    "    [\"/avionics/data/speed-feedforward-v2.json\"] = \"speedFeedforward\",\013\010",
    "    [\"/avionics/data/systems-intent.json\"] = \"systemsIntent\",\013\010",
    "    [\"/avionics/data/remotes.json\"] = \"remotes\",\013\010",
    "}\013\010",
    "\013\010",
    "local function validState(value)\013\010",
    "    return value.schemaVersion == 1 and object(value.sections) and object(value.previous)\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Resolve current core state and recover a verified backup with conservative authority.\010",
    "local function readState(statePath, dependencies)\013\010",
    "    local fsApi = select(1, api(dependencies))\013\010",
    "    if not fsApi or type(fsApi.exists) ~= \"function\" then return nil, \"unavailable\" end\013\010",
    "    local exists = fsApi.exists(statePath) or fsApi.exists(statePath .. \".bak\")\013\010",
    "    if not exists then return nil, \"missing\" end\013\010",
    "    for _, path in ipairs({statePath, statePath .. \".bak\"}) do\013\010",
    "        local value = readDocument(path, dependencies)\013\010",
    "        if value and validState(value) then\013\010",
    "            if path ~= statePath and statePath ~= PILOT_STATE_PATH then\013\010",
    "                -- Recover saved data while requiring fresh activation and remote flight grants.\013\010",
    "                value.sections.systemsIntent = {schemaVersion = 1, active = false}\013\010",
    "                value.previous.systemsIntent = nil\013\010",
    "                local pairing = value.sections.remotes\013\010",
    "                if object(pairing) and object(pairing.remotes) then\013\010",
    "                    for _, remote in pairs(pairing.remotes) do\013\010",
    "                        if object(remote) then remote.flightAllowed = false end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "                value.previous.remotes = nil\013\010",
    "            end\013\010",
    "            return value\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return nil, \"invalid\"\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Read and decode a JSON document through the configured filesystem dependency.\010",
    "function Storage.readJson(path, dependencies)\013\010",
    "    local base = path:gsub(\"%.bak$\", \"\")\013\010",
    "    local key = STATE_SECTIONS[base]\013\010",
    "    if not key then return readDocument(path, dependencies) end\013\010",
    "    local state, status = readState(sectionPath(key), dependencies)\013\010",
    "    if status == \"missing\" then state, status = readState(LEGACY_STATE_PATH, dependencies) end\013\010",
    "    if state then\013\010",
    "        local records = base == path and state.sections or state.previous\013\010",
    "        if object(records[key]) then return records[key] end\013\010",
    "        if records[key] ~= nil then return nil, \"invalid core state section\", \"invalid\" end\013\010",
    "        return nil, \"core state section is missing\", \"missing\"\013\010",
    "    end\013\010",
    "    if status ~= \"missing\" then return nil, \"core state is \" .. status, status end\013\010",
    "    local fsApi = select(1, api(dependencies))\013\010",
    "    if base == path and key == \"remotes\" and not fsApi.exists(path) and fsApi.exists(path .. \".remote-bak\") then\013\010",
    "        return nil, \"Remote registry missing; restore its backup first\", \"invalid\"\013\010",
    "    end\013\010",
    "    if not fsApi.exists(path) then return nil, \"legacy record is missing\", \"missing\" end\013\010",
    "    return readDocument(path, dependencies)\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Read the configuration document and validate its schema and fields.\010",
    "function Storage.loadConfig(path, dependencies)\013\010",
    "    local config, reason = Storage.readJson(path or \"avionics/config.json\", dependencies)\013\010",
    "    if not config then return nil, reason end\013\010",
    "    local ok, invalid = Storage.validateConfig(config)\013\010",
    "    if not ok then return nil, \"invalid core configuration: \" .. tostring(invalid) end\013\010",
    "    if config.thrust then\013\010",
    "        config.thrust.primary_max_rpm=config.thrust.primary_max_rpm or\013\010",
    "            math.max(1,math.floor((config.thrust.direct_max_request or .25)*256+.5))\013\010",
    "        config.thrust.direct_max_request=config.thrust.primary_max_rpm/256\013\010",
    "    end\013\010",
    "    local control=config.altitude_control\013\010",
    "    if control then\013\010",
    "        if control.startup_max_vertical_speed==nil then\013\010",
    "            control.startup_max_vertical_speed=control.max_vertical_speed\013\010",
    "        end\013\010",
    "        if control.startup_vertical_speed_limit==nil then\013\010",
    "            control.startup_vertical_speed_limit=control.max_vertical_speed+1\013\010",
    "        end\013\010",
    "        if control.startup_gas_target_m3_per_chamber==nil then\013\010",
    "            control.startup_gas_target_m3_per_chamber=0\013\010",
    "        end\013\010",
    "        if control.launch_settle_seconds==nil then control.launch_settle_seconds=10 end\013\010",
    "        local shapingDefaults={startup_acceleration_seconds=60,startup_braking_lookahead_seconds=30,\013\010",
    "            ceiling_soft_start_rate=0.002,ceiling_rise_rate=0.02,ceiling_fast_rate=0.08,climb_trim_boost=1,level_damping_gain=1,level_lead_seconds=0,\013\010",
    "            level_boost_start_blocks=0.5,level_boost_max=10}\013\010",
    "        for name,value in pairs(shapingDefaults) do\013\010",
    "            if control[name]==nil then control[name]=value end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return config\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Load a validated primary JSON document, then its retained backup.\010",
    "function Storage.readValidatedJson(path, validate, dependencies)\013\010",
    "    local primary, primaryReason = Storage.readJson(path, dependencies)\013\010",
    "    if primary then\013\010",
    "        local ok, reason = validate(primary)\013\010",
    "        if ok then return primary end\013\010",
    "        primaryReason = reason or \"primary JSON validation failed\"\013\010",
    "    end\013\010",
    "    local backup, backupReason = Storage.readJson(path .. \".bak\", dependencies)\013\010",
    "    if backup then\013\010",
    "        local ok, reason = validate(backup)\013\010",
    "        if ok then return backup, \"recovered backup: \" .. tostring(primaryReason) end\013\010",
    "        backupReason = reason or \"backup JSON validation failed\"\013\010",
    "    end\013\010",
    "    return nil, tostring(primaryReason) .. \"; \" .. tostring(backupReason)\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Verify a JSON replacement and retain the previous valid document.\010",
    "local function writeDocument(path, value, dependencies, validate)\013\010",
    "    local fsApi, jsonApi = api(dependencies)\013\010",
    "    if not fsApi or type(fsApi.open) ~= \"function\" or type(fsApi.move) ~= \"function\" or\013\010",
    "        type(fsApi.delete) ~= \"function\" or type(fsApi.exists) ~= \"function\" or\013\010",
    "        not jsonApi or type(jsonApi.serializeJSON) ~= \"function\" then\013\010",
    "        return false, \"ComputerCraft filesystem or JSON serialization is unavailable\"\013\010",
    "    end\013\010",
    "    if validate then\013\010",
    "        local valid, reason = validate(value)\013\010",
    "        if not valid then return false, reason end\013\010",
    "    end\013\010",
    "    local okEncode, encoded = pcall(jsonApi.serializeJSON, value)\013\010",
    "    if not okEncode or type(encoded) ~= \"string\" then return false, \"could not encode JSON: \" .. tostring(encoded) end\013\010",
    "    if #encoded > MAX_JSON_BYTES then return false, \"JSON exceeds the size limit\" end\013\010",
    "\013\010",
    "    local directory = type(fsApi.getDir) == \"function\" and fsApi.getDir(path) or \"\"\013\010",
    "    if directory ~= \"\" and type(fsApi.makeDir) == \"function\" then\013\010",
    "        local okDir, dirError = pcall(fsApi.makeDir, directory)\013\010",

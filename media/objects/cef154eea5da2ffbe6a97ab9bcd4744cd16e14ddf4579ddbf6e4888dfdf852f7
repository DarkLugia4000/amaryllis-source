    "-- Summary: Calculate projected support error, correction direction and control horizons.\010",
    "local function systemsSupportDemand(self,io,s,dt,desiredRatio,actualRatio,now,slewDt)\013\010",
    "    slewDt=finite(slewDt) and slewDt>0 and math.min(slewDt,SYSTEMS_MAX_SLEW_CATCHUP_SECONDS) or dt\013\010",
    "    local tolerance=self.config.lift_balance_tolerance_fraction or 0.2\013\010",
    "    local gravity=math.abs(io.vessel.environment.gravity.y)\013\010",
    "    local responseSeconds=math.max(self.config.hover_capture_seconds or 5,1)\013\010",
    "    local hoverSpeed=self.config.hover_max_vertical_speed or 0.2\013\010",
    "    local state=s.dynamics or {}\013\010",
    "    local lag=s.responseLagSeconds\013\010",
    "    local v=io.vessel\013\010",
    "    local maxVs=s.phase==\"MAIN_LIFT\" and systemsStartupNominalSpeed(self.config) or\013\010",
    "        (self.config.max_vertical_speed or 1)\013\010",
    "    -- Keep the lift deadband narrow enough that the commanded ratio can still\013\010",
    "    -- correct vertical-speed errors inside the hover capture band.\013\010",
    "    local releaseDelay=0\013\010",
    "    if s.phase==\"MAIN_LIFT\" and actualRatio>desiredRatio and actualRatio>0 then\013\010",
    "        -- Predict the ceiling slew needed to reduce the current measured lift.\013\010",
    "        -- Ceiling travel and envelope fill both continue after a control batch,\013\010",
    "        -- so include both in the response horizon used for braking.\013\010",
    "        local reduction=clamp((actualRatio-desiredRatio)/actualRatio,0,1)\013\010",
    "        releaseDelay=reduction/math.max(SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND,0.001)\013\010",
    "    end\013\010",
    "    local startupHorizon=s.phase==\"MAIN_LIFT\" and\013\010",
    "        systemsStartupControlHorizon(self.config,lag,state.sampleSeconds) or lag\013\010",
    "    local supportProjectionHorizon=math.max(finite(state.sampleSeconds) and state.sampleSeconds or 0,\013\010",
    "        finite(lag) and lag or 0)\013\010",
    "    local deadbandHorizon=s.phase==\"MAIN_LIFT\" and startupHorizon or responseSeconds\013\010",
    "    local deadband=math.max(0.0001,math.min(tolerance*0.005,\013\010",
    "        hoverSpeed/(gravity*math.max(deadbandHorizon or responseSeconds,1))*0.25))\013\010",
    "    local controlRatio=actualRatio\013\010",
    "    local forecastLiftRate=finite(state.projectedLiftRate) and state.projectedLiftRate or state.liftRate\013\010",
    "    if startupHorizon and startupHorizon>0 and finite(forecastLiftRate) then\013\010",
    "        -- Project measured support during both acquisition and the normal HOLD\013\010",
    "        -- handoff. The same continuous envelope prevents a delayed plant from\013\010",
    "        -- accumulating repeated ceiling increases while current lift catches up.\013\010",
    "        controlRatio=systemsProjectedSupportRatio(actualRatio,forecastLiftRate,\013\010",
    "            supportProjectionHorizon+releaseDelay,desiredRatio) or actualRatio\013\010",
    "    end\013\010",
    "    local error=desiredRatio-controlRatio\013\010",
    "    local direction=error>deadband and 1 or (error< -deadband and -1 or 0)\013\010",
    "    -- Keep each batch's ceiling correction proportional to the measured\013\010",
    "    -- support error and the live ceiling. Do not bake the test plant's\013\010",
    "    -- nonlinear response curve into production control.\013\010",
    "    local correctionFraction=clamp(math.abs(desiredRatio-controlRatio)/\013\010",
    "        math.max(desiredRatio,0.05),0,1)\013\010",
    "    local sampleSeconds=finite(state.sampleSeconds) and math.max(state.sampleSeconds,0.1) or 0.5\013\010",
    "    local appliedCommandAge=now-(s.lastTargetAppliedAt or s.lastTargetCommandAt or now)\013\010",
    "    local envelopeHorizon=systemsStartupEnvelopeHorizon(lag,state.sampleSeconds)\013\010",
    "    if s.phase==\"MAIN_LIFT\" and startupHorizon and controlRatio>desiredRatio and actualRatio<desiredRatio and\013\010",
    "        finite(v.verticalSpeed) and v.verticalSpeed<=(self.config.hover_max_vertical_speed or 0.2) and\013\010",
    "        finite(v.altitude) and finite(s.target) and s.target>v.altitude then\013\010",
    "        -- A forecast may show that the current ceiling is still filling toward\013\010",
    "        -- hover support. While actual lift is below demand and the vessel has\013\010",
    "        -- not begun a controlled climb, hold the ceiling and let that measured\013\010",
    "        -- fill response arrive instead of reversing the ramp abruptly.\013\010",
    "        direction=0\013\010",
    "    end\013\010",
    "    if s.phase==\"MAIN_LIFT\" and direction>0 then\013\010",
    "        local requestedSpeed=finite(self.verticalTarget) and self.verticalTarget or 0\013\010",
    "        local requestedAcceleration=s.lastRequestedAcceleration\013\010",
    "        local measuredAcceleration=state.verticalAccelerationRaw\013\010",
    "        local accelerationSatisfied=finite(requestedAcceleration) and finite(measuredAcceleration) and\013\010",
    "            (measuredAcceleration>=requestedAcceleration or\013\010",
    "             (requestedAcceleration<0 and finite(v.verticalSpeed) and v.verticalSpeed>requestedSpeed))\013\010",
    "        local supportSatisfied=actualRatio>=desiredRatio-deadband and finite(v.verticalSpeed) and\013\010",
    "            v.verticalSpeed>=requestedSpeed\013\010",
    "        if supportSatisfied or accelerationSatisfied then\013\010",
    "            -- A delayed lift-rate forecast can ask for another upward batch\013\010",
    "            -- after actual support/speed already satisfy the command. Hold the\013\010",
    "            -- current ceiling until measured acceleration falls behind the\013\010",
    "            -- requested motion; genuine positive speed error with support\013\010",
    "            -- below demand remains eligible for an upward correction.\013\010",
    "            direction=0\013\010",
    "        end\013\010",
    "    end\013\010",
    "    s.lastSupportCorrectionFraction=correctionFraction\013\010",
    "    s.lastSupportCorrectionDirection=direction\013\010",
    "    s.lastCeilingSlewSeconds=slewDt\013\010",
    "    return {\013\010",
    "        slewDt=slewDt,\013\010",
    "        tolerance=tolerance,\013\010",
    "        gravity=gravity,\013\010",
    "        responseSeconds=responseSeconds,\013\010",
    "        hoverSpeed=hoverSpeed,\013\010",
    "        state=state,\013\010",
    "        lag=lag,\013\010",
    "        v=v,\013\010",
    "        maxVs=maxVs,\013\010",
    "        releaseDelay=releaseDelay,\013\010",
    "        startupHorizon=startupHorizon,\013\010",
    "        supportProjectionHorizon=supportProjectionHorizon,\013\010",
    "        deadband=deadband,\013\010",
    "        controlRatio=controlRatio,\013\010",
    "        error=error,\013\010",
    "        direction=direction,\013\010",
    "        correctionFraction=correctionFraction,\013\010",
    "        sampleSeconds=sampleSeconds,\013\010",
    "        appliedCommandAge=appliedCommandAge,\013\010",
    "        envelopeHorizon=envelopeHorizon,\013\010",
    "        forecastLiftRate=forecastLiftRate,\013\010",
    "        desiredRatio=desiredRatio,\013\010",
    "        actualRatio=actualRatio,\013\010",
    "    }\013\010",
    "end\013\010",

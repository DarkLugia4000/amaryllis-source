    "    if math.abs(pitchTarget-measuredPitch)<pitchDeadband then pitchControlMeasurement=pitchTarget end\013\010",
    "    observePidMeasurement(self.rollTrim,roll,elapsed)\013\010",
    "    observePidMeasurement(self.pitchTrim,pitchControlMeasurement,elapsed)\013\010",
    "    s.lastPidAt=now\013\010",
    "end\013\010",
    "-- Section: Recovery | Physical target reconciliation and retained-run resumption.\010",
    "-- Summary: Classify the chambers' current probe/control lease stages.\010",
    "local function recoveryStageMode(io)\013\010",
    "    local mode=nil\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local current\013\010",
    "        if node and node.systemsStage==\"control\" and node.systemsProbeReady==true then current=\"control\"\013\010",
    "        elseif node and node.systemsStage==\"probe\" and node.systemsProbeReady==true then current=\"probe\"\013\010",
    "        elseif node and node.systemsStage==nil and node.systemsProbeReady~=true then current=\"expired\"\013\010",
    "        else current=\"transition\" end\013\010",
    "        if mode==nil then mode=current elseif mode~=current then return \"mixed\" end\013\010",
    "    end\013\010",
    "    return mode or \"mixed\"\013\010",
    "end\013\010",
    "-- Summary: Construct probe recovery maps from the retained chamber targets.\010",
    "local function recoveryProbeMaps(io,maps)\013\010",
    "    local result=copyMaps(maps)\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,provider in pairs(io.nodes[q].providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                -- Probe renews telemetry without changing existing steam.\013\010",
    "                -- Core's authoritative map is restored by the control stage.\013\010",
    "                result[q][name]=provider.targetAmount\013\010",
    "            elseif provider.controlRole==\"fine\" and result[q][name]==0 then\013\010",
    "                result[q][name]=provider.minimumNonzeroTarget or 5\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return result\013\010",
    "end\013\010",
    "-- Summary: Bind retained-map verification, batch renewal and completion to the current recovery run.\010",
    "local function systemsRecoveryOperations(self,io,now,s,recovery,wait)\013\010",
    "    -- Summary: Complete the active recovery stage using verified physical target maps.\010",
    "    local function finishActive(actualMaps,actualCoarse)\013\010",
    "        local priorPhase=recovery.resumePhase or s.phase\013\010",
    "        TelemetryRecovery.complete(self,io,s,now,actualMaps,actualCoarse)\013\010",
    "        logSystemsTelemetryRecovery(self,nil,true)\013\010",
    "        if priorPhase==\"VENT_IGNITION\" and s.initialGasTarget and s.initialGasTarget.waitingForCapacity and\013\010",
    "            not s.seedBatchPendingAck then\013\010",
    "            local gasInfo=s.initialGasTarget\013\010",
    "            gasInfo.bootstrapAppliedM3PerChamberByQuadrant=systemsProviderTargetTotals(io,s.currentTargets)\013\010",
    "            gasInfo.controlMapPendingAck=false\013\010",
    "            s.phase=\"VERIFYING\";s.phaseStartedAt=now\013\010",
    "            s.acquisitionPidActive=false;s.lastPidAt=now;s.lastTargetCommandAt=now;s.lastTargetAppliedAt=now\013\010",
    "        elseif priorPhase==\"VENT_IGNITION\" then\013\010",
    "            local gasInfo=s.initialGasTarget\013\010",
    "            if gasInfo then\013\010",
    "                local actual=systemsProviderTargetTotals(io,s.currentTargets)\013\010",
    "                if actual then gasInfo.appliedM3PerChamberByQuadrant=actual end\013\010",
    "                local seedWasIssued=s.seedBatchPendingAck==true\013\010",
    "                local fullyApplied=gasInfo.requestedM3PerChamber<=0 or seedWasIssued\013\010",
    "                local planned=gasInfo.plannedM3PerChamberByQuadrant\013\010",
    "                if planned and actual and fullyApplied then\013\010",
    "                    fullyApplied=true\013\010",
    "                    for _,q in ipairs(QUADS) do\013\010",
    "                        if planned[q]~=actual[q] then fullyApplied=false;break end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "                gasInfo.seeded=fullyApplied and gasInfo.requestedM3PerChamber>0\013\010",
    "                gasInfo.waitingForCapacity=false;gasInfo.controlMapPendingAck=false\013\010",
    "                if gasInfo.requestedM3PerChamber>0 and not seedWasIssued then\013\010",
    "                    gasInfo.status=\"RECOVERED_LIMITED_NO_SEED\"\013\010",
    "                elseif gasInfo.requestedM3PerChamber>0 then\013\010",
    "                    gasInfo.status=fullyApplied and (gasInfo.limited and \"RECOVERED_APPLIED_LIMITED\" or \"RECOVERED_APPLIED\") or\013\010",
    "                        \"RECOVERED_WITH_RETAINED_MAP\"\013\010",
    "                    if not fullyApplied then gasInfo.reason=\"TELEMETRY RECOVERY RETAINED THE VERIFIED PARTIAL STARTUP MAP; SEED WAS NOT REAPPLIED\" end\013\010",
    "                end\013\010",
    "            end\013\010",
    "            s.seedBatchPendingAck=false\013\010",
    "            s.phase=\"MAIN_LIFT\";s.phaseStartedAt=now\013\010",
    "            if not s.launchStartedAt and (s.launchDurationSeconds or 0)>0 then s.launchStartedAt=now end\013\010",
    "            s.baseline=copyMaps(s.currentTargets);self.baseline=copyMaps(s.currentTargets)\013\010",
    "            self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "            self:resetTrim();self:seedLevelBias();self.effort=0;self.verticalTarget=0\013\010",
    "            s.acquisitionPidActive=false;s.lastPidAt=now;s.lastTargetCommandAt=now;s.lastTargetAppliedAt=now\013\010",
    "            s.lastLiftProgressAt=now;s.lastLiftRatio=nil\013\010",
    "        elseif priorPhase==\"PROBING\" then\013\010",
    "            s.phase=\"VERIFYING\";s.phaseStartedAt=now;s.reason=\"WAITING FOR PROBE BALLOON DATA\"\013\010",
    "            s.renewAt=now+SYSTEMS_PROBE_RENEW_SECONDS;s.renewing=false\013\010",
    "        end\013\010",
    "        s.reason=\"LIFT TELEMETRY RESTORED; RESUMING \"..tostring(s.phase)\013\010",
    "        self.reason=s.reason;self.enabled=true;self.available=false\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=false,\013\010",
    "            complete=s.phase==\"READY\",target=s.target,reason=s.reason,warning=s.warning,\013\010",
    "            curve=s.curve,demandProgress=s.demandProgress,capacityProgress=s.capacityProgress}\013\010",
    "        return true\013\010",
    "    end\013\010",
    "    -- Summary: Compare a chamber's physical provider readback with the retained target map.\010",
    "    local function verifyMap(node,q,expected)\013\010",
    "        local actual,reason=TelemetryRecovery.readTargetMap(node,expected,s.providerRoles[q])\013\010",
    "        if not actual then return false,q..\" \"..tostring(reason) end\013\010",
    "        if not TelemetryRecovery.mapsEqual(actual,expected) then\013\010",
    "            return false,q..\" PROVIDER CEILING CHANGED DURING TELEMETRY RECOVERY\"\013\010",
    "        end\013\010",
    "        return true\013\010",
    "    end\013\010",
    "    -- Summary: Check recovery acknowledgements and readbacks for the active command stage.\010",
    "    local function verifyCommand(stage)\013\010",
    "        local all=true\013\010",
    "        local leaseExpired=false\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local pending=s.pending and s.pending[q]\013\010",
    "            local node=io.nodes[q]\013\010",
    "            -- The local sender can reject control before assigning a pending\013\010",
    "            -- sequence when the node's probe lease has expired. Detect that\013\010",
    "            -- live state independently of ACKs, or retries remain stuck on\013\010",
    "            -- control forever. Identity and hardware guards run above; the\013\010",
    "            -- lease-expired branch reconciles retained maps before probing.\013\010",
    "            if node.systemsStage==nil and node.systemsProbeReady~=true and\013\010",
    "                (stage==\"control\" or (pending and now-pending.sentAt>=SYSTEMS_ACK_TIMEOUT_SECONDS)) then\013\010",
    "                all=false;leaseExpired=true\013\010",
    "            end\013\010",
    "            if not pending then all=false\013\010",
    "            elseif node.lastAppliedSeq==pending.seq then\013\010",
    "                if not io:commandWasApplied(q,pending.seq,pending.targets) then\013\010",
    "                    recovery.sendFailure=q..\" RECOVERY TARGET READBACK MISMATCH\"\013\010",
    "                    return false,\"retry\"\013\010",
    "                end\013\010",
    "                local expectedStage=pending.stage or stage\013\010",
    "                if node.systemsStage~=expectedStage or node.systemsProbeReady~=true then\013\010",
    "                    -- A node can keep the pending sequence and exact target\013\010",
    "                    -- readback after its renewable lease expires. That is a\013\010",
    "                    -- lease lapse, not evidence that the accepted command was\013\010",
    "                    -- rejected or altered; rearm the retained map below.\013\010",
    "                    if node.systemsStage==nil and node.systemsProbeReady~=true then\013\010",
    "                        all=false;leaseExpired=true\013\010",
    "                    else\013\010",
    "                        recovery.sendFailure=q..\" RECOVERY STAGE READBACK MISMATCH\"\013\010",
    "                        return false,\"retry\"\013\010",
    "                    end\013\010",
    "                end\013\010",
    "                if expectedStage==\"probe\" and not leaseExpired then\013\010",
    "                    for name,provider in pairs(node.providers or {}) do\013\010",
    "                        if provider.controlRole==\"fine\" and provider.signalStrength~=15 then\013\010",
    "                            recovery.sendFailure=q..\" RECOVERY PROBE ACTIVATION MISMATCH\"\013\010",
    "                            return false,\"retry\"\013\010",
    "                        end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            else\013\010",
    "                all=false\013\010",
    "                if node.lastReceivedSeq==pending.seq then\013\010",
    "                    for _,nodeFault in ipairs(node.faults or {}) do\013\010",
    "                        if type(nodeFault)==\"string\" and stage==\"control\" and\013\010",
    "                            nodeFault:find(\"SYSTEMS_PROBE_REQUIRED\",1,true) then\013\010",
    "                            -- The node's probe lease lapsed before control\013\010",
    "                            -- arrived. Resending control can never succeed;\013\010",
    "                            -- re-probe (keeping retained outputs), then restore.\013\010",
    "                            leaseExpired=true\013\010",
    "                        elseif type(nodeFault)==\"string\" and nodeFault:match(\"^SYSTEMS\") then\013\010",
    "                            recovery.sendFailure=q..\" \"..nodeFault\013\010",
    "                            return false,\"retry\"\013\010",
    "                        end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if leaseExpired then return false,\"lease-expired\" end\013\010",
    "        return all\013\010",
    "    end\013\010",
    "    -- Summary: Stage the next verified probe/control recovery batch.\010",
    "    local function sendRecoveryBatch(stage,maps,coarse)\013\010",
    "        s.recoveryStages=nil\013\010",
    "        if stage==\"probe\" then\013\010",
    "            maps=recoveryProbeMaps(io,maps)\013\010",
    "            s.recoveryStages={}\013\010",
    "            for _,q in ipairs(QUADS) do\013\010",
    "                local node=io.nodes[q]\013\010",
    "                -- A valid control owner cannot accept a probe. Keep its exact\013\010",
    "                -- observed map and renew control while expired peers re-probe.\013\010",
    "                if node.systemsStage==\"control\" and node.systemsProbeReady==true then\013\010",
    "                    local actual,reason=TelemetryRecovery.readTargetMap(node,\013\010",
    "                        recovery.targetMaps and recovery.targetMaps[q],s.providerRoles[q])\013\010",
    "                    if not actual then return wait(q..\" \"..tostring(reason),false) end\013\010",
    "                    maps[q]=actual;s.recoveryStages[q]=\"control\"\013\010",
    "                end\013\010",
    "            end\013\010",
    "            recovery.probeTargets=copyMaps(maps)\013\010",
    "        end\013\010",
    "        recovery.commandStage=stage\013\010",
    "        recovery.lastRetryAt=now\013\010",
    "        recovery.hasAttempted=true\013\010",
    "        recovery.attemptCount=(recovery.attemptCount or 0)+1\013\010",
    "        self:beginSystemsBatch(io,stage,maps,now,stage==\"control\" and coarse or nil)\013\010",
    "        if not self.systemsRun then return false end\013\010",
    "        return wait(recovery.mismatchReason or (stage==\"probe\" and\013\010",
    "            \"REVALIDATING LIFT PROBE; RETAINING APPLIED OUTPUTS\" or\013\010",
    "            \"REAPPLYING CORE LIFT TARGETS AND CONTROL LEASE\"),true)\013\010",
    "    end\013\010",
    "\013\010",
    "    return finishActive,verifyMap,verifyCommand,sendRecoveryBatch\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Reconcile physical targets, renew authority and resume the retained systems run.\010",
    "function Flight:updateSystemsRecovery(io,now,s)\013\010",
    "    local recovery=s.telemetryRecovery\013\010",
    "    local function wait(reason,pending)\013\010",
    "        TelemetryRecovery.suspend(self,s,now,reason)\013\010",
    "        logSystemsTelemetryRecovery(self,recovery.failed and\013\010",
    "            (\"RECOVERY FAILED AFTER 120 SECONDS: \"..tostring(reason)..\"; CONTINUING RETRIES\") or reason,false)\013\010",
    "        self.systemsSnapshot.pending=pending==true\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    local assembled,assemblyReason,assembly=Flight.assemblyGate(io,now)\013\010",
    "    if not assembled then\013\010",
    "        if assembly and assembly.state==\"DISASSEMBLED\" then\013\010",
    "            self:stopSystems(io,assemblyReason or \"VESSEL DISASSEMBLED\",now);return false\013\010",
    "        end\013\010",
    "        self.assembly=assembly\013\010",
    "        return wait(assemblyReason or \"ASSEMBLY STATE UNKNOWN\",s.pending~=nil)\013\010",
    "    end\013\010",
    "    local mode=recoveryStageMode(io)\013\010",
    "    local allowInactive=true -- Recovery reapplies activation as well as ceilings.\013\010",
    "    local good,fault,abortDetails=self:systemsGuard(io,now,s,allowInactive,true)\013\010",
    "    if not good then\013\010",
    "        if TelemetryRecovery.isTransientGuardFault(io,s,now,fault,self) then\013\010",
    "            return wait(fault,s.pending~=nil)\013\010",
    "        end\013\010",
    "        self:stopSystems(io,fault,now,abortDetails);return false\013\010",
    "    end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes[q]\013\010",
    "        if node.systemsSupported~=true then\013\010",
    "            self:stopSystems(io,q..\" SYSTEMS CAPABILITY CHANGED\",now);return false\013\010",
    "        end\013\010",
    "        if node.systemsStartReady~=true then\013\010",
    "            return wait(q..\" WAITING FOR START SYSTEMS HARDWARE READINESS\",s.pending~=nil)\013\010",
    "        end\013\010",
    "    end\013\010",
    "\013\010",
    "    local finishActive,verifyMap,verifyCommand,sendRecoveryBatch=\013\010",
    "        systemsRecoveryOperations(self,io,now,s,recovery,wait)\013\010",
    "\013\010",
    "    -- Rebinding starts a new node command sequence, so the old boot's ACK is\013\010",
    "    -- never used to complete a pending batch. Verify the exact live provider\013\010",
    "    -- signature first, reconcile the physical maps, then renew a probe lease\013\010",
    "    -- under the newly accepted boot before restoring the retained control map.\013\010",
    "    local trustedRebinds={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        if io.nodes[q].boot~=s.boots[q] then\013\010",
    "            local state,reason=TelemetryRecovery.nodeBootState(io,s,q,now,self)\013\010",
    "            if state==\"wait\" then return wait(q..\" \"..tostring(reason),s.pending~=nil) end\013\010",
    "            if state~=\"trusted\" then\013\010",
    "                self:stopSystems(io,reason or q..\" LIFT BOOT CHANGE NOT TRUSTED\",now)\013\010",
    "                return false\013\010",
    "            end\013\010",
    "            trustedRebinds[q]=true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if next(trustedRebinds) then\013\010",
    "        if recovery.hasAttempted and recovery.lastRetryAt and\013\010",
    "            now-recovery.lastRetryAt<SYSTEMS_RECOVERY_RETRY_SECONDS then\013\010",
    "            return wait(\"WAITING TO RECONCILE THE REBOUND LIFT NODE\",s.pending~=nil)\013\010",
    "        end\013\010",
    "        local actualMaps,mapReason,actualCoarse=TelemetryRecovery.authoritativeTargetMaps(s,io.nodes)\013\010",
    "        if not actualMaps then\013\010",
    "            if mapReason and (mapReason:find(\"READBACK UNAVAILABLE\",1,true) or\013\010",
    "                mapReason:find(\"READBACK INVALID\",1,true)) then return wait(mapReason,s.pending~=nil) end\013\010",
    "            self:stopSystems(io,mapReason or \"RETAINED SYSTEMS MAP COULD NOT BE VERIFIED\",now)\013\010",
    "            return false\013\010",
    "        end\013\010",
    "        if not recovery.targetMaps then recovery.targetMaps=copyMaps(actualMaps) end\013\010",
    "        recovery.currentMaps=copyMaps(actualMaps)\013\010",
    "        recovery.coarseTrimApplied=copyMaps(actualCoarse or s.coarseTrimApplied or {})\013\010",
    "        recovery.probeTargets=recoveryProbeMaps(io,actualMaps)\013\010",
    "        s.currentTargets=copyMaps(actualMaps);s.appliedMaps=copyMaps(actualMaps)\013\010",
    "        s.coarseTrimApplied=copyMaps(recovery.coarseTrimApplied)\013\010",
    "        s.pending=nil;s.batchTargets=nil;s.batchStage=nil;s.batchCoarseTrimApplied={}\013\010",
    "        for q in pairs(trustedRebinds) do\013\010",
    "            local node=io.nodes[q]\013\010",
    "            s.boots[q]=node.boot\013\010",
    "            s.bindingFingerprints[q]=node.bindingFingerprint\013\010",
    "            s.bindingGenerations=s.bindingGenerations or {};s.bindingGenerations[q]=node.bindingGeneration\013\010",
    "            s.acceptedBootGenerations=s.acceptedBootGenerations or {}\013\010",
    "            s.acceptedBootGenerations[q]=node.acceptedBootGeneration\013\010",
    "        end\013\010",
    "        recovery.commandStage=nil\013\010",
    "        return sendRecoveryBatch(\"probe\",recovery.probeTargets,recovery.coarseTrimApplied)\013\010",
    "    end\013\010",
    "\013\010",
    "    if recovery.commandStage then\013\010",
    "        local stage=recovery.commandStage\013\010",
    "        local applied,terminal=verifyCommand(stage)\013\010",
    "        if terminal==\"terminal\" or self.systemsRun~=s then return false end\013\010",
    "        if terminal==\"lease-expired\" then\013\010",
    "            if recovery.lastRetryAt and now-recovery.lastRetryAt<SYSTEMS_RECOVERY_RETRY_SECONDS then\013\010",
    "                return wait(\"LIFT CONTROL LEASE EXPIRED; REARMING RETAINED OUTPUTS\",true)\013\010",
    "            end\013\010",
    "            local actualMaps,mapReason,actualCoarse=TelemetryRecovery.authoritativeTargetMaps(s,io.nodes)\013\010",
    "            if not actualMaps then\013\010",
    "                if mapReason and mapReason:find(\"READBACK UNAVAILABLE\",1,true) then\013\010",
    "                    return wait(mapReason,true)\013\010",
    "                end\013\010",
    "                self:stopSystems(io,mapReason or \"RETAINED SYSTEMS MAP COULD NOT BE VERIFIED\",now);return false\013\010",
    "            end\013\010",
    "            -- Preserve the desired control map and reconcile every live\013\010",
    "            -- quadrant, including any already-applied part of a pending\013\010",
    "            -- batch. The probe refreshes expired leases before restoring it.\013\010",
    "            recovery.currentMaps=copyMaps(actualMaps)\013\010",
    "            recovery.coarseTrimApplied=copyMaps(actualCoarse or s.coarseTrimApplied or {})\013\010",
    "            recovery.probeTargets=recoveryProbeMaps(io,actualMaps)\013\010",
    "            s.currentTargets=copyMaps(actualMaps);s.appliedMaps=copyMaps(actualMaps)\013\010",
    "            s.coarseTrimApplied=copyMaps(recovery.coarseTrimApplied)\013\010",
    "            s.pending=nil;s.batchTargets=nil;s.batchStage=nil;s.batchCoarseTrimApplied={}\013\010",
    "            recovery.commandStage=nil\013\010",
    "            return sendRecoveryBatch(\"probe\",recovery.probeTargets,recovery.coarseTrimApplied)\013\010",
    "        end\013\010",
    "        if not applied then\013\010",
    "            local timedOut=false\013\010",
    "            for _,q in ipairs(QUADS) do\013\010",
    "                local pending=s.pending and s.pending[q]\013\010",
    "                if not pending or now-pending.sentAt>=SYSTEMS_ACK_TIMEOUT_SECONDS then timedOut=true end\013\010",
    "            end\013\010",
    "            if timedOut and (not recovery.lastRetryAt or now-recovery.lastRetryAt>=SYSTEMS_RECOVERY_RETRY_SECONDS) then\013\010",
    "                return sendRecoveryBatch(stage,s.batchTargets,recovery.coarseTrimApplied)\013\010",
    "            end\013\010",
    "            return wait(recovery.sendFailure or \"WAITING FOR FRESH LIFT RECOVERY ACKNOWLEDGEMENTS\",true)\013\010",
    "        end\013\010",
    "        if stage==\"probe\" then\013\010",
    "            local probeMaps=recovery.probeTargets\013\010",
    "            for _,q in ipairs(QUADS) do\013\010",
    "                local ok,why=verifyMap(io.nodes[q],q,probeMaps[q])\013\010",
    "                if not ok then self:stopSystems(io,why,now);return false end\013\010",
    "            end\013\010",
    "            local envelope,envelopeReason=self:systemsEnvelopeReady(io,false,false,true)\013\010",
    "            if not envelope then\013\010",
    "                if TelemetryRecovery.isTransientGuardFault(io,s,now,envelopeReason,self) then\013\010",
    "                    return wait(envelopeReason,true)\013\010",
    "                end\013\010",
    "                self:stopSystems(io,envelopeReason or \"RECOVERY PROBE ENVELOPE INVALID\",now);return false\013\010",
    "            end\013\010",
    "            local resumePhase=recovery.resumePhase or s.phase\013\010",
    "            if resumePhase==\"PROBING\" or resumePhase==\"VERIFYING\" then\013\010",
    "                local actualMaps=recovery.targetMaps or s.probeTargets\013\010",
    "                local coarse=recovery.coarseTrimApplied or s.coarseTrimApplied or {}\013\010",
    "                return finishActive(actualMaps,coarse)\013\010",
    "            end\013\010",
    "            return sendRecoveryBatch(\"control\",recovery.targetMaps,recovery.coarseTrimApplied)\013\010",
    "        end\013\010",
    "        local strict,strictReason=self:systemsGuard(io,now,s,false,true)\013\010",
    "        if not strict then\013\010",
    "            if TelemetryRecovery.isTransientGuardFault(io,s,now,strictReason,self) then\013\010",
    "                return wait(strictReason,true)\013\010",
    "            end\013\010",
    "            self:stopSystems(io,strictReason,now);return false\013\010",
    "        end\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local ok,why=verifyMap(io.nodes[q],q,recovery.targetMaps[q])\013\010",
    "            if not ok then self:stopSystems(io,why,now);return false end\013\010",
    "        end\013\010",
    "        return finishActive(recovery.targetMaps,recovery.coarseTrimApplied)\013\010",
    "    end\013\010",
    "\013\010",
    "    local actualMaps,mapReason,actualCoarse,mismatch,mismatchReason=TelemetryRecovery.authoritativeTargetMaps(s,io.nodes)\013\010",
    "    if not actualMaps then\013\010",
    "        if mapReason and mapReason:find(\"READBACK UNAVAILABLE\",1,true) then return wait(mapReason,s.pending~=nil) end\013\010",
    "        self:stopSystems(io,mapReason or \"RETAINED SYSTEMS MAP COULD NOT BE VERIFIED\",now);return false\013\010",
    "    end\013\010",
    "    recovery.targetMaps=copyMaps(actualMaps)\013\010",
    "    recovery.mismatchReason=mismatchReason\013\010",
    "    recovery.coarseTrimApplied=copyMaps(actualCoarse or s.coarseTrimApplied or {})\013\010",
    "    s.currentTargets=copyMaps(actualMaps);s.coarseTrimApplied=copyMaps(recovery.coarseTrimApplied)\013\010",
    "    s.pending=nil;s.batchTargets=nil;s.batchStage=nil;s.batchCoarseTrimApplied={};s.appliedMaps=copyMaps(actualMaps)\013\010",
    "\013\010",
    "    if mode==\"control\" then\013\010",
    "        if mismatch then\013\010",
    "            return sendRecoveryBatch(\"control\",actualMaps,actualCoarse)\013\010",
    "        end\013\010",
    "        return finishActive(actualMaps,actualCoarse)\013\010",
    "    elseif mode==\"probe\" then\013\010",
    "        if s.phase==\"PROBING\" or s.phase==\"VERIFYING\" then\013\010",
    "            return finishActive(actualMaps,actualCoarse)\013\010",
    "        end\013\010",
    "        local envelope,envelopeReason=self:systemsEnvelopeReady(io,false,false,true)\013\010",
    "        if not envelope then\013\010",
    "            if TelemetryRecovery.isTransientGuardFault(io,s,now,envelopeReason,self) then return wait(envelopeReason,false) end\013\010",
    "            self:stopSystems(io,envelopeReason or \"RECOVERY PROBE ENVELOPE INVALID\",now);return false\013\010",
    "        end\013\010",
    "        return sendRecoveryBatch(\"control\",actualMaps,actualCoarse)\013\010",
    "    elseif mode==\"expired\" or mode==\"mixed\" then\013\010",
    "        local probeMaps=recoveryProbeMaps(io,actualMaps)\013\010",
    "        recovery.probeTargets=copyMaps(probeMaps)\013\010",
    "        return sendRecoveryBatch(\"probe\",probeMaps,actualCoarse)\013\010",
    "    end\013\010",
    "    return wait(\"WAITING FOR ALL LIFT NODES TO REACH A CONSISTENT LEASE STATE\",false)\013\010",
    "end\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Measure stable hover duration near the selected altitude and report capture readiness.\010",
    "function Flight:systemsCaptureReady(s,v,now,supportSettled,actualRatio)\013\010",
    "    local liftReady=supportSettled and math.abs(actualRatio-1)<=self.config.lift_balance_tolerance_fraction\013\010",
    "    local distance=math.abs(s.target-v.altitude)\013\010",
    "    local normal=liftReady and distance<=5 and math.abs(v.verticalSpeed)<=self.config.hover_max_vertical_speed\013\010",
    "    local wide=liftReady and distance<=10 and v.verticalSpeed>-.5 and v.verticalSpeed<.5\013\010",
    "    if normal then s.hoverSince=s.hoverSince or now else s.hoverSince=nil end\013\010",
    "    if wide then s.wideHoverSince=s.wideHoverSince or now else s.wideHoverSince=nil end\013\010",
    "    if normal or wide then s.reason=\"CAPTURING STABLE HOVER\" end\013\010",
    "    return (s.hoverSince~=nil and now-s.hoverSince>=self.config.hover_capture_seconds) or\013\010",
    "        (s.wideHoverSince~=nil and now-s.wideHoverSince>10)\013\010",
    "end\013\010",
    "-- Summary: Verify pending command results and transfer acknowledged startup or control maps.\010",
    "local function systemsAcknowledgeBatch(self,io,now,s)\013\010",
    "    local allApplied=true\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local pending=s.pending[q]\013\010",
    "        local node=io.nodes[q]\013\010",
    "        -- A fresh response for this sequence can explicitly reject the\013\010",
    "        -- command. Surface that reason instead of waiting for an ACK that\013\010",
    "        -- will never arrive. Historical faults cannot reject a new packet.\013\010",
    "        if node.lastReceivedSeq==pending.seq and node.lastAppliedSeq~=pending.seq then\013\010",
    "            for _,fault in ipairs(node.faults or {}) do\013\010",
    "                if type(fault)==\"string\" and fault:match(\"^SYSTEMS\") then\013\010",
    "                    TelemetryRecovery.suspend(self,s,now,q..\" \"..fault)\013\010",
    "                    self:updateSystemsRecovery(io,now,s);return\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if io:commandWasApplied(q,pending.seq,pending.targets) then\013\010",
    "            s.appliedMaps[q]=clone(pending.targets)\013\010",
    "        else\013\010",
    "            allApplied=false\013\010",
    "            if now-pending.sentAt>SYSTEMS_ACK_TIMEOUT_SECONDS then\013\010",
    "                TelemetryRecovery.suspend(self,s,now,q..\" SYSTEMS COMMAND ACK TIMEOUT\")\013\010",
    "                self:updateSystemsRecovery(io,now,s);return\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if not allApplied then\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=true,complete=false,\013\010",
    "            target=s.target,reason=s.reason,warning=s.warning,curve=s.curve,\013\010",
    "            demandProgress=s.demandProgress,capacityProgress=s.capacityProgress,\013\010",
    "            desiredLiftRatio=s.lastDesiredRatio}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local stage=s.batchStage\013\010",
    "    if stage==\"control\" then\013\010",
    "        local ackWait=0\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local pending=s.pending[q]\013\010",
    "            if pending and finite(pending.sentAt) then ackWait=math.max(ackWait,now-pending.sentAt) end\013\010",
    "        end\013\010",
    "        s.lastAckWaitSeconds=ackWait\013\010",
    "    end\013\010",
    "    s.pending=nil\013\010",
    "    if stage==\"control\" and (s.phase==\"MAIN_LIFT\" or s.phase==\"READY\") then\013\010",
    "        self:observeSystemsPidAfterAck(io,s,now)\013\010",
    "    end\013\010",
    "    if stage==\"probe\" then\013\010",
    "        if s.phase==\"PROBING\" then\013\010",
    "            s.phase=\"VERIFYING\";s.phaseStartedAt=now;s.reason=\"WAITING FOR PROBE BALLOON DATA\"\013\010",
    "            s.renewAt=now+SYSTEMS_PROBE_RENEW_SECONDS;s.renewing=false\013\010",
    "        else\013\010",
    "            s.renewing=false;s.renewAt=now+SYSTEMS_PROBE_RENEW_SECONDS\013\010",
    "        end\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local controlTargetsChanged=stage==\"control\" and\013\010",
    "        systemsBulkTargetsChanged(s.batchTargets,s.currentTargets,io.nodes)\013\010",
    "    s.currentTargets=copyMaps(s.batchTargets);s.lastControlAt=now\013\010",
    "    if stage==\"control\" then s.coarseTrimApplied=clone(s.batchCoarseTrimApplied or {}) end\013\010",
    "    if controlTargetsChanged then s.lastTargetAppliedAt=now end\013\010",
    "    if s.phase==\"VENT_IGNITION\" then\013\010",
    "        local gasInfo=s.initialGasTarget\013\010",
    "        if gasInfo and gasInfo.waitingForCapacity and not s.seedBatchPendingAck then\013\010",
    "            gasInfo.bootstrapAppliedM3PerChamberByQuadrant=systemsProviderTargetTotals(io,s.currentTargets)\013\010",
    "            gasInfo.status=\"WAITING_FOR_VERIFIED_CAPACITY\"\013\010",
    "            gasInfo.controlMapPendingAck=false\013\010",
    "            s.phase=\"VERIFYING\";s.phaseStartedAt=now;s.reason=\"WAITING FOR VERIFIED BALANCED CAPACITY FOR INITIAL GAS TARGET\"\013\010",
    "            s.acquisitionPidActive=false;s.lastPidAt=now;s.lastTargetCommandAt=now;s.lastTargetAppliedAt=now\013\010",
    "            self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=false,complete=false,\013\010",
    "                target=s.target,reason=s.reason,initialGasTarget=clone(gasInfo)}\013\010",
    "            return\013\010",
    "        end\013\010",
    "        if gasInfo then\013\010",
    "            local actualTotals,actualReason=systemsProviderTargetTotals(io,s.currentTargets)\013\010",
    "            if actualTotals then gasInfo.appliedM3PerChamberByQuadrant=actualTotals end\013\010",
    "            gasInfo.controlMapPendingAck=false;gasInfo.waitingForCapacity=false\013\010",
    "            if gasInfo.requestedM3PerChamber>0 and s.seedBatchPendingAck then\013\010",
    "                gasInfo.seeded=true\013\010",
    "                gasInfo.status=gasInfo.limited and \"APPLIED_LIMITED\" or \"APPLIED\"\013\010",
    "            elseif gasInfo.requestedM3PerChamber>0 then\013\010",
    "                gasInfo.seeded=false;gasInfo.status=\"LIMITED_NOT_APPLIED\"\013\010",
    "                gasInfo.reason=gasInfo.limitReason or actualReason or \"INITIAL GAS TARGET WAS NOT APPLIED\"\013\010",
    "                gasInfo.limited=true\013\010",
    "            else\013\010",
    "                gasInfo.seeded=false;gasInfo.status=\"DISABLED\"\013\010",
    "            end\013\010",
    "            s.seedBatchPendingAck=false\013\010",
    "        end\013\010",
    "        if s.airborneStart then\013\010",
    "            -- Already flying: no launch settle and no lift build. Hold\013\010",
    "            -- from the acknowledged current ceilings in READY.\013\010",
    "            s.launchComplete=true;s.launchDurationSeconds=0;s.airborne=true\013\010",
    "            self:captureSystemsBaseline(io,s,now)\013\010",
    "            s.reason=\"AIRBORNE START COMPLETE; HOLDING SELECTED ALTITUDE\"\013\010",
    "            self.reason=s.reason\013\010",
    "            return\013\010",
    "        end\013\010",
    "        s.phase=\"MAIN_LIFT\";s.phaseStartedAt=now\013\010",
    "        if not s.launchStartedAt and (s.launchDurationSeconds or 0)>0 then s.launchStartedAt=now end\013\010",
    "        s.lastLiftRatio=nil;s.lastLiftProgressAt=now;s.reason=\"BUILDING LIFT TO TARGET\"\013\010",
    "        -- The acknowledged control-start map is the acquisition baseline.\013\010",
    "        -- Reset derivative history here so probe activation time cannot\013\010",
    "        -- enter either PID, and give trim symmetric authority immediately.\013\010",
    "        s.baseline=copyMaps(s.currentTargets);self.baseline=copyMaps(s.currentTargets)\013\010",
    "        self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "        self:resetTrim();self:seedLevelBias();self.effort=0;self.verticalTarget=0\013\010",
    "        s.coarseTrimApplied={};s.batchCoarseTrimApplied={}\013\010",
    "        s.acquisitionPidActive=false;s.lastPidAt=now;s.lastTargetCommandAt=now;s.lastTargetAppliedAt=now\013\010",
    "    end\013\010",
    "    return\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Check every steam vent's boiler reading against full startup efficiency.\010",
    "function Flight:systemsBoilersReady(io)\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,p in pairs(io.nodes[q] and io.nodes[q].providers or {}) do\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                if p.boilerEfficiencyValid~=true or not finite(p.boilerEfficiency) or\013\010",
    "                    p.boilerEfficiency<0 or p.boilerEfficiency>1 then\013\010",
    "                    return false,q..\"/\"..name..\" BOILER EFFICIENCY UNAVAILABLE; CHECK BOILER\"\013\010",
    "                end\013\010",
    "                if p.boilerEfficiency<1 then\013\010",
    "                    return false,q..\"/\"..name..\" LOW BOILER EFFICIENCY \"..\013\010",
    "                        string.format(\"%.1f%%\",p.boilerEfficiency*100)..\"; CHECK BOILER (REQUIRED 100%)\"\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "-- Returns nil when every bulk vent boiler reads at least SYSTEMS_BOILER_MINIMUM_EFFICIENCY.\013\010",
    "-- Summary: Returns nil when every bulk vent boiler reads at least SYSTEMS_BOILER_MINIMUM_EFFICIENCY.\010",
    "function Flight:systemsBoilerFault(io)\013\010",
    "    local unavailable,lowest\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,p in pairs(io.nodes[q] and io.nodes[q].providers or {}) do\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                local label=q..\"/\"..tostring(name):sub(1,24)\013\010",
    "                if p.boilerEfficiencyValid~=true or not finite(p.boilerEfficiency) or\013\010",
    "                    p.boilerEfficiency<0 or p.boilerEfficiency>1 then\013\010",
    "                    unavailable=unavailable or label\013\010",
    "                elseif p.boilerEfficiency<SYSTEMS_BOILER_MINIMUM_EFFICIENCY and\013\010",
    "                    (not lowest or p.boilerEfficiency<lowest.efficiency) then\013\010",
    "                    lowest={label=label,efficiency=p.boilerEfficiency}\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if unavailable then return unavailable..\" BOILER EFFICIENCY UNAVAILABLE\" end\013\010",
    "    if lowest then\013\010",
    "        return string.format(\"%s BOILER %.1f%% (MINIMUM %d%%)\",lowest.label,lowest.efficiency*100,\013\010",
    "            SYSTEMS_BOILER_MINIMUM_EFFICIENCY*100)\013\010",
    "    end\013\010",
    "    return nil\013\010",
    "end\013\010",
    "\013\010",
    "-- Boiler gate: every bulk vent boiler must read 100%. After SYSTEMS_BOILER_WAIT_SECONDS the start\013\010",
    "-- is refused if any boiler is below SYSTEMS_BOILER_MINIMUM_EFFICIENCY or unreadable, and otherwise\013\010",
    "-- continues with a warning naming the boiler that is still below 100%.\013\010",
    "-- Section: Recovery | Physical target reconciliation and retained-run resumption.\010",
    "-- Summary: Wait for boiler readiness, verify the startup envelope and send the initial control map.\010",
    "local function systemsVerifyStartup(self,io,now,s,balanced,balancedReason)\013\010",
    "    local boilersReady,boilerReason=self:systemsBoilersReady(io)\013\010",
    "    local boilerAccepted=false\013\010",
    "    if boilersReady then\013\010",
    "        s.boilerWaitStartedAt=nil\013\010",
    "    else\013\010",
    "        s.boilerWaitStartedAt=s.boilerWaitStartedAt or now\013\010",
    "        local waited=now-s.boilerWaitStartedAt\013\010",
    "        if waited>=SYSTEMS_BOILER_WAIT_SECONDS then\013\010",
    "            local fault=self:systemsBoilerFault(io)\013\010",
    "            if fault then\013\010",
    "                self:stopSystems(io,\"START REFUSED: \"..fault,now,\013\010",
    "                    {phase=s.phase,boiler=fault,boilerWaitedSeconds=waited})\013\010",
    "                return\013\010",
    "            end\013\010",
    "            boilerAccepted=true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if boilerAccepted then\013\010",
    "        s.boilerWaiting=nil;s.reason=nil\013\010",
    "        s.warning=\"BOILER BELOW 100% AFTER \"..SYSTEMS_BOILER_WAIT_SECONDS..\" S; STARTING: \"..boilerReason\013\010",
    "    elseif not boilersReady then\013\010",
    "        s.boilerWaiting=true;s.reason=boilerReason;s.warning=boilerReason;self.reason=boilerReason\013\010",
    "        s.phaseStartedAt=now\013\010",
    "        if now>=(s.renewAt or now) then\013\010",
    "            s.renewing=true\013\010",
    "            self:beginSystemsBatch(io,\"probe\",s.probeTargets,now)\013\010",
    "        end\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=s.pending~=nil,\013\010",
    "            complete=false,target=s.target,reason=boilerReason,warning=boilerReason}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    if s.boilerWaiting then\013\010",
    "        s.boilerWaiting=nil;s.reason=nil;s.warning=systemsWarning(io,s);s.phaseStartedAt=now\013\010",
    "    end\013\010",
    "    local envelopeReady,envelopeReason=self:systemsEnvelopeReady(io)\013\010",
    "    if s.initialGasTarget and s.initialGasTarget.waitingForCapacity and\013\010",
    "        (not envelopeReady or balanced.phase==\"UNAVAILABLE\" or balanced.phase==\"INFEASIBLE\") then\013\010",
    "        s.reason=not envelopeReady and (envelopeReason or \"WAITING FOR VERIFIED STARTUP GAS CAPACITY\") or\013\010",
    "            (balancedReason or balanced.reason or \"WAITING FOR VERIFIED STARTUP GAS CAPACITY\")\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=false,complete=false,\013\010",
    "            target=s.target,reason=s.reason,warning=s.warning,curve=s.curve,\013\010",
    "            demandProgress=s.demandProgress,capacityProgress=s.capacityProgress,\013\010",
    "            initialGasTarget=clone(s.initialGasTarget)}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    if envelopeReady then\013\010",
    "        local maps=s.controlStartTargets\013\010",
    "        if type(maps)~=\"table\" then self:stopSystems(io,\"VENT IGNITION TARGETS UNAVAILABLE\",now);return end\013\010",
    "        if balanced.phase==\"UNAVAILABLE\" or balanced.phase==\"INFEASIBLE\" then\013\010",
    "            local why=balancedReason or balanced.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "            local canStartAtFloor=balanced.phase==\"UNAVAILABLE\" and\013\010",
    "                (why:find(\"WAITING FOR BULK ENVELOPE CAPACITY\",1,true) or\013\010",
    "                 why:find(\"BALLOON CAPACITY UNAVAILABLE\",1,true)) and\013\010",
    "                self:isFloorOnlyTargets(io,maps,true,false,true)\013\010",
    "            if canStartAtFloor then\013\010",
    "                s.balancedReason=why\013\010",
    "                if s.initialGasTarget and s.initialGasTarget.requestedM3PerChamber>0 then\013\010",
    "                    s.initialGasTarget.waitingForCapacity=true\013\010",
    "                    s.initialGasTarget.status=\"WAITING_FOR_VERIFIED_CAPACITY\"\013\010",
    "                    s.initialGasTarget.reason=why\013\010",
    "                    s.initialGasTarget.bootstrapM3PerChamberByQuadrant=systemsProviderTargetTotals(io,maps)\013\010",
    "                end\013\010",
    "                s.phase=\"VENT_IGNITION\"\013\010",
    "                self:beginSystemsBatch(io,\"control\",maps,now);return\013\010",
    "            end\013\010",
    "            envelopeReady=false;envelopeReason=why\013\010",
    "        else\013\010",
    "            local capped,capReason,limited=self:capBalancedTargets(io,maps,balanced)\013\010",
    "            if not capped then\013\010",
    "                envelopeReady=false;envelopeReason=capReason or \"BALANCED PROVIDER FLOOR LIMIT UNAVAILABLE\"\013\010",
    "                s.balancedReason=envelopeReason\013\010",
    "                balanced.phase=\"INFEASIBLE\";balanced.reason=envelopeReason\013\010",
    "            else\013\010",
    "                maps=capped\013\010",
    "                local seedInfo\013\010",
    "                local seedMaps,info,seedReason=self:systemsStartupGasSeedTargets(io,maps,balanced,s)\013\010",
    "                seedInfo=info\013\010",
    "                local seedWillApply=seedMaps~=nil and info.requestedM3PerChamber>0\013\010",
    "                if not seedMaps then\013\010",
    "                    seedMaps=maps\013\010",
    "                    seedInfo=s.initialGasTarget or info\013\010",
    "                    seedInfo.waitingForCapacity=false\013\010",
    "                    if seedInfo.requestedM3PerChamber>0 then\013\010",
    "                        seedInfo.limited=true\013\010",
    "                        seedInfo.limitReason=seedReason or \"INITIAL GAS TARGET COULD NOT BE SAFELY ALLOCATED\"\013\010",
    "                    end\013\010",
    "                end\013\010",
    "                local seedCapped,seedCapReason,seedLimited=self:capBalancedTargets(io,seedMaps,balanced)\013\010",
    "                if not seedCapped then\013\010",
    "                    envelopeReady=false;envelopeReason=seedCapReason or \"INITIAL GAS TARGET CAPACITY UNAVAILABLE\"\013\010",
    "                    s.balancedReason=envelopeReason\013\010",
    "                    return\013\010",
    "                end\013\010",
    "                local planned,plannedReason=systemsProviderTargetTotals(io,seedCapped)\013\010",
    "                if not planned then\013\010",
    "                    self:stopSystems(io,plannedReason or \"INITIAL GAS TARGET MAP INVALID\",now);return\013\010",
    "                end\013\010",
    "                seedInfo.plannedM3PerChamberByQuadrant=planned\013\010",
    "                seedInfo.waitingForCapacity=false\013\010",
    "                seedInfo.controlMapPendingAck=true\013\010",
    "                if seedLimited then\013\010",
    "                    seedInfo.limited=true\013\010",
    "                    seedInfo.limitReason=seedInfo.limitReason or seedCapReason or\013\010",
    "                        \"WEAKEST BALANCED CAPACITY REDUCED THE INITIAL GAS TARGET\"\013\010",
    "                    balanced.capApplied=true;balanced.demandLimited=true\013\010",
    "                end\013\010",
    "                seedInfo.status=seedInfo.requestedM3PerChamber>0 and \"ACKNOWLEDGMENT_PENDING\" or \"DISABLED\"\013\010",
    "                s.initialGasTarget=seedInfo\013\010",
    "                s.seedBatchPendingAck=seedWillApply\013\010",
    "                seedCapped=retainActiveBulk(seedCapped,s.retainedBulk)\013\010",
    "                maps=seedCapped\013\010",
    "                s.controlStartTargets=copyMaps(seedCapped)\013\010",
    "                s.phase=\"VENT_IGNITION\"\013\010",
    "                self:beginSystemsBatch(io,\"control\",maps,now);return\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    s.reason=envelopeReason or \"WAITING FOR PROBE BALLOON DATA\"\013\010",
    "    if now-s.phaseStartedAt>SYSTEMS_ENVELOPE_TIMEOUT_SECONDS then\013\010",
    "        self:stopSystems(io,(envelopeReason or \"BALLOON DATA UNAVAILABLE\")..\"; PROBE TIMED OUT\",now);return\013\010",
    "    end\013\010",
    "    if now>=s.renewAt then\013\010",
    "        s.renewing=true;s.phase=\"VERIFYING\"\013\010",
    "        self:beginSystemsBatch(io,\"probe\",s.probeTargets,now);return\013\010",
    "    end\013\010",
    "    self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=false,complete=false,\013\010",
    "        target=s.target,reason=s.reason,warning=s.warning,curve=s.curve,\013\010",
    "        demandProgress=s.demandProgress,capacityProgress=s.capacityProgress}\013\010",
    "    return\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Maintain leveling and retained targets through the configured startup settling interval.\010",
    "local function systemsLaunchSettling(self,io,now,s,balanced)\013\010",
    "    local remaining=math.max(0,(s.launchDurationSeconds or 0)-(now-s.launchStartedAt))\013\010",
    "    if remaining>0 then\013\010",
    "        s.acquisitionPidActive=false;self.effort=0;self.verticalTarget=0\013\010",
    "        s.lastPidAt=now;s.lastLiftProgressAt=now\013\010",
    "        if now-s.lastControlAt>=io.config.network.sample_interval_seconds then\013\010",
    "            local launchDt=clamp(now-(s.lastControlAt or now),0.05,3)\013\010",
    "            s.lastControlAt=now\013\010",
    "            -- Keep leveling while the altitude PID is paused: an uneven\013\010",
    "            -- fill pitches the ship hardest during these first seconds.\013\010",
    "            local launchMaps,launchApplied=s.currentTargets,s.coarseTrimApplied\013\010",
    "            local trimmedOk=s.baseline and self:updateTrim(io,s.baseline,launchDt,launchDt,now)\013\010",
    "            if trimmedOk then\013\010",
    "                local base={}\013\010",
    "                for _,q in ipairs(QUADS) do\013\010",
    "                    base[q]={}\013\010",
    "                    for name,value in pairs(s.currentTargets[q] or {}) do\013\010",
    "                        local applied=s.coarseTrimApplied and s.coarseTrimApplied[q] and s.coarseTrimApplied[q][name]\013\010",
    "                        base[q][name]=finite(applied) and value-applied or value\013\010",
    "                    end\013\010",
    "                end\013\010",
    "                local trimmed=self:applyCoarseSteamTrim(io,base,balanced,now)\013\010",
    "                local capped=trimmed and self:capBalancedTargets(io,trimmed,balanced)\013\010",
    "                if capped then\013\010",
    "                    launchMaps,launchApplied=capped,{}\013\010",
    "                    for _,q in ipairs(QUADS) do\013\010",
    "                        launchApplied[q]={}\013\010",
    "                        for name,p in pairs(io.nodes[q].providers or {}) do\013\010",
    "                            if p.controlRole==\"bulk\" and finite(capped[q][name]) and finite(base[q][name]) then\013\010",
    "                                launchApplied[q][name]=capped[q][name]-base[q][name]\013\010",
    "                            end\013\010",
    "                        end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            end\013\010",
    "            self:beginSystemsBatch(io,\"control\",launchMaps,now,launchApplied)\013\010",
    "            if not self.systemsRun or s.telemetryRecovery then return end\013\010",
    "        end\013\010",
    "        s.reason=\"LAUNCH SETTLING / PID PAUSED: \"..string.format(\"%.1f\",remaining)..\"s\"\013\010",
    "        self.reason=s.reason\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=\"LAUNCH\",pending=s.pending~=nil,\013\010",
    "            complete=false,target=s.target,reason=s.reason,pidActive=false,launchRemainingSeconds=remaining}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    s.launchComplete=true\013\010",
    "    self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "    s.dynamics=nil;s.acquisitionMotionSamples=0;s.acquisitionMotionReadyAt=nil\013\010",
    "    s.lastPidAt=now;s.lastControlAt=now;s.lastSystemsUpdateAt=now\013\010",
    "    s.reason=\"LAUNCH SETTLED; BUILDING LIFT TO TARGET\"\013\010",
    "    return\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Advance altitude guidance on fresh control intervals, cap provider targets and issue the next batch.\010",
    "local function systemsActiveControl(self,io,now,s,balanced)\013\010",
    "    local c=self.config;local v=io.vessel\013\010",
    "    local lift=0;for _,q in ipairs(QUADS) do lift=lift+io.nodes[q].balloon.lift end\013\010",
    "    -- The raw getter excludes both gravity and the local pressure multiplier.\013\010",
    "    local actualRatio=lift*airPressure(v)/v.mass\013\010",
    "    local responseSeconds=math.max(c.hover_capture_seconds or 5,1)\013\010",
    "    local maxVs=c.max_vertical_speed or 1\013\010",
    "    local desiredVs=self.verticalTarget or clamp((s.target-v.altitude)/responseSeconds,-maxVs,maxVs)\013\010",
    "    local dynamics=s.dynamics or {}\013\010",
    "    local measuredLiftRate=finite(dynamics.projectedLiftRate) and dynamics.projectedLiftRate or dynamics.liftRate\013\010",
    "    local supportTarget=finite(s.lastDesiredRatio) and s.lastDesiredRatio or 1\013\010",
    "    local supportTolerance=math.min(c.lift_balance_tolerance_fraction,\013\010",
    "        math.max(0.005,(c.hover_max_vertical_speed or 0.2)/\013\010",
    "            (math.abs(v.environment.gravity.y)*math.max(responseSeconds,1))))\013\010",
    "    local supportSettled=math.abs(actualRatio-supportTarget)<=supportTolerance and\013\010",
    "        not (actualRatio<supportTarget and finite(measuredLiftRate) and\013\010",
    "            measuredLiftRate< -supportTolerance/math.max(responseSeconds,1))\013\010",
    "    if s.phase==\"MAIN_LIFT\" then\013\010",
    "        if self:systemsCaptureReady(s,v,now,supportSettled,actualRatio) then\013\010",
    "            self:captureSystemsBaseline(io,s,now)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if now-s.lastControlAt<io.config.network.sample_interval_seconds then\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=false,complete=s.phase==\"READY\",\013\010",
    "            target=s.target,reason=s.reason,warning=s.warning,curve=s.curve,\013\010",
    "            demandProgress=s.demandProgress,capacityProgress=s.capacityProgress,\013\010",
    "            desiredLiftRatio=s.lastDesiredRatio,\013\010",
    "            liftRatio=actualRatio,verticalSpeedTarget=desiredVs}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local dt=now-s.lastControlAt\013\010",
    "    if dt<=0 or dt>SYSTEMS_SAMPLE_GAP_SECONDS then\013\010",
    "        self:stopSystems(io,\"SYSTEMS CONTROL SAMPLE GAP\",now,{phase=s.phase,\013\010",
    "            elapsedSeconds=dt,sampleGapLimitSeconds=SYSTEMS_SAMPLE_GAP_SECONDS,\013\010",
    "            lastControlAt=s.lastControlAt,lastTargetCommandAt=s.lastTargetCommandAt})\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local pidDt=now-(s.lastPidAt or s.lastControlAt)\013\010",
    "    if pidDt<=0 or pidDt>SYSTEMS_SAMPLE_GAP_SECONDS then\013\010",
    "        self:stopSystems(io,\"SYSTEMS PID SAMPLE GAP\",now,{phase=s.phase,\013\010",
    "            elapsedSeconds=pidDt,sampleGapLimitSeconds=SYSTEMS_SAMPLE_GAP_SECONDS,\013\010",
    "            lastPidAt=s.lastPidAt,lastTargetCommandAt=s.lastTargetCommandAt})\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local actuatorElapsed=now-(s.lastTargetCommandAt or s.lastControlAt)\013\010",
    "    local slewDt=finite(actuatorElapsed) and actuatorElapsed>0 and\013\010",
    "        math.min(actuatorElapsed,SYSTEMS_MAX_SLEW_CATCHUP_SECONDS) or dt\013\010",
    "    s.lastControlAt=now\013\010",
    "    -- Calculate acquisition demand only after the previous four-quadrant\013\010",
    "    -- batch was acknowledged. The feed-forward comes from validated mass,\013\010",
    "    -- local pressure, gravity, gas composition and current bulk output; the\013\010",
    "    -- existing slew/taper/balanced-cap path remains the only actuator route.\013\010",
    "    local outerIBefore,innerIBefore=self.outer.i,self.inner.i\013\010",
    "    s.lastLiftCalculationAt=now\013\010",
    "    local desiredRatio=1\013\010",
    "    if s.phase==\"MAIN_LIFT\" then\013\010",
    "        desiredRatio=self:systemsAcquisitionControl(io,s,pidDt,actualRatio,now,slewDt)\013\010",
    "        desiredVs=self.verticalTarget or 0\013\010",
    "        if s.acquisitionPidActive then\013\010",
    "            local trimOk,trimReason=self:updateTrim(io,s.baseline,pidDt,slewDt,now)\013\010",
    "            if not trimOk then self:stopSystems(io,trimReason or \"SYSTEMS TRIM DATA UNAVAILABLE\",now);return end\013\010",
    "            if s.airborne and self.trimStatus and self.trimStatus.levelIndicated then self:rememberLevelBias(now) end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local maps,direction,allAtMaximum,curveTelemetry\013\010",
    "    if s.phase==\"READY\" then\013\010",
    "        self.target=s.target\013\010",
    "        local mapReason\013\010",
    "        maps,mapReason=self:systemsHoldTargets(io,s,pidDt,actualRatio,now,slewDt)\013\010",
    "        if not maps then self:stopSystems(io,mapReason or \"SYSTEMS HOLD DATA UNAVAILABLE\",now);return end\013\010",
    "        pcall(self.rememberHoverOffset,self,io.vessel,s,actualRatio,now)\013\010",
    "        pcall(self.autoEnablePropulsion,self,io,s,now)\013\010",
    "        desiredRatio=finite(s.lastDesiredRatio) and s.lastDesiredRatio or desiredRatio\013\010",
    "    else\013\010",
    "        maps,direction,allAtMaximum,curveTelemetry=self:systemsControlTargets(io,s,dt,desiredRatio,actualRatio,now,slewDt)\013\010",
    "        s.curve=curveTelemetry.curve\013\010",
    "        s.demandProgress=curveTelemetry.demandProgress\013\010",
    "        s.capacityProgress=curveTelemetry.capacityProgress\013\010",
    "        s.capacityLimited=curveTelemetry.capacityLimited\013\010",
    "        s.fastBoost=curveTelemetry.fastBoost\013\010",
    "        s.warning=systemsWarning(io,s)\013\010",
    "        if direction>0 and allAtMaximum then\013\010",
    "            self.outer.i=outerIBefore;self.inner.i=innerIBefore\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if s.phase==\"MAIN_LIFT\" and s.acquisitionPidActive and s.initialGasTarget and\013\010",
    "        s.initialGasTarget.seeded==true and finite(s.initialGasTarget.requestedM3PerChamber) and\013\010",
    "        s.initialGasTarget.requestedM3PerChamber>0 then\013\010",
    "        local demandCapped,capReason,capInfo=capSeededStartupSupportTargets(io,maps,desiredRatio,self.config)\013\010",
    "        if not demandCapped then self:stopSystems(io,capReason or \"STARTUP SEED SUPPORT CAP FAILED\",now);return end\013\010",
    "        maps=demandCapped\013\010",
    "        s.initialGasTarget.dynamicDemandMaximumM3PerChamber=capInfo and capInfo.maximumM3PerChamber\013\010",
    "        s.initialGasTarget.dynamicDemandCapApplied=capInfo and capInfo.limited==true or false\013\010",
    "        s.initialGasTarget.dynamicDemandFloorLimited=capInfo and capInfo.floorLimited==true or false\013\010",
    "        if capInfo and capInfo.limited then\013\010",
    "            self.outer.i=outerIBefore;self.inner.i=innerIBefore\013\010",
    "        end\013\010",
    "    end\013\010",
    "    s.lastPidAt=now\013\010",
    "    local baseMaps=copyMaps(maps)\013\010",
    "    maps=self:applyCoarseSteamTrim(io,baseMaps,balanced,now)\013\010",
    "    local capped,capReason,capacityLimited=self:capBalancedTargets(io,maps,balanced)\013\010",
    "    if not capped then\013\010",
    "        balanced.phase=\"INFEASIBLE\";balanced.reason=capReason or \"BALANCED PROVIDER FLOOR LIMIT UNAVAILABLE\"\013\010",
    "        s.balancedReason=balanced.reason;s.reason=balanced.reason\013\010",
    "        if s.currentTargets then\013\010",
    "            self:beginSystemsBatch(io,\"control\",s.currentTargets,now)\013\010",
    "        end\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=s.pending~=nil,\013\010",
    "            complete=s.phase==\"READY\",target=s.target,reason=s.reason,warning=s.warning,\013\010",
    "            liftRatio=actualRatio,balancedLift=balanced}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    maps=capped\013\010",
    "    if capacityLimited then\013\010",
    "        self.saturated=true\013\010",
    "        self.outer.i=outerIBefore;self.inner.i=innerIBefore\013\010",
    "    end\013\010",
    "    if balanced.targetUnreachable then s.balancedReason=balanced.reason end\013\010",
    "    if s.phase~=\"READY\" and direction>0 and allAtMaximum and\013\010",
    "        not capacityLimited and not balanced.targetUnreachable then\013\010",
    "        if not s.lastLiftRatio or actualRatio>s.lastLiftRatio+SYSTEMS_LIFT_PROGRESS_EPSILON then\013\010",
    "            s.lastLiftProgressAt=now\013\010",
    "        elseif now-s.lastLiftProgressAt>=math.max(60,(c.hover_capture_seconds or 5)*4) then\013\010",
    "            self:stopSystems(io,\"MAXIMUM VENT CEILINGS; LIFT NOT INCREASING\",now);return\013\010",
    "        end\013\010",
    "    elseif s.phase~=\"READY\" then s.lastLiftProgressAt=now end\013\010",
    "    s.lastLiftRatio=actualRatio\013\010",
    "    local appliedCoarse={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        appliedCoarse[q]={}\013\010",
    "        for name,p in pairs(io.nodes[q].providers or {}) do\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                appliedCoarse[q][name]=maps[q][name]-baseMaps[q][name]\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    self:beginSystemsBatch(io,\"control\",maps,now,appliedCoarse)\013\010",
    "    self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=true,complete=s.phase==\"READY\",\013\010",
    "        target=s.target,reason=s.reason,liftRatio=actualRatio,desiredLiftRatio=desiredRatio,\013\010",
    "        verticalSpeedTarget=self.verticalTarget or desiredVs,effort=self.effort,saturated=self.saturated==true,\013\010",
    "        warning=s.warning,curve=s.curve,demandProgress=s.demandProgress,capacityProgress=s.capacityProgress,\013\010",
    "        fastBoost=s.fastBoost,balancedLift=balanced}\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Advance startup, acquisition, recovery and altitude-hold target batches.\010",
    "function Flight:updateSystems(io,now)\013\010",
    "    local s=self.systemsRun\013\010",
    "    if not s then\013\010",
    "        local prepared,reason=self:systemsPreflight(io,now)\013\010",
    "        self.systemsAvailable=prepared~=nil;self.systemsBlockedReason=reason\013\010",
    "        local previous=self.systemsLastOutcome\013\010",
    "        self.systemsSnapshot={active=false,available=self.systemsAvailable==true,\013\010",
    "            phase=previous and previous.phase or (self.systemsAvailable and \"READY\" or \"IDLE\"),pending=false,\013\010",
    "            complete=false,target=previous and previous.target or nil,\013\010",
    "            reason=reason or (previous and previous.reason or nil),\013\010",
    "            abortReason=previous and previous.phase==\"ABORTED\" and previous.reason or nil,\013\010",
    "            abortDetails=previous and previous.abortDetails or nil}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    if s.telemetryRecovery then\013\010",
    "        self:updateSystemsRecovery(io,now,s)\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local good,fault,abortDetails=self:systemsGuard(io,now,s)\013\010",
    "    if not good then\013\010",
    "        if TelemetryRecovery.isTransientGuardFault(io,s,now,fault,self) then\013\010",
    "            TelemetryRecovery.suspend(self,s,now,fault)\013\010",
    "            self:updateSystemsRecovery(io,now,s)\013\010",
    "        else self:stopSystems(io,fault,now,abortDetails) end\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local previousUpdateAt=s.lastSystemsUpdateAt\013\010",
    "    if finite(previousUpdateAt) and now-previousUpdateAt>SYSTEMS_SAMPLE_GAP_SECONDS then\013\010",
    "        local pending=s.pending and s.pending[QUADS[1]]\013\010",
    "        local pendingAckSeconds=pending and finite(pending.sentAt) and now-pending.sentAt or nil\013\010",
    "        -- Scheduling gaps suspend integration and retain lift; recovery must\013\010",
    "        -- revalidate live identity, providers, targets and ACKs before resuming.\013\010",
    "        TelemetryRecovery.suspend(self,s,now,\"SYSTEMS RUNTIME SAMPLE GAP\")\013\010",
    "        s.telemetryRecovery.sampleGapDetails={phase=s.phase,lastUpdateAt=previousUpdateAt,\013\010",
    "            elapsedSeconds=now-previousUpdateAt,sampleGapLimitSeconds=SYSTEMS_SAMPLE_GAP_SECONDS,\013\010",
    "            pendingAckSeconds=pendingAckSeconds}\013\010",
    "        return\013\010",
    "    elseif finite(previousUpdateAt) and now<previousUpdateAt then\013\010",
    "        self:stopSystems(io,\"SYSTEMS RUNTIME CLOCK MOVED BACKWARD\",now,{phase=s.phase,\013\010",
    "            lastUpdateAt=previousUpdateAt,elapsedSeconds=now-previousUpdateAt,\013\010",
    "            sampleGapLimitSeconds=SYSTEMS_SAMPLE_GAP_SECONDS})\013\010",
    "        return\013\010",
    "    end\013\010",
    "    s.lastSystemsUpdateAt=now\013\010",
    "    -- A fresh node may have lost its renewable lease before the command's\013\010",
    "    -- rejection arrives. Re-probe using the retained run instead of waiting\013\010",
    "    -- for a matching rejected sequence or letting an ACK timeout abort it.\013\010",
    "    if s.batchStage==\"control\" or s.phase==\"READY\" or s.phase==\"MAIN_LIFT\" then\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local node=io.nodes[q]\013\010",
    "            if node.systemsStage==nil and node.systemsProbeReady~=true then\013\010",
    "                TelemetryRecovery.suspend(self,s,now,q..\" LIFT CONTROL LEASE LOST\")\013\010",
    "                self:updateSystemsRecovery(io,now,s);return\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    self:observeSystemsDynamics(io,s,now)\013\010",
    "    s.warning=systemsWarning(io,s)\013\010",
    "    self.reason=s.reason or self.reason\013\010",
    "    if (s.phase==\"MAIN_LIFT\" or s.phase==\"READY\") and self.controls and\013\010",
    "        finite(self.controls.targets.altitude) and self.controls.targets.altitude>=self.config.minimum_world_y and\013\010",
    "        self.controls.targets.altitude<=self.config.altitude_ceiling then\013\010",
    "        -- START SYSTEMS seeds this target from the selected cockpit value.\013\010",
    "        -- Later valid cockpit edits remain live even while an ACK is pending.\013\010",
    "        if s.target~=self.controls.targets.altitude then s.supportCorrectionRemainders={} end\013\010",
    "        s.target=self.controls.targets.altitude\013\010",
    "    end\013\010",
    "    local balanced,balancedReason=self:balancedLiftModel(io,s.target,now)\013\010",
    "    self.balancedLift=balanced;s.balancedLift=balanced\013\010",
    "    if balanced.phase==\"UNAVAILABLE\" or balanced.phase==\"INFEASIBLE\" then\013\010",
    "        s.balancedReason=balancedReason or balanced.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "    elseif balanced.targetUnreachable then\013\010",
    "        s.balancedReason=balanced.reason\013\010",
    "    else\013\010",
    "        s.balancedReason=nil\013\010",
    "    end\013\010",
    "    if s.pending then\013\010",
    "        return systemsAcknowledgeBatch(self,io,now,s)\013\010",
    "    end\013\010",
    "    if s.phase==\"PROBING\" then return end\013\010",
    "    if s.phase==\"VERIFYING\" then\013\010",
    "        return systemsVerifyStartup(self,io,now,s,balanced,balancedReason)\013\010",
    "    end\013\010",
    "    if s.phase==\"VENT_IGNITION\" then return end\013\010",
    "    if s.phase~=\"MAIN_LIFT\" and s.phase~=\"READY\" then\013\010",
    "        self:stopSystems(io,\"INVALID SYSTEMS PHASE\",now);return\013\010",
    "    end\013\010",
    "    if s.phase==\"MAIN_LIFT\" and s.launchStartedAt and not s.launchComplete then\013\010",
    "        return systemsLaunchSettling(self,io,now,s,balanced)\013\010",
    "    end\013\010",
    "    if balanced.phase==\"UNAVAILABLE\" or balanced.phase==\"INFEASIBLE\" then\013\010",
    "        s.reason=s.balancedReason or balanced.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "        if s.currentTargets and now-s.lastControlAt>=io.config.network.sample_interval_seconds then\013\010",
    "            s.lastControlAt=now\013\010",
    "            self:beginSystemsBatch(io,\"control\",s.currentTargets,now)\013\010",
    "        end\013\010",
    "        self.systemsSnapshot={active=true,available=false,phase=s.phase,pending=s.pending~=nil,\013\010",
    "            complete=s.phase==\"READY\",target=s.target,reason=s.reason,warning=s.warning,\013\010",
    "            liftRatio=s.dynamics and s.dynamics.actualRatio,balancedLift=balanced}\013\010",
    "        return\013\010",
    "    end\013\010",
    "    return systemsActiveControl(self,io,now,s,balanced)\013\010",
    "end\013\010",
    "-- Summary: Track vent-start acknowledgements and report the completed startup operation.\010",
    "function Flight:updateStartup(io,now)\013\010",
    "    self.startupComplete=io.config.vent_startup_enabled==true\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q];local bulk=0\013\010",
    "        if not n or not io:nodeFresh(q,now) then self.startupComplete=false\013\010",
    "        else\013\010",
    "            for _,p in pairs(n.providers or {}) do\013\010",
    "                if p.controlRole==\"bulk\" then\013\010",
    "                    bulk=bulk+1\013\010",
    "                    if not p.signalValid or p.signalStrength~=15 or not p.attachedValid or not p.attached or\013\010",
    "                        not p.gasOutputValid or not finite(p.gasOutput) or p.gasOutput<0 or\013\010",
    "                        (p.activeSupported and (not p.activeValid or not p.active)) then self.startupComplete=false end\013\010",
    "                end\013\010",
    "            end\013\010",
    "            if bulk~=steamCount(n) then self.startupComplete=false end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.startupPending then\013\010",
    "        local applied=true\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local command=self.startupPending[q]\013\010",
    "            if io.nodes[q].boot~=command.boot then\013\010",
    "                self.startupPending=nil;self.startupReason=q..\" STARTUP BOOT CHANGED\";break\013\010",
    "            end\013\010",
    "            if not io:commandWasApplied(q,command.seq,command.targets) then applied=false end\013\010",
    "        end\013\010",
    "        if self.startupPending and applied then self.startupPending=nil;self.startupReason=\"VENTS STARTED\"\013\010",
    "        elseif self.startupPending and now-self.startupSentAt>(io.config.vent_startup_ack_seconds or 18) then\013\010",
    "            self.startupPending=nil;self.startupReason=\"VENT STARTUP NOT ACKNOWLEDGED; CHECK LIFT LOGS\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local maps,blocked=self:startupTargets(io,now)\013\010",
    "    self.startupBlockedReason=blocked\013\010",
    "    self.startupAvailable=not self.startupComplete and self.startupPending==nil and maps~=nil\013\010",
    "end\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Copy a permitted navigator action into a bounded core request.\010",
    "local function copyBridgeAction(value,depth,budget)\013\010",
    "    local kind=type(value)\013\010",
    "    if kind==\"number\" then if not finite(value) then error(\"nonfinite action\",0) end;return value end\013\010",
    "    if kind==\"string\" then if #value>2048 then error(\"action string too long\",0) end;return value end\013\010",
    "    if kind==\"boolean\" or kind==\"nil\" then return value end\013\010",
    "    if kind~=\"table\" or depth>4 then error(\"invalid action nesting\",0) end\013\010",
    "    local out={}\013\010",
    "    for key,item in pairs(value) do\013\010",
    "        budget.n=budget.n+1\013\010",
    "        if budget.n>128 or type(key)~=\"string\" and type(key)~=\"number\" or\013\010",
    "            type(key)==\"string\" and #key>128 or type(key)==\"number\" and not finite(key) then error(\"action size/key limit\",0) end\013\010",
    "        out[key]=copyBridgeAction(item,depth+1,budget)\013\010",
    "    end\013\010",
    "    return out\013\010",
    "end\013\010",
    "local function sameBridgeAction(a,b)\013\010",
    "    if type(a)~=type(b) then return false end\013\010",
    "    if type(a)~=\"table\" then return a==b end\013\010",
    "    for k,v in pairs(a) do if not sameBridgeAction(v,b[k]) then return false end end\013\010",
    "    for k in pairs(b) do if a[k]==nil then return false end end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Correlate navigator requests with the current core session and dispatch accepted actions.\010",
    "function Flight:bridgeRequest(io,message,now)\013\010",
    "    local boot,seq=message.boot,message.seq\013\010",
    "    if type(boot)~=\"string\" or #boot==0 or #boot>128 or not boot:match(\"^[%w_%.%-:]+$\") or\013\010",
    "        not finite(seq) or seq%1~=0 or seq<1 or seq>io.config.network.max_sequence then\013\010",
    "        return false,\"INVALID BRIDGE REQUEST IDENTITY\"\013\010",
    "    end\013\010",
    "    self.retiredBridgeBoots=self.retiredBridgeBoots or {}; self.bridgeBootOrder=self.bridgeBootOrder or {}\013\010",
    "    if self.retiredBridgeBoots[boot] then return false,\"RETIRED BRIDGE BOOT\" end\013\010",
    "    if self.bridgeBoot~=boot then\013\010",
    "        if self.bridgeBoot then\013\010",
    "            self.retiredBridgeBoots[self.bridgeBoot]=true\013\010",
    "            self.bridgeBootOrder[#self.bridgeBootOrder+1]=self.bridgeBoot\013\010",
    "            if #self.bridgeBootOrder>32 then self.retiredBridgeBoots[table.remove(self.bridgeBootOrder,1)]=nil end\013\010",
    "        end\013\010",
    "        -- Navigator owns presentation, not altitude authority. Its reboot\013\010",
    "        -- changes request identity without stopping the core's running hold.\013\010",
    "        self.maintenanceReview=nil;self.tuningReview=nil;self.stopReview=nil\013\010",
    "        if self.tuningRun then self:abortTuning(io,\"BRIDGE RESTARTED\") end\013\010",
    "        self.bridgeBoot=boot; self.lastRequestSeq=0\013\010",
    "        self.bridgeRequestResults={};self.bridgeRequestOrder={}\013\010",
    "    end\013\010",
    "    self.bridgeRequestResults=self.bridgeRequestResults or {};self.bridgeRequestOrder=self.bridgeRequestOrder or {}\013\010",
    "    local copied,action=pcall(copyBridgeAction,message.action,0,{n=0})\013\010",
    "    if not copied or type(action)~=\"table\" or type(action.type)~=\"string\" then return false,\"INVALID BRIDGE ACTION\" end\013\010",
    "    local prior=self.bridgeRequestResults[seq]\013\010",
    "    if prior then\013\010",
    "        if not sameBridgeAction(prior.action,action) or prior.expiresAt~=message.expiresAt then return false,\"BRIDGE REQUEST ID REUSED\" end\013\010",
    "        if prior.accepted==nil then return false,\"COMMAND RESULT PENDING\" end\013\010",
    "        return prior.accepted,prior.reason\013\010",
    "    end\013\010",
    "    if seq<=self.lastRequestSeq then return false,\"BRIDGE REQUEST REPLAY\" end\013\010",
    "    self.lastRequestSeq=seq\013\010",
    "    local record={action=copyBridgeAction(action,0,{n=0}),expiresAt=message.expiresAt}\013\010",
    "    self.bridgeRequestResults[seq]=record;self.bridgeRequestOrder[#self.bridgeRequestOrder+1]=seq\013\010",
    "    if #self.bridgeRequestOrder>32 then self.bridgeRequestResults[table.remove(self.bridgeRequestOrder,1)]=nil end\013\010",
    "    -- The navigator's wall-clock deadline prevents a queued command from\013\010",
    "    -- becoming a surprise action after a long game/event-queue stall.\013\010",
    "    if message.expiresAt~=nil and (not finite(message.expiresAt) or message.expiresAt<=now or message.expiresAt>now+60) then\013\010",
    "        record.accepted=false;record.reason=\"COMMAND EXPIRED OR DEADLINE INVALID\";return false,record.reason\013\010",
    "    end\013\010",
    "    local called,accepted,reason=pcall(function()\013\010",
    "        if io.remoteAP then io.remoteAP:pilotAction(action) end\013\010",
    "        return self:request(io,action,now)\013\010",
    "    end)\013\010",
    "    if not called then accepted,reason=false,\"COMMAND ERROR; CHECK CORE: \"..tostring(accepted):sub(1,160) end\013\010",
    "    record.accepted,record.reason=accepted==true,reason\013\010",
    "    return record.accepted,record.reason\013\010",
    "end\013\010",
    "-- ===================== ASSEMBLY GATE =====================\013\010",
    "-- A blocked assembly gate cancels active lift calculations and PID tuning.\013\010",
    "-- Applied provider ceilings are retained while command authority is released.\013\010",
    "-- Pending tuning reviews and vent startup state are cleared.\013\010",
    "-- An active systems run with uncertain assembly follows telemetry recovery.\013\010",
    "-- Confirmed disassembly enters this blocked path.\013\010",
    "-- Propulsion is stopped separately by Thrust; its endpoints ramp to zero.\013\010",
    "-- Retained systems intent is evaluated by autoResumeSystems on later updates.\013\010",
    "-- Summary: Suspend assembly-gated flight operations and retain their last applied lift settings.\010",
    "function Flight:assemblyBlocked(io,now,reason)\013\010",
    "    reason=reason or \"VESSEL DISASSEMBLED\"\013\010",
    "    if self.tuningRun then self:abortTuning(io,reason) end\013\010",
    "    if self.systemsRun then self:stopSystems(io,reason,now) end\013\010",
    "    if self.enabled then self:stop(reason) end\013\010",
    "    self.tuningReview=nil;self.startupPending=nil\013\010",
    "    self.hoverSince=nil;self.tuningHoverSince=nil\013\010",
    "    self.available=false;self.reason=reason\013\010",
    "    self.systemsAvailable=false;self.systemsBlockedReason=reason\013\010",
    "    local last=self.systemsLastOutcome\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=\"BLOCKED\",pending=false,complete=false,\013\010",
    "        target=last and last.target or nil,reason=reason,\013\010",
    "        abortReason=last and last.phase==\"ABORTED\" and last.reason or nil,\013\010",
    "        abortDetails=last and last.abortDetails or nil}\013\010",
    "    self.tuningSnapshot={available=false,active=false,reason=reason,result=self.tuningResult}\013\010",
    "    self.startupAvailable=false;self.startupBlockedReason=reason\013\010",
    "    self.trimStatus=nil\013\010",
    "end\013\010",
    "-- Summary: Publish the validated altitude/input authority context to chamber controllers.\010",
    "function Flight:renewLiftControlContext(io,now)\013\010",
    "    local controls=self.controls\013\010",
    "    local assembled,_,assembly=Flight.assemblyGate(io,now)\013\010",
    "    local assemblyUnknown=not assembled and (not assembly or assembly.state~=\"DISASSEMBLED\")\013\010",
    "    if self.systemsRun and assemblyUnknown and not self.systemsRun.telemetryRecovery then\013\010",
    "        TelemetryRecovery.suspend(self,self.systemsRun,now,\"ASSEMBLY STATE UNKNOWN\")\013\010",
    "    end\013\010",
    "    if self.systemsRun and assembled and not self.systemsRun.telemetryRecovery then\013\010",
    "        local guarded,guardReason=self:systemsGuard(io,now,self.systemsRun)\013\010",
    "        if not guarded and TelemetryRecovery.isTransientGuardFault(io,self.systemsRun,now,guardReason,self) then\013\010",
    "            TelemetryRecovery.suspend(self,self.systemsRun,now,guardReason)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local telemetrySuspended=self.systemsRun and self.systemsRun.telemetryRecovery~=nil\013\010",
    "    local assemblySuppressed=not assembled\013\010",
    "    local selected=controls and controls.targets and controls.targets.altitude or nil\013\010",
    "    local inputsActive=false\013\010",
    "    if controls and type(controls.fresh)==\"function\" then\013\010",
    "        local fresh=controls:fresh(io,now)\013\010",
    "        inputsActive=fresh==true and controls.available==true\013\010",
    "    end\013\010",
    "    if telemetrySuspended or assemblySuppressed then inputsActive=false end\013\010",
    "    local limits=self.config or {}\013\010",
    "    local altitudeValid=not telemetrySuspended and not assemblySuppressed and finite(selected) and finite(limits.minimum_world_y) and\013\010",
    "        finite(limits.altitude_ceiling) and selected>=limits.minimum_world_y and selected<=limits.altitude_ceiling\013\010",
    "    local activeSystemsPhase=not self.systemsRun or self.systemsRun.phase==\"READY\" or\013\010",
    "        (self.systemsRun.phase==\"MAIN_LIFT\" and self.systemsRun.acquisitionPidActive==true)\013\010",
    "    local pidCandidate=self.enabled==true and not self.shutdownJob and not self.emergencyLiftLatched and\013\010",
    "        not self.tuningRun and not self.startupPending and not self.maintenanceJob and activeSystemsPhase and\013\010",
    "        not telemetrySuspended and not assemblySuppressed\013\010",
    "    local pidActive=false\013\010",
    "    if pidCandidate and altitudeValid and inputsActive then\013\010",
    "        if self.systemsRun then\013\010",
    "            local guarded=self:systemsGuard(io,now,self.systemsRun)==true\013\010",
    "            if self.systemsRun.phase==\"MAIN_LIFT\" then\013\010",
    "                local feedForward=self:systemsHoverFeedForward(io,self.systemsRun,now)\013\010",
    "                pidActive=guarded and feedForward~=nil\013\010",
    "                if not pidActive then self.systemsRun.acquisitionPidActive=false end\013\010",
    "            else\013\010",
    "                local feedForward,feedReason=self:systemsHoverFeedForward(io,self.systemsRun,now)\013\010",
    "                pidActive=guarded and feedForward~=nil\013\010",
    "                self.systemsRun.acquisitionPidActive=pidActive\013\010",
    "                self.systemsRun.feedForwardReason=feedReason\013\010",
    "            end\013\010",
    "        else\013\010",
    "            pidActive=self:check(io,now)==true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local context={selectedAltitude=altitudeValid and selected or nil,\013\010",
    "        pidActive=pidActive,inputsActive=inputsActive}\013\010",
    "    self.liftControlContext=context\013\010",
    "    if type(io.sendLiftControlContext)==\"function\" then\013\010",
    "        for _,q in ipairs(QUADS) do pcall(io.sendLiftControlContext,io,q,context) end\013\010",

    "-- Summary: Calculate altitude, vertical-speed and lift headroom plus release urgency.\010",
    "local function systemsBrakingBudgets(self,s,demand)\013\010",
    "    local state = demand.state\013\010",
    "    local lag = demand.lag\013\010",
    "    local v = demand.v\013\010",
    "    local gravity = demand.gravity\013\010",
    "    local startupHorizon = demand.startupHorizon\013\010",
    "    local responseSeconds = demand.responseSeconds\013\010",
    "    local hoverSpeed = demand.hoverSpeed\013\010",
    "    local maxVs = demand.maxVs\013\010",
    "    local releaseDelay = demand.releaseDelay\013\010",
    "    local forecastLiftRate = demand.forecastLiftRate\013\010",
    "    local supportProjectionHorizon = demand.supportProjectionHorizon\013\010",
    "    local desiredRatio = demand.desiredRatio\013\010",
    "    local actualRatio = demand.actualRatio\013\010",
    "    local controlRatio = demand.controlRatio\013\010",
    "    local deadband = demand.deadband\013\010",
    "    -- An observed lag remains useful for braking during a temporary supply\013\010",
    "    -- step. Supply instability blocks upward boost, but should not erase the\013\010",
    "    -- measured stopping horizon.\013\010",
    "    local altitudeBudget,verticalBudget,liftBudget=0,0,0\013\010",
    "    local releaseUrgency=0\013\010",
    "    local forecastOnlyRelease=false\013\010",
    "    if startupHorizon and startupHorizon>0 and finite(v.altitude) and finite(v.verticalSpeed) then\013\010",
    "        local response=math.max(self.config.hover_capture_seconds or 5,1)\013\010",
    "        local rise=math.max(0,v.verticalSpeed)\013\010",
    "        local controlDelay=(s.phase==\"MAIN_LIFT\" and\013\010",
    "            systemsStartupEnvelopeHorizon(lag,state.sampleSeconds) or\013\010",
    "            math.max(6,finite(lag) and lag or 0,finite(state.sampleSeconds) and state.sampleSeconds or 0))+releaseDelay\013\010",
    "        local projectedY=v.altitude+systemsProjectedClimbDistance(v,state,controlDelay,gravity,desiredRatio)\013\010",
    "        local brakeAcceleration=s.phase==\"MAIN_LIFT\" and systemsStartupAcceleration(self.config,lag,\013\010",
    "            state.sampleSeconds,s.lastAckWaitSeconds) or maxVs/response\013\010",
    "        local commandInterval=finite(state.sampleSeconds) and math.max(0,state.sampleSeconds) or 0\013\010",
    "        local brakingResponse=s.phase==\"MAIN_LIFT\" and startupHorizon or\013\010",
    "            (finite(lag) and lag or response)\013\010",
    "        local stoppingDistance=rise*rise/(2*math.max(brakeAcceleration,0.01))+rise*(brakingResponse+commandInterval)\013\010",
    "        local altitudeMargin=s.phase==\"MAIN_LIFT\" and hoverSpeed*response or maxVs*response\013\010",
    "        local altitudeScale=s.phase==\"MAIN_LIFT\" and math.max(hoverSpeed*response,1) or\013\010",
    "            math.max(maxVs*response,1)\013\010",
    "        local remaining=(s.target or v.altitude)-projectedY-stoppingDistance-altitudeMargin\013\010",
    "        altitudeBudget=clamp(remaining/altitudeScale,0,1)\013\010",
    "        verticalBudget=clamp((maxVs*0.5-rise)/math.max(maxVs*0.5,0.01),0,1)\013\010",
    "        local projectedRatio=systemsProjectedSupportRatio(actualRatio,forecastLiftRate,\013\010",
    "            supportProjectionHorizon+releaseDelay,desiredRatio) or actualRatio\013\010",
    "        liftBudget=clamp((desiredRatio-projectedRatio)/math.max(desiredRatio-1,deadband*4),0,1)\013\010",
    "        if state.complete and state.outputsValid and state.efficienciesValid then\013\010",
    "            local measuredLiftUrgency=clamp((actualRatio-desiredRatio)/\013\010",
    "                math.max(desiredRatio-1,0.02),0,1)\013\010",
    "            releaseUrgency=math.max(1-altitudeBudget,1-verticalBudget,measuredLiftUrgency)\013\010",
    "        end\013\010",
    "        local nominal=systemsStartupNominalSpeed(self.config)\013\010",
    "        local remainingTarget=(s.target or v.altitude)-v.altitude\013\010",
    "        if s.phase==\"MAIN_LIFT\" and actualRatio<desiredRatio and controlRatio>desiredRatio and\013\010",
    "            rise<nominal*0.5 and remainingTarget>maxVs*response then\013\010",
    "            -- Linear projection can cross demand while the vessel is still\013\010",
    "            -- well below neutral lift. Use its distance beyond demand to ask\013\010",
    "            -- for a small, proportional ceiling correction, not the full\013\010",
    "            -- altitude/vertical braking release. Once lift or climb is\013\010",
    "            -- actually excessive, the regular braking urgency applies.\013\010",
    "            forecastOnlyRelease=true\013\010",
    "            releaseUrgency=clamp((controlRatio-desiredRatio)/\013\010",
    "                math.max(desiredRatio-1,deadband*4),0,1)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return altitudeBudget,verticalBudget,liftBudget,releaseUrgency,forecastOnlyRelease\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Track demonstrated acquisition motion and its permitted acceleration progress.\010",
    "local function systemsMotionProgress(self,s,demand,now)\013\010",
    "    local state = demand.state\013\010",
    "    local lag = demand.lag\013\010",
    "    local v = demand.v\013\010",
    "    local desiredRatio = demand.desiredRatio\013\010",
    "    local actualRatio = demand.actualRatio\013\010",
    "    local maxVs = demand.maxVs\013\010",
    "    local startupProgress=1\013\010",
    "    local startupMotionProgress=1\013\010",
    "    if s.phase==\"MAIN_LIFT\" then\013\010",
    "        local supportTarget=(s.hoverFeedForward and s.hoverFeedForward.targetSupportRatio) or desiredRatio\013\010",
    "        local nominal=systemsStartupNominalSpeed(self.config)\013\010",
    "        local speedProgress=clamp(1-math.max(0,v.verticalSpeed)/math.max(nominal*0.75,0.01),0,1)\013\010",
    "        local accelerationLimit=systemsStartupAcceleration(self.config,lag,state.sampleSeconds,s.lastAckWaitSeconds)\013\010",
    "        local accelerationProgress=clamp(1-math.max(0,state.verticalAcceleration or 0)/\013\010",
    "            math.max(accelerationLimit,0.01),0,1)\013\010",
    "        if state.supplyStep then\013\010",
    "            s.acquisitionMotionSamples=0\013\010",
    "            s.acquisitionMotionReadyAt=nil\013\010",
    "            s.acquisitionMotionLostAt=nil\013\010",
    "        elseif finite(v.verticalSpeed) and v.verticalSpeed>0.1 then\013\010",
    "            s.acquisitionMotionSamples=(s.acquisitionMotionSamples or 0)+1\013\010",
    "            s.acquisitionMotionLostAt=nil\013\010",
    "        else\013\010",
    "            s.acquisitionMotionSamples=0\013\010",
    "            -- Brief deceleration or a hover capture does not erase response\013\010",
    "            -- already demonstrated by the vessel. Invalidate that proof only\013\010",
    "            -- after support is measurably lost for a full response horizon\013\010",
    "            -- while the selected target still calls for a meaningful climb.\013\010",
    "            local responseHorizon=systemsStartupControlHorizon(self.config,lag,state.sampleSeconds)\013\010",
    "            local meaningfulClimb=finite(s.target) and finite(v.altitude) and\013\010",
    "                s.target-v.altitude>maxVs*math.max(self.config.hover_capture_seconds or 5,1)\013\010",
    "            local supportLost=finite(actualRatio) and actualRatio<math.min(0.98,supportTarget-0.02)\013\010",
    "            if s.acquisitionMotionReadyAt and meaningfulClimb and supportLost then\013\010",
    "                s.acquisitionMotionLostAt=s.acquisitionMotionLostAt or now\013\010",
    "                if now-s.acquisitionMotionLostAt>=responseHorizon then\013\010",
    "                    s.acquisitionMotionReadyAt=nil\013\010",
    "                    s.acquisitionMotionLostAt=nil\013\010",
    "                end\013\010",
    "            else\013\010",
    "                s.acquisitionMotionLostAt=nil\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if s.acquisitionMotionSamples>=3 then\013\010",
    "            s.acquisitionMotionReadyAt=s.acquisitionMotionReadyAt or now\013\010",
    "        end\013\010",
    "        startupMotionProgress=0\013\010",
    "        if s.acquisitionMotionReadyAt then\013\010",
    "            startupMotionProgress=clamp((now-s.acquisitionMotionReadyAt)/\013\010",
    "                systemsStartupSpeedRampHorizon(self.config,lag,state.sampleSeconds,s.lastAckWaitSeconds),0,1)\013\010",
    "        end\013\010",
    "        startupProgress=math.min(systemsSupportProgress(actualRatio,supportTarget),\013\010",
    "            speedProgress,accelerationProgress,startupMotionProgress)\013\010",
    "    end\013\010",
    "    return startupProgress,startupMotionProgress\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Allocate per-provider ceiling changes, trim and fractional correction remainders within current limits.\010",
    "local function systemsProviderTargets(self,io,s,demand,now)\013\010",
    "    local state = demand.state\013\010",
    "    local lag = demand.lag\013\010",
    "    local v = demand.v\013\010",
    "    local slewDt = demand.slewDt\013\010",
    "    local tolerance = demand.tolerance\013\010",
    "    local gravity = demand.gravity\013\010",
    "    local hoverSpeed = demand.hoverSpeed\013\010",
    "    local maxVs = demand.maxVs\013\010",
    "    local desiredRatio = demand.desiredRatio\013\010",
    "    local actualRatio = demand.actualRatio\013\010",
    "    local error = demand.error\013\010",
    "    local direction = demand.direction\013\010",
    "    local correctionFraction = demand.correctionFraction\013\010",
    "    local sampleSeconds = demand.sampleSeconds\013\010",
    "    local appliedCommandAge = demand.appliedCommandAge\013\010",
    "    local envelopeHorizon = demand.envelopeHorizon\013\010",
    "    local deadband = demand.deadband\013\010",
    "    local altitudeBudget = demand.altitudeBudget\013\010",
    "    local verticalBudget = demand.verticalBudget\013\010",
    "    local liftBudget = demand.liftBudget\013\010",
    "    local releaseUrgency = demand.releaseUrgency\013\010",
    "    local forecastOnlyRelease = demand.forecastOnlyRelease\013\010",
    "    local startupProgress = demand.startupProgress\013\010",
    "    local startupMotionProgress = demand.startupMotionProgress\013\010",
    "    local remainders = demand.remainders\013\010",
    "    -- Summary: Calculate a bounded provider change from measured support error and actuator limits.\010",
    "    local function supportStepFor(q,name,available)\013\010",
    "        local quadrant=remainders[q]\013\010",
    "        if not quadrant then quadrant={};remainders[q]=quadrant end\013\010",
    "        local entry=quadrant[name]\013\010",
    "        if not entry then entry={direction=direction,remainder=0};quadrant[name]=entry end\013\010",
    "        if direction==0 then return 0 end\013\010",
    "        if entry.direction~=direction then\013\010",
    "            if entry.direction~=0 then entry.remainder=0 end\013\010",
    "            entry.direction=direction\013\010",
    "        end\013\010",
    "        if available<=0 then entry.remainder=0;return 0 end\013\010",
    "        local budget=available*correctionFraction+clamp(entry.remainder or 0,0,0.999999)\013\010",
    "        local whole=math.min(available,math.floor(budget))\013\010",
    "        entry.remainder=math.max(0,budget-whole)\013\010",
    "        return whole\013\010",
    "    end\013\010",
    "    local maps={};local allAtMaximum=direction>0\013\010",
    "    local demandProgress,capacityProgress,capacityLimited={},{},{}\013\010",
    "    local fastBoost={}\013\010",
    "    local correctionBand=math.max(deadband*4,0.005)\013\010",
    "    local commandCadence=finite(s.lastAckWaitSeconds) and math.max(sampleSeconds,\013\010",
    "        s.lastAckWaitSeconds+sampleSeconds) or sampleSeconds\013\010",
    "    local actualSupportError=math.abs(actualRatio-desiredRatio)\013\010",
    "    local rawAcceleration=state.verticalAccelerationRaw\013\010",
    "    local responseSettled=finite(rawAcceleration) and\013\010",
    "        math.abs(rawAcceleration)<=math.max(0.02,gravity*0.005)\013\010",
    "    local slowAckCorrection=direction~=0 and finite(s.lastAckWaitSeconds) and\013\010",
    "        s.lastAckWaitSeconds>sampleSeconds*1.5 and envelopeHorizon>0 and\013\010",
    "        state.complete and state.outputsValid and state.efficienciesValid and state.supplyStep~=true and\013\010",
    "        finite(v.verticalSpeed) and math.abs(v.verticalSpeed)<=hoverSpeed and responseSettled and\013\010",
    "        actualSupportError<=correctionBand and math.abs(actualRatio-1)<=math.max(0.02,correctionBand) and\013\010",
    "        releaseUrgency<0.5\013\010",
    "    if slowAckCorrection then\013\010",
    "        -- A slow command cadence repeats a small near-neutral correction only\013\010",
    "        -- once per actuator ACK, while the fill response spans many seconds.\013\010",
    "        -- Apply the same measured response-share to increase and decrease\013\010",
    "        -- corrections in this settled regime. Excess lift, unsafe climb,\013\010",
    "        -- rising acceleration, and high vertical speed keep full release.\013\010",
    "        local responseShare=clamp((math.max(0,appliedCommandAge)+commandCadence)/\013\010",
    "            (envelopeHorizon+commandCadence),0,1)\013\010",
    "        local proximity=clamp(1-actualSupportError/correctionBand,0,1)\013\010",
    "        correctionFraction=correctionFraction*(1-proximity*(1-responseShare))\013\010",
    "    end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        maps[q]={}\013\010",
    "        local quadrant=state.quadrants and state.quadrants[q] or {}\013\010",
    "        local quadrantHasHeadroom=false\013\010",
    "        for name,provider in pairs(io.nodes[q].providers) do\013\010",
    "            if provider.controlRole==\"bulk\" and s.currentTargets[q][name]<provider.maxTarget then\013\010",
    "                quadrantHasHeadroom=true\013\010",
    "                break\013\010",
    "            end\013\010",
    "        end\013\010",
    "        local quadrantReleaseUrgency=releaseUrgency\013\010",
    "        local projectedFill\013\010",
    "        if lag and finite(quadrant.fillFraction) then\013\010",
    "            local fillRate=math.max(0,quadrant.fillRate or 0)\013\010",
    "            projectedFill=quadrant.fillFraction+fillRate*lag/math.max(quadrant.capacity or 1,0.000001)\013\010",
    "            capacityProgress[q]=projectedFill\013\010",
    "        end\013\010",
    "        local fillBudget=1\013\010",
    "        if projectedFill then\013\010",
    "            fillBudget=clamp((SYSTEMS_FAST_FILL_STOP_FRACTION-projectedFill)/\013\010",
    "                (SYSTEMS_FAST_FILL_STOP_FRACTION-SYSTEMS_FAST_FILL_TAPER_FRACTION),0,1)\013\010",
    "            if state.complete and state.outputsValid and state.efficienciesValid then\013\010",
    "                quadrantReleaseUrgency=math.max(quadrantReleaseUrgency,1-fillBudget)\013\010",
    "            end\013\010",
    "            local node=io.nodes[q];local measuredLift=node and node.balloon and node.balloon.lift\013\010",
    "            local requiredPerQuad=io.vessel.mass*desiredRatio/(4*airPressure(io.vessel))\013\010",
    "            if projectedFill>=SYSTEMS_FAST_FILL_TAPER_FRACTION and finite(measuredLift) and measuredLift<requiredPerQuad then\013\010",
    "                capacityLimited[q]=true\013\010",
    "            end\013\010",
    "        end\013\010",
    "        demandProgress[q]=clamp((quadrant.lift or 0)*4*airPressure(io.vessel)/io.vessel.mass,0,2)\013\010",
    "        for name,p in pairs(io.nodes[q].providers) do\013\010",
    "            local value=s.currentTargets[q][name]\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                local applied=s.coarseTrimApplied and s.coarseTrimApplied[q] and\013\010",
    "                    s.coarseTrimApplied[q][name]\013\010",
    "                if finite(applied) then value=value-applied end\013\010",
    "                local floor=p.minimumNonzeroTarget or 50\013\010",
    "                local maximum=p.maxTarget\013\010",
    "                    local demandScale=(s.phase==\"MAIN_LIFT\" or s.phase==\"READY\") and 0.02 or tolerance\013\010",
    "                local magnitude=math.min(1,math.max(0,(math.abs(error)-deadband)/\013\010",
    "                    math.max(demandScale,deadband*4,0.01)))\013\010",
    "                if direction>0 then\013\010",
    "                    local supplySettled=not s.supplyStepAt or (lag and now-s.supplyStepAt>=lag)\013\010",
    "                    local fastReady=s.phase==\"MAIN_LIFT\" and quadrantHasHeadroom and lag and supplySettled and state.supplyStable and state.complete and\013\010",
    "                        state.outputsValid and state.efficienciesValid and state.fullEfficiency==true and state.quadrants[q] and\013\010",
    "                        projectedFill~=nil and not state.supplyStep\013\010",
    "                    -- Neutral support with no vessel motion is the most\013\010",
    "                    -- dangerous instant to accelerate filling: the plant may\013\010",
    "                    -- still be waiting on envelope lag. Keep the soft startup\013\010",
    "                    -- rate until positive motion is observed across multiple\013\010",
    "                    -- samples and one further measured response horizon.\013\010",
    "                    if s.phase==\"MAIN_LIFT\" then\013\010",
    "                        fastReady=fastReady and startupMotionProgress>=1\013\010",
    "                    end\013\010",
    "                    local boost=fastReady and math.min(altitudeBudget,verticalBudget,liftBudget,fillBudget,\013\010",
    "                        startupProgress) or 0\013\010",
    "                    fastBoost[q]=boost\013\010",
    "                    local softRate,riseRate,fastRate=ceilingRiseRates(self.config)\013\010",
    "                    local rate=riseRate\013\010",
    "                    if s.phase==\"MAIN_LIFT\" then\013\010",
    "                        rate=softRate+(riseRate-softRate)*startupProgress\013\010",
    "                    end\013\010",
    "                    rate=rate+(fastRate-riseRate)*boost\013\010",
    "                    local slewScale=maximum\013\010",
    "                    if s.phase==\"READY\" then\013\010",
    "                        -- HOLD remains incremental after a restart/recovery\013\010",
    "                        -- with no lag estimate. Maximum capacity is not the\013\010",
    "                        -- amount currently keeping the vessel near hover.\013\010",
    "                        slewScale=math.max(1,value-(p.minimumNonzeroTarget or 50))\013\010",
    "                    end\013\010",
    "                    local step=math.max(1,math.floor(slewScale*rate*slewDt*magnitude+0.5))\013\010",
    "                    local headroom=maximum-value\013\010",
    "                    local supportStep=supportStepFor(q,name,value)\013\010",
    "                    step=headroom>0 and math.min(step,headroom,supportStep) or 0\013\010",
    "                    value=math.min(maximum,value+step)\013\010",
    "                elseif direction<0 then\013\010",
    "                    local releaseRate=s.phase==\"READY\" and SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND or\013\010",
    "                        SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND+\013\010",
    "                        (SYSTEMS_FAST_RELEASE_FRACTION_PER_SECOND-SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND)*\013\010",
    "                        clamp(quadrantReleaseUrgency,0,1)\013\010",
    "                    -- In HOLD, or with a measured response horizon, slew down\013\010",
    "                    -- from the applied ceiling. Using the configured maximum\013\010",
    "                    -- as the scale can remove a large share of a much smaller\013\010",
    "                    -- live ceiling in a single batch. Unknown-lag legacy\013\010",
    "                    -- fixtures retain the maximum-based emergency slew.\013\010",
    "                    local floor=p.minimumNonzeroTarget or 50\013\010",
    "                    local releaseScale=(s.phase==\"READY\" or lag) and math.max(1,value-floor) or maximum\013\010",
    "                    if forecastOnlyRelease then releaseScale=math.max(1,value-floor) end\013\010",
    "                    local step=math.max(1,math.floor(releaseScale*releaseRate*slewDt*magnitude+0.5))\013\010",
    "                    local available=value-floor\013\010",
    "                    local supportStep=supportStepFor(q,name,available)\013\010",
    "                    step=available>0 and math.min(step,available,supportStep) or 0\013\010",
    "                    value=math.max(floor,value-step)\013\010",
    "                end\013\010",
    "                value=clamp(value,floor,maximum)\013\010",
    "                if value<maximum then allAtMaximum=false end\013\010",
    "            elseif p.controlRole==\"fine\" and s.baseline and s.baseline[q] then\013\010",
    "                local base=s.baseline[q][name] or value\013\010",
    "                value=clamp(math.floor(base+(self.trim[q] or 0)+0.5),\013\010",
    "                    p.minimumNonzeroTarget or 5,p.maxTarget)\013\010",
    "            end\013\010",
    "            maps[q][name]=value\013\010",
    "        end\013\010",
    "        if fastBoost[q]==nil then fastBoost[q]=0 end\013\010",
    "    end\013\010",
    "    local anyBoost=false\013\010",
    "    for _,boost in pairs(fastBoost) do if boost>0 then anyBoost=true;break end end\013\010",
    "    return maps,direction,allAtMaximum,{curve=anyBoost and \"ALTITUDE-AWARE FAST SLEW\" or \"CONSERVATIVE FEEDBACK\",\013\010",
    "        fastBoost=fastBoost,demandProgress=demandProgress,capacityProgress=capacityProgress,capacityLimited=capacityLimited}\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Allocate bounded provider targets from the requested support ratio and trim corrections.\010",
    "function Flight:systemsControlTargets(io,s,dt,desiredRatio,actualRatio,now,slewDt)\013\010",
    "    local demand=systemsSupportDemand(self,io,s,dt,desiredRatio,actualRatio,now,slewDt)\013\010",
    "    local remainders=s.supportCorrectionRemainders or {}\013\010",
    "    s.supportCorrectionRemainders=remainders\013\010",
    "    demand.remainders=remainders\013\010",
    "    demand.altitudeBudget,demand.verticalBudget,demand.liftBudget,demand.releaseUrgency,demand.forecastOnlyRelease=\013\010",
    "        systemsBrakingBudgets(self,s,demand)\013\010",
    "    demand.startupProgress,demand.startupMotionProgress=systemsMotionProgress(self,s,demand,now)\013\010",
    "    return systemsProviderTargets(self,io,s,demand,now)\013\010",
    "end\013\010",
    "-- Summary: Describe observed provider-capacity and efficiency limitations during lift acquisition.\010",
    "local function systemsWarning(io,s)\013\010",
    "    local lowEfficiency,capacityLimited={},{}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes[q]\013\010",
    "        local lowestName,lowestEfficiency\013\010",
    "        for name,provider in pairs(node and node.providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" and provider.signalValid==true and provider.signalStrength==15 and\013\010",
    "                provider.boilerEfficiencyValid==true and finite(provider.boilerEfficiency) and\013\010",
    "                (not lowestEfficiency or provider.boilerEfficiency<lowestEfficiency) then\013\010",
    "                lowestName,lowestEfficiency=name,provider.boilerEfficiency\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if lowestEfficiency and lowestEfficiency<SYSTEMS_FULL_BOILER_EFFICIENCY then\013\010",
    "            lowEfficiency[#lowEfficiency+1]=q..\"/\"..tostring(lowestName):sub(1,20)..\" \"..\013\010",
    "                string.format(\"%.1f%%\",lowestEfficiency*100)\013\010",
    "        end\013\010",
    "        if s.capacityLimited and s.capacityLimited[q] then capacityLimited[#capacityLimited+1]=q end\013\010",
    "    end\013\010",
    "    local warnings={}\013\010",
    "    if s.acquisitionStallRecovery then\013\010",
    "        warnings[#warnings+1]=\"STATIONARY BELOW TARGET; APPLYING GENTLE LIFT CORRECTION\"\013\010",
    "    end\013\010",
    "    if s.acquisitionOverdue then\013\010",
    "        warnings[#warnings+1]=\"ACQUISITION TAKING LONGER THAN EXPECTED; CONTROL CONTINUING\"\013\010",
    "    end\013\010",
    "    if #lowEfficiency>0 then\013\010",
    "        warnings[#warnings+1]=\"LOW BOILER EFFICIENCY \"..table.concat(lowEfficiency,\", \")..\" (EXPECTED 100%)\"\013\010",
    "    end\013\010",
    "    if #capacityLimited>0 then\013\010",
    "        warnings[#warnings+1]=\"BALLOON CAPACITY NEAR FULL WITH LIFT BELOW DEMAND \"..table.concat(capacityLimited,\",\")\013\010",
    "    end\013\010",
    "    return #warnings>0 and table.concat(warnings,\"; \") or nil\013\010",
    "end\013\010",
    "-- Summary: Capture stable hover targets and transition the systems run to READY.\010",
    "function Flight:captureSystemsBaseline(io,s,now)\013\010",
    "    s.baseline=copyMaps(s.currentTargets)\013\010",
    "    s.supportCorrectionRemainders={}\013\010",
    "    self.baseline=copyMaps(s.baseline);self.boots=clone(s.boots)\013\010",
    "    self.uuid=s.uuid;self.hardwareFingerprint=s.fingerprint;self.target=s.target\013\010",
    "    self.mixBaseline={}\013\010",
    "    for _,q in ipairs(QUADS) do self.mixBaseline[q]=clone(io.nodes[q].balloon.gasMix) end\013\010",
    "    self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "    self:seedHoverOffset(io.vessel.altitude)\013\010",
    "    self.verticalTarget=io.vessel.verticalSpeed\013\010",
    "    self:resetTrim(true);self.effort=0;self.saturated=false\013\010",
    "    if s.dynamics and finite(s.dynamics.actualRatio) then s.lastDesiredRatio=s.dynamics.actualRatio\013\010",
    "    else s.lastDesiredRatio=1 end\013\010",
    "    self.initialAcquisitionEnded=true\013\010",
    "    s.phase=\"READY\";s.phaseStartedAt=now;s.lastControlAt=now\013\010",
    "    -- Startup's extra takeoff margin is not a learned hover requirement.\013\010",
    "    -- Carrying it into READY adds lift after the braking limiter and can\013\010",
    "    -- overpower a negative speed-loop correction through the selected height.\013\010",
    "    s.climbStallBoost=0;s.climbStallSince=nil;s.holdDriftSince=nil\013\010",
    "    self:rememberLevelBias(now,true)\013\010",
    "    s.reason=\"HOLDING SELECTED ALTITUDE\"\013\010",
    "    clearOperationIssue(self,\"flight\",\"systems\",\"Core flight systems recovered: stable altitude hold reached\")\013\010",
    "end\013\010",
    "-- Summary: Combine trim and altitude demand into the next hold target maps.\010",
    "function Flight:systemsHoldTargets(io,s,dt,actualRatio,now,slewDt)\013\010",
    "    local trimOk,trimReason=self:updateTrim(io,s.baseline,dt,slewDt,now)\013\010",
    "    if not trimOk then return nil,trimReason end\013\010",
    "    local desiredRatio,reason=self:systemsAcquisitionControl(io,s,dt,actualRatio,now,slewDt)\013\010",
    "    if not finite(desiredRatio) then return nil,reason or \"HOLD PLANT INPUTS UNAVAILABLE\" end\013\010",
    "    local maps=self:systemsControlTargets(io,s,dt,desiredRatio,actualRatio,now,slewDt)\013\010",
    "    return maps\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Shape altitude-loop demand using measured lag, approach braking and startup motion limits.\010",
    "local function acquisitionVerticalDemand(self,io,s,demand)\013\010",
    "    local c = demand.c\013\010",
    "    local v = demand.v\013\010",
    "    local dt = demand.dt\013\010",
    "    local actualRatio = demand.actualRatio\013\010",
    "    local now = demand.now\013\010",
    "    local commandSlewDt = demand.commandSlewDt\013\010",
    "    local maxVs = demand.maxVs\013\010",
    "    local responseSeconds = demand.responseSeconds\013\010",
    "    local gravity = demand.gravity\013\010",
    "    local startupDemand = demand.startupDemand\013\010",
    "    local oldOuterI,oldInnerI=self.outer.i,self.inner.i\013\010",
    "    -- READY hold lead. A support change takes effect only after the command\013\010",
    "    -- ACK and balloon fill (several seconds), so reacting to the present\013\010",
    "    -- altitude and speed overshoots both ways: logged 2026-10-20 as a ~20 s,\013\010",
    "    -- +/-5 block limit cycle. Steer both loops on values predicted part of\013\010",
    "    -- the measured response lag ahead.\013\010",
    "    local leadSeconds=0\013\010",
    "    if s.phase==\"READY\" and not startupDemand then\013\010",
    "        -- After an airborne start or recovery no response lag has been\013\010",
    "        -- measured; estimate it from the measured command ACK wait plus ~2 s\013\010",
    "        -- of balloon fill.\013\010",
    "        local responseLag=s.responseLagSeconds\013\010",
    "        if not finite(responseLag) then\013\010",
    "            responseLag=(finite(s.lastAckWaitSeconds) and s.lastAckWaitSeconds or 2.5)+2\013\010",
    "        end\013\010",
    "        leadSeconds=clamp(responseLag*0.6,0,4)\013\010",
    "    end\013\010",
    "    local leadDynamics=s.dynamics or {}\013\010",
    "    local leadAcceleration=finite(leadDynamics.verticalAcceleration) and\013\010",
    "        clamp(leadDynamics.verticalAcceleration,-1,1) or 0\013\010",
    "    local leadVs=v.verticalSpeed+leadAcceleration*leadSeconds\013\010",
    "    local leadAltitude=v.altitude+(v.verticalSpeed+0.5*leadAcceleration*leadSeconds)*leadSeconds\013\010",
    "    s.holdLeadSeconds=leadSeconds\013\010",
    "    local desiredVs,outerLimited=self.outer:step(s.target,leadAltitude,dt,-maxVs,maxVs)\013\010",
    "    -- Names the bound that set this sample's climb command, for the displays.\013\010",
    "    local limiter=outerLimited and \"MAX CLB\" or \"ALTITUDE PID\"\013\010",
    "    local lag=s.responseLagSeconds\013\010",
    "    local state=s.dynamics or {}\013\010",
    "    local horizon=systemsStartupControlHorizon(c,lag,state.sampleSeconds)\013\010",
    "    local envelopeHorizon=systemsStartupEnvelopeHorizon(lag,state.sampleSeconds)\013\010",
    "    local hoverSpeed=c.hover_max_vertical_speed or 0.2\013\010",
    "    local remainingTarget=s.target-v.altitude\013\010",
    "    local holdApproachActive=s.phase==\"READY\" and\013\010",
    "        math.abs(remainingTarget)<=math.max(4,maxVs*responseSeconds)\013\010",
    "    if not holdApproachActive then s.holdApproach=nil end\013\010",
    "    if holdApproachActive then\013\010",
    "        -- A delayed envelope must begin braking while still on the approach\013\010",
    "        -- side of the target. Project the current signed travel over the\013\010",
    "        -- response horizon, rather than waiting for the altitude error to\013\010",
    "        -- change sign. Bound noisy lag estimates to two response horizons;\013\010",
    "        -- a measured ACK wait is still included in full.\013\010",
    "        local delay=math.max(responseSeconds,math.min(finite(lag) and lag or 0,responseSeconds*2),\013\010",
    "            finite(s.lastAckWaitSeconds) and s.lastAckWaitSeconds or 0,state.sampleSeconds or .5)\013\010",
    "        -- Use HOLD's gentle braking authority, not startup acceleration.\013\010",
    "        -- Otherwise the stopping-distance governor assumes a faster brake\013\010",
    "        -- than the support-demand cap is actually allowed to command.\013\010",
    "        local acceleration=maxVs/math.max(SYSTEMS_STARTUP_SPEED_RAMP_SECONDS,responseSeconds,delay,.5)\013\010",
    "        local distance=math.abs(remainingTarget)\013\010",
    "        local approachSpeed=2*acceleration*distance/\013\010",
    "            (math.sqrt((acceleration*delay)^2+2*acceleration*distance)+acceleration*delay)\013\010",
    "        local bounded=remainingTarget>0 and clamp(desiredVs,0,approachSpeed) or\013\010",
    "            (remainingTarget<0 and clamp(desiredVs,-approachSpeed,0) or 0)\013\010",
    "        s.holdApproach={responseSeconds=delay,projectedAltitude=v.altitude+v.verticalSpeed*delay,\013\010",
    "            approachVerticalSpeed=approachSpeed,braking=finite(v.verticalSpeed) and\013\010",
    "                v.verticalSpeed*(bounded-v.verticalSpeed)<0}\013\010",
    "        if math.abs(bounded-desiredVs)>1e-9 then\013\010",
    "            desiredVs=bounded;outerLimited=true;limiter=\"APPROACH\"\013\010",
    "            local g=self.outer.g\013\010",
    "            if finite(g.ki) and g.ki>0 then\013\010",
    "                local integral=(desiredVs-g.kp*remainingTarget-g.kd*self.outer.d)/g.ki\013\010",
    "                local limit=math.max(0,g.integral_limit or 0)\013\010",
    "                -- Remove accumulated approach demand, without leaving an\013\010",
    "                -- opposing offset that could strand a quiet ship off target.\013\010",
    "                if remainingTarget>0 then integral=math.max(0,integral)\013\010",
    "                elseif remainingTarget<0 then integral=math.min(0,integral)\013\010",
    "                else integral=0 end\013\010",
    "                self.outer.i=clamp(integral,-limit,limit)\013\010",
    "            else self.outer.i=oldOuterI end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local approachSupportTolerance=math.max(0.02,hoverSpeed/math.max(gravity*responseSeconds,0.1))\013\010",
    "    local captureApproach=startupDemand and remainingTarget>0 and\013\010",
    "        remainingTarget<=math.max(3,hoverSpeed*envelopeHorizon) and\013\010",
    "        finite(v.verticalSpeed) and math.abs(v.verticalSpeed)<=hoverSpeed and\013\010",
    "        math.abs(actualRatio-1)<=approachSupportTolerance\013\010",
    "    if captureApproach then\013\010",
    "        -- The long startup acceleration horizon is appropriate for shaping a\013\010",
    "        -- takeoff, but would reserve the entire final one-to-three blocks as\013\010",
    "        -- stopping distance at hover speed. Near a settled target, retain the\013\010",
    "        -- measured envelope projection below and use the actual response\013\010",
    "        -- horizon for current-speed travel.\013\010",
    "        horizon=math.max(state.sampleSeconds or 0.5,finite(lag) and lag or 0)\013\010",
    "        desiredVs=math.min(desiredVs,hoverSpeed)\013\010",
    "    end\013\010",
    "    if startupDemand and remainingTarget<0 and desiredVs>0 then\013\010",
    "        -- Do not let a positive altitude-loop integral keep requesting ascent\013\010",
    "        -- after the selected height has already been crossed. Start a bounded\013\010",
    "        -- hover-speed descent target and clear the conflicting positive bias.\013\010",
    "        desiredVs=-math.min(hoverSpeed,(-remainingTarget)/responseSeconds)\013\010",
    "        self.outer.i=math.min(0,self.outer.i)\013\010",
    "        outerLimited=true\013\010",
    "    end\013\010",
    "    if startupDemand and desiredVs>0 then\013\010",
    "        -- Do not wind the climb-speed target to its nominal limit while the\013\010",
    "        -- envelope is still filling against a grounded vessel. Allow only a\013\010",
    "        -- small initial takeoff speed, then earn the larger command from\013\010",
    "        -- sustained measured motion over the response horizon.\013\010",
    "        local motionProgress=0\013\010",
    "        if s.acquisitionMotionReadyAt then\013\010",
    "            motionProgress=clamp((now-s.acquisitionMotionReadyAt)/\013\010",
    "                systemsStartupSpeedRampHorizon(c,lag,state.sampleSeconds,s.lastAckWaitSeconds),0,1)\013\010",
    "        end\013\010",
    "        local initialSpeed=math.min(maxVs,math.max(c.hover_max_vertical_speed or 0.2,maxVs*0.05))\013\010",
    "        local motionSpeedCap=initialSpeed+(maxVs-initialSpeed)*motionProgress\013\010",
    "        if desiredVs>motionSpeedCap then\013\010",
    "            desiredVs=motionSpeedCap;limiter=\"TAKEOFF RAMP\"\013\010",
    "            local g=self.outer.g\013\010",
    "            if finite(g.ki) and g.ki>0 and finite(g.kp) and finite(g.kd) then\013\010",
    "                local error=s.target-v.altitude\013\010",
    "                local integral=(desiredVs-g.kp*error-g.kd*self.outer.d)/g.ki\013\010",
    "                local limit=finite(g.integral_limit) and math.max(0,g.integral_limit) or 0\013\010",
    "                self.outer.i=clamp(math.max(0,integral),-limit,limit)\013\010",
    "            else self.outer.i=math.min(self.outer.i,oldOuterI) end\013\010",
    "            outerLimited=true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if startupDemand and v.altitude<s.target then\013\010",
    "        local releaseDelay=0\013\010",
    "        if finite(s.lastDesiredRatio) and actualRatio>s.lastDesiredRatio and actualRatio>0 then\013\010",
    "            releaseDelay=clamp((actualRatio-s.lastDesiredRatio)/actualRatio,0,1)/\013\010",
    "                math.max(SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND,0.001)\013\010",
    "        end\013\010",
    "        local projectedRise=systemsProjectedClimbDistance(v,state,\013\010",
    "            envelopeHorizon+releaseDelay,gravity,s.lastDesiredRatio)\013\010",
    "        local brakeAcceleration=systemsStartupAcceleration(c,lag,state.sampleSeconds,s.lastAckWaitSeconds)\013\010",
    "        local speedLead=math.max(0,v.verticalSpeed)*horizon\013\010",
    "        local remaining=math.max(0,s.target-v.altitude-projectedRise-speedLead)\013\010",
    "        local safeSpeed=math.sqrt(2*brakeAcceleration*remaining)\013\010",
    "        if desiredVs>safeSpeed then\013\010",
    "            desiredVs=safeSpeed;limiter=\"BRAKING\"\013\010",
    "            -- Back-calculate the altitude integral to the lag-limited speed\013\010",
    "            -- command. Merely freezing it would preserve a saturated climb\013\010",
    "            -- offset through a long fill delay and slow recovery after braking.\013\010",
    "            local g=self.outer.g\013\010",
    "            if finite(g.ki) and g.ki>0 and finite(g.kp) and finite(g.kd) then\013\010",
    "                local limit=finite(g.integral_limit) and math.max(0,g.integral_limit) or 0\013\010",
    "                local altitudeError=s.target-v.altitude\013\010",
    "                local integral=(desiredVs-g.kp*altitudeError-g.kd*self.outer.d)/g.ki\013\010",
    "                integral=clamp(integral,-limit,limit)\013\010",
    "                -- The lag limiter already constrains commanded climb/descent.\013\010",
    "                -- Do not back-calculate an opposing integral large enough to\013\010",
    "                -- cancel a target error and strand acquisition below target.\013\010",
    "                if altitudeError>0 then integral=math.max(0,integral)\013\010",
    "                elseif altitudeError<0 then integral=math.min(0,integral)\013\010",
    "                else integral=0 end\013\010",
    "                self.outer.i=integral\013\010",
    "            elseif self.outer.i>oldOuterI then self.outer.i=oldOuterI end\013\010",
    "            outerLimited=true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    -- Startup speed grows with measured support. Shape both acceleration and\013\010",
    "    -- braking with the same physical bound so a noisy forecast cannot drop a\013\010",
    "    -- positive command to zero in one sample and restart the climb next tick.\013\010",
    "    local requestedVs=desiredVs\013\010",
    "    if startupDemand and requestedVs>0 then\013\010",
    "        local unsupported=requestedVs\013\010",
    "        requestedVs=math.min(requestedVs,maxVs*systemsSupportProgress(actualRatio,1))\013\010",
    "        if requestedVs<unsupported-1e-9 then limiter=\"V/S DEMAND LIM\" end\013\010",
    "    end\013\010",
    "    if startupDemand then\013\010",
    "        local acceleration=systemsStartupAcceleration(c,lag,state.sampleSeconds,s.lastAckWaitSeconds)\013\010",
    "        local slew=acceleration*commandSlewDt\013\010",
    "        local previousVs=self.verticalTarget or 0\013\010",
    "        local bounded=clamp(requestedVs,previousVs-slew,previousVs+slew)\013\010",
    "        if math.abs(bounded-desiredVs)>1e-9 then\013\010",
    "            desiredVs=bounded;limiter=bounded>previousVs and \"ACCEL LIMIT\" or \"DECEL LIMIT\"\013\010",
    "            local g=self.outer.g\013\010",
    "            if finite(g.ki) and g.ki>0 and finite(g.kp) and finite(g.kd) then\013\010",
    "                local altitudeError=s.target-v.altitude\013\010",
    "                local integral=(desiredVs-g.kp*altitudeError-g.kd*self.outer.d)/g.ki\013\010",
    "                local limit=finite(g.integral_limit) and math.max(0,g.integral_limit) or 0\013\010",
    "                self.outer.i=clamp(integral,-limit,limit)\013\010",
    "            else self.outer.i=oldOuterI end\013\010",
    "            outerLimited=true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    s.speedLimiter=limiter\013\010",
    "    self.verticalTarget=clamp(desiredVs,-maxVs,maxVs)\013\010",
    "    self.speedLimited=outerLimited==true\013\010",
    "    demand.oldInnerI=oldInnerI\013\010",
    "    demand.leadVs=leadVs\013\010",
    "    demand.lag=lag\013\010",
    "    demand.horizon=horizon\013\010",
    "    demand.hoverSpeed=hoverSpeed\013\010",
    "    demand.remainingTarget=remainingTarget\013\010",
    "    demand.holdApproachActive=holdApproachActive\013\010",
    "    demand.captureApproach=captureApproach\013\010",
    "end\013\010",

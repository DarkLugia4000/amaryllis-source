    "-- Rebind a fresh Sable association across retained control references.\013\010",
    "-- Summary: Adopt a fresh Sable UUID across retained control references and persistent selections.\010",
    "function Flight:adoptVesselIdentity(io,now)\013\010",
    "    local v=io.vessel or {}\013\010",
    "    local observed=(io.primaryReadings or {}).uuid\013\010",
    "    local stale=(io.config.network or {}).sensor_stale_seconds or 18\013\010",
    "    if v.valid~=true or not observed or observed.value~=v.uuid or not finite(observed.at) or\013\010",
    "        now<observed.at or now-observed.at>stale or\013\010",
    "        (self.vesselAdoptedAt and observed.at<=self.vesselAdoptedAt) then return end\013\010",
    "    local old=self.uuid or (self.systemsRun or {}).uuid or (self.controls or {}).uuid\013\010",
    "    if not old or old==v.uuid then return end\013\010",
    "    local track=io.assemblyTrack\013\010",
    "    local uncertain=not track or track.error~=nil or not finite(track.definiteAt) or\013\010",
    "        now-track.definiteAt>stale\013\010",
    "    if not uncertain then return end\013\010",
    "    self.vesselAdoptedAt=observed.at\013\010",
    "    -- Summary: Update matching retained vessel UUID references through the operation's nested records.\010",
    "    local function rebind(value,depth,seen)\013\010",
    "        if type(value)~=\"table\" or depth>8 or seen[value] then return end\013\010",
    "        seen[value]=true\013\010",
    "        for key,item in pairs(value) do\013\010",
    "            if (key==\"uuid\" or key==\"headingTargetUuid\" or key==\"speedTargetUuid\") and item==old then\013\010",
    "                value[key]=v.uuid\013\010",
    "            elseif type(item)==\"table\" then rebind(item,depth+1,seen) end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    for _,value in ipairs({self,self.controls,io.autopilot or {},io.positionAnchor or {},\013\010",
    "        io.controlPresets or {}}) do rebind(value,0,{}) end\013\010",
    "    if self.restart and self.restart.saved then self.restart:write(self.restart.saved) end\013\010",
    "    if io.controlPresets then io.controlPresets:update(io,self,now) end\013\010",
    "    if type(os.__amaryllisLog)==\"function\" then os.__amaryllisLog(\"Vessel association updated: \"..old..\" -> \"..v.uuid,\"core.identity\") end\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Update cockpit state, retained intent and the current altitude-control lifecycle.\010",
    "function Flight:update(io,now)\013\010",
    "    self:adoptVesselIdentity(io,now)\013\010",
    "    NavigationSettings.ensure(io.config)\013\010",
    "    if self.controls then self.controls:update(io,now) end\013\010",
    "    self.settingsEntries={}\013\010",
    "    for _,f in ipairs(FIELDS) do local entry=clone(f);entry.path=nil;entry.value=readPath(io.config,f.path);self.settingsEntries[#self.settingsEntries+1]=entry end\013\010",
    "    if self.systemsRun then self:setSystemsIntent(true)\013\010",
    "    elseif not self.emergencyLiftLatched then pcall(self.autoResumeSystems,self,io,now) end\013\010",
    "    if self.emergencyLiftLatched then\013\010",
    "        if self.emergencyLiftDisarmJob then self:updateLiftDisarm(io,now)\013\010",
    "        else self:updateEmergencyLiftKill(io,now) end\013\010",
    "        self.available=false;self.startupAvailable=false;self.systemsAvailable=false\013\010",
    "        if self.emergencyLiftLatched then\013\010",
    "            self.reason=self.emergencyLiftDisarmJob and self.emergencyLiftDisarmJob.reason or \"EMERGENCY LIFT KILL LATCHED; DISARM KILL FIRST\"\013\010",
    "            self.systemsBlockedReason=self.reason\013\010",
    "            self.systemsSnapshot={active=false,available=false,phase=\"BLOCKED\",pending=false,complete=false,reason=self.reason}\013\010",
    "        end\013\010",
    "        return\013\010",
    "    end\013\010",
    "    self:renewLiftControlContext(io,now)\013\010",
    "    -- Sending four control-context messages may yield while the input worker\013\010",
    "    -- publishes a newer completion timestamp. Evaluate subsequent gates using\013\010",
    "    -- the shared live clock, matching the snapshot and assembly-gate behavior.\013\010",
    "    if io and type(io.nowSeconds)==\"function\" then\013\010",
    "        local ok,current=pcall(io.nowSeconds,io)\013\010",
    "        if ok and finite(current) and (not finite(now) or current>now) then now=current end\013\010",
    "    end\013\010",
    "    if self.stopReview and now>self.stopReview.expires then self.stopReview=nil end\013\010",
    "    if self.shutdownJob then self:updateShutdown(io,now);self.available=false;return end\013\010",
    "    self.maintenanceSnapshot=self:maintenanceState(io,now)\013\010",
    "    local assembled,assemblyReason,assembly=Flight.assemblyGate(io,now)\013\010",
    "    self.assembly=assembly\013\010",
    "    self:updateMaintenance(io,now)\013\010",
    "    if not assembled then\013\010",
    "        if self.systemsRun and assembly and assembly.state~=\"DISASSEMBLED\" then\013\010",
    "            TelemetryRecovery.suspend(self,self.systemsRun,now,assemblyReason or \"ASSEMBLY STATE UNKNOWN\")\013\010",
    "            self:updateSystemsRecovery(io,now,self.systemsRun)\013\010",
    "            self.available=false\013\010",
    "            return\013\010",
    "        end\013\010",
    "        self:assemblyBlocked(io,now,assemblyReason); return\013\010",
    "    end\013\010",
    "    local targetY=self.controls and self.controls.targets and self.controls.targets.altitude or\013\010",
    "        (io.vessel and io.vessel.altitude)\013\010",
    "    self.balancedLift=self:balancedLiftModel(io,targetY,now)\013\010",
    "    self:updateTuning(io,now)\013\010",
    "    if self.tuningRun then self.available=false;return end\013\010",
    "    self:updateStartup(io,now)\013\010",
    "    if self.systemsRun then\013\010",
    "        self:updateSystems(io,now);self.available=false\013\010",
    "        return\013\010",
    "    end\013\010",
    "    self:updateSystems(io,now)\013\010",
    "    local ok,reason=self:check(io,now)\013\010",
    "    if not self.enabled then\013\010",
    "        self.reason=reason or self.reason or \"NOT ENGAGED\"\013\010",
    "        if ok and math.abs(io.vessel.verticalSpeed)<=self.config.hover_max_vertical_speed then\013\010",
    "            self.hoverSince=self.hoverSince or now\013\010",
    "        else self.hoverSince=nil end\013\010",
    "        self.available=ok and self.hoverSince~=nil and now-self.hoverSince>=self.config.hover_capture_seconds\013\010",
    "        return\013\010",
    "    end\013\010",
    "    if not ok then self:stop(reason); return end\013\010",
    "    if self.pending then\013\010",
    "        local acknowledged=true\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            if not io:commandWasApplied(q,self.pending[q].seq,self.pending[q].targets) then acknowledged=false end\013\010",
    "        end\013\010",
    "        if not acknowledged then\013\010",
    "            if now-self.sentAt>io.config.network.commission_ack_seconds then self:stop(\"LIFT COMMAND ACK TIMEOUT\") end\013\010",
    "            return -- Do not integrate while a previous write is still pending.\013\010",
    "        end\013\010",
    "        self.pending=nil\013\010",
    "    end\013\010",
    "    local dt=now-self.lastUpdate\013\010",
    "    if dt<io.config.network.sample_interval_seconds then return end\013\010",
    "    if dt>3 or dt<=0 then self:stop(\"CONTROL SAMPLE GAP\"); return end\013\010",
    "    self.lastUpdate=now\013\010",
    "    if self.controls then self.target=self.controls.targets.altitude end\013\010",
    "    local oldOuterI,oldInnerI=self.outer.i,self.inner.i\013\010",
    "    self.verticalTarget,self.speedLimited=self.outer:step(self.target,io.vessel.altitude,dt,\013\010",
    "        -self.config.max_vertical_speed,self.config.max_vertical_speed)\013\010",
    "    self.effort,self.feedLimited=self.inner:step(self.verticalTarget,io.vessel.verticalSpeed,dt,\013\010",
    "        -self.config.max_feed_fraction,self.config.max_feed_fraction)\013\010",
    "    local trimOk,trimReason=self:updateTrim(io,self.baseline,dt,dt,now)\013\010",
    "    if not trimOk then self:stop(trimReason);return end\013\010",
    "    local allTargets={}; self.saturated=false; local bulkSaturated=false\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        allTargets[q]={}\013\010",
    "        for name,p in pairs(io.nodes[q].providers) do\013\010",
    "            local value=self.baseline[q][name]\013\010",
    "            if p.controlRole==\"bulk\" then value=value*(1+self.effort)\013\010",
    "            else value=value+self.trim[q] end\013\010",
    "            -- Continuous control never requests zero: the burner must stay on\013\010",
    "            -- for envelope calculation, and provider zero clamping is untested.\013\010",
    "            local bounded=clamp(math.floor(value+0.5),p.controlRole==\"fine\" and 0 or p.minimumNonzeroTarget,p.maxTarget)\013\010",
    "            if bounded>0 and bounded<p.minimumNonzeroTarget then bounded=p.minimumNonzeroTarget end\013\010",
    "            if bounded~=math.floor(value+0.5) then\013\010",
    "                self.saturated=true\013\010",
    "                if p.controlRole==\"bulk\" then bulkSaturated=true end\013\010",
    "            end\013\010",
    "            allTargets[q][name]=bounded\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local model,modelReason=self:balancedLiftModel(io,self.target,now)\013\010",
    "    self.balancedLift=model\013\010",
    "    if model.phase==\"UNAVAILABLE\" or model.phase==\"INFEASIBLE\" then\013\010",
    "        self.outer.i=oldOuterI;self.inner.i=oldInnerI\013\010",
    "        self:stop(modelReason or model.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\");return\013\010",
    "    end\013\010",
    "    local baseTargets=copyMaps(allTargets)\013\010",
    "    allTargets=self:applyCoarseSteamTrim(io,baseTargets,model,now)\013\010",
    "    local capped,capReason,capacityLimited=self:capBalancedTargets(io,allTargets,model)\013\010",
    "    if not capped then\013\010",
    "        self.outer.i=oldOuterI;self.inner.i=oldInnerI\013\010",
    "        self:stop(capReason or \"BALANCED LIFT TARGET LIMIT UNAVAILABLE\");return\013\010",
    "    end\013\010",
    "    allTargets=capped\013\010",
    "    if capacityLimited then\013\010",
    "        self.saturated=true;bulkSaturated=true\013\010",
    "        self.outer.i=oldOuterI;self.inner.i=oldInnerI\013\010",
    "    end\013\010",
    "    if model.phase==\"LIMITED\" then\013\010",
    "        self.balancedLift=model\013\010",
    "    end\013\010",
    "    -- Provider ceilings add another saturation boundary after the PID. Freeze\013\010",
    "    -- both integrals there as well, so maximum vent caps cannot wind them up.\013\010",
    "    if bulkSaturated then self.outer.i=oldOuterI; self.inner.i=oldInnerI end\013\010",
    "    -- Snapshot validation above covers all four nodes before the first send.\013\010",
    "    -- Each node still repeats identity, bounds and commissioning checks itself.\013\010",
    "    self.pending={}; self.sentAt=now\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local sent,seq=io:sendAltitudeCommand(q,allTargets[q])\013\010",
    "        if not sent then self:stop(\"LIFT SEND FAILED: \"..tostring(seq)); return end\013\010",
    "        self.pending[q]={seq=seq,targets=allTargets[q]}\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Add flight, maintenance, recovery and systems information to a cached display snapshot.\010",
    "function Flight:decorate(snapshot,io,now)\013\010",
    "    io=io or {}\013\010",
    "    if io.config and io.thrust and self.controls then\013\010",
    "        local ap=self:ensureAutopilot(io)\013\010",
    "        snapshot.autopilot=ap:snapshot(io,self.controls,now or snapshot.updatedAt or 0)\013\010",
    "        if not self.enabled or self.emergencyLiftLatched or self.shutdownJob or self.tuningRun or self.maintenanceJob or\013\010",
    "            (self.systemsRun and self.systemsRun.phase~=\"READY\") or (self.restart and (self.restart.job or self.restart.saved)) then\013\010",
    "            snapshot.autopilot.available=false;snapshot.autopilot.engageReason=\"ESTABLISH ALTITUDE HOLD / FINISH SYSTEMS OPERATION\"\013\010",
    "        end\013\010",

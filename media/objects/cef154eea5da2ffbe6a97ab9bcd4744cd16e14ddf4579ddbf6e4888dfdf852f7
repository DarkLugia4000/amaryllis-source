    "    end\013\010",
    "    -- The old io.anchor guard represents a total cockpit lockout. Horizontal\013\010",
    "    -- anchor authority lives separately so steering and lift remain available.\013\010",
    "    snapshot.anchorControl=io.positionAnchor and io.positionAnchor:snapshot() or {active=false,state=\"OFF\"}\013\010",
    "    if type(io.assemblyGate)==\"function\" then\013\010",
    "        local _,_,assembly=io:assemblyGate(now);snapshot.assembly=assembly\013\010",
    "    end\013\010",
    "\013\010",
    "    snapshot.anchor=snapshot.anchorControl.state\013\010",
    "    local anchorReady,anchorReason=false,\"ENABLE PROPULSION FIRST\"\013\010",
    "    if io.thrust and io.config and (io.config.thrust or {}).enabled==true and not self.emergencyLiftLatched and not self.shutdownJob then\013\010",
    "        anchorReady,anchorReason=io.thrust:activationReady(io,now,self.controls)\013\010",
    "        if anchorReady then\013\010",
    "            local v,why=(io.positionAnchor or Anchor.new(io.config)):telemetry(io,now)\013\010",
    "            anchorReady=v~=nil;anchorReason=not v and why or nil\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.restart and (self.restart.job or self.restart.saved) then anchorReady=false;anchorReason=\"SYSTEMS RESTART IN PROGRESS\" end\013\010",
    "    snapshot.anchorControl.available=anchorReady and not snapshot.anchorControl.active\013\010",
    "    if io.autopilot and io.autopilot.active then snapshot.anchorControl.available=false;anchorReason=\"DISENGAGE AUTOPILOT FIRST\" end\013\010",
    "    snapshot.anchorControl.engageReason=anchorReason\013\010",
    "    local restart=self.restart\013\010",
    "    snapshot.systemsRestart={available=restart~=nil and not restart.job and not restart.saved and\013\010",
    "        not self.emergencyLiftDisarmJob and not self.shutdownJob and not self.tuningRun and not self.maintenanceJob,\013\010",
    "        active=restart~=nil and (restart.job~=nil or restart.saved~=nil),reason=restart and restart.reason}\013\010",
    "    snapshot.systemsStopReview=self.stopReview\013\010",
    "    local trimPidActive=not self.systemsRun or\013\010",
    "        ((self.systemsRun.phase==\"READY\" or self.systemsRun.phase==\"MAIN_LIFT\") and\013\010",
    "            self.systemsRun.acquisitionPidActive==true)\013\010",
    "    local trimControl=self.enabled and trimPidActive and\013\010",
    "        self.trimStatus and clone(self.trimStatus) or {active=false}\013\010",
    "    local bias=self.config and self.config.manual_fore_aft_trim_blocks\013\010",
    "    if not finite(bias) then bias=0 end\013\010",
    "    trimControl.manualForeAftBias=bias\013\010",
    "    trimControl.manualTargetForeAftHeightDifferenceBlocks=bias\013\010",
    "    trimControl.manualTrimMinimum=MANUAL_TRIM_MIN\013\010",
    "    trimControl.manualTrimMaximum=MANUAL_TRIM_MAX\013\010",
    "    trimControl.manualTrimSteps={MANUAL_TRIM_STEPS[1],MANUAL_TRIM_STEPS[2]}\013\010",
    "    trimControl.manualTrimAvailable,trimControl.manualTrimReason=\013\010",
    "        self:manualTrimAvailability(io,finite(now) and now or snapshot.updatedAt)\013\010",
    "    if not finite(trimControl.foreAftHeightDifferenceBlocks) then\013\010",
    "        local nodes=snapshot.nodes or {};local heights={}\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local node=nodes[q];local altitude=node and node.altitude\013\010",
    "            if not node or node.online~=true or not altitude or altitude.valid~=true or\013\010",

    "    if finite(s.target) and s.target>self.config.altitude_ceiling then s.target=self.config.altitude_ceiling end\013\010",
    "    if not finite(s.target) or s.target<self.config.minimum_world_y then\013\010",
    "        return nil,\"RETAINED ALTITUDE TARGET OUT OF RANGE\"\013\010",
    "    end\013\010",
    "    -- A command may have applied to only some providers before the\013\010",
    "    -- abort. Recover core's retained intent, not an unexplained observed map.\013\010",
    "    -- The guards above verify identity/bindings; this helper checks the exact\013\010",
    "    -- provider allowlist and target bounds before recovery re-applies it.\013\010",
    "    local maps,mapReason,coarse=TelemetryRecovery.authoritativeTargetMaps(s,io.nodes)\013\010",
    "    if not maps then return nil,mapReason end\013\010",
    "    s.currentTargets=copyMaps(maps);s.coarseTrimApplied=copyMaps(coarse)\013\010",
    "    s.appliedMaps=copyMaps(maps);s.pending=nil;s.batchTargets=nil;s.batchStage=nil;s.batchCoarseTrimApplied={}\013\010",
    "    s.telemetryRecovery=nil;s.launchComplete=true;s.launchDurationSeconds=0;s.airborne=true\013\010",
    "    s.climbStallBoost=0;s.climbStallSince=nil;s.holdDriftSince=nil\013\010",
    "    return s\013\010",
    "end\013\010",
    "-- Summary: Reconstruct altitude control from retained target maps and fresh provider observations.\010",
    "function Flight:recoverSystems(io,now)\013\010",
    "    local s,reason=self:abortRecoveryState(io,now)\013\010",
    "    if not s then return false,reason end\013\010",
    "    s.recoveredAbortReason=self.systemsLastOutcome.reason\013\010",
    "    self.systemsRun=s;self.systemsLastOutcome=nil;self.systemsRetainedRun=nil\013\010",
    "    self.enabled=true;self.available=false;self.target=s.target\013\010",
    "    if self.controls then self.controls.targets.altitude=s.target end\013\010",
    "    self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "    self:seedHoverOffset(io.vessel.altitude)\013\010",
    "    self.verticalTarget=io.vessel.verticalSpeed;self.effort=0\013\010",
    "    -- The existing recovery coordinator renews activation/leases at these\013\010",
    "    -- exact maps and waits for ACK/readback before normal PID writes resume.\013\010",

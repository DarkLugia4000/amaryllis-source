    "-- Summary: Calculate vertical-speed feedback and gate startup integration on supply observations.\010",
    "local function acquisitionSpeedEffort(self,io,s,demand)\013\010",
    "    local c = demand.c\013\010",
    "    local dt = demand.dt\013\010",
    "    local startupDemand = demand.startupDemand\013\010",
    "    local oldInnerI = demand.oldInnerI\013\010",
    "    local leadVs = demand.leadVs\013\010",
    "    local lag = demand.lag\013\010",
    "    local speedError=self.verticalTarget-leadVs\013\010",
    "    local effort,innerLimited=self.inner:step(self.verticalTarget,leadVs,dt,\013\010",
    "        -(c.max_feed_fraction or 0.15),c.max_feed_fraction or 0.15)\013\010",
    "    local state=s.dynamics or {}\013\010",
    "    local supplySettled=state.supplyStable==true and state.responseRatesStable==true and\013\010",
    "        state.outputsValid==true and state.efficienciesValid==true and\013\010",
    "        state.knownLowEfficiency~=true and state.supplyStep~=true and\013\010",
    "        -- After an airborne start or recovery no response lag is measured\013\010",
    "        -- until a large lift step happens, which a steady HOLD never makes.\013\010",
    "        -- Requiring it froze the speed integral (logged 2026-10-21: 11\013\010",
    "        -- blocks below target at +0.01 b/s for minutes, integral pinned).\013\010",
    "        -- HOLD already estimates the lag for its lead; takeoff still waits.\013\010",
    "        (lag~=nil or (s.phase==\"READY\" and not startupDemand))\013\010",
    "    local unwindingIntegral=oldInnerI*speedError<0\013\010",
    "    -- READY hold: the gas supply changes continuously during every climb\013\010",
    "    -- (more gas per block as pressure falls), so supply-stability gating froze\013\010",
    "    -- the integral upward for whole climbs while letting it wind down freely\013\010",
    "    -- in descents (logged 2026-10-22: integral flat at 6.1 for 60 s of a climb,\013\010",
    "    -- -6 after a descent, 7.5 block undershoot). Takeoff keeps the gate.\013\010",
    "    local holdIntegral=s.phase==\"READY\" and not startupDemand\013\010",
    "    if not supplySettled and not holdIntegral and self.inner.i>oldInnerI and not unwindingIntegral then\013\010",
    "        -- A cold/stepped boiler and unmeasured fill delay are not evidence\013\010",
    "        -- that extra integral demand is safe. Opposing error can still unwind.\013\010",
    "        self.inner.i=oldInnerI\013\010",
    "        effort=clamp(self.inner.g.kp*speedError+self.inner.g.ki*self.inner.i+\013\010",
    "            self.inner.g.kd*self.inner.d,-(c.max_feed_fraction or 0.15),c.max_feed_fraction or 0.15)\013\010",
    "    end\013\010",
    "    self.effort=effort;self.feedLimited=innerLimited==true\013\010",
    "    s.acquisitionPidActive=true\013\010",
    "    demand.effort=effort\013\010",
    "    demand.innerLimited=innerLimited\013\010",
    "    demand.speedError=speedError\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Combine hover feedforward and speed effort within the existing support and acceleration bounds.\010",
    "local function acquisitionSupportDemand(self,io,s,demand)\013\010",
    "    local c = demand.c\013\010",
    "    local v = demand.v\013\010",
    "    local maxVs = demand.maxVs\013\010",
    "    local responseSeconds = demand.responseSeconds\013\010",
    "    local gravity = demand.gravity\013\010",
    "    local startupDemand = demand.startupDemand\013\010",
    "    local feedForward = demand.feedForward\013\010",
    "    local oldInnerI = demand.oldInnerI\013\010",
    "    local lag = demand.lag\013\010",
    "    local horizon = demand.horizon\013\010",
    "    local hoverSpeed = demand.hoverSpeed\013\010",
    "    local holdApproachActive = demand.holdApproachActive\013\010",
    "    local effort = demand.effort\013\010",
    "    local speedError = demand.speedError\013\010",
    "    local state=s.dynamics or {}\013\010",
    "    local dragKnown=finite(state.verticalDragEstimate) and state.verticalDragEstimate>=0\013\010",
    "    local drag=dragKnown and state.verticalDragEstimate or 0\013\010",
    "    -- Account for signed vertical drag: it opposes ascent and helps brake a\013\010",
    "    -- descent. The speed PID supplies the remaining support demand.\013\010",
    "    -- Feed drag forward for the COMMANDED vertical speed, never more than the\013\010",
    "    -- speed actually reached in that direction. Feeding it from measured\013\010",
    "    -- speed was positive feedback: the drag estimate also absorbs hover-model\013\010",
    "    -- error and runs high, so a faster climb asked for more lift and climbed\013\010",
    "    -- faster (logged 2026-10-20: desired support 1.2 while commanded -5 b/s,\013\010",
    "    -- runaway to +7 b/s, then the mirror image to -6 b/s). Bounded to 5% of\013\010",
    "    -- weight; the speed PID supplies the rest.\013\010",
    "    local commanded=finite(self.verticalTarget) and self.verticalTarget or 0\013\010",
    "    local speedForDrag=commanded\013\010",
    "    if commanded*v.verticalSpeed>0 and math.abs(v.verticalSpeed)<math.abs(commanded) then\013\010",
    "        speedForDrag=v.verticalSpeed\013\010",
    "    end\013\010",
    "    local measuredResistance=dragKnown and drag*speedForDrag or 0\013\010",
    "    local dragCompensation=finite(gravity) and gravity>0 and measuredResistance/gravity or 0\013\010",
    "    -- The estimate runs high, so a 5% bound sat saturated through every\013\010",
    "    -- commanded descent as a constant bias; keep it small.\013\010",
    "    dragCompensation=clamp(dragCompensation,-0.02,0.02)\013\010",
    "    -- READY hold uses no drag feed-forward: the estimate is unreliable and\013\010",
    "    -- every way of switching the term caused a 2% lift step. The speed\013\010",
    "    -- integral learns steady error instead. Startup keeps it.\013\010",
    "    if not startupDemand then dragCompensation=0 end\013\010",
    "    local supportBaseline=feedForward.targetSupportRatio+dragCompensation\013\010",
    "    local holdBraking=not startupDemand and v.verticalSpeed*speedError<0\013\010",
    "    s.holdFeedForwardLimited=false\013\010",
    "    s.dragSupportCompensation=dragCompensation\013\010",
    "    if holdBraking and dragCompensation*v.verticalSpeed>0 then\013\010",
    "        -- While braking, drop the drag term only if it pushes in the\013\010",
    "        -- direction of the motion being arrested. A term that already\013\010",
    "        -- opposes the motion stays: removing a negative (descent) term the\013\010",
    "        -- moment she drifted upward was a +2% lift step that restarted the\013\010",
    "        -- climb (logged 2026-10-20 as gas jumps of ~1500 per chamber). Do NOT anchor the baseline\013\010",
    "        -- to measured support: measured support lags the request by the ACK\013\010",
    "        -- and fill delay, so \"measured minus correction\" ratcheted support\013\010",
    "        -- down for the whole rise and up for the whole fall (logged\013\010",
    "        -- 2026-10-20: ~25 s, +/-8 block cycle independent of PID gains).\013\010",
    "        s.holdFeedForwardLimited=math.abs(dragCompensation)>1e-9\013\010",
    "        supportBaseline=feedForward.targetSupportRatio\013\010",
    "    end\013\010",
    "    -- READY vertical drag feed-forward. Her vertical drag balances about\013\010",
    "    -- 1.9% of weight per b/s (logged 2026-10-22: +1.5% above hover held\013\010",
    "    -- +0.85 b/s, -2% held -1.0 b/s; time constant ~5.3 s, like horizontal).\013\010",
    "    -- Without it the speed PID (0.012 per b/s of error) supplied only ~1.7%\013\010",
    "    -- and climbs crept at 0.3-0.9 b/s against a 2.4 b/s command. Fed from the\013\010",
    "    -- COMMANDED speed only (never measured speed: that was positive\013\010",
    "    -- feedback), so it shrinks smoothly as the altitude loop closes in.\013\010",
    "    if not startupDemand then\013\010",
    "        local perBps=Registry.number(c,\"altitude_control.vertical_drag_support_per_bps\")\013\010",
    "        local vsFeedForward=clamp(perBps*commanded,-(c.max_feed_fraction or 0.15),c.max_feed_fraction or 0.15)\013\010",
    "        supportBaseline=supportBaseline+vsFeedForward\013\010",
    "        s.verticalSpeedFeedForward=vsFeedForward\013\010",
    "    end\013\010",
    "    s.appliedDragSupportCompensation=supportBaseline-feedForward.targetSupportRatio\013\010",
    "    local minimumSupport=math.max(0,1-c.lift_balance_tolerance_fraction)\013\010",
    "    local maximumSupport=1+c.lift_balance_tolerance_fraction\013\010",
    "    local uncappedSupportRequest=clamp(supportBaseline+effort,minimumSupport,maximumSupport)\013\010",
    "    local desiredRatio=uncappedSupportRequest\013\010",
    "    if (startupDemand or s.phase==\"READY\") and finite(gravity) and gravity>0 then\013\010",
    "        -- Bound total support demand by the speed-loop acceleration request in\013\010",
    "        -- both startup and the delayed-response HOLD handoff. HOLD uses its\013\010",
    "        -- measured response horizon; only takeoff uses the deliberately slow\013\010",
    "        -- startup speed ramp. Signed measured drag remains separate.\013\010",
    "        local horizon=startupDemand and systemsStartupControlHorizon(c,lag,state.sampleSeconds) or\013\010",
    "            math.max(finite(lag) and lag or 0,state.sampleSeconds or 0.5)\013\010",
    "        local holdAccelerationHorizon=math.max(responseSeconds,\013\010",
    "            finite(lag) and lag or 0,finite(state.sampleSeconds) and state.sampleSeconds or 0.5)\013\010",
    "        local accelerationLimit\013\010",
    "        if startupDemand then\013\010",
    "            accelerationLimit=systemsStartupAcceleration(c,lag,state.sampleSeconds,s.lastAckWaitSeconds)\013\010",
    "        else\013\010",
    "            -- Preserve gentle normal HOLD corrections around the setpoint.\013\010",
    "            -- Away from target, taper in measured-response authority in both\013\010",
    "            -- directions. A distant ascent needs the same ability to leave\013\010",
    "            -- hover as a distant descent; the gentle cap alone can settle at\013\010",
    "            -- neutral support without producing the requested motion.\013\010",
    "            local normalHoldAcceleration=maxVs/SYSTEMS_STARTUP_SPEED_RAMP_SECONDS\013\010",
    "            accelerationLimit=normalHoldAcceleration\013\010",
    "            local holdError=s.target-v.altitude\013\010",
    "            local brakingClearance=math.max(3,hoverSpeed*responseSeconds)\013\010",
    "            if self.verticalTarget~=0 then\013\010",
    "                local direction=self.verticalTarget>0 and 1 or -1\013\010",
    "                local responseAcceleration=maxVs/holdAccelerationHorizon\013\010",
    "                local speed=math.abs(v.verticalSpeed)\013\010",
    "                local stoppingRange=speed*holdAccelerationHorizon+\013\010",
    "                    speed*speed/(2*math.max(responseAcceleration,0.01))\013\010",
    "                local authorityRange=math.max(brakingClearance,stoppingRange,maxVs*responseSeconds,1)\013\010",
    "                local altitudeAuthority=clamp((direction*holdError-brakingClearance)/authorityRange,0,1)\013\010",
    "                local speedAuthority=direction<0 and clamp(-speedError/math.max(maxVs,0.01),0,1) or 0\013\010",
    "                local authority=math.max(altitudeAuthority,speedAuthority)\013\010",
    "                accelerationLimit=normalHoldAcceleration+\013\010",
    "                    (responseAcceleration-normalHoldAcceleration)*authority\013\010",
    "            end\013\010",
    "        end\013\010",
    "        local requestedAcceleration=speedError/math.max(horizon,0.5)\013\010",
    "        if startupDemand and speedError<0 then\013\010",
    "            -- Braking follows the measured actuator response, not the slower\013\010",
    "            -- positive speed ramp. This matches the acceleration bound used\013\010",
    "            -- by the stopping-distance governor while keeping deceleration\013\010",
    "            -- proportional for small speed errors.\013\010",
    "            local brakingHorizon=math.max(state.sampleSeconds or 0.5,\013\010",
    "                finite(lag) and lag or 0.5)\013\010",
    "            requestedAcceleration=speedError/brakingHorizon\013\010",
    "        elseif startupDemand and not s.acquisitionMotionReadyAt and speedError>0 then\013\010",
    "            -- A grounded vessel cannot earn its measured-motion proof when\013\010",
    "            -- the speed-loop cap asks for less acceleration than unknown drag\013\010",
    "            -- consumes. Use the bounded startup acceleration once to establish\013\010",
    "            -- gentle motion; afterward the measured drag feed-forward and\013\010",
    "            -- slower feedback horizon govern the ramp.\013\010",
    "            requestedAcceleration=accelerationLimit\013\010",
    "        end\013\010",
    "        requestedAcceleration=clamp(requestedAcceleration,-accelerationLimit,accelerationLimit)\013\010",
    "        s.lastRequestedAcceleration=requestedAcceleration\013\010",
    "        local lowerEffort=math.min(0,requestedAcceleration)/gravity\013\010",
    "        local upperEffort=math.max(0,requestedAcceleration)/gravity\013\010",
    "        -- In HOLD, centre the acceleration band on the hover support the\013\010",
    "        -- integral has learned, not on the model's 1.00. The model can be ~5%\013\010",
    "        -- off at altitude; a band around 1.00 (with back-calculation) kept the\013\010",
    "        -- integral from ever reaching the real hover point, so she could not\013\010",
    "        -- descend (logged 2026-10-20: 30 blocks above target, -2 b/s asked).\013\010",
    "        local learnedCentre=supportBaseline\013\010",
    "        if not startupDemand then\013\010",
    "            local g=self.inner.g\013\010",
    "            local learned=finite(g.ki) and finite(self.inner.i) and g.ki*self.inner.i or 0\013\010",
    "            learnedCentre=supportBaseline+clamp(learned,-(c.max_feed_fraction or 0.15),c.max_feed_fraction or 0.15)\013\010",
    "        end\013\010",
    "        desiredRatio=clamp(uncappedSupportRequest,\013\010",
    "            clamp(learnedCentre+lowerEffort,minimumSupport,maximumSupport),\013\010",
    "            clamp(learnedCentre+upperEffort,minimumSupport,maximumSupport))\013\010",
    "        if (holdApproachActive or holdBraking) and v.verticalSpeed*speedError<0 and\013\010",
    "            (uncappedSupportRequest-learnedCentre)*requestedAcceleration<=0 then\013\010",
    "            -- Retain learned hover support. Only replace an integral that is\013\010",
    "            -- opposing braking, using the existing gentle acceleration bound;\013\010",
    "            -- the back-calculation below transfers it to that bounded effort.\013\010",
    "            desiredRatio=clamp(learnedCentre+requestedAcceleration/gravity,minimumSupport,maximumSupport)\013\010",
    "        end\013\010",
    "        if math.abs(desiredRatio-uncappedSupportRequest)>1e-9 then\013\010",
    "            local gains=self.inner.g\013\010",
    "            if finite(gains.ki) and gains.ki>0 and finite(gains.kp) and finite(gains.kd) then\013\010",
    "                local allowedEffort=desiredRatio-supportBaseline\013\010",
    "                local limit=finite(gains.integral_limit) and math.max(0,gains.integral_limit) or 0\013\010",
    "                local allowedIntegral=(allowedEffort-gains.kp*speedError-gains.kd*self.inner.d)/gains.ki\013\010",
    "                self.inner.i=clamp(allowedIntegral,-limit,limit)\013\010",
    "                effort=clamp(gains.kp*speedError+gains.ki*self.inner.i+gains.kd*self.inner.d,\013\010",
    "                    -(c.max_feed_fraction or 0.15),c.max_feed_fraction or 0.15)\013\010",
    "                self.effort=effort;self.feedLimited=true\013\010",
    "            else self.inner.i=oldInnerI end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    -- A settled envelope can be numerically at neutral support while the\013\010",
    "    -- extremely small startup speed-loop margin never produces actual motion.\013\010",
    "    -- Require sustained quiet motion and output caught up to every bulk target\013\010",
    "    -- before renewing bounded acceleration. Never boost a still-filling plant.\013\010",
    "    demand.state=state\013\010",
    "    demand.supportBaseline=supportBaseline\013\010",
    "    demand.holdBraking=holdBraking\013\010",
    "    demand.minimumSupport=minimumSupport\013\010",
    "    demand.maximumSupport=maximumSupport\013\010",
    "    demand.desiredRatio=desiredRatio\013\010",
    "    demand.effort=effort\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Apply measured acquisition shortfall and retained hover-drift corrections, then finalize anti-windup.\010",
    "local function acquisitionStallCorrection(self,io,s,demand)\013\010",
    "    local c = demand.c\013\010",
    "    local v = demand.v\013\010",
    "    local dt = demand.dt\013\010",
    "    local actualRatio = demand.actualRatio\013\010",
    "    local now = demand.now\013\010",
    "    local responseSeconds = demand.responseSeconds\013\010",
    "    local gravity = demand.gravity\013\010",
    "    local startupDemand = demand.startupDemand\013\010",
    "    local oldInnerI = demand.oldInnerI\013\010",
    "    local lag = demand.lag\013\010",
    "    local hoverSpeed = demand.hoverSpeed\013\010",
    "    local remainingTarget = demand.remainingTarget\013\010",
    "    local holdApproachActive = demand.holdApproachActive\013\010",
    "    local captureApproach = demand.captureApproach\013\010",
    "    local effort = demand.effort\013\010",
    "    local innerLimited = demand.innerLimited\013\010",
    "    local speedError = demand.speedError\013\010",
    "    local state = demand.state\013\010",
    "    local supportBaseline = demand.supportBaseline\013\010",
    "    local holdBraking = demand.holdBraking\013\010",
    "    local minimumSupport = demand.minimumSupport\013\010",
    "    local maximumSupport = demand.maximumSupport\013\010",
    "    local desiredRatio = demand.desiredRatio\013\010",
    "    local outputSettled=state.complete==true and state.outputsValid==true\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,provider in pairs(io.nodes[q].providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                local target=s.currentTargets and s.currentTargets[q] and s.currentTargets[q][name]\013\010",
    "                if not finite(target) or provider.gasOutputValid~=true or not finite(provider.gasOutput) or\013\010",
    "                    math.abs(provider.gasOutput-target)>math.max(1,target*.0001) then outputSettled=false end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local quietShortfall=captureApproach and remainingTarget>SYSTEMS_TARGET_TOLERANCE_BLOCKS and\013\010",
    "        self.verticalTarget>0 and math.abs(v.verticalSpeed)<=.02 and\013\010",
    "        finite(state.verticalAccelerationRaw) and math.abs(state.verticalAccelerationRaw)<=.005 and\013\010",
    "        outputSettled and state.supplyStep~=true\013\010",
    "    s.acquisitionStallRecovery=false\013\010",
    "    if quietShortfall then\013\010",
    "        s.acquisitionStallSince=s.acquisitionStallSince or now\013\010",
    "        local dwell=math.max(10,finite(lag) and lag or SYSTEMS_STARTUP_CONTROL_HORIZON_SECONDS)\013\010",
    "        if now-s.acquisitionStallSince>=dwell then\013\010",
    "            local acceleration=math.min(systemsStartupAcceleration(c,lag,state.sampleSeconds,s.lastAckWaitSeconds),\013\010",
    "                hoverSpeed/responseSeconds)\013\010",
    "            local recoveryDemand=clamp(actualRatio+acceleration/gravity,minimumSupport,maximumSupport)\013\010",
    "            if recoveryDemand>desiredRatio then\013\010",
    "                desiredRatio=recoveryDemand;s.acquisitionStallRecovery=true\013\010",
    "                self.effort=desiredRatio-supportBaseline\013\010",
    "            end\013\010",
    "        end\013\010",
    "    else s.acquisitionStallSince=nil end\013\010",
    "    -- Climb stall recovery: lift estimates carry about 1% error, so a small\013\010",
    "    -- commanded margin can leave the ship hovering far below its target.\013\010",
    "    -- While well below target, commanded upward and not moving, raise the\013\010",
    "    -- support request slowly until she climbs; release it once she does.\013\010",
    "    local stallBoost=s.climbStallBoost or 0\013\010",
    "    if startupDemand and remainingTarget>8 and self.verticalTarget>0 and finite(v.verticalSpeed) then\013\010",
    "        if v.verticalSpeed<math.min(0.15,0.5*self.verticalTarget) and outputSettled and state.supplyStep~=true then\013\010",
    "            -- Stalled or sinking while commanded up: the hover estimate is\013\010",
    "            -- short. The measured shortfall at about Y 95 was ~0.6% of weight,\013\010",
    "            -- so build the margin within seconds rather than minutes.\013\010",
    "            s.climbStallSince=s.climbStallSince or now\013\010",
    "            if now-s.climbStallSince>=4 then stallBoost=math.min(0.05,stallBoost+0.003*math.max(0,dt)) end\013\010",
    "        elseif v.verticalSpeed>1.2*self.verticalTarget then\013\010",
    "            -- Climbing faster than commanded: hand the margin back gradually.\013\010",
    "            s.climbStallSince=nil\013\010",
    "            stallBoost=math.max(0,stallBoost-0.002*math.max(0,dt))\013\010",
    "        else\013\010",
    "            -- Climbing slower than commanded. The support actually delivered\013\010",
    "            -- trails the request by the ACK wait plus balloon fill (~0.6% of\013\010",
    "            -- weight in logged climbs), as large as the whole startup\013\010",
    "            -- acceleration budget, so she crept up at ~0.2 b/s with near-zero\013\010",
    "            -- measured acceleration. Learn that shortfall: while measured\013\010",
    "            -- acceleration stays below the requested acceleration, add the\013\010",
    "            -- missing fraction of weight over an 8 s time constant.\013\010",
    "            s.climbStallSince=nil\013\010",
    "            local requested=s.lastRequestedAcceleration\013\010",
    "            local measured=finite(state.verticalAcceleration) and state.verticalAcceleration or state.verticalAccelerationRaw\013\010",
    "            if finite(requested) and requested>0 and finite(measured) and finite(gravity) and gravity>0 and\013\010",
    "                outputSettled and state.supplyStep~=true and measured<requested then\013\010",
    "                local missing=clamp((requested-measured)/gravity,0,0.01)\013\010",
    "                stallBoost=math.min(0.05,stallBoost+missing/8*math.max(0,dt))\013\010",
    "            end\013\010",
    "        end\013\010",
    "    elseif s.phase==\"READY\" and finite(v.verticalSpeed) and finite(remainingTarget) then\013\010",
    "        -- HOLD support bias. HOLD may only request ~0.2% of weight beyond the\013\010",
    "        -- estimated hover support, smaller than that estimate's own error, so\013\010",
    "        -- she could sink (or rise) slowly away from the target while the\013\010",
    "        -- controller believed it was holding. While more than a block off\013\010",
    "        -- target and drifting slowly (not moving toward it), learn a slow offset in the\013\010",
    "        -- target's direction; keep it once she holds (it is the estimate's\013\010",
    "        -- error), and unlearn it the same way after an overshoot.\013\010",
    "        s.climbStallSince=nil\013\010",
    "        -- Near-target braking takes precedence over a historical drift boost.\013\010",
    "        -- The allocator still limits actual ceiling travel; retaining this\013\010",
    "        -- offset here can reverse the requested braking acceleration's sign.\013\010",
    "        if (holdApproachActive or holdBraking) and v.verticalSpeed*speedError<0 and stallBoost*speedError<0 then\013\010",
    "            stallBoost=0;s.holdDriftSince=nil\013\010",
    "        end\013\010",
    "        local towardTarget=remainingTarget>0 and v.verticalSpeed or -v.verticalSpeed\013\010",
    "        if math.abs(remainingTarget)>1 and towardTarget<0.05 and math.abs(v.verticalSpeed)<0.15 then\013\010",
    "            s.holdDriftSince=s.holdDriftSince or now\013\010",
    "            if now-s.holdDriftSince>=20 then\013\010",
    "                local direction=remainingTarget>0 and 1 or -1\013\010",
    "                -- Five times faster once the progress watchdog has declared an\013\010",
    "                -- altitude stall: whatever is holding her, lean on it.\013\010",
    "                local rate=self.altitudeProgressStalled and 0.001 or 0.0002\013\010",
    "                stallBoost=clamp(stallBoost+direction*rate*math.max(0,dt),-0.03,0.05)\013\010",
    "            end\013\010",
    "        else\013\010",
    "            s.holdDriftSince=nil\013\010",
    "        end\013\010",
    "    else\013\010",
    "        -- Near the target or outside the climb: fade any margin out smoothly.\013\010",
    "        s.climbStallSince=nil;stallBoost=math.max(0,stallBoost-0.004*math.max(0,dt))\013\010",
    "    end\013\010",
    "    s.climbStallBoost=stallBoost\013\010",
    "    if stallBoost~=0 then\013\010",
    "        desiredRatio=clamp(desiredRatio+stallBoost,minimumSupport,maximumSupport)\013\010",
    "        if math.abs(stallBoost)>0.002 then\013\010",
    "            s.speedLimiter=s.phase==\"READY\" and \"HOLD SUPPORT BIAS\" or \"CLIMB STALL BOOST\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if innerLimited and ((effort>=c.max_feed_fraction and speedError>0) or\013\010",
    "        (effort<=-c.max_feed_fraction and speedError<0)) then self.inner.i=oldInnerI end\013\010",
    "    s.lastDesiredRatio=desiredRatio\013\010",
    "    return desiredRatio\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Compute bounded vertical-speed and lift-ratio demand from altitude error and measured dynamics.\010",
    "function Flight:systemsAcquisitionControl(io,s,dt,actualRatio,now,slewDt)\013\010",
    "    local c=self.config;local v=io.vessel\013\010",
    "    local state=s.dynamics or {}\013\010",
    "    local startupDemand=s.phase==\"MAIN_LIFT\"\013\010",
    "    -- Keep virtual speed-target slew bounded across an ACK wait. The startup\013\010",
    "    -- acceleration itself has already been reduced by the measured command\013\010",
    "    -- cadence, so this capped elapsed budget lets a braking target respond\013\010",
    "    -- without feeding the entire wait into either PID integrator.\013\010",
    "    local commandSlewDt=finite(slewDt) and slewDt>0 and\013\010",
    "        math.min(slewDt,SYSTEMS_MAX_SLEW_CATCHUP_SECONDS) or dt\013\010",
    "    local maxVs=startupDemand and systemsStartupNominalSpeed(c) or (c.max_vertical_speed or 1)\013\010",
    "    local responseSeconds=math.max(c.hover_capture_seconds or 5,1)\013\010",
    "    local gravity=math.abs(v.environment.gravity.y)\013\010",
    "    local feedForward,feedReason=self:systemsHoverFeedForward(io,s,now)\013\010",
    "    if not feedForward then\013\010",
    "        if not startupDemand then\013\010",
    "            s.acquisitionPidActive=false;s.feedForwardReason=feedReason\013\010",
    "            return nil,feedReason or \"HOLD PLANT INPUTS UNAVAILABLE\"\013\010",
    "        end\013\010",
    "        -- Preserve the slow measured-lift ramp if output telemetry is absent,\013\010",
    "        -- but do not claim a nested PID is active without its verified plant\013\010",
    "        -- inputs. No integrator or trim state is changed on this fallback.\013\010",
    "        s.acquisitionPidActive=false;s.feedForwardReason=feedReason\013\010",
    "        s.speedLimiter=\"NO LIFT OUTPUT DATA\"\013\010",
    "        local desired=clamp((s.target-v.altitude)/responseSeconds,-maxVs,maxVs)\013\010",
    "        local lag=s.responseLagSeconds\013\010",
    "        local horizon=systemsStartupControlHorizon(c,lag,(s.dynamics or {}).sampleSeconds)\013\010",
    "        if startupDemand and v.altitude<s.target then\013\010",
    "            local releaseDelay=0\013\010",
    "            if finite(s.lastDesiredRatio) and actualRatio>s.lastDesiredRatio and actualRatio>0 then\013\010",
    "                releaseDelay=clamp((actualRatio-s.lastDesiredRatio)/actualRatio,0,1)/\013\010",
    "                    math.max(SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND,0.001)\013\010",
    "            end\013\010",
    "            local envelopeHorizon=systemsStartupEnvelopeHorizon(lag,state.sampleSeconds)\013\010",
    "            local projectedRise=systemsProjectedClimbDistance(v,state,\013\010",
    "                envelopeHorizon+releaseDelay,gravity,s.lastDesiredRatio)\013\010",
    "            local speedLead=math.max(0,v.verticalSpeed)*horizon\013\010",
    "            local remaining=math.max(0,s.target-v.altitude-projectedRise-speedLead)\013\010",
    "            desired=math.min(desired,math.sqrt(2*systemsStartupAcceleration(c,lag,state.sampleSeconds,\013\010",
    "                s.lastAckWaitSeconds)*remaining))\013\010",
    "        end\013\010",
    "        if desired>0 then\013\010",
    "            desired=math.min(desired,maxVs*systemsSupportProgress(actualRatio,1))\013\010",
    "            local acceleration=systemsStartupAcceleration(c,lag,state.sampleSeconds,s.lastAckWaitSeconds)\013\010",
    "            desired=math.min(desired,(self.verticalTarget or 0)+acceleration*commandSlewDt)\013\010",
    "        end\013\010",
    "        self.verticalTarget=desired\013\010",
    "        self.effort=0;self.feedLimited=false;self.speedLimited=false\013\010",
    "        return clamp(1+(self.verticalTarget-v.verticalSpeed)/(gravity*responseSeconds),\013\010",
    "            math.max(0,1-c.lift_balance_tolerance_fraction),1+c.lift_balance_tolerance_fraction)\013\010",
    "    end\013\010",
    "    s.feedForwardReason=nil\013\010",
    "    local demand={\013\010",
    "        c=c,\013\010",
    "        v=v,\013\010",
    "        dt=dt,\013\010",
    "        actualRatio=actualRatio,\013\010",
    "        now=now,\013\010",
    "        commandSlewDt=commandSlewDt,\013\010",
    "        maxVs=maxVs,\013\010",
    "        responseSeconds=responseSeconds,\013\010",
    "        gravity=gravity,\013\010",
    "        startupDemand=startupDemand,\013\010",
    "        feedForward=feedForward,\013\010",
    "    }\013\010",
    "    acquisitionVerticalDemand(self,io,s,demand)\013\010",
    "    acquisitionSpeedEffort(self,io,s,demand)\013\010",
    "    acquisitionSupportDemand(self,io,s,demand)\013\010",
    "    return acquisitionStallCorrection(self,io,s,demand)\013\010",
    "end\013\010",
    "-- Summary: Send the next pending chamber target and record its acknowledgement deadline.\010",
    "function Flight:sendSystemsNext(io,now)\013\010",
    "    local s=self.systemsRun;if not s then return false end\013\010",
    "    if s.batchStage==\"control\" then s.lastTargetCommandAt=now end\013\010",
    "    s.pending={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local targets=s.batchTargets[q]\013\010",
    "        local commandStage=s.telemetryRecovery and s.recoveryStages and s.recoveryStages[q] or s.batchStage\013\010",
    "        local ok,seq=io:sendSystemsCommand(q,targets,commandStage)\013\010",
    "        if not ok then\013\010",
    "            if s.telemetryRecovery then\013\010",
    "                s.telemetryRecovery.sendFailure=q..\" SYSTEMS SEND FAILED: \"..tostring(seq)\013\010",
    "                s.telemetryRecovery.lastRetryAt=now\013\010",
    "                s.telemetryRecovery.hasAttempted=true\013\010",
    "                s.telemetryRecovery.retryCount=(s.telemetryRecovery.retryCount or 0)+1\013\010",
    "                s.pending[q]=nil\013\010",
    "                return false\013\010",
    "            end\013\010",
    "            TelemetryRecovery.suspend(self,s,now,q..\" SYSTEMS SEND FAILED: \"..tostring(seq))\013\010",
    "            return false\013\010",
    "        end\013\010",
    "        s.pending[q]={q=q,seq=seq,targets=targets,stage=commandStage,sentAt=now,boot=s.boots[q]}\013\010",
    "    end\013\010",
    "    if s.telemetryRecovery then\013\010",
    "        s.telemetryRecovery.lastRetryAt=now\013\010",
    "        s.telemetryRecovery.hasAttempted=true\013\010",
    "        s.telemetryRecovery.retryCount=(s.telemetryRecovery.retryCount or 0)+1\013\010",
    "        s.telemetryRecovery.sendFailure=nil\013\010",
    "    end\013\010",
    "    if s.balancedReason then\013\010",
    "        s.reason=s.balancedReason\013\010",
    "    elseif s.batchStage==\"probe\" then\013\010",
    "        s.reason=s.phase==\"VERIFYING\" and \"KEEPING PROBE BURNERS ACTIVE\" or \"ACTIVATING PROBE BURNERS\"\013\010",
    "    elseif s.phase==\"VENT_IGNITION\" then s.reason=\"ACTIVATING BULK VENTS\"\013\010",
    "    elseif s.phase==\"READY\" then s.reason=self.trimStatus and self.trimStatus.authorityLimited and\013\010",
    "        \"HOLDING ALTITUDE / TRIM AUTHORITY EXHAUSTED\" or \"HOLDING SELECTED ALTITUDE\"\013\010",
    "    else s.reason=\"BUILDING LIFT TO TARGET\" end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Stage a complete chamber target batch with its command stage and trim allocation.\010",
    "function Flight:beginSystemsBatch(io,stage,maps,now,coarseTrimApplied)\013\010",
    "    local s=self.systemsRun;if not s then return false end\013\010",
    "    if not s.telemetryRecovery and stage==\"control\" and s.phase==\"MAIN_LIFT\" and not s.responseProbe and not s.responseLagSeconds and\013\010",
    "        systemsBulkCeilingSum(maps,io.nodes)>systemsBulkCeilingSum(s.currentTargets,io.nodes) then\013\010",
    "        local dynamics=s.dynamics or {}\013\010",
    "        s.responseProbe={excitation=true,at=now,actualRatio=dynamics.actualRatio or 0,\013\010",
    "            quadrants=clone(dynamics.quadrants or {})}\013\010",
    "    end\013\010",
    "    s.batchStage=stage;s.batchTargets=copyMaps(maps);s.appliedMaps={}\013\010",
    "    if stage==\"control\" then\013\010",
    "        s.batchCoarseTrimApplied=clone(coarseTrimApplied~=nil and coarseTrimApplied or s.coarseTrimApplied or {})\013\010",
    "    else s.batchCoarseTrimApplied=nil end\013\010",
    "    return self:sendSystemsNext(io,now)\013\010",
    "end\013\010",
    "-- Never lower an active vent below the ceiling it held when START SYSTEMS\013\010",
    "-- began (preflight records them). Floors from the takeoff seed or balance\013\010",
    "-- caps must not take lift away from a vessel that is already flying.\013\010",
    "-- Summary: Retain observed bulk-vent targets while constructing a probe-stage recovery map.\010",
    "local function retainActiveBulk(maps,retained)\013\010",
    "    if type(maps)~=\"table\" or type(retained)~=\"table\" then return maps end\013\010",
    "    for q,entries in pairs(retained) do\013\010",
    "        for name,amount in pairs(entries) do\013\010",
    "            if type(maps[q])==\"table\" and finite(maps[q][name]) and finite(amount) and amount>maps[q][name] then\013\010",
    "                maps[q][name]=amount\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return maps\013\010",
    "end\013\010",
    "-- Current balloon lift carrying at least 90% of the weight means the ship is\013\010",
    "-- flying (or effectively floating): there is nothing to take off or build.\013\010",
    "-- Summary: Current balloon lift carrying at least 90% of the weight means the ship is flying (or effectively floating): there is nothing to take off or build.\010",
    "function Flight:systemsAirborneAtStart(io)\013\010",
    "    local v=io.vessel or {}\013\010",
    "    local pressure=airPressure(v)\013\010",
    "    if not pressure or not finite(v.mass) or v.mass<=0 then return false end\013\010",
    "    local sum=0\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local balloon=io.nodes and io.nodes[q] and io.nodes[q].balloon\013\010",
    "        if type(balloon)~=\"table\" or balloon.liftValid~=true or not finite(balloon.lift) then return false end\013\010",
    "        sum=sum+balloon.lift\013\010",
    "    end\013\010",
    "    local ratio=sum*pressure/v.mass\013\010",
    "    return ratio>=0.9,ratio\013\010",
    "end\013\010",
    "-- Airborne START SYSTEMS adopts the exact ceilings the chambers hold now,\013\010",
    "-- like a core restart restore: probe, re-arm control at those same maps,\013\010",
    "-- then normal READY/HOLD control toward the selected altitude. No takeoff\013\010",
    "-- seed, launch settle or lift build is run.\013\010",
    "-- Summary: Adopt verified existing lift into an airborne altitude-control run.\010",
    "function Flight:startSystemsAirborne(io,now,prepared)\013\010",
    "    local v=io.vessel\013\010",
    "    local maps={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        maps[q]={}\013\010",
    "        for name,provider in pairs(io.nodes[q].providers or {}) do\013\010",
    "            local amount=provider.targetAmount\013\010",
    "            local limit=prepared.limits[q] and prepared.limits[q][name]\013\010",
    "            if not limit or not finite(amount) then return false,q..\" EXISTING GAS TARGET UNAVAILABLE\" end\013\010",
    "            if amount<limit.minimum then\013\010",
    "                if provider.controlRole==\"fine\" and provider.signalStrength==0 then amount=0\013\010",
    "                else return false,q..\" EXISTING GAS TARGET BELOW CONTROL FLOOR\" end\013\010",
    "            end\013\010",

    "    local h=fs.open(path,\"r\");if not h then return nil end\013\010",
    "    local raw=h.readAll();h.close();return textutils.unserializeJSON(raw)\013\010",
    "end\013\010",
    "local function age(n)return finite(n)and string.format(\"%.1fs\",math.max(0,n))or\"--\"end\013\010",
    "-- Section: Remote panel | Paired cached views, command review and input navigation.\010",
    "-- Summary: Wrap display text to the available character width.\010",
    "local function wrap(text,width)\013\010",
    "    text=clean(text);local out={}\013\010",
    "    while #text>width do\013\010",
    "        local at=text:sub(1,width+1):match(\"^.*() \")\013\010",
    "        if not at or at<width/2 then at=width+1 end\013\010",
    "        out[#out+1]=text:sub(1,at-1);text=text:sub(at):gsub(\"^ +\",\"\")\013\010",
    "    end\013\010",
    "    out[#out+1]=text;return out\013\010",
    "end\013\010",
    "function App.new(cfg)\013\010",
    "    assert(type(cfg)==\"table\"and cfg.schemaVersion==1 and type(cfg.coreID)==\"number\"and\013\010",
    "        type(cfg.token)==\"string\"and type(cfg.pairID)==\"string\"and cfg.protocol==\"amaryllis.remote.v1\",\"Invalid remote pairing\")\013\010",
    "    local form={name=\"Remote CMD\",cruiseSpeed=3}\013\010",
    "    return setmetatable({cfg=cfg,page=\"home\",focus={},offsets={},cache={},nav={},form=form,sequence=0,\013\010",
    "        online=false,notice=\"Connecting...\",links={},releaseAnchor=false},App)\013\010",
    "end\013\010",
    "-- Summary: Discover and open the paired remote's network interfaces.\010",
    "function App:modems()\013\010",
    "    local found=false\013\010",
    "    for _,name in ipairs(peripheral.getNames())do if peripheral.hasType(name,\"modem\")then\013\010",
    "        local m=peripheral.wrap(name);local ok,wireless=pcall(m.isWireless)\013\010",
    "        if ok and wireless then rednet.open(name);found=true end\013\010",
    "    end end\013\010",
    "    return found\013\010",
    "end\013\010",
    "-- Summary: Send a correlated authenticated packet to the paired core.\010",
    "function App:send(action,extra)\013\010",
    "    if self.pending then return false end\013\010",
    "    if (action==\"status\"or action==\"ap_status\")and self.readAfter and os.clock()<self.readAfter then\013\010",
    "        self:deferRead(self.readAfter-os.clock());return false\013\010",
    "    end\013\010",
    "    if self.readTimer then os.cancelTimer(self.readTimer);self.readTimer=nil end\013\010",
    "    if not self:modems()then self.online=false;self.notice=\"Attach wireless modem\";return false end\013\010",
    "    self.sequence=self.sequence+1\013\010",
    "    local id=os.getComputerID()..\":\"..os.epoch(\"utc\")..\":\"..self.sequence\013\010",
    "    local p={v=1,pairID=self.cfg.pairID,token=self.cfg.token,requestID=id,sentAt=os.epoch(\"utc\"),boot=self.boot,action=action}\013\010",
    "    for k,v in pairs(extra or {})do p[k]=v end\013\010",
    "    rednet.send(self.cfg.coreID,p,self.cfg.protocol)\013\010",
    "    self.pending={id=id,action=action,page=p.page,at=os.clock()};self.timeout=os.startTimer(5)\013\010",
    "    return true\013\010",
    "end\013\010",
    "function App:statusPage()\013\010",
    "    local pages={home=\"OVERVIEW\",overview=\"OVERVIEW\",lift=\"LIFT\",propulsion=\"PROPULSION\",navigation=\"NAVIGATION\",\013\010",
    "        computers=\"FLEET\",computer=\"FLEET\",errors=\"FLEET\",details=\"FLEET\",related=\"FLEET\",logs=\"LOGS\"}\013\010",
    "    return pages[self.page]\013\010",
    "end\013\010",
    "function App:deferRead(delay)\013\010",
    "    if not self.readTimer then self.readTimer=os.startTimer(math.max(.05,delay or .3))end\013\010",
    "end\013\010",
    "-- Summary: Request the active cached status view at the allowed read cadence.\010",
    "function App:poll()\013\010",
    "    if self.pending then return end\013\010",
    "    if not self.boot then self:send(\"hello\")\013\010",
    "    elseif self.command then self:send(\"ap_result\",{commandID=self.command.id})\013\010",
    "    elseif self.page==\"ap\"or self.page==\"destination\"or self.page==\"review\"or self.page==\"route\"then self:send(\"ap_status\")\013\010",
    "    else\013\010",
    "        -- Presentation reads cached publications. Ship work keeps its existing priority.\013\010",
    "        local page=self:statusPage()\013\010",
    "        if page then self:send(\"status\",{page=page})\013\010",
    "        elseif not self.lastReply or os.clock()-self.lastReply>=2 then self:send(\"status\",{page=\"OVERVIEW\"})end\013\010",
    "    end\013\010",
    "end\013\010",
    "function App:choose(page)\013\010",
    "    self.page=page;self.links={}\013\010",
    "    local target=self:statusPage()\013\010",
    "    -- Navigation is local; related views share the same cached fleet reply.\013\010",
    "    if not self.boot or not self.command and(target and not self.cache[target] or\013\010",
    "        (page==\"ap\"or page==\"route\"or page==\"destination\")and not self.navAt)then self:poll()end\013\010",
    "end\013\010",
    "function App:back()\013\010",
    "    if self.editor then self.editor=nil;return end\013\010",
    "    if self.page==\"review\"then self.review=nil;self.notice=\"Review cancelled\"end\013\010",
    "    local parents={overview=\"status\",lift=\"status\",propulsion=\"status\",navigation=\"status\",computer=\"computers\",\013\010",
    "        errors=\"computer\",details=\"computer\",related=\"computer\",destination=\"ap\",review=\"ap\",route=\"ap\",connection=\"tools\"}\013\010",
    "    self:choose(parents[self.page]or\"home\")\013\010",
    "end\013\010",
    "-- Summary: Validate entered destination fields and open the command review.\010",
    "function App:startReview(cancel)\013\010",
    "    if self.command or self.pending then self.notice=\"Wait for current request\";return end\013\010",
    "    local n=self.nav\013\010",
    "    if not self.online or not self.boot or not n.session or not self.navAt or os.clock()-self.navAt>6 then self.notice=\"Connect to core first\";return end\013\010",
    "    if not n.enabled then self.notice=n.reason or\"Enable remote AP on core\";return end\013\010",
    "    if not n.permitted then self.notice=\"Core must allow this remote\";return end\013\010",
    "    if cancel then\013\010",
    "        if not n.owned then self.notice=\"No route owned by this remote\";return end\013\010",
    "    else\013\010",
    "        if n.active then self.notice=\"Active route cannot be replaced\";return end\013\010",
    "        local f=self.form\013\010",
    "        if not finite(f.x)or not finite(f.z)or math.abs(f.x)>30000000 or math.abs(f.z)>30000000 then self.notice=\"Enter valid destination X/Z\";return end\013\010",
    "        if not finite(f.altitude)or f.altitude< -64 or f.altitude>320 then self.notice=\"Enter altitude (-64 to 320)\";return end\013\010",
    "        if not finite(f.cruiseSpeed)or f.cruiseSpeed<.1 or f.cruiseSpeed>30 then self.notice=\"Enter speed (0.1 to 30)\";return end\013\010",
    "    end\013\010",
    "    self.review={cancel=cancel,session=n.session,generation=n.generation,destination=copy(self.form),releaseAnchor=self.releaseAnchor}\013\010",
    "    self.review.destination.name=\"Remote CMD\"\013\010",
    "    self.focus.review=2;self:choose(\"review\");self.notice=\"Review before confirming\"\013\010",
    "end\013\010",
    "-- Summary: Submit the confirmed remote command and track its result.\010",
    "function App:confirm()\013\010",
    "    local r=self.review\013\010",
    "    if not r or self.pending or self.command then self.notice=\"Wait for current request\";return end\013\010",
    "    if not self.online or self.nav.session~=r.session or self.nav.generation~=r.generation then\013\010",
    "        self.review=nil;self:choose(\"ap\");self.notice=\"Authority changed; review again\";return\013\010",
    "    end\013\010",
    "    self.sequence=self.sequence+1\013\010",
    "    local id=os.getComputerID()..\":\"..os.epoch(\"utc\")..\":\"..self.sequence\013\010",
    "    if self:send(r.cancel and\"ap_cancel\"or\"ap_send\",{commandID=id,coreSession=r.session,generation=r.generation,\013\010",
    "        destination=r.destination,releaseAnchor=r.releaseAnchor})then\013\010",
    "        self.command={id=id,session=r.session};self.review=nil;self.page=\"ap\";self.notice=\"PENDING: core must validate\"\013\010",
    "    end\013\010",
    "end\013\010",
    "function App:computer()\013\010",
    "    local item=self.cache.FLEET\013\010",
    "    for _,c in ipairs(item and item.data.computers or{})do if c.role==self.selected then return c end end\013\010",
    "end\013\010",
    "function App:reportAge(c)\013\010",
    "    local cached=self.cache.FLEET\013\010",
    "    return finite(c.age)and c.age+math.max(0,os.clock()-(cached and cached.at or os.clock()))or nil\013\010",
    "end\013\010",
    "-- Summary: Handle the selected remote page entry or operation.\010",
    "function App:activate(action)\013\010",
    "    if action:sub(1,3)==\"go:\"then self:choose(action:sub(4))\013\010",
    "    elseif action:sub(1,9)==\"computer:\"then self.selected=action:sub(10);self:choose(\"computer\")\013\010",
    "    elseif action:sub(1,5)==\"edit:\"then\013\010",
    "        if self.command then self.notice=\"Wait for command result\";return end\013\010",
    "        local k=action:sub(6);self.editor={key=k,buffer=self.form[k]and tostring(self.form[k])or\"\"}\013\010",
    "    elseif action==\"back\"then self:back()\013\010",
    "    elseif action==\"review\"then self:startReview(false)\013\010",
    "    elseif action==\"cancel-route\"then self:startReview(true)\013\010",
    "    elseif action==\"confirm\"then self:confirm()\013\010",
    "    elseif action==\"anchor\"then if not self.command then self.releaseAnchor=not self.releaseAnchor end\013\010",
    "    elseif action==\"refresh\"then self:poll()\013\010",
    "    elseif action==\"reconnect\"then\013\010",
    "        if self.pending then os.cancelTimer(self.timeout)end\013\010",
    "        self.pending=nil;self.boot=nil;self.online=false;self.review=nil;self.notice=\"Reconnecting...\";self:poll()\013\010",
    "    elseif action==\"admin\"and fs.exists(\"/admin.lua\")then\013\010",
    "        shell.run(\"/admin.lua\")\013\010",
    "        if self.pending then os.cancelTimer(self.timeout)end\013\010",
    "        self.pending=nil;self.boot=nil;self.online=false;self:poll()\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Render the current remote page from cached core replies.\010",
    "function App:draw()\013\010",
    "    local w,h=term.getSize();self.links={}\013\010",
    "    term.setBackgroundColor(GRAY);term.setTextColor(WHITE);term.clear();term.setCursorBlink(false)\013\010",
    "    local function put(x,y,s,width,fg,bg)\013\010",
    "        if y<1 or y>h or x>w then return end\013\010",
    "        width=math.max(0,math.min(width or w-x+1,w-x+1))\013\010",
    "        term.setCursorPos(x,y);term.setTextColor(fg or WHITE);term.setBackgroundColor(bg or GRAY)\013\010",
    "        term.write((clean(s)..string.rep(\" \",width)):sub(1,width))\013\010",
    "    end\013\010",
    "    local function button(y,label,action)\013\010",
    "        if h==19 and y==16 then y=15 end\013\010",
    "        if y>h-4 or y<4 then return end\013\010",
    "        self.links[#self.links+1]={x=2,y=y,w=w-2,label=label,action=action}\013\010",
    "    end\013\010",
    "    local titles={home=\"HOME\",status=\"STATUS\",overview=\"OVERVIEW\",lift=\"LIFT\",propulsion=\"PROPULSION\",navigation=\"NAVIGATION\",\013\010",
    "        computers=\"COMPUTERS\",computer=\"COMPUTER\",errors=\"ERRORS\",details=\"DETAILS\",related=\"RELATED LOGS\",logs=\"LOGS\",\013\010",
    "        ap=\"AUTOPILOT\",route=\"ROUTE PROGRESS\",destination=\"DESTINATION\",review=\"REVIEW\",tools=\"TOOLS\",connection=\"CONNECTION\"}\013\010",
    "    put(1,1,\"AMARYLLIS / REMOTE\",w,WHITE,BLACK)\013\010",
    "    local reachable=self.lastReply and os.clock()>=self.lastReply and os.clock()-self.lastReply<=10\013\010",
    "    put(2,2,reachable and (\"CONNECTED #\"..self.cfg.coreID) or \"CORE UNREACHABLE\",w-2,reachable and WHITE or YELLOW)\013\010",
    "    if self.page~=\"home\"then put(2,3,\"< Back\",7,BLACK,LIGHT)end\013\010",
    "    put(self.page==\"home\"and 2 or 10,3,titles[self.page]or\"REMOTE\",w-(self.page==\"home\"and 2 or 10))\013\010",
    "    -- Summary: Render the visible entries for the current selection and scroll position.\010",
    "    local function list(rows,first,last,key)\013\010",
    "        first=first or 5;last=last or h-5;key=key or self.page\013\010",
    "        local rendered={}\013\010",
    "        for _,line in ipairs(rows)do for _,part in ipairs(wrap(line,w-3))do rendered[#rendered+1]=part end end\013\010",
    "        local cap=math.max(1,last-first+1);local offset=math.max(0,math.min(math.max(0,#rendered-cap),self.offsets[key]or 0))\013\010",
    "        self.offsets[key]=offset\013\010",
    "        for i=1,cap do put(2,first+i-1,rendered[offset+i]or\"\",w-2)end\013\010",
    "        if #rendered>cap then put(w-9,4,(offset+1)..\"/\"..#rendered,8,LIGHT)end\013\010",
    "    end\013\010",
    "    -- Summary: Resolve the cached status page and its source age.\010",
    "    local function cached(page)\013\010",
    "        local entry=self.cache[page]\013\010",
    "        if not entry then return{\"Waiting for core...\"}end\013\010",
    "        local rows={}\013\010",
    "        if not self.online or os.clock()-entry.at>6 then rows[1]=\"STALE: last reported\"end\013\010",
    "        for _,s in ipairs(entry.data.lines or{})do rows[#rows+1]=s end\013\010",
    "        return rows\013\010",
    "    end\013\010",
    "    if w<26 or h<19 then\013\010",
    "        put(2,5,\"Requires 26 x 19.\",w-2);return\013\010",
    "    elseif self.page==\"home\"then\013\010",
    "        for i,item in ipairs({{\"Status\",\"status\"},{\"Computers\",\"computers\"},{\"Autopilot\",\"ap\"},{\"Logs\",\"logs\"},{\"Tools\",\"tools\"}})do\013\010",
    "            button(4+i*2,item[1]..\" >\", \"go:\"..item[2])\013\010",
    "        end\013\010",
    "    elseif self.page==\"status\"then\013\010",
    "        for i,item in ipairs({{\"Overview\",\"overview\"},{\"Lift\",\"lift\"},{\"Propulsion\",\"propulsion\"},{\"Navigation\",\"navigation\"}})do\013\010",
    "            button(4+i*2,item[1]..\" >\",\"go:\"..item[2])\013\010",
    "        end\013\010",
    "    elseif self.page==\"computers\"then\013\010",
    "        local entry=self.cache.FLEET;local rows=entry and entry.data.computers or{}\013\010",
    "        local selected=self.focus.computers or 1;local cap=h-9\013\010",
    "        local offset=self.offsets.computers or 0\013\010",
    "        if selected<=offset then offset=selected-1 elseif selected>offset+cap then offset=selected-cap end\013\010",
    "        offset=math.max(0,math.min(math.max(0,#rows-cap),offset));self.offsets.computers=offset\013\010",
    "        if #rows==0 then list(cached(\"FLEET\"))end\013\010",
    "        for i=offset+1,math.min(#rows,offset+cap)do\013\010",
    "            local c=rows[i]\013\010",
    "            local state=c.state or\"WAIT\"\013\010",
    "            if not self.online or entry and os.clock()-entry.at>6 then state=\"STALE\"end\013\010",
    "            local label=clean(c.name)..\" #\"..clean(c.id)\013\010",
    "            button(5+i-offset,label:sub(1,w-10)..string.rep(\" \",math.max(1,w-10-#label))..state,\"computer:\"..c.role)\013\010",
    "        end\013\010",
    "        if #rows>cap then put(w-9,4,(offset+1)..\"-\"..math.min(#rows,offset+cap)..\"/\"..#rows,8,LIGHT)end\013\010",
    "        self.totalComputers=#rows\013\010",
    "        self.visibleOffset=offset\013\010",
    "    elseif self.page==\"computer\"then\013\010",
    "        local c=self:computer()\013\010",
    "        if not c then list({\"Waiting for computer report...\"})\013\010",
    "        else\013\010",
    "            local reported=self.online and self.cache.FLEET and os.clock()-self.cache.FLEET.at<=6 and c.state~=\"STALE\" and c.state~=\"WAIT\"\013\010",
    "            put(2,5,clean(c.name)..\" #\"..clean(c.id),w-2)\013\010",
    "            put(2,6,\"State: \"..(reported and clean(c.state)or\"STALE\"),w-2)\013\010",
    "            put(2,7,(reported and\"Program: \"or\"Last prog: \")..(c.running==nil and(c.reporting and\"REPORTING\"or\"--\")or c.running and\"RUNNING\"or\"STOPPED\"),w-2)\013\010",
    "            put(2,8,(reported and\"Hardware: \"or\"Last hw: \")..(c.hardware==nil and\"--\"or c.hardware and\"AVAILABLE\"or\"UNAVAILABLE\"),w-2)\013\010",
    "            put(2,9,\"Report: \"..age(self:reportAge(c))..\" ago\",w-2)\013\010",
    "            put(2,10,\"Reply: \"..(finite(c.reply)and string.format(\"%.0fms\",c.reply*1000)or\"--\"),w-2)\013\010",
    "            button(12,\"Errors (\"..#(c.errors or{})..\") >\",\"go:errors\")\013\010",
    "            button(14,\"More details >\",\"go:details\")\013\010",
    "            button(16,\"Related logs >\",\"go:related\")\013\010",
    "        end\013\010",
    "    elseif self.page==\"errors\"or self.page==\"details\"or self.page==\"related\"then\013\010",
    "        local c=self:computer()\013\010",
    "        local rows=c and(self.page==\"errors\"and c.errors or self.page==\"details\"and c.details or c.logs)or{}\013\010",
    "        if #rows==0 then rows={self.page==\"errors\"and\"No reported errors.\"or\"No related core log events.\"}end\013\010",
    "        list(rows)\013\010",
    "    elseif self.page==\"ap\"then\013\010",
    "        local n=self.nav\013\010",
    "        put(2,5,\"Access: \"..(n.permitted and\"ALLOWED\"or\"NOT ALLOWED\"),w-2)\013\010",
    "        put(2,6,\"Remote AP: \"..(n.enabled and\"ENABLED\"or\"DISABLED\"),w-2)\013\010",
    "        put(2,7,\"State: \"..clean(n.state),w-2)\013\010",
    "        put(2,8,n.owned and\"Your route\"or\"No route owned\",w-2)\013\010",
    "        put(2,9,\"Distance: \"..(finite(n.distance)and string.format(\"%.1f\",n.distance)or\"--\"),w-2)\013\010",
    "        button(11,\"Destination >\",\"go:destination\")\013\010",
    "        button(13,n.active and\"Route progress >\"or\"Review route >\",n.active and\"go:route\"or\"review\");button(15,\"Disengage route >\",\"cancel-route\")\013\010",
    "    elseif self.page==\"route\"then\013\010",
    "        local n=self.nav;local d=n.destination or{}\013\010",
    "        list({\"State: \"..clean(n.state),\"X: \"..clean(d.x),\"Z: \"..clean(d.z),\"Altitude: \"..clean(d.altitude),\013\010",
    "            \"Cruise: \"..clean(d.cruiseSpeed)..\" b/s\",\"Distance: \"..clean(n.distance),\"Speed: \"..clean(n.speed)..\" b/s\",\013\010",
    "            n.owned and\"Your route\"or\"Route owned elsewhere\",n.apReason or n.reason or\"\"})\013\010",
    "    elseif self.page==\"destination\"then\013\010",
    "        for i,item in ipairs({{\"X\",\"x\"},{\"Z\",\"z\"},{\"Altitude\",\"altitude\"},{\"Speed\",\"cruiseSpeed\"}})do\013\010",
    "            button(4+i*2,item[1]..\": \"..clean(self.form[item[2]])..(item[2]==\"cruiseSpeed\"and\" b/s\"or\"\"),\"edit:\"..item[2])\013\010",
    "        end\013\010",
    "        button(14,\"Release anchor: \"..(self.releaseAnchor and\"YES\"or\"NO\"),\"anchor\")\013\010",
    "        button(16,\"Review route >\",\"review\")\013\010",
    "    elseif self.page==\"review\"then\013\010",
    "        local r=self.review\013\010",
    "        if not r then self.page=\"ap\";return self:draw()end\013\010",
    "        list({r.cancel and\"Disengage your route?\"or\"Send Remote CMD?\",\013\010",
    "            \"X \"..clean(r.destination.x)..\" Z \"..clean(r.destination.z),\013\010",
    "            \"Altitude \"..clean(r.destination.altitude),\"Speed \"..clean(r.destination.cruiseSpeed)..\" b/s\",\013\010",
    "            \"Release anchor: \"..(r.releaseAnchor and\"YES\"or\"NO\"),\"Clear route required.\"},5,12)\013\010",
    "        button(14,\"Confirm\",\"confirm\");button(16,\"Cancel\",\"back\")\013\010",
    "    elseif self.page==\"tools\"then\013\010",
    "        button(6,\"Refresh\",\"refresh\");button(8,\"Reconnect\",\"reconnect\");button(10,\"Connection details >\",\"go:connection\")\013\010",
    "        if fs.exists(\"/admin.lua\")then button(12,\"Administration >\",\"admin\")end\013\010",
    "    elseif self.page==\"connection\"then\013\010",
    "        list({\"Core #\"..self.cfg.coreID,\"Link: \"..(reachable and\"CONNECTED\"or\"CORE UNREACHABLE\"),\013\010",
    "            \"Last reply: \"..(self.lastReply and age(os.clock()-self.lastReply)or\"--\"),\013\010",
    "            \"Round trip: \"..(self.roundTrip and string.format(\"%.0fms\",self.roundTrip*1000)or\"--\"),\013\010",
    "            \"Protocol: \"..self.cfg.protocol})\013\010",
    "    else\013\010",
    "        local pages={overview=\"OVERVIEW\",lift=\"LIFT\",propulsion=\"PROPULSION\",navigation=\"NAVIGATION\",logs=\"LOGS\"}\013\010",
    "        list(cached(pages[self.page]or\"OVERVIEW\"))\013\010",
    "    end\013\010",
    "    local focus=math.max(1,math.min(#self.links,self.focus[self.page]or 1))\013\010",
    "    if self.page==\"computers\"then focus=math.max(1,math.min(#self.links,(self.focus.computers or 1)-(self.visibleOffset or 0)))\013\010",
    "    else self.focus[self.page]=focus end\013\010",
    "    for i,link in ipairs(self.links)do put(link.x,link.y,(i==focus and\"> \"or\"  \")..link.label,link.w,i==focus and BLACK or WHITE,i==focus and LIGHT or GRAY)end\013\010",
    "    local message=self.editor and(\"Edit \"..self.editor.key..\": \"..self.editor.buffer)or self.notice\013\010",
    "    local rows=wrap(message or\"\",w-3)\013\010",
    "    local neutral=({Connected=true,[\"Status received\"]=true,[\"Updating status...\"]=true,[\"Ready for destination\"]=true,[\"Destination updated\"]=true,[\"Review cancelled\"]=true})[self.notice]\013\010",
    "    local color=self.online and neutral and LIGHT or YELLOW\013\010",

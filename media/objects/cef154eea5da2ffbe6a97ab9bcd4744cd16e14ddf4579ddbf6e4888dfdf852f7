    "-- An explicit airborne recovery reuses verified retained gas, not the takeoff\013\010",
    "-- seed. Validation is read-only and also supplies the bridge's availability.\013\010",
    "-- Section: Recovery | Physical target reconciliation and retained-run resumption.\010",
    "-- Summary: Record a terminal recovery guard result while retaining applied lift intent.\010",
    "function Flight:abortRecoveryState(io,now)\013\010",
    "    if self.systemsRun or self.shutdownJob or self.stopReview or self.emergencyLiftLatched or\013\010",
    "        self.tuningRun or self.startupPending or self.maintenanceJob or\013\010",
    "        (self.restart and (self.restart.job or self.restart.saved)) then\013\010",
    "        return nil,\"FINISH CURRENT SYSTEMS OPERATION FIRST\"\013\010",
    "    end\013\010",
    "    if not self.systemsLastOutcome or self.systemsLastOutcome.phase~=\"ABORTED\" or\013\010",
    "        type(self.systemsRetainedRun)~=\"table\" then return nil,\"NO RETAINED ABORT TO RECOVER\" end\013\010",
    "    local s=clone(self.systemsRetainedRun)\013\010",
    "    if s.phase~=\"READY\" and s.phase~=\"MAIN_LIFT\" then return nil,\"NO RETAINED AIRBORNE CONTROL STATE\" end\013\010",
    "    local assembled,why=Flight.assemblyGate(io,now)\013\010",
    "    if not assembled then return nil,why or \"VESSEL ASSEMBLY UNAVAILABLE\" end\013\010",
    "    if type(io.routeAllowed)==\"function\" then\013\010",
    "        local allowed,reason=io:routeAllowed();if not allowed then return nil,reason end\013\010",
    "    elseif io.identityReady==false then return nil,\"CORE IDENTITY UNVERIFIED\" end\013\010",
    "    -- Validate a restarted chamber using the same trusted Hello, vessel and\013\010",
    "    -- exact provider signature checks as live telemetry recovery. Only the\013\010",
    "    -- cloned candidate is rebound; availability checks never change authority.\013\010",
    "    local trustedRebinds={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        if node and node.boot~=s.boots[q] then\013\010",
    "            local state,bootReason=TelemetryRecovery.nodeBootState(io,s,q,now,self)\013\010",
    "            if state~=\"trusted\" then return nil,q..\" \"..tostring(bootReason or \"LIFT BOOT CHANGE NOT TRUSTED\") end\013\010",
    "            trustedRebinds[q]=true\013\010",
    "            s.boots[q]=node.boot\013\010",
    "            s.bindingGenerations=s.bindingGenerations or {}\013\010",
    "            s.bindingGenerations[q]=node.bindingGeneration\013\010",
    "            s.acceptedBootGenerations=s.acceptedBootGenerations or {}\013\010",
    "            s.acceptedBootGenerations[q]=node.acceptedBootGeneration\013\010",
    "        end\013\010",
    "    end\013\010",
    "    -- Normal flight guards remain in force, including current speed limits.\013\010",
    "    -- A historical abort can be cleared only after its blocking cause clears.\013\010",
    "    s.phase=\"READY\"\013\010",
    "    local valid,reason=self:systemsGuard(io,now,s,true,true)\013\010",
    "    if not valid then return nil,reason end\013\010",

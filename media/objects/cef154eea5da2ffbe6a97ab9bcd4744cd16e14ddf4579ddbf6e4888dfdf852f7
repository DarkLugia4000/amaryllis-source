    "    snapshot.trimControl=trimControl\013\010",
    "    snapshot.maintenance=self.maintenanceSnapshot\013\010",
    "    snapshot.tuning=self.tuningSnapshot\013\010",
    "    snapshot.emergencyLift=self:emergencyLiftState()\013\010",
    "    local balanced=self.balancedLift or {phase=\"UNAVAILABLE\",targetSupportKnown=false,\013\010",
    "        reason=\"BALANCED LIFT CAPACITY NOT SAMPLED\"}\013\010",
    "    snapshot.balancedLift={phase=balanced.phase,reason=balanced.reason,\013\010",
    "        limitingQuadrant=balanced.limitingQuadrant,\013\010",
    "        rawPerQuadrantMaximum=balanced.rawPerQuadrantMaximum,rawVesselMaximum=balanced.rawVesselMaximum,\013\010",
    "        currentSupportRatio=balanced.currentSupportRatio,actualSupportRatio=balanced.actualSupportRatio,\013\010",
    "        targetSupportRatio=balanced.targetSupportRatio,targetSupportKnown=balanced.targetSupportKnown==true,\013\010",
    "        targetUnreachable=balanced.targetUnreachable==true,capApplied=balanced.capApplied==true,\013\010",
    "        demandLimited=balanced.demandLimited==true}\013\010",
    "    if self.controls then self.controls:decorate(snapshot) end\013\010",
    "    -- Mode selectors publish pilot intent; automatic controllers publish their\013\010",
    "    -- temporary operating modes separately for instruments and status checks.\013\010",
    "    snapshot.effectiveModes=clone(snapshot.modes or {})\013\010",

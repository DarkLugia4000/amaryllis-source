    "-- Summary: Check requested chamber targets against the balanced capacity model.\010",
    "function Flight:balancedTargetsFit(io,maps,now,targetY)\013\010",
    "    local model,reason=self:balancedLiftModel(io,targetY,now)\013\010",
    "    if model.phase==\"UNAVAILABLE\" or model.phase==\"INFEASIBLE\" then\013\010",
    "        return false,reason or model.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local capped,capReason=self:capBalancedTargets(io,maps,model)\013\010",
    "    if not capped then return false,capReason or \"BALANCED LIFT CAPACITY LIMIT UNAVAILABLE\" end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,value in pairs(maps[q] or {}) do\013\010",
    "            if capped[q][name]~=value then\013\010",
    "                return false,q..\" LIFT CAP LIMIT: TUNING CEILING WOULD EXCEED BALANCED MAXIMUM\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return true,nil,model\013\010",
    "end\013\010",

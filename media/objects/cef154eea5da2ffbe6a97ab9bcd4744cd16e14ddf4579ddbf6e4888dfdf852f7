    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Recognize target maps at the configured provider floors and fine-provider state.\010",
    "function Flight:isFloorOnlyTargets(io,maps,parkFine,preserveExistingFine,allowTrimBaseline)\013\010",
    "    if type(maps)~=\"table\" then return false end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local targets=maps[q]\013\010",
    "        if type(node)~=\"table\" or type(targets)~=\"table\" then return false end\013\010",
    "        for name,provider in pairs(node.providers or {}) do\013\010",
    "            local value=targets[name]\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                if value~=(provider.minimumNonzeroTarget or 50) then return false end\013\010",
    "            elseif provider.controlRole==\"fine\" then\013\010",
    "                local wanted=parkFine and 0 or (preserveExistingFine and provider.targetAmount or\013\010",
    "                    (provider.minimumNonzeroTarget or 5))\013\010",
    "                local neutralTrimBaseline\013\010",
    "                if allowTrimBaseline then\013\010",
    "                    local floor=math.max(5,provider.minimumNonzeroTarget or 5)\013\010",
    "                    local authority=finite(self.config.max_trim_ceiling_change) and\013\010",
    "                        math.max(0,self.config.max_trim_ceiling_change) or 25\013\010",
    "                    neutralTrimBaseline=math.min(provider.maxTarget,math.ceil(floor+authority))\013\010",
    "                end\013\010",
    "                if value~=wanted and not (parkFine and neutralTrimBaseline and value==neutralTrimBaseline) then\013\010",
    "                    return false\013\010",
    "                end\013\010",
    "            else return false end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "local function freshAt(now,at,limit)\013\010",
    "    return finite(at) and now>=at and now-at<=limit\013\010",
    "end\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Resolve and validate the selected startup altitude.\010",
    "function Flight:systemsTarget(io)\013\010",
    "    local c=self.config\013\010",
    "    local minimum,maximum=c and c.minimum_world_y,c and c.altitude_ceiling\013\010",
    "    if not finite(minimum) or not finite(maximum) or minimum>=maximum then return nil,\"ALTITUDE LIMITS INVALID\" end\013\010",
    "    local selected=self.controls and self.controls.targets and self.controls.targets.altitude\013\010",
    "    if finite(selected) and selected>=minimum and selected<=maximum then return selected,\"SELECTED ALTITUDE\" end\013\010",
    "    return minimum,\"MINIMUM ALTITUDE FALLBACK\"\013\010",
    "end\013\010",
    "-- Summary: Collect verified vessel, cockpit, provider and chamber identity for a systems run.\010",
    "function Flight:systemsPreflight(io,now)\013\010",
    "    if not self.config or not self.outer or not self.inner then return nil,\"SYSTEMS FLIGHT CONTROL CONFIGURATION UNAVAILABLE\" end\013\010",
    "    local c=self.config\013\010",
    "    if self.tuningRun or self.tuningReview then return nil,\"PID TUNING IN PROGRESS\" end\013\010",
    "    if self.maintenanceJob then return nil,\"LIFT MAINTENANCE IN PROGRESS\" end\013\010",
    "    if self.startupPending then return nil,\"VENT STARTUP ALREADY PENDING\" end\013\010",
    "    if self.enabled then return nil,\"ALTITUDE CONTROL ALREADY ENGAGED\" end\013\010",
    "    if io.anchor==\"ANCHORED\" or io.anchor==\"BRAKING\" then return nil,\"ANCHOR SUPPRESSES START SYSTEMS\" end\013\010",
    "    local stale=io.config.network.sensor_stale_seconds\013\010",
    "    local v=io.vessel\013\010",
    "    if not v or v.valid~=true or type(v.uuid)~=\"string\" or v.uuid==\"\" or\013\010",
    "        not freshAt(now,v.at,stale) or not finite(v.altitude) or not finite(v.verticalSpeed) then\013\010",
    "        return nil,\"VESSEL ALTITUDE / VERTICAL SPEED UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local gravity=v.environment and v.environment.gravity\013\010",
    "    if not finite(v.mass) or v.mass<=0 or not gravity or not finite(gravity.y) or gravity.y>=0 then\013\010",
    "        return nil,\"VESSEL MASS / GRAVITY UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    if not airPressure(v) then return nil,\"VESSEL AIR PRESSURE UNAVAILABLE\" end\013\010",
    "    local inputs=io.inputs\013\010",
    "    local inputFresh,inputReason\013\010",
    "    if self.controls then inputFresh,inputReason=self.controls:usable(io,now)\013\010",
    "    else\013\010",
    "        inputFresh=inputs and inputs.valid==true and freshAt(now,inputs.at,stale) and type(inputs.raw)==\"table\"\013\010",
    "        inputReason=\"COCKPIT INPUTS STALE\"\013\010",
    "    end\013\010",
    "    if not inputFresh then return nil,inputReason or \"COCKPIT INPUTS STALE\" end\013\010",
    "    if type(io.sendSystemsCommand)~=\"function\" or type(io.sendSystemsStop)~=\"function\" then\013\010",
    "        return nil,\"SYSTEMS COMMAND INTERFACE UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local target,targetReason=self:systemsTarget(io)\013\010",
    "    if not target then return nil,targetReason end\013\010",
    "    local maps,controlTargets,boots,roles,limits={},{},{},{},{}\013\010",
    "    local retainedBulk={}\013\010",
    "    local bindingFingerprints,bindingGenerations,acceptedBootGenerations,nodeIDs={},{},{},{}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q]\013\010",
    "        if not n or not io:nodeFresh(q,now) or type(n.boot)~=\"string\" or n.boot==\"\" then\013\010",
    "            return nil,\"WAITING FOR LIFT NODE \"..q\013\010",
    "        end\013\010",
    "        if n.systemsStartReady~=true then\013\010",
    "            return nil,q..\" SYSTEMS RECEIVER UNAVAILABLE\"\013\010",
    "        end\013\010",
    "        if n.armed==true or n.operationBusy==true then return nil,q..\" LIFT CONTROLLER ALREADY OPERATING\" end\013\010",
    "        if type(n.providers)~=\"table\" then return nil,q..\" PROVIDER INTERFACES UNAVAILABLE\" end\013\010",
    "        local bulk,fine=0,0;maps[q]={};controlTargets[q]={};roles[q]={};limits[q]={};boots[q]=n.boot\013\010",
    "        nodeIDs[q]=n.id\013\010",
    "        if n.bindingFingerprintValid==true and boundedBindingFingerprint(n.bindingFingerprint) then\013\010",
    "            bindingFingerprints[q]=n.bindingFingerprint\013\010",
    "        end\013\010",
    "        if finite(n.bindingGeneration) and n.bindingGeneration%1==0 and\013\010",
    "            n.bindingGeneration>=0 and n.bindingGeneration<=2147483647 then\013\010",
    "            bindingGenerations[q]=n.bindingGeneration\013\010",
    "        end\013\010",
    "        if finite(n.acceptedBootGeneration) and n.acceptedBootGeneration%1==0 and\013\010",
    "            n.acceptedBootGeneration>=1 and n.acceptedBootGeneration<=2147483647 then\013\010",
    "            acceptedBootGenerations[q]=n.acceptedBootGeneration\013\010",
    "        end\013\010",
    "        for name,p in pairs(n.providers) do\013\010",
    "            if not p.present or not p.writable or p.targetValid~=true or not finite(p.targetAmount) or\013\010",
    "                p.signalValid~=true or not finite(p.signalStrength) or not finite(p.maxTarget) then\013\010",
    "                return nil,q..\" START SYSTEMS PROVIDER INTERFACE INVALID\"\013\010",
    "            end\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                bulk=bulk+1\013\010",
    "                local floor=p.minimumNonzeroTarget or 50\013\010",
    "                if not finite(floor) or floor<1 or p.maxTarget<floor then return nil,q..\" VENT CEILING BOUNDS INVALID\" end\013\010",
    "                if p.targetAmount<0 or p.targetAmount>p.maxTarget then return nil,q..\" VENT CEILING READBACK INVALID\" end\013\010",
    "                if p.signalStrength>0 and p.targetAmount<floor then\013\010",
    "                    return nil,q..\" ACTIVE VENT CEILING INVALID\"\013\010",
    "                end\013\010",
    "                maps[q][name]=p.targetAmount\013\010",
    "                -- Inactive vents enter the control lease at the known minimum.\013\010",
    "                -- An active vent keeps its current ceiling: START SYSTEMS at\013\010",
    "                -- altitude must take over the existing lift, never drop it.\013\010",
    "                -- Only STOP SYSTEMS (or explicit control) lowers it.\013\010",
    "                if p.signalStrength>0 and p.targetAmount>floor then\013\010",
    "                    controlTargets[q][name]=p.targetAmount\013\010",
    "                    retainedBulk[q]=retainedBulk[q] or {}\013\010",
    "                    retainedBulk[q][name]=p.targetAmount\013\010",
    "                else\013\010",
    "                    controlTargets[q][name]=floor\013\010",
    "                end\013\010",
    "                roles[q][name]=\"bulk\";limits[q][name]={minimum=floor,maximum=p.maxTarget}\013\010",
    "            elseif p.controlRole==\"fine\" then\013\010",
    "                fine=fine+1\013\010",
    "                local floor=math.max(5,p.minimumNonzeroTarget or 5)\013\010",
    "                if p.targetAmount<0 or p.targetAmount>p.maxTarget then return nil,q..\" PROBE CEILING READBACK INVALID\" end\013\010",
    "                local value=p.signalStrength==0 and floor or math.max(p.targetAmount,floor)\013\010",
    "                if p.signalStrength>0 and p.targetAmount<floor then return nil,q..\" ACTIVE PROBE CEILING INVALID\" end\013\010",
    "                if p.maxTarget<floor or value>p.maxTarget then return nil,q..\" PROBE CEILING BOUNDS INVALID\" end\013\010",
    "                maps[q][name]=math.ceil(value)\013\010",
    "                -- Keep the trim burner on a low, symmetric baseline during\013\010",
    "                -- acquisition. Starting exactly at its floor leaves no room\013\010",
    "                -- for negative pitch/roll corrections. The existing trim cap\013\010",
    "                -- remains the authority limit in both directions.\013\010",
    "                local trimAuthority=finite(c.max_trim_ceiling_change) and\013\010",
    "                    math.max(0,c.max_trim_ceiling_change) or 25\013\010",
    "                controlTargets[q][name]=math.min(p.maxTarget,math.ceil(floor+trimAuthority))\013\010",
    "                roles[q][name]=\"fine\";limits[q][name]={minimum=floor,maximum=p.maxTarget}\013\010",
    "            else return nil,q..\" PROVIDER ROLE UNVERIFIED\" end\013\010",
    "        end\013\010",
    "        if bulk~=steamCount(n) or fine~=1 then return nil,q..\" EXPECTED CONFIGURED BULK VENTS AND ONE PROBE\" end\013\010",
    "    end\013\010",
    "    return {probeTargets=maps,controlTargets=controlTargets,retainedBulk=retainedBulk,boots=boots,roles=roles,limits=limits,target=target,targetReason=targetReason,\013\010",
    "        uuid=v.uuid,fingerprint=io.hardwareFingerprint,bindingFingerprints=bindingFingerprints,\013\010",
    "        bindingGenerations=bindingGenerations,acceptedBootGenerations=acceptedBootGenerations,\013\010",
    "        nodeIDs=nodeIDs,coreSession=io.session,coreID=io.localID}\013\010",
    "end\013\010",
    "-- Summary: Revalidate the active run's observations, identities and configured provider boundaries.\010",
    "function Flight:systemsGuard(io,now,s,allowInactiveLease,skipTargetMatch)\013\010",
    "    if io.anchor==\"ANCHORED\" or io.anchor==\"BRAKING\" then return false,\"ANCHOR ENGAGED\" end\013\010",
    "    local stale=io.config.network.sensor_stale_seconds\013\010",
    "    local v=io.vessel\013\010",
    "    local vesselState,vesselReason=TelemetryRecovery.vesselState(io,s,now)\013\010",
    "    if vesselState~=\"trusted\" then return false,vesselReason end\013\010",
    "    -- Elapsed acquisition time is diagnostic, not a reason to revoke airborne\013\010",
    "    -- control. Keep the same targets, PID history and leveling authority.\013\010",
    "    s.acquisitionOverdue=s.phase~=\"READY\" and finite(s.startedAt) and\013\010",
    "        finite(s.acquisitionTimeout) and now-s.startedAt>s.acquisitionTimeout or false\013\010",
    "    -- Startup gets its own nominal command speed and hard transient limit.\013\010",
    "    -- Ordinary hover keeps the existing flight limit. A legacy config without\013\010",
    "    -- the startup fields retains the old max+1 guard.\013\010",
    "    local speedLimit=(self.config.max_vertical_speed or 1)+1\013\010",
    "    local speedFault=v.verticalSpeed>speedLimit or\013\010",
    "        (s.phase==\"READY\" and v.verticalSpeed< -speedLimit)\013\010",
    "    if s.phase==\"MAIN_LIFT\" then\013\010",
    "        speedLimit=systemsStartupSpeedLimit(self.config)\013\010",
    "        speedFault=math.abs(v.verticalSpeed)>speedLimit\013\010",
    "    end\013\010",
    "    if speedFault then\013\010",
    "        return false,\"VERTICAL SPEED LIMIT EXCEEDED\",{\013\010",
    "            target=s.target,actualWorldY=v.altitude,verticalSpeed=v.verticalSpeed,\013\010",
    "            verticalSpeedLimit=speedLimit}\013\010",
    "    end\013\010",
    "    local gravity=v.environment and v.environment.gravity\013\010",
    "    if not finite(v.mass) or not gravity or not finite(gravity.y) then\013\010",
    "        return false,\"VESSEL MASS / GRAVITY UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    if v.mass<=0 or gravity.y>=0 then return false,\"VESSEL MASS / GRAVITY INVALID\" end\013\010",
    "    local pressure=v.environment and v.environment.airPressure\013\010",
    "    if not finite(pressure) then return false,\"VESSEL AIR PRESSURE UNAVAILABLE\" end\013\010",
    "    if pressure<=0 then return false,\"VESSEL AIR PRESSURE INVALID\" end\013\010",
    "    if io.hardwareFingerprint~=s.fingerprint then return false,\"CORE SENSOR BINDINGS CHANGED\" end\013\010",
    "    local inputs=io.inputs\013\010",
    "    local good,reason\013\010",
    "    if self.controls then good,reason=self.controls:usable(io,now)\013\010",
    "    else good=inputs and inputs.valid==true and freshAt(now,inputs.at,stale) and type(inputs.raw)==\"table\" end\013\010",
    "    if not good then return false,reason or \"COCKPIT INPUTS STALE\" end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q]\013\010",
    "        if not n or not io:nodeFresh(q,now) then return false,q..\" LIFT TELEMETRY STALE\" end\013\010",
    "        if s.bindingFingerprints and s.bindingFingerprints[q] then\013\010",
    "            if n.bindingFingerprintValid~=true or not boundedBindingFingerprint(n.bindingFingerprint) then\013\010",
    "                return false,q..\" LIFT BINDING DATA UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if n.bindingFingerprint~=s.bindingFingerprints[q] then\013\010",
    "                return false,q..\" LIFT HARDWARE BINDINGS CHANGED\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if n.boot~=s.boots[q] then\013\010",
    "            if not s.telemetryRecovery then return false,q..\" LIFT BOOT CHANGED\" end\013\010",
    "            local state,bootReason=TelemetryRecovery.nodeBootState(io,s,q,now,self)\013\010",
    "            if state==\"wait\" then return false,q..\" \"..tostring(bootReason) end\013\010",
    "            if state~=\"trusted\" then return false,bootReason or q..\" LIFT BOOT CHANGED\" end\013\010",
    "        end\013\010",
    "        local count=0\013\010",
    "        for name,p in pairs(n.providers or {}) do\013\010",
    "            count=count+1\013\010",
    "            local expectedRole=s.providerRoles[q][name]\013\010",
    "            local bound=s.providerLimits[q][name]\013\010",
    "            if not expectedRole or not bound or p.controlRole~=expectedRole then\013\010",
    "                return false,q..\" PROVIDER ALLOWLIST CHANGED\"\013\010",
    "            end\013\010",
    "            if p.presenceValid==false or (p.presenceValid==nil and p.present~=true) then\013\010",
    "                return false,q..\" PROVIDER \"..name..\" PRESENCE READBACK UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if p.present~=true then return false,q..\" PROVIDER \"..name..\" CONFIRMED MISSING OR WRONG TYPE\" end\013\010",
    "            if p.writableValid==false or (p.writableValid==nil and p.writable~=true) then\013\010",
    "                return false,q..\" PROVIDER \"..name..\" WRITE INTERFACE READBACK UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if p.writable~=true then return false,q..\" PROVIDER \"..name..\" CONFIRMED NOT WRITABLE\" end\013\010",
    "            if p.targetValid~=true or not finite(p.targetAmount) then\013\010",
    "                return false,q..\" PROVIDER \"..name..\" CEILING READBACK UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if p.signalValid~=true or not finite(p.signalStrength) then\013\010",
    "                return false,q..\" PROVIDER \"..name..\" ACTIVATION SIGNAL READBACK UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if not finite(p.maxTarget) or\013\010",
    "                (p.minimumNonzeroTarget~=nil and not finite(p.minimumNonzeroTarget)) then\013\010",
    "                return false,q..\" PROVIDER \"..name..\" LIMIT READBACK UNAVAILABLE\"\013\010",
    "            end\013\010",
    "            if p.maxTarget~=bound.maximum or (p.minimumNonzeroTarget or bound.minimum)~=bound.minimum then\013\010",
    "                return false,q..\" PROVIDER ALLOWLIST CHANGED\"\013\010",
    "            end\013\010",
    "            if not skipTargetMatch and not (s.pending and s.pending[q]) then\013\010",
    "                local expectedTargets=s.currentTargets and s.currentTargets[q] or s.probeTargets[q]\013\010",
    "                local expected=expectedTargets and expectedTargets[name]\013\010",
    "                local parkedFine=expected==0 and expectedRole==\"fine\" and p.signalStrength==0 and\013\010",
    "                    p.targetAmount==bound.minimum\013\010",
    "                if expected~=nil and p.targetAmount~=expected and not parkedFine then\013\010",
    "                    return false,q..\" PROVIDER CEILING CHANGED\"\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if count~=steamCount(n)+1 then return false,q..\" PROVIDER ALLOWLIST CHANGED\" end\013\010",
    "    end\013\010",
    "    if (s.phase==\"MAIN_LIFT\" or s.phase==\"READY\") then\013\010",
    "        local live,liveReason=self:systemsEnvelopeReady(io,false,not allowInactiveLease,allowInactiveLease)\013\010",
    "        if not live then return false,liveReason or \"BALLOON / PROVIDER TELEMETRY LOST\" end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- The trim probe burner is the decisive balloon check: when it still sees a balloon, a vent without one points at the boiler.\013\010",
    "-- Only the trim probe burner decides whether a balloon is attached. Vent readings are unreliable, so a vent fault\013\010",
    "-- that the probe does not confirm points at the boiler.\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Word a balloon attachment fault from the trim probe reading and send vent faults to the boiler check.\010",
    "function Flight:ventBalloonIssue(n,q,name)\013\010",
    "    local b=n.balloon\013\010",
    "    local probeName=b and type(b.source)==\"string\" and b.source\013\010",
    "    local probe=probeName and n.providers and n.providers[probeName]\013\010",
    "    local probeKnown=probe and probe.controlRole==\"fine\" and b.hasBalloonValid==true\013\010",
    "    if probeKnown and b.hasBalloon==false then return q..\" PROBE FAIL: CHECK BALLOON INTEGRITY\" end\013\010",
    "    if probeKnown then return q..\" VENT \"..name..\" FAIL; CHECK BOILER\" end\013\010",
    "    local vent=n.providers and n.providers[name]\013\010",
    "    if vent and vent.gasOutputValid~=true then return q..\" VENT \"..name..\" LIFT FAIL; CHECK BOILER\" end\013\010",
    "    return \"CHAMBER \"..q..\" UNCONFIRMED; CHECK PROBE; CHECK BOILER\"\013\010",
    "end\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Check chamber envelope composition and lift observations for startup.\010",
    "function Flight:systemsEnvelopeReady(io,requireProbeReady,requireLiveProviders,allowInactiveLease)\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q]\013\010",
    "        if requireProbeReady~=false and n.systemsProbeReady~=true then return false,q..\" PROBE NOT ACKNOWLEDGED\" end\013\010",
    "        if not n.altitude or n.altitude.valid~=true or not finite(n.altitude.sensorWorldY) then return false,q..\" ALTITUDE DATA UNAVAILABLE\" end\013\010",
    "        local b=n.balloon\013\010",
    "        local source=b and type(b.source)==\"string\" and b.source or \"representative provider\"\013\010",
    "        if not b then return false,q..\" BALLOON STATUS UNAVAILABLE\" end\013\010",
    "        if b.hasBalloonValid~=true then return false,q..\" PROVIDER \"..source..\" BALLOON ATTACHMENT READBACK UNAVAILABLE\" end\013\010",
    "        if b.hasBalloon~=true then return false,self:ventBalloonIssue(n,q,source) end\013\010",
    "        if b.gasMixValid~=true or type(b.gasMix)~=\"table\" then return false,q..\" PROVIDER \"..source..\" BALLOON GAS MIX UNAVAILABLE\" end\013\010",
    "        if b.liftValid~=true or not finite(b.lift) then return false,q..\" PROVIDER \"..source..\" BALLOON LIFT READBACK UNAVAILABLE\" end\013\010",
    "        if b.lift<=0 then return false,q..\" PROVIDER \"..source..\" REPORTS NO POSITIVE BALLOON LIFT\" end\013\010",
    "        local bulk,fine,mixAvailable=0,0,false\013\010",
    "        for _,amount in pairs(b.gasMix) do if finite(amount) and amount>0 then mixAvailable=true;break end end\013\010",
    "        if not mixAvailable then return false,q..\" PROVIDER \"..source..\" BALLOON GAS MIX HAS NO POSITIVE AMOUNT\" end\013\010",
    "        for name,p in pairs(n.providers or {}) do\013\010",
    "            if p.presenceValid==false or (p.presenceValid==nil and p.present~=true) then return false,q..\" PROVIDER \"..name..\" PRESENCE READBACK UNAVAILABLE\" end\013\010",
    "            if not p.present then return false,q..\" PROVIDER \"..name..\" CONFIRMED MISSING OR WRONG TYPE\" end\013\010",
    "            if p.writableValid==false or (p.writableValid==nil and p.writable~=true) then return false,q..\" PROVIDER \"..name..\" WRITE INTERFACE READBACK UNAVAILABLE\" end\013\010",
    "            if not p.writable then return false,q..\" PROVIDER \"..name..\" CONFIRMED NOT WRITABLE\" end\013\010",
    "            if p.targetValid~=true then return false,q..\" PROVIDER \"..name..\" CEILING READBACK UNAVAILABLE\" end\013\010",
    "            if p.signalValid~=true or not finite(p.signalStrength) then return false,q..\" PROVIDER \"..name..\" ACTIVATION SIGNAL READBACK UNAVAILABLE\" end\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                bulk=bulk+1\013\010",
    "                if requireLiveProviders and p.signalStrength~=15 then return false,q..\" PROVIDER \"..name..\" ACTIVATION SIGNAL \"..tostring(p.signalStrength)..\" (EXPECTED 15)\" end\013\010",
    "                if (requireLiveProviders or allowInactiveLease) and p.signalStrength>1 then\013\010",
    "                    if not p.attachedValid then return false,q..\" PROVIDER \"..name..\" BALLOON ATTACHMENT READBACK UNAVAILABLE\" end\013\010",
    "                    if not p.attached then return false,self:ventBalloonIssue(n,q,name) end\013\010",
    "                    if not p.gasTypeValid or type(p.gasType)~=\"string\" then return false,q..\" PROVIDER \"..name..\" GAS TYPE READBACK UNAVAILABLE\" end\013\010",
    "                    if p.gasType~=\"steam\" then return false,q..\" PROVIDER \"..name..\" GAS TYPE \"..p.gasType..\" (EXPECTED steam)\" end\013\010",
    "                    if requireLiveProviders then\013\010",
    "                        if p.signalStrength~=15 then return false,q..\" PROVIDER \"..name..\" ACTIVATION SIGNAL \"..tostring(p.signalStrength)..\" (EXPECTED 15)\" end\013\010",
    "                        if p.activeSupported and not p.activeValid then return false,q..\" PROVIDER \"..name..\" ACTIVITY READBACK UNAVAILABLE\" end\013\010",
    "                        if p.activeSupported and not p.active then return false,q..\" PROVIDER \"..name..\" REPORTS INACTIVE\" end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            elseif p.controlRole==\"fine\" then\013\010",
    "                fine=fine+1\013\010",
    "                local floor=p.minimumNonzeroTarget or 5\013\010",
    "                local parkedFine=requireLiveProviders and p.signalStrength==0 and\013\010",
    "                    (p.targetAmount==0 or p.targetAmount==floor)\013\010",
    "                if p.signalStrength>1 then\013\010",
    "                if not p.attachedValid then return false,q..\" PROVIDER \"..name..\" BALLOON ATTACHMENT READBACK UNAVAILABLE\" end\013\010",
    "                if not p.attached then return false,q..\" PROBE FAIL: CHECK BALLOON INTEGRITY\" end\013\010",
    "                if not p.gasTypeValid or type(p.gasType)~=\"string\" then return false,q..\" PROVIDER \"..name..\" GAS TYPE READBACK UNAVAILABLE\" end\013\010",
    "                end\013\010",
    "                if requireLiveProviders and not parkedFine and p.signalStrength~=15 then return false,q..\" PROVIDER \"..name..\" ACTIVATION SIGNAL \"..tostring(p.signalStrength)..\" (EXPECTED 15)\" end\013\010",
    "                if requireLiveProviders and not parkedFine and p.activeSupported and not p.activeValid then return false,q..\" PROVIDER \"..name..\" ACTIVITY READBACK UNAVAILABLE\" end\013\010",
    "                if requireLiveProviders and not parkedFine and p.activeSupported and not p.active then return false,q..\" PROVIDER \"..name..\" REPORTS INACTIVE\" end\013\010",
    "            else return false,q..\" PROVIDER ROLE UNVERIFIED\" end\013\010",
    "        end\013\010",
    "        if bulk~=steamCount(n) or fine~=1 then return false,q..\" EXPECTED CONFIGURED BULK VENTS AND ONE PROBE\" end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Estimate lift response, vertical acceleration and drag from successive vessel/chamber samples.\010",
    "function Flight:observeSystemsDynamics(io,s,now)\013\010",
    "    local v=io.vessel\013\010",
    "    local pressure=airPressure(v)\013\010",
    "    if not pressure or not finite(v.mass) or v.mass<=0 then return end\013\010",
    "    local totalLift=0\013\010",
    "    local current={at=now,quadrants={},outputsValid=true,efficienciesValid=true,\013\010",
    "        fullEfficiency=true,knownLowEfficiency=false,complete=true}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes[q];local balloon=node and node.balloon or {}\013\010",
    "        local item={}\013\010",
    "        if balloon.liftValid==true and finite(balloon.lift) then\013\010",
    "            item.lift=balloon.lift;totalLift=totalLift+balloon.lift\013\010",
    "        end\013\010",
    "        if balloon.filledVolumeValid==true and balloon.capacityValid==true and\013\010",
    "            finite(balloon.filledVolume) and finite(balloon.capacity) and balloon.capacity>0 and\013\010",
    "            balloon.filledVolume>=0 and balloon.filledVolume<=balloon.capacity then\013\010",
    "            item.filledVolume=balloon.filledVolume;item.capacity=balloon.capacity\013\010",
    "            item.fillFraction=balloon.filledVolume/balloon.capacity\013\010",
    "        end\013\010",
    "        local output,outputCount,efficiency,efficiencyCount=0,0,0,0\013\010",
    "        local minimumEfficiency\013\010",
    "        for _,provider in pairs(node and node.providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                if provider.gasOutputValid==true and finite(provider.gasOutput) and provider.gasOutput>=0 then\013\010",
    "                    output=output+provider.gasOutput;outputCount=outputCount+1\013\010",
    "                end\013\010",
    "                if provider.boilerEfficiencyValid==true and finite(provider.boilerEfficiency) and\013\010",
    "                    provider.boilerEfficiency>=0 then\013\010",
    "                    efficiency=efficiency+provider.boilerEfficiency;efficiencyCount=efficiencyCount+1\013\010",
    "                    minimumEfficiency=minimumEfficiency and math.min(minimumEfficiency,provider.boilerEfficiency) or\013\010",
    "                        provider.boilerEfficiency\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if outputCount==steamCount(node) then item.gasOutput=output else current.outputsValid=false end\013\010",
    "        if efficiencyCount==steamCount(node) then\013\010",
    "            item.boilerEfficiency=efficiency/efficiencyCount\013\010",
    "            item.minimumBoilerEfficiency=minimumEfficiency\013\010",
    "            if minimumEfficiency<SYSTEMS_FULL_BOILER_EFFICIENCY then\013\010",
    "                current.fullEfficiency=false;current.knownLowEfficiency=true\013\010",
    "            end\013\010",
    "        else current.efficienciesValid=false;current.fullEfficiency=false end\013\010",
    "        if not item.filledVolume or not item.lift then current.complete=false end\013\010",
    "        current.quadrants[q]=item\013\010",
    "    end\013\010",
    "    current.actualRatio=totalLift*pressure/v.mass\013\010",
    "    current.verticalSpeed=v.verticalSpeed\013\010",
    "    local previous=s.dynamics\013\010",
    "    local sampleSeconds=(io.config.network and io.config.network.sample_interval_seconds) or 0.5\013\010",
    "    if previous and now>previous.at then\013\010",
    "        local dt=now-previous.at\013\010",
    "        current.sampleSeconds=dt\013\010",
    "        current.liftRate=(current.actualRatio-previous.actualRatio)/dt\013\010",
    "        local liftRateHorizon=finite(s.responseLagSeconds) and\013\010",
    "            math.max(s.responseLagSeconds,sampleSeconds) or sampleSeconds\013\010",
    "        local liftRateAlpha=dt/(liftRateHorizon+dt)\013\010",
    "        local previousLiftRate=finite(previous.projectedLiftRate) and\013\010",
    "            previous.projectedLiftRate or current.liftRate\013\010",
    "        current.projectedLiftRate=previousLiftRate+liftRateAlpha*(current.liftRate-previousLiftRate)\013\010",
    "        local measuredAcceleration=(v.verticalSpeed-previous.verticalSpeed)/dt\013\010",
    "        current.verticalAccelerationRaw=measuredAcceleration\013\010",
    "        local priorAcceleration=finite(previous.verticalAcceleration) and previous.verticalAcceleration or measuredAcceleration\013\010",
    "        local accelerationFilterSeconds=math.max(2,4*sampleSeconds)\013\010",
    "        local accelerationAlpha=dt/(accelerationFilterSeconds+dt)\013\010",
    "        current.verticalAcceleration=priorAcceleration+accelerationAlpha*(measuredAcceleration-priorAcceleration)\013\010",
    "        local meanSpeed=(v.verticalSpeed+previous.verticalSpeed)*0.5\013\010",
    "        local gravity=v.environment and v.environment.gravity and math.abs(v.environment.gravity.y)\013\010",
    "        local meanRatio=(current.actualRatio+previous.actualRatio)*0.5\013\010",
    "        local minimumDragSpeed=0.02\013\010",
    "        if s.phase==\"MAIN_LIFT\" and finite(s.startAltitude) and finite(v.altitude) and\013\010",
    "            v.altitude>s.startAltitude+0.1 then s.launchMotionVerified=true end\013\010",
    "        local groundedStartup=s.phase==\"MAIN_LIFT\" and finite(s.startAltitude) and not s.launchMotionVerified\013\010",
    "        current.groundedStartup=groundedStartup\013\010",
    "        if groundedStartup then\013\010",
    "            -- Ground contact supplies an unknown force. Dividing that force\013\010",
    "            -- residual by a tiny vibration velocity invents enormous drag.\013\010",
    "            -- Use the reported environment value until actual CoM ascent\013\010",
    "            -- demonstrates free motion; also discard any earlier bad fit.\013\010",
    "            local environmentDrag=v.environment and v.environment.universalDrag\013\010",
    "            current.verticalDragEstimate=finite(environmentDrag) and environmentDrag>=0 and environmentDrag or 0\013\010",
    "            current.verticalDragCandidate=nil;current.verticalDragSamples=0\013\010",
    "            current.lowSpeedDragCandidate=nil;current.lowSpeedDragSamples=0\013\010",
    "        elseif finite(gravity) and gravity>0 and finite(meanSpeed) and\013\010",
    "            math.abs(meanSpeed)>minimumDragSpeed and finite(meanRatio) then\013\010",
    "            local dragSample=(gravity*(meanRatio-1)-measuredAcceleration)/meanSpeed\013\010",
    "            if finite(dragSample) and dragSample>0 then\013\010",
    "                local lowSpeedDrag=math.abs(meanSpeed)<=0.05 and finite(previous.verticalDragEstimate)\013\010",
    "                if lowSpeedDrag then\013\010",
    "                    -- A low-speed sample can repair a biased initial estimate,\013\010",
    "                    -- but do not divide noisy near-zero motion into an\013\010",
    "                    -- unbounded drag jump. Require three mutually consistent\013\010",
    "                    -- finite readings that also remain within a bounded step\013\010",
    "                    -- of the established estimate.\013\010",
    "                    local estimate=previous.verticalDragEstimate\013\010",
    "                    local withinEstimate=math.abs(dragSample-estimate)<=math.max(estimate*0.5,0.25)\013\010",
    "                    local priorCandidate=withinEstimate and previous.lowSpeedDragCandidate or nil\013\010",
    "                    local consistent=priorCandidate and\013\010",
    "                        math.abs(dragSample-priorCandidate)<=math.max(math.abs(priorCandidate)*0.25,0.02)\013\010",
    "                    current.lowSpeedDragSamples=withinEstimate and consistent and\013\010",
    "                        (previous.lowSpeedDragSamples or 0)+1 or (withinEstimate and 1 or 0)\013\010",
    "                    current.lowSpeedDragCandidate=withinEstimate and (consistent and\013\010",
    "                        (priorCandidate+dragSample)*0.5 or dragSample) or nil\013\010",
    "                    current.verticalDragEstimate=estimate\013\010",
    "                    if current.lowSpeedDragSamples>=3 then\013\010",
    "                        local dragAlpha=dt/(math.max(3*sampleSeconds,4)+dt)\013\010",
    "                        current.verticalDragEstimate=estimate+\013\010",
    "                            (current.lowSpeedDragCandidate-estimate)*dragAlpha\013\010",
    "                    end\013\010",
    "                elseif finite(previous.verticalDragEstimate) then\013\010",
    "                    current.lowSpeedDragCandidate=nil;current.lowSpeedDragSamples=0\013\010",
    "                    local dragFilterSeconds=math.max(3*sampleSeconds,4)\013\010",
    "                    local dragAlpha=dt/(dragFilterSeconds+dt)\013\010",
    "                    current.verticalDragEstimate=previous.verticalDragEstimate+\013\010",
    "                        (dragSample-previous.verticalDragEstimate)*dragAlpha\013\010",
    "                else\013\010",
    "                    -- Infer low-speed resistance only after three consistent\013\010",
    "                    -- moving samples; this avoids dividing a single noisy\013\010",
    "                    -- acceleration residual by a near-zero velocity.\013\010",
    "                    local priorCandidate=previous.verticalDragCandidate\013\010",
    "                    local consistent=finite(priorCandidate) and\013\010",
    "                        math.abs(dragSample-priorCandidate)<=math.max(math.abs(priorCandidate)*0.25,0.02)\013\010",
    "                    current.verticalDragSamples=consistent and (previous.verticalDragSamples or 0)+1 or 1\013\010",
    "                    current.verticalDragCandidate=consistent and\013\010",
    "                        (priorCandidate+dragSample)*0.5 or dragSample\013\010",
    "                    if current.verticalDragSamples>=3 then\013\010",
    "                        current.verticalDragEstimate=current.verticalDragCandidate\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            else\013\010",
    "                current.verticalDragEstimate=previous.verticalDragEstimate\013\010",
    "                current.verticalDragCandidate=nil;current.verticalDragSamples=0\013\010",
    "            end\013\010",
    "        else\013\010",
    "            current.verticalDragEstimate=previous.verticalDragEstimate\013\010",
    "            current.verticalDragCandidate=previous.verticalDragCandidate\013\010",
    "            current.verticalDragSamples=previous.verticalDragSamples\013\010",
    "        end\013\010",
    "        local supplyStable=previous.outputsValid and current.outputsValid and\013\010",
    "            previous.efficienciesValid and current.efficienciesValid\013\010",
    "        local responseRatesStable=true\013\010",
    "        local supplyStep=false\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local before,after=previous.quadrants[q],current.quadrants[q]\013\010",
    "            if not before or not after or before.gasOutput==nil or after.gasOutput==nil or\013\010",
    "                before.boilerEfficiency==nil or after.boilerEfficiency==nil then\013\010",
    "                supplyStable=false\013\010",
    "            else\013\010",
    "                local outputJump=before.gasOutput>0 and after.gasOutput>before.gasOutput*1.5\013\010",
    "                local efficiencyJump=before.boilerEfficiency>0 and\013\010",
    "                    after.boilerEfficiency>before.boilerEfficiency*1.5 and\013\010",
    "                    after.boilerEfficiency-before.boilerEfficiency>0.05\013\010",
    "                if outputJump or efficiencyJump then supplyStep=true end\013\010",
    "                local outputChange=math.abs(after.gasOutput-before.gasOutput)\013\010",
    "                local efficiencyChange=math.abs(after.boilerEfficiency-before.boilerEfficiency)\013\010",
    "                if outputChange>math.max(math.abs(before.gasOutput)*0.1,0.001) or efficiencyChange>0.05 then\013\010",
    "                    supplyStable=false\013\010",
    "                end\013\010",
    "                if before.filledVolume and after.filledVolume and before.capacity and after.capacity then\013\010",
    "                    local oldRate=(before.fillRate or 0)\013\010",
    "                    local newRate=(after.filledVolume-before.filledVolume)/dt\013\010",
    "                    after.fillRate=newRate\013\010",
    "                    local fillRateTolerance=math.max(0.01,math.abs(oldRate)*0.2)\013\010",
    "                    if math.abs(newRate-oldRate)>fillRateTolerance then responseRatesStable=false end\013\010",
    "                else responseRatesStable=false end\013\010",
    "            end\013\010",
    "            if previous.quadrants[q] and current.quadrants[q] and\013\010",
    "                previous.quadrants[q].lift and current.quadrants[q].lift then\013\010",
    "                local oldRate=previous.quadrants[q].liftRate or 0\013\010",
    "                local newRate=(current.quadrants[q].lift-previous.quadrants[q].lift)/dt\013\010",
    "                current.quadrants[q].liftRate=newRate\013\010",
    "                if math.abs(newRate-oldRate)>math.max(SYSTEMS_LIFT_PROGRESS_EPSILON,math.abs(oldRate)*0.2) then\013\010",
    "                    responseRatesStable=false\013\010",
    "                end\013\010",
    "            else responseRatesStable=false end\013\010",
    "        end\013\010",
    "        if supplyStep then s.supplyStableSamples=0;s.supplyStepAt=now\013\010",
    "        elseif supplyStable then s.supplyStableSamples=(s.supplyStableSamples or 0)+1\013\010",
    "        else s.supplyStableSamples=0 end\013\010",
    "        current.supplyStep=supplyStep\013\010",
    "        current.supplyStable=(s.supplyStableSamples or 0)>=SYSTEMS_RATE_STABLE_SAMPLES\013\010",
    "        current.responseRatesStable=responseRatesStable\013\010",
    "        if supplyStep and s.responseProbe and s.responseProbe.excitation==true and current.fullEfficiency then\013\010",
    "            -- A sudden source restoration is a new excitation. Restart the\013\010",
    "            -- response measurement here so outage/recovery time is not folded\013\010",
    "            -- into the normal envelope-fill lag.\013\010",
    "            s.responseProbe={excitation=true,at=now,actualRatio=current.actualRatio,\013\010",
    "                quadrants=clone(current.quadrants),ceilingSum=s.responseProbe.ceilingSum,\013\010",
    "                liftRiseSamples=0,fillRiseSamples=0}\013\010",
    "        end\013\010",
    "        if s.responseProbe and s.responseProbe.excitation==true and current.fullEfficiency and current.outputsValid then\013\010",
    "            local probe=s.responseProbe\013\010",
    "            if not s.fillResponseLagSeconds then\013\010",
    "                for _,q in ipairs(QUADS) do\013\010",
    "                    local start=probe.quadrants[q];local after=current.quadrants[q]\013\010",
    "                    if start and after and start.filledVolume and after.filledVolume and\013\010",
    "                        finite(after.gasOutput) and after.gasOutput>0 and\013\010",
    "                        math.abs(after.filledVolume-start.filledVolume)>1 then\013\010",
    "                        if after.filledVolume<start.filledVolume then\013\010",
    "                            start.filledVolume=after.filledVolume\013\010",
    "                            probe.fillRiseSamples=0\013\010",
    "                        else\013\010",
    "                            start.filledVolume=after.filledVolume\013\010",
    "                            probe.fillRiseSamples=(probe.fillRiseSamples or 0)+1\013\010",
    "                            if probe.fillRiseSamples>=3 then\013\010",
    "                                s.fillResponseLagSeconds=now-probe.at;break\013\010",
    "                            end\013\010",
    "                        end\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            end\013\010",
    "            local positiveOutput=false\013\010",
    "            for _,q in ipairs(QUADS) do\013\010",
    "                local quadrant=current.quadrants[q]\013\010",
    "                if quadrant and finite(quadrant.gasOutput) and quadrant.gasOutput>0 then positiveOutput=true;break end\013\010",
    "            end\013\010",
    "            if not s.liftResponseLagSeconds and positiveOutput then\013\010",
    "                local change=current.actualRatio-probe.actualRatio\013\010",
    "                if change< -SYSTEMS_LIFT_RESPONSE_ONSET_EPSILON then\013\010",
    "                    -- START SYSTEMS can begin with residual lift from the\013\010",
    "                    -- probe phase. Follow its measured decay so we do not\013\010",
    "                    -- mistake the later return to that stale high level for\013\010",
    "                    -- the beginning of an upward response.\013\010",
    "                    probe.actualRatio=current.actualRatio\013\010",
    "                    probe.liftRiseSamples=0\013\010",
    "                elseif change>SYSTEMS_LIFT_RESPONSE_ONSET_EPSILON then\013\010",
    "                    probe.actualRatio=current.actualRatio\013\010",
    "                    probe.liftRiseSamples=(probe.liftRiseSamples or 0)+1\013\010",
    "                    if probe.liftRiseSamples>=3 then\013\010",
    "                        s.liftResponseLagSeconds=now-probe.at\013\010",
    "                    end\013\010",
    "                else\013\010",
    "                    probe.liftRiseSamples=0\013\010",
    "                end\013\010",
    "            end\013\010",
    "            if s.liftResponseLagSeconds then\013\010",
    "                s.responseLagSeconds=math.max(s.liftResponseLagSeconds,s.fillResponseLagSeconds or 0,sampleSeconds)\013\010",
    "                s.responseProbe=nil\013\010",
    "            end\013\010",
    "        end\013\010",
    "    else\013\010",
    "        current.supplyStable=false\013\010",
    "        current.responseRatesStable=false\013\010",
    "        s.supplyStableSamples=0\013\010",
    "    end\013\010",
    "    if previous then\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local before,after=previous.quadrants[q],current.quadrants[q]\013\010",
    "            if before and after and before.filledVolume and after.filledVolume and now>previous.at then\013\010",
    "                after.fillRate=(after.filledVolume-before.filledVolume)/(now-previous.at)\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    s.dynamics=current\013\010",
    "end\013\010",

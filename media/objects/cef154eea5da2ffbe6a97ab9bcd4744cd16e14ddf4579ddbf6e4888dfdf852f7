    "\013\010",
    "    -- Pair symmetry makes FL/BR and FR/BL equal-and-opposite even after\013\010",
    "    -- integer quantization, preserving the total steam lift request.\013\010",
    "    local requested={FL=roll+pitch,FR=pitch-roll,BL=roll-pitch,BR=-roll-pitch}\013\010",
    "    local availableScale=1\013\010",

    "        end\013\010",
    "    end\013\010",
    "    local s={phase=\"READY\",providerRoles=prepared.roles,providerLimits=prepared.limits,boots=prepared.boots,\013\010",
    "        bindingFingerprints=prepared.bindingFingerprints,bindingGenerations=prepared.bindingGenerations,\013\010",
    "        acceptedBootGenerations=prepared.acceptedBootGenerations,nodeIDs=prepared.nodeIDs,\013\010",
    "        coreID=prepared.coreID,coreSession=prepared.coreSession,uuid=prepared.uuid,fingerprint=prepared.fingerprint,\013\010",
    "        target=prepared.target,targetReason=prepared.targetReason,\013\010",
    "        currentTargets=copyMaps(maps),baseline=copyMaps(maps),appliedMaps=copyMaps(maps),\013\010",
    "        coarseTrimApplied={},batchCoarseTrimApplied={},startAltitude=v.altitude,index=1,\013\010",
    "        startedAt=now,phaseStartedAt=now,lastSystemsUpdateAt=now,lastControlAt=now,lastPidAt=now,\013\010",
    "        lastTargetCommandAt=now,lastTargetAppliedAt=now,lastLiftProgressAt=now,lastAckWaitSeconds=0,\013\010",
    "        acquisitionTimeout=86400,launchComplete=true,launchDurationSeconds=0,acquisitionPidActive=false,\013\010",
    "        airborne=true,airborneStart=true}\013\010",
    "    TelemetryRecovery.suspend(self,s,now,\"AIRBORNE START: ADOPTING CURRENT LIFT\")\013\010",
    "    s.telemetryRecovery.targetMaps=copyMaps(maps)\013\010",
    "    s.telemetryRecovery.coarseTrimApplied={}\013\010",
    "    local good,reason=self:systemsGuard(io,now,s,true,true)\013\010",
    "    if not good and not TelemetryRecovery.isTransientGuardFault(io,s,now,reason,self) then\013\010",
    "        return false,reason\013\010",
    "    end\013\010",
    "    self.systemsRun=s;self.systemsLastOutcome=nil;self.systemsRetainedRun=nil\013\010",
    "    self.enabled=true;self.available=false;self.target=s.target;self.baseline=copyMaps(maps)\013\010",
    "    if self.controls then self.controls.targets.altitude=s.target end\013\010",
    "    self:resetTrim();self:seedLevelBias()\013\010",
    "    self.outer:reset(v.altitude);self.inner:reset(v.verticalSpeed)\013\010",
    "    self:seedHoverOffset(v.altitude)\013\010",
    "    self.verticalTarget=v.verticalSpeed;self.effort=0\013\010",
    "    self.reason=\"AIRBORNE START: ADOPTING CURRENT LIFT\"\013\010",
    "    self.systemsSnapshot={active=true,available=false,phase=\"READY\",pending=true,complete=false,\013\010",
    "        target=s.target,reason=self.reason}\013\010",
    "    return true,\"AIRBORNE START\"\013\010",
    "end\013\010",
    "-- Summary: Validate startup and initialize its probe, target and retained-identity state.\010",
    "function Flight:startSystems(io,now,prepared)\013\010",
    "    if self.systemsRun then return false,\"START SYSTEMS ALREADY ACTIVE\" end\013\010",
    "    local reason\013\010",
    "    if not prepared then prepared,reason=self:systemsPreflight(io,now) end\013\010",
    "    if not prepared then\013\010",
    "        self.systemsAvailable=false;self.systemsBlockedReason=reason\013\010",
    "        logOperationIssue(self,\"flight\",\"systems\",\"START SYSTEMS FAILED: \"..tostring(reason))\013\010",
    "        return false,reason\013\010",
    "    end\013\010",
    "    self.coreLogIssues=self.coreLogIssues or {};self.coreLogIssues[issueScope(\"flight\",\"systems\")]=nil\013\010",
    "    -- Already flying: skip takeoff and lift build entirely.\013\010",
    "    local airborne=self:systemsAirborneAtStart(io)\013\010",
    "    if airborne then return self:startSystemsAirborne(io,now,prepared) end\013\010",
    "    local initialGasRequested=self.config.startup_gas_target_m3_per_chamber\013\010",
    "    if not finite(initialGasRequested) or initialGasRequested<0 then initialGasRequested=0 end\013\010",
    "    -- Airborne start: current balloon lift already carries the vessel. Then\013\010",
    "    -- the takeoff seed, launch settle and lift build are skipped: control is\013\010",
    "    -- taken over at the current ceilings and goes straight to READY.\013\010",
    "    local airborneStart,airborneRatio=false,nil\013\010",
    "    do\013\010",
    "        local v=io.vessel or {}\013\010",
    "        local pressure=airPressure(v)\013\010",
    "        if next(prepared.retainedBulk or {})~=nil and pressure and finite(v.mass) and v.mass>0 then\013\010",
    "            local liftSum,complete=0,true\013\010",
    "            for _,q in ipairs(QUADS) do\013\010",
    "                local balloon=io.nodes[q] and io.nodes[q].balloon\013\010",

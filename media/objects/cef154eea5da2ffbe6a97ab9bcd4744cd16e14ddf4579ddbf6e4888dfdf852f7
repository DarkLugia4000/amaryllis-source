    "        -- Schema-1 installations without the optional startup seed retain\013\010",
    "        -- minimum-floor startup exactly as before.\013\010",
    "        c.startup_gas_target_m3_per_chamber=0\013\010",
    "    end\013\010",
    "    if c and c.launch_settle_seconds==nil then c.launch_settle_seconds=10 end\013\010",
    "    if c and c.manual_fore_aft_trim_blocks==nil then\013\010",
    "        -- Preserve older config files while giving manual trim a durable,\013\010",
    "        -- neutral target in the same core JSON document.\013\010",
    "        c.manual_fore_aft_trim_blocks=0\013\010",
    "    end\013\010",
    "    if c and c.level_boost_start_blocks==nil then c.level_boost_start_blocks=0.5 end\013\010",
    "    if c and c.level_boost_max==nil then c.level_boost_max=10 end\013\010",
    "    if c and not c.trim_pid then\013\010",
    "        -- Existing JSON installations gain trim learning without losing any\013\010",
    "        -- user-set altitude gains, ceiling limits or slew limits.\013\010",
    "        c.trim_pid={ki=0.25,kd=1,integral_limit=100,derivative_filter_seconds=2}\013\010",
    "    end\013\010",
    "    return setmetatable({config=c,enabled=false,reason=\"NOT ENGAGED\",lastRequestSeq=0,\013\010",
    "        controls=config.cockpit and Controls.new(config),\013\010",
    "        outer=c and PID.new(c.altitude_pid),inner=c and PID.new(c.vertical_speed_pid)}, {__index=Flight})\013\010",
    "end\013\010",
    "-- Section: Emergency lift | Latched operator shutdown and verified disarm.\010",
    "-- Summary: Load the persisted Kill Lift latch and prepare its verification state.\010",
    "function Flight:configureEmergencyLock(storage,dependencies,path)\013\010",
    "    self.emergencyLockStorage=storage\013\010",
    "    self.emergencyLockDependencies=dependencies or {}\013\010",
    "    self.emergencyLockPath=path or \"/avionics/data/emergency-lift-lock.json\"\013\010",
    "    local fsApi=self.emergencyLockDependencies.fs or fs\013\010",
    "    if type(fsApi)~=\"table\" or type(fsApi.exists)~=\"function\" or\013\010",
    "        type(storage)~=\"table\" or type(storage.readJson)~=\"function\" then\013\010",
    "        self.emergencyLiftLatched=true\013\010",
    "        self.emergencyLiftPersistenceWarning=\"EMERGENCY LOCK FILE STATUS UNAVAILABLE; START SYSTEMS REQUIRED\"\013\010",
    "    else\013\010",
    "        local ok,exists=pcall(fsApi.exists,self.emergencyLockPath)\013\010",
    "        if not ok then\013\010",
    "            self.emergencyLiftLatched=true\013\010",
    "            self.emergencyLiftPersistenceWarning=\"EMERGENCY LOCK FILE CHECK FAILED: \"..tostring(exists)\013\010",
    "        elseif exists then\013\010",
    "            local readOk,state,reason=pcall(storage.readJson,self.emergencyLockPath,self.emergencyLockDependencies)\013\010",
    "            if readOk and type(state)==\"table\" and state.schemaVersion==1 and type(state.latched)==\"boolean\" then\013\010",
    "                self.emergencyLiftLatched=state.latched\013\010",
    "            else\013\010",
    "                self.emergencyLiftLatched=true\013\010",
    "                self.emergencyLiftPersistenceWarning=\"EMERGENCY LOCK FILE INVALID; FAILING CLOSED: \"..tostring(readOk and reason or state)\013\010",
    "            end\013\010",
    "        else\013\010",
    "            self.emergencyLiftLatched=false\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.emergencyLiftLatched then\013\010",
    "        self.emergencyLiftJob={recovering=true,complete=false,pending=true,phase=\"RECHECKING AFTER REBOOT\",\013\010",
    "            reason=\"Rechecking fresh chamber status; no automatic actuator command was sent\",quadrants={}}\013\010",
    "        for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "            self.emergencyLiftJob.quadrants[q]={status=\"WAITING_FOR_FRESH_NODE\",attempts=0,\013\010",
    "                ackReason=\"Waiting for fresh BULK OFF / PROBE ON readback; press KILL LIFT to reassert if needed\"}\013\010",
    "        end\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Level memory: the steam differential that held the ship level last time\013\010",
    "-- is saved and used as the starting split for the next launch, so a fixed\013\010",
    "-- weight imbalance does not have to be rediscovered by pitching first.\013\010",
    "-- Section: Leveling | Chamber-height feedback and retained trim allocation.\010",
    "-- Summary: Load the stored leveling bias and its persistence dependencies.\010",
    "function Flight:configureLevelMemory(storage,dependencies,path)\013\010",
    "    self.levelStorage=storage\013\010",
    "    self.levelDependencies=dependencies or {}\013\010",
    "    self.levelPath=path or \"/avionics/data/level-bias.json\"\013\010",
    "    self.levelBias=nil\013\010",
    "    if type(storage)~=\"table\" or type(storage.readJson)~=\"function\" then return end\013\010",
    "    local ok,state=pcall(storage.readJson,self.levelPath,self.levelDependencies)\013\010",
    "    if ok and type(state)==\"table\" and state.schemaVersion==1 and finite(state.roll) and finite(state.pitch) and\013\010",
    "        math.abs(state.roll)<=10000 and math.abs(state.pitch)<=10000 then\013\010",
    "        self.levelBias={roll=state.roll,pitch=state.pitch}\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Hover correction memory. The lift model's hover support is a few percent\013\010",
    "-- off and the error depends on height (logged ~4.8% near Y 144). The HOLD\013\010",
    "-- speed integral learns it each flight; remember it per 20-block band so a\013\010",
    "-- new hold starts from it instead of relearning during the approach.\013\010",
    "local HOVER_BAND_BLOCKS=20\013\010",
    "local function hoverBandKey(altitude) return tostring(math.floor(altitude/HOVER_BAND_BLOCKS)*HOVER_BAND_BLOCKS) end\013\010",
    "-- Section: Persistent learning | Validated calibration and retained operating records.\010",
    "-- Summary: Load learned hover offsets and configure their persistence.\010",
    "function Flight:configureHoverMemory(storage,dependencies,path)\013\010",
    "    self.hoverStorage=storage\013\010",
    "    self.hoverDependencies=dependencies or {}\013\010",
    "    self.hoverPath=path or \"/avionics/data/hover-offset.json\"\013\010",
    "    self.hoverOffsets={}\013\010",
    "    if type(storage)~=\"table\" or type(storage.readJson)~=\"function\" then return end\013\010",
    "    local ok,state=pcall(storage.readJson,self.hoverPath,self.hoverDependencies)\013\010",
    "    if ok and type(state)==\"table\" and state.schemaVersion==1 and type(state.bands)==\"table\" then\013\010",
    "        for key,entry in pairs(state.bands) do\013\010",
    "            if tonumber(key) and type(entry)==\"table\" and finite(entry.offset) and math.abs(entry.offset)<=0.15 then\013\010",
    "                self.hoverOffsets[tostring(key)]={offset=entry.offset,samples=finite(entry.samples) and entry.samples or 1}\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Interpolate the learned hover offset for the current altitude.\010",
    "function Flight:learnedHoverOffset(altitude)\013\010",
    "    if not finite(altitude) or type(self.hoverOffsets)~=\"table\" then return nil end\013\010",
    "    local key=hoverBandKey(altitude)\013\010",
    "    if self.hoverOffsets[key] then return self.hoverOffsets[key].offset end\013\010",
    "    local best,bestDistance\013\010",
    "    for band,entry in pairs(self.hoverOffsets) do\013\010",
    "        local distance=math.abs(tonumber(band)-tonumber(key))\013\010",
    "        if distance<=2*HOVER_BAND_BLOCKS and (not bestDistance or distance<bestDistance) then\013\010",
    "            best,bestDistance=entry.offset,distance\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return best\013\010",
    "end\013\010",
    "-- Summary: Apply the learned hover offset to the altitude-control baseline.\010",
    "function Flight:seedHoverOffset(altitude)\013\010",
    "    local offset=self:learnedHoverOffset(altitude)\013\010",
    "    local g=self.inner and self.inner.g\013\010",
    "    if not offset or not g or not finite(g.ki) or g.ki<=0 then return end\013\010",
    "    local limit=finite(g.integral_limit) and g.integral_limit or 0\013\010",
    "    self.inner.i=clamp(offset/g.ki,-limit,limit)\013\010",
    "    self.hoverOffsetSeeded=offset\013\010",
    "end\013\010",
    "-- The propulsion state is saved in config.json (thrust.enabled) and survives core reboots, START\013\010",
    "-- SYSTEMS and RESTART SYSTEMS. A confirmed STOP SYSTEMS saves it as disabled. When it is disabled,\013\010",
    "-- READY enables it automatically after 10 s of steady altitude hold, retrying every 2 s while\013\010",
    "-- propulsion refuses.\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Save propulsion as disabled when STOP SYSTEMS is confirmed, cancelling AP and the anchor.\010",
    "function Flight:disablePropulsionForStop(io,now)\013\010",
    "    local thrust=io.thrust\013\010",
    "    if not thrust or type(thrust.setEnabled)~=\"function\" then return end\013\010",
    "    if not (thrust.config and thrust.config.thrust and thrust.config.thrust.enabled==true) then return end\013\010",
    "    if io.autopilot then io.autopilot:cancel(io,self.controls,\"SYSTEMS STOPPED\",false) end\013\010",
    "    if io.positionAnchor then io.positionAnchor:cancel(self.controls,\"SYSTEMS STOPPED\") end\013\010",
    "    local accepted,reason=thrust:setEnabled(io,now,self.controls,false,self.storage,self.settingsDependencies,\013\010",
    "        \"PROPULSION OFF: SYSTEMS STOPPED\")\013\010",
    "    if not accepted then logOperationIssue(self,\"flight\",\"propulsion disable at stop\",reason) end\013\010",
    "end\013\010",
    "-- Summary: Enable a disabled propulsion once per start sequence after the READY altitude hold has stayed settled for 10 s.\010",
    "function Flight:autoEnablePropulsion(io,s,now)\013\010",
    "    if s.propulsionAutoDone or not io.thrust or type(io.thrust.setEnabled)~=\"function\" then return end\013\010",
    "    local thrustConfig=io.thrust.config and io.thrust.config.thrust or {}\013\010",
    "    if thrustConfig.enabled==true then s.propulsionAutoDone=true;return end\013\010",
    "    local v=io.vessel or {}\013\010",
    "    local settled=s.phase==\"READY\" and finite(v.altitude) and finite(v.verticalSpeed) and finite(s.target) and\013\010",
    "        math.abs(v.verticalSpeed)<=0.1 and math.abs(s.target-v.altitude)<=1.5\013\010",
    "    if not settled then s.propulsionSettledSince=nil;return end\013\010",
    "    s.propulsionSettledSince=s.propulsionSettledSince or now\013\010",
    "    if now-s.propulsionSettledSince<10 then return end\013\010",
    "    if s.propulsionAutoTriedAt and now-s.propulsionAutoTriedAt<2 then return end\013\010",
    "    s.propulsionAutoTriedAt=now\013\010",
    "    io.systemsReady=true\013\010",
    "    local accepted,reason=io.thrust:setEnabled(io,now,self.controls,true,self.storage,self.settingsDependencies)\013\010",
    "    if accepted then\013\010",
    "        s.propulsionAutoDone=true\013\010",
    "        if type(os.__amaryllisLog)==\"function\" then\013\010",
    "            pcall(os.__amaryllisLog,\"Propulsion enabled automatically after the altitude hold settled\",\"core.flight\")\013\010",
    "        end\013\010",
    "    else\013\010",
    "        s.propulsionAutoReason=reason\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Section: Persistent learning | Validated calibration and retained operating records.\010",
    "-- Summary: Update learned hover offsets from stable measured hover conditions.\010",
    "function Flight:rememberHoverOffset(v,s,actualRatio,now)\013\010",
    "    local g=self.inner and self.inner.g\013\010",
    "    local settled=s.phase==\"READY\" and finite(v.altitude) and finite(v.verticalSpeed) and\013\010",
    "        math.abs(v.verticalSpeed)<=0.05 and finite(s.target) and math.abs(s.target-v.altitude)<=1.5 and\013\010",
    "        finite(actualRatio) and finite(s.lastDesiredRatio) and math.abs(actualRatio-s.lastDesiredRatio)<=0.005 and\013\010",
    "        g and finite(g.ki) and g.ki>0 and finite(self.inner.i)\013\010",
    "    if not settled then self.hoverSettledSince=nil;return end\013\010",
    "    self.hoverSettledSince=self.hoverSettledSince or now\013\010",
    "    if now-self.hoverSettledSince<15 then return end\013\010",
    "    local learned=clamp(g.ki*self.inner.i,-0.15,0.15)\013\010",
    "    self.hoverOffsets=self.hoverOffsets or {}\013\010",
    "    local key=hoverBandKey(v.altitude)\013\010",
    "    local entry=self.hoverOffsets[key]\013\010",
    "    if entry then entry.offset=entry.offset*0.7+learned*0.3;entry.samples=math.min(1000,(entry.samples or 1)+1)\013\010",
    "    else self.hoverOffsets[key]={offset=learned,samples=1} end\013\010",
    "    if self.hoverSavedAt and now-self.hoverSavedAt<30 then return end\013\010",
    "    self.hoverSavedAt=now\013\010",
    "    local storage=self.hoverStorage\013\010",
    "    if type(storage)==\"table\" and type(storage.writeJson)==\"function\" then\013\010",
    "        pcall(storage.writeJson,self.hoverPath or \"/avionics/data/hover-offset.json\",\013\010",
    "            {schemaVersion=1,bandBlocks=HOVER_BAND_BLOCKS,bands=self.hoverOffsets},self.hoverDependencies)\013\010",
    "    end\013\010",
    "end\013\010",
    "function Flight:seedLevelBias()\013\010",
    "    local bias=self.levelBias\013\010",
    "    if type(bias)~=\"table\" then return end\013\010",
    "    self.coarseSteamTrim={roll=bias.roll,pitch=bias.pitch}\013\010",
    "    self.coarseSteamTrimIntegral={roll=bias.roll,pitch=bias.pitch}\013\010",
    "    self.coarseSteamTrimEngaged={roll=bias.roll~=0,pitch=bias.pitch~=0}\013\010",
    "end\013\010",
    "-- Section: Leveling | Chamber-height feedback and retained trim allocation.\010",
    "-- Summary: Return learned leveling to the saved level bias, or to zero when none is saved, during the altitude hold.\010",
    "function Flight:resetLeveling(io,now)\013\010",
    "    local s=self.systemsRun\013\010",
    "    if not s or s.phase~=\"READY\" then return false,\"RESET LEVELING NEEDS START SYSTEMS READY\" end\013\010",
    "    if s.telemetryRecovery then return false,\"WAIT FOR LIFT TELEMETRY RECOVERY\" end\013\010",
    "    local bias=self.levelBias\013\010",
    "    local saved=type(bias)==\"table\" and finite(bias.roll) and finite(bias.pitch)\013\010",
    "    local roll,pitch=saved and bias.roll or 0,saved and bias.pitch or 0\013\010",
    "    -- The learned split jumps to the reset value; the applied split follows at the leveling slew rate.\013\010",
    "    self.coarseSteamTrimIntegral={roll=roll,pitch=pitch}\013\010",
    "    self.coarseSteamTrimEngaged={roll=false,pitch=false}\013\010",
    "    if self.rollTrim then self.rollTrim:reset() end\013\010",
    "    if self.pitchTrim then self.pitchTrim:reset() end\013\010",
    "    self.levelRates=nil;self.levelTiltSince=nil\013\010",
    "    local reason=saved and \"LEVELING RESET TO SAVED BIAS\" or \"LEVELING RESET TO ZERO\"\013\010",
    "    emitCoreLog(string.format(\"%s (roll %.1f, pitch %.1f)\",reason,roll,pitch),\"core.flight.leveling\")\013\010",
    "    return true,reason\013\010",
    "end\013\010",
    "-- Summary: Persist the current leveling bias at the configured save cadence.\010",
    "function Flight:rememberLevelBias(now,force)\013\010",
    "    local trim=self.coarseSteamTrim\013\010",
    "    if not trim or not finite(trim.roll) or not finite(trim.pitch) then return end\013\010",
    "    local last=self.levelBiasSaved\013\010",
    "    if not force and last and finite(now) and now-last.at<60 then return end\013\010",
    "    if last and math.abs(last.roll-trim.roll)<1 and math.abs(last.pitch-trim.pitch)<1 then return end\013\010",
    "    self.levelBias={roll=trim.roll,pitch=trim.pitch}\013\010",
    "    self.levelBiasSaved={roll=trim.roll,pitch=trim.pitch,at=finite(now) and now or 0}\013\010",
    "    local write=self.levelStorage and self.levelStorage.writeJson\013\010",
    "    if type(write)==\"function\" then\013\010",
    "        pcall(write,self.levelPath,{schemaVersion=1,roll=trim.roll,pitch=trim.pitch},self.levelDependencies)\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Section: Emergency lift | Latched operator shutdown and verified disarm.\010",
    "-- Summary: Write the accepted Kill Lift latch to its persistent record.\010",
    "function Flight:persistEmergencyLock(latched)\013\010",
    "    if not self.emergencyLockStorage then return true end\013\010",
    "    local write=self.emergencyLockStorage.writeJson\013\010",
    "    if type(write)~=\"function\" then\013\010",
    "        self.emergencyLiftPersistenceWarning=\"EMERGENCY LOCK STORAGE UNAVAILABLE\"\013\010",
    "        return false,self.emergencyLiftPersistenceWarning\013\010",
    "    end\013\010",
    "    local callOk,ok,reason=pcall(write,self.emergencyLockPath,{schemaVersion=1,latched=latched==true},\013\010",
    "        self.emergencyLockDependencies)\013\010",
    "    if not callOk or not ok then\013\010",
    "        if not callOk then reason=ok end\013\010",
    "        self.emergencyLiftPersistenceWarning=\"EMERGENCY LOCK PERSISTENCE FAILED: \"..tostring(reason)\013\010",
    "        return false,self.emergencyLiftPersistenceWarning\013\010",
    "    end\013\010",
    "    self.emergencyLiftPersistenceWarning=nil\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Leveling | Chamber-height feedback and retained trim allocation.\010",
    "-- Summary: Reset trim PID state and optionally retain the coarse trim allocation.\010",
    "function Flight:resetTrim(preserveCoarse)\013\010",
    "    local c=self.config\013\010",
    "    local g={kp=c.trim_ceiling_per_block,ki=c.trim_pid.ki,kd=c.trim_pid.kd,\013\010",
    "        integral_limit=c.trim_pid.integral_limit,derivative_filter_seconds=c.trim_pid.derivative_filter_seconds}\013\010",
    "    self.rollTrim=PID.new(g);self.pitchTrim=PID.new(g)\013\010",
    "    self.trim={FL=0,FR=0,BL=0,BR=0};self.trimStatus=nil;self.levelRates=nil\013\010",
    "    if not preserveCoarse then\013\010",
    "        self.coarseSteamTrim={roll=0,pitch=0}\013\010",
    "        self.coarseSteamTrimIntegral={roll=0,pitch=0}\013\010",
    "        self.coarseSteamTrimEngaged={roll=false,pitch=false}\013\010",
    "    end\013\010",
    "end\013\010",
    "\013\010",
    "-- Height differences are in world blocks, not angles. Symmetric axis mixing\013\010",
    "-- avoids learning four unrelated integrals and distinguishes roll from pitch.\013\010",
    "-- The altitude PID absorbs any common lift added by clipping at probe floors.\013\010",
    "-- Summary: Check that chamber observations are aligned closely enough for trim calculations.\010",
    "function Flight:coarseTrimSamplesAligned(io,now)\013\010",
    "    local oldest,latest\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local at=node and node.lastSeen\013\010",
    "        if not finite(at) then return false,\"STEAM TRIM SENSOR TIME UNAVAILABLE\" end\013\010",
    "        if type(io.nodeFresh)==\"function\" and finite(now) and not io:nodeFresh(q,now) then\013\010",
    "            return false,\"STEAM TRIM SENSOR STALE\"\013\010",
    "        end\013\010",
    "        oldest=not oldest and at or math.min(oldest,at)\013\010",
    "        latest=not latest and at or math.max(latest,at)\013\010",
    "    end\013\010",
    "    local sample=io.config and io.config.network and io.config.network.sample_interval_seconds or 0.5\013\010",
    "    local maxSkew=math.max(1,finite(sample) and sample*2 or 1)\013\010",
    "    if latest-oldest>maxSkew then return false,\"STEAM TRIM SENSOR SKEW\" end\013\010",
    "    return true\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Compute bounded roll and pitch corrections from chamber heights and the selected trim bias.\010",
    "function Flight:updateTrim(io,baseline,dt,slewDt,now)\013\010",
    "    if not self.rollTrim then self:resetTrim() end\013\010",
    "    -- While still resting on the ground, the measured tilt is the terrain\013\010",
    "    -- and landing gear, not a lift imbalance. Leveling against it loads one\013\010",
    "    -- end with extra lift that flips the ship the moment it lifts off.\013\010",
    "    -- Until 1 block above the start height, hold the learned split.\013\010",
    "    local run=self.systemsRun\013\010",
    "    if run and not run.airborne then\013\010",
    "        local v=io.vessel\013\010",
    "        if v and finite(v.altitude) then\013\010",
    "            run.groundAltitude=run.groundAltitude or v.altitude\013\010",
    "            local ratio=run.dynamics and run.dynamics.actualRatio\013\010",
    "            -- Lift carrying nearly all the weight also means the ground no\013\010",
    "            -- longer holds the hull's attitude.\013\010",
    "            if v.altitude>=run.groundAltitude+1 or (finite(ratio) and ratio>=0.97) then\013\010",
    "                run.airborne=true;self.levelRates=nil\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if not run.airborne then\013\010",
    "            local trim=self.coarseSteamTrim or {roll=0,pitch=0}\013\010",
    "            self.trimStatus={active=true,grounded=true,reason=\"ON GROUND: HOLDING LEARNED LEVEL SPLIT\",\013\010",
    "                fineAuthorityLimited=false,authorityLimited=false,levelIndicated=false,\013\010",
    "                coarseSteamTrimRoll=trim.roll,coarseSteamTrimPitch=trim.pitch,\013\010",
    "                coarseSteamTrimActive=false,coarseSteamTrimLimited=false,\013\010",
    "                rollIntegral=self.rollTrim.i,pitchIntegral=self.pitchTrim.i}\013\010",
    "            return true\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local c=self.config;local y={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        y[q]=io.nodes[q].altitude.sensorWorldY\013\010",
    "        if not finite(y[q]) then return nil,\"SECTION ALTITUDE UNAVAILABLE\" end\013\010",
    "    end\013\010",
    "    local roll=(y.FL+y.BL-y.FR-y.BR)/4\013\010",
    "    local measuredRoll=roll\013\010",
    "    local measuredPitch=(y.FL+y.FR-y.BL-y.BR)/4\013\010",
    "    local manualBias=finite(c.manual_fore_aft_trim_blocks) and\013\010",
    "        clamp(c.manual_fore_aft_trim_blocks,MANUAL_TRIM_MIN,MANUAL_TRIM_MAX) or 0\013\010",
    "    -- Existing pitch error is half the measured fore/aft average-height\013\010",
    "    -- difference. A bow-up world-block target therefore maps to bias / 2.\013\010",
    "    local pitchTarget=manualBias/2\013\010",
    "    local leveledHeights={FL=y.FL-manualBias/2,FR=y.FR-manualBias/2,\013\010",
    "        BL=y.BL+manualBias/2,BR=y.BR+manualBias/2}\013\010",
    "    local lowest,highest\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        lowest=not lowest and leveledHeights[q] or math.min(lowest,leveledHeights[q])\013\010",
    "        highest=not highest and leveledHeights[q] or math.max(highest,leveledHeights[q])\013\010",
    "    end\013\010",
    "    local levelSpread=highest-lowest\013\010",
    "    local levelTolerance=0.5\013\010",

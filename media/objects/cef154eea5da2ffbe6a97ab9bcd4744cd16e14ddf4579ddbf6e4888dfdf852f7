    "    if restart and restart.saved then\013\010",
    "        snapshot.modes=clone(restart.saved.controls.modes)\013\010",
    "        snapshot.effectiveModes=clone(snapshot.modes)\013\010",
    "        snapshot.targets=clone(restart.saved.controls.targets)\013\010",
    "    end\013\010",
    "    snapshot.settings=snapshot.settings or {};snapshot.settings.entries=self.settingsEntries\013\010",
    "    local recoverRun,recoverReason=self:abortRecoveryState(io,now or snapshot.updatedAt)\013\010",
    "    snapshot.systemsRecovery={available=recoverRun~=nil,reason=recoverReason,\013\010",
    "        target=self.systemsLastOutcome and self.systemsLastOutcome.target or nil}\013\010",
    "    snapshot.altitudeControl={enabled=self.enabled,available=self.available==true,reason=self.reason,\013\010",
    "        target=self.systemsRun and self.systemsRun.target or self.target,\013\010",
    "        effort=self.effort,verticalSpeedTarget=self.verticalTarget,saturated=self.saturated==true,\013\010",

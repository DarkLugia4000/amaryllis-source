    "-- START SYSTEMS uses the same equilibrium feed-forward as normal flight: raw\013\010",
    "-- envelope lift is checked against the configured gas strengths, then local\013\010",
    "-- pressure and vessel mass convert it to support. Gravity is included on both\013\010",
    "-- sides because Aeronautics applies it to balloon lift as well as vessel\013\010",
    "-- weight. Fresh bulk output and current ceilings are recorded to ground the\013\010",
    "-- response estimate; ceiling commands still use the conservative slew below.\013\010",
    "-- Summary: START SYSTEMS uses the same equilibrium feed-forward as normal flight: raw envelope lift is checked against the configured gas strengths, then local pressure and vessel mass convert it to support. Gravity is included on both sides because Aeronautics applies it to balloon lift as well as vessel weight. Fresh bulk output and current ceilings are recorded to ground the response estimate; ceiling commands still use the conservative slew below.\010",
    "function Flight:systemsHoverFeedForward(io,s,now)\013\010",
    "    local vessel=io.vessel or {}\013\010",
    "    local gravity=vessel.environment and vessel.environment.gravity and\013\010",
    "        math.abs(vessel.environment.gravity.y)\013\010",
    "    local pressure=airPressure(vessel)\013\010",
    "    if not finite(vessel.mass) or vessel.mass<=0 or not finite(gravity) or gravity<=0 or\013\010",
    "        not pressure then return nil,\"MASS / GRAVITY / PRESSURE UNAVAILABLE\" end\013\010",
    "    local strengths=self.config and self.config.verified_gas_lift_strengths\013\010",
    "    if type(strengths)~=\"table\" then return nil,\"VERIFIED GAS LIFT STRENGTHS UNAVAILABLE\" end\013\010",
    "    local mixedLift,bulkOutput,bulkCeiling=0,0,0\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        if not node or not io:nodeFresh(q,now) then return nil,q..\" BULK DATA STALE\" end\013\010",
    "        local balloon=node.balloon or {}\013\010",
    "        if balloon.gasMixValid~=true or type(balloon.gasMix)~=\"table\" then\013\010",
    "            return nil,q..\" GAS MIX UNAVAILABLE\"\013\010",
    "        end\013\010",
    "        for gas,amount in pairs(balloon.gasMix) do\013\010",
    "            if type(gas)~=\"string\" or not finite(amount) or amount<0 then\013\010",
    "                return nil,q..\" GAS MIX INVALID\"\013\010",
    "            end\013\010",
    "            if amount>0 then\013\010",
    "                local strength=strengths[gas]\013\010",
    "                if not finite(strength) or strength<=0 then return nil,\"LIFT STRENGTH UNVERIFIED FOR \"..gas end\013\010",
    "                mixedLift=mixedLift+amount*strength\013\010",
    "            end\013\010",
    "        end\013\010",
    "        for name,provider in pairs(node.providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                if provider.gasTypeValid~=true or type(provider.gasType)~=\"string\" or\013\010",
    "                    not finite(strengths[provider.gasType]) or strengths[provider.gasType]<=0 then\013\010",
    "                    return nil,q..\" PROVIDER \"..name..\" GAS STRENGTH UNAVAILABLE\"\013\010",
    "                end\013\010",
    "                if provider.gasOutputValid~=true or not finite(provider.gasOutput) or provider.gasOutput<0 or\013\010",
    "                    not finite(provider.targetAmount) or provider.targetAmount<0 then\013\010",
    "                    return nil,q..\" PROVIDER \"..name..\" OUTPUT / CEILING UNAVAILABLE\"\013\010",
    "                end\013\010",
    "                bulkOutput=bulkOutput+provider.gasOutput*strengths[provider.gasType]\013\010",
    "                bulkCeiling=bulkCeiling+provider.targetAmount*strengths[provider.gasType]\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if mixedLift<=0 then return nil,\"POSITIVE VERIFIED ENVELOPE LIFT REQUIRED\" end\013\010",
    "    local weight=vessel.mass*gravity\013\010",
    "    local requiredLift=weight/(pressure*gravity)\013\010",
    "    local targetSupportRatio=requiredLift*pressure*gravity/weight\013\010",
    "    local currentSupportRatio=mixedLift*pressure*gravity/weight\013\010",
    "    local feedForward={source=\"VERIFIED MASS / PRESSURE / GAS MIX / BULK OUTPUT\",\013\010",
    "        targetSupportRatio=targetSupportRatio,currentSupportRatio=currentSupportRatio,\013\010",
    "        requiredRawLift=requiredLift,measuredRawLift=mixedLift,\013\010",
    "        bulkLiftOutput=bulkOutput,bulkLiftCeiling=bulkCeiling,\013\010",
    "        bulkOutputPerCeiling=bulkCeiling>0 and bulkOutput/bulkCeiling or nil}\013\010",
    "    s.hoverFeedForward=feedForward\013\010",
    "    return feedForward\013\010",
    "end\013\010",

    "    end\013\010",
    "    local providers,strengthSums,rawTotals={},{},{ }\013\010",
    "    local strengthReference\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes[q];providers[q]={};strengthSums[q]=0;rawTotals[q]=0\013\010",
    "        for name,p in pairs(node.providers or {}) do\013\010",
    "            local amount=baseMaps[q] and baseMaps[q][name]\013\010",

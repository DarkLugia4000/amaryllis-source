    "        snapshot.systemsStartup.appliedDragSupportCompensation=s.appliedDragSupportCompensation\013\010",
    "        snapshot.systemsStartup.feedForwardReason=s.feedForwardReason\013\010",
    "        snapshot.systemsStartup.speedLimiter=s.speedLimiter\013\010",
    "        snapshot.systemsStartup.ackWaitSeconds=s.lastAckWaitSeconds\013\010",
    "        if s.launchStartedAt and not s.launchComplete and not s.telemetryRecovery then\013\010",

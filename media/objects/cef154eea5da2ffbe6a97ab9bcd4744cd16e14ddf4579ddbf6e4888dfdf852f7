    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Release the renewable systems lease and retain the applied provider ceilings.\010",
    "function Flight:stopSystems(io,reason,now,abortDetails)\013\010",
    "    local s=self.systemsRun\013\010",
    "    if not s then return false,\"NO ACTIVE SYSTEMS SEQUENCE\" end\013\010",
    "    self.systemsRetainedRun=clone(s)\013\010",
    "    now=now or (io.nowSeconds and io:nowSeconds()) or 0\013\010",
    "    -- Stop cancels the renewable command lease while retaining every provider\013\010",
    "    -- ceiling already applied. Never restore output against stale hardware.\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes and io.nodes[q]\013\010",
    "        if n and n.boot==s.boots[q] and io.nodeFresh and io:nodeFresh(q,now) then\013\010",
    "            pcall(io.sendSystemsStop,io,q)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local outcome=reason or \"STOPPED BY OPERATOR\"\013\010",
    "    local phase=outcome==\"STOPPED BY OPERATOR\" and \"STOPPED\" or \"ABORTED\"\013\010",
    "    self.systemsRun=nil;self.enabled=false;self.available=false;self.pending=nil;self.hoverSince=nil\013\010",
    "    self.reason=outcome\013\010",
    "    local savedDetails=type(abortDetails)==\"table\" and clone(abortDetails) or nil\013\010",
    "    self.systemsLastOutcome={phase=phase,target=s.target,reason=outcome,abortDetails=savedDetails,\013\010",
    "        initialGasTarget=clone(s.initialGasTarget)}\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=phase,pending=false,complete=false,\013\010",
    "        target=s.target,reason=outcome,warning=s.warning,curve=s.curve,\013\010",
    "        demandProgress=s.demandProgress,capacityProgress=s.capacityProgress,\013\010",
    "        abortReason=phase==\"ABORTED\" and outcome or nil,abortDetails=savedDetails,\013\010",
    "        initialGasTarget=clone(s.initialGasTarget)}\013\010",
    "    if phase==\"ABORTED\" then\013\010",
    "        logOperationIssue(self,\"flight\",\"systems\",outcome,systemsAbortText(savedDetails))\013\010",
    "    end\013\010",
    "    return true,outcome\013\010",
    "end\013\010",
    "-- Summary: Update altitude and attitude PID measurements after target acknowledgement.\010",
    "function Flight:observeSystemsPidAfterAck(io,s,now)\013\010",
    "    local elapsed=now-(s.lastPidAt or now)\013\010",
    "    observePidMeasurement(self.outer,io.vessel.altitude,elapsed)\013\010",
    "    observePidMeasurement(self.inner,io.vessel.verticalSpeed,elapsed)\013\010",
    "    local y={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        y[q]=io.nodes[q].altitude and io.nodes[q].altitude.sensorWorldY\013\010",
    "        if not finite(y[q]) then s.lastPidAt=now;return end\013\010",
    "    end\013\010",
    "    local roll=(y.FL+y.BL-y.FR-y.BR)/4\013\010",
    "    local measuredPitch=(y.FL+y.FR-y.BL-y.BR)/4\013\010",
    "    local config=self.config\013\010",
    "    if math.abs(roll)<config.trim_deadband_blocks then roll=0 end\013\010",
    "    local manualBias=finite(config.manual_fore_aft_trim_blocks) and\013\010",
    "        clamp(config.manual_fore_aft_trim_blocks,MANUAL_TRIM_MIN,MANUAL_TRIM_MAX) or 0\013\010",
    "    local pitchTarget=manualBias/2\013\010",
    "    local pitchControlMeasurement=measuredPitch\013\010",
    "    local pitchDeadband=config.trim_deadband_blocks\013\010",

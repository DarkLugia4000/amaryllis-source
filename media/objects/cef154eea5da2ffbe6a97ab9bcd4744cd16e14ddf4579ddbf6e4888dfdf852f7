    "            state = importState(statePath, dependencies)\013\010",
    "        end\013\010",
    "        local previous = state.sections[key]\013\010",
    "        if object(previous) and (not validate or validate(previous)) then state.previous[key] = previous end\013\010",
    "        state.sections[key] = value\013\010",
    "        return writeDocument(statePath, state, dependencies, validState)\013\010",
    "    end)\013\010",
    "    os.__amaryllisPersistentStateWrite = nil\013\010",
    "    if not called then return false, tostring(saved) end\013\010",
    "    return saved, reason\013\010",
    "end\013\010",
    "\013\010",
    "\013\010",
    "\013\010",
    "\013\010",
    "-- Settings save that preserves edits made to the file. Saving one setting\013\010",
    "-- used to write the whole in-memory configuration, silently reverting any\013\010",
    "-- change made to config.json since boot. This reads the file, applies only\013\010",
    "-- the changed keys, validates and writes it. A missing intermediate table is\013\010",
    "-- copied from the running configuration. A file that is unreadable or\013\010",
    "-- invalid on disk (for example mid-edit) is never overwritten.\013\010",
    "-- changes: list of {path={\"thrust\",\"speed_pid\",\"kp\"}, value=0.03}.\013\010",
    "-- Returns ok, reason, fileDiffered (the file held values the running\013\010",
    "-- configuration does not; they stay in the file and apply on reboot).\013\010",
    "local function deepCopy(value)\013\010",
    "    if type(value)~=\"table\" then return value end\013\010",
    "    local out={};for k,v in pairs(value) do out[k]=deepCopy(v) end;return out\013\010",
    "end\013\010",
    "-- Summary: Compare the requested configuration subset with the stored document.\010",
    "local function subsetDiffers(disk,memory)\013\010",
    "    if type(disk)~=\"table\" then\013\010",
    "        if type(disk)==\"number\" and type(memory)==\"number\" then return math.abs(disk-memory)>1e-12 end\013\010",
    "        return disk~=memory\013\010",
    "    end\013\010",
    "    if type(memory)~=\"table\" then return true end\013\010",

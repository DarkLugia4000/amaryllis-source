    "-- Once a configured seed has handed control to the acquisition PID, keep each\013\010",
    "-- commanded chamber map inside the support ratio the measured controller has\013\010",
    "-- requested. The seed is only an initial ceiling; it must not be treated as a\013\010",
    "-- minimum while delayed gas is still entering the envelope.\013\010",
    "-- Summary: Limit startup fill targets against the measured support envelope.\010",
    "local function capSeededStartupSupportTargets(io,maps,supportRatio,config)\013\010",
    "    local vessel=io.vessel or {}\013\010",
    "    local pressure=airPressure(vessel)\013\010",
    "    local strengths=config and config.verified_gas_lift_strengths\013\010",
    "    if not finite(vessel.mass) or vessel.mass<=0 or not pressure or type(strengths)~=\"table\" or\013\010",
    "        not finite(supportRatio) or supportRatio<0 then\013\010",
    "        return nil,\"STARTUP SEED SUPPORT CAP INPUTS UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local capped=copyMaps(maps)\013\010",
    "    local limited,floorLimited=false,false\013\010",
    "    local maximumM3PerChamber=math.huge\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local fineTarget,fineStrength=nil,nil\013\010",
    "        local bulkEntries,bulkFloor,bulkCurrent,bulkStrength={},0,0,nil\013\010",
    "        for name,provider in pairs(node and node.providers or {}) do\013\010",
    "            local amount=maps[q] and maps[q][name]\013\010",
    "            if not finite(amount) then return nil,q..\" STARTUP SUPPORT MAP INCOMPLETE\" end\013\010",
    "            if provider.controlRole==\"fine\" then\013\010",
    "                fineTarget=amount\013\010",
    "                fineStrength=configuredProviderStrength(config,provider)\013\010",
    "            elseif provider.controlRole==\"bulk\" then\013\010",
    "                local strength=configuredProviderStrength(config,provider)\013\010",
    "                local floor=math.max(provider.minimumNonzeroTarget or provider.minTarget or 50,\013\010",
    "                    provider.minTarget or 0)\013\010",
    "                if not finite(strength) or strength<=0 or not finite(floor) or\013\010",
    "                    not finite(provider.maxTarget) or amount<floor or amount>provider.maxTarget then\013\010",
    "                    return nil,q..\" STARTUP SUPPORT PROVIDER LIMITS / STRENGTH UNAVAILABLE\"\013\010",
    "                end\013\010",
    "                if bulkStrength and math.abs(bulkStrength-strength)>1e-9 then\013\010",
    "                    return nil,q..\" STARTUP STEAM STRENGTHS DO NOT MATCH\"\013\010",
    "                end\013\010",
    "                bulkStrength=strength;bulkFloor=bulkFloor+floor;bulkCurrent=bulkCurrent+amount\013\010",
    "                bulkEntries[#bulkEntries+1]={name=name,amount=amount,floor=floor}\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if not finite(fineTarget) or not finite(fineStrength) or fineStrength<=0 or\013\010",
    "            not finite(bulkStrength) or bulkStrength<=0 or #bulkEntries==0 then\013\010",
    "            return nil,q..\" STARTUP SUPPORT PROVIDER MAP INVALID\"\013\010",
    "        end\013\010",
    "        local rawBudget=vessel.mass*supportRatio/(4*pressure)\013\010",
    "        local desiredBulk=math.floor(math.max(0,rawBudget-fineTarget*fineStrength)/bulkStrength+1e-9)\013\010",
    "        maximumM3PerChamber=math.min(maximumM3PerChamber,fineTarget+desiredBulk)\013\010",
    "        if desiredBulk<bulkFloor then floorLimited=true end\013\010",
    "        if bulkCurrent>desiredBulk then\013\010",
    "            limited=true\013\010",
    "            local extra=math.max(0,bulkCurrent-bulkFloor)\013\010",
    "            local allowed=math.max(0,desiredBulk-bulkFloor)\013\010",
    "            local scale=extra>0 and math.min(1,allowed/extra) or 0\013\010",
    "            for _,entry in ipairs(bulkEntries) do\013\010",
    "                capped[q][entry.name]=entry.floor+math.floor(math.max(0,entry.amount-entry.floor)*scale)\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return capped,nil,{limited=limited,floorLimited=floorLimited,\013\010",
    "        maximumM3PerChamber=maximumM3PerChamber}\013\010",
    "end\013\010",

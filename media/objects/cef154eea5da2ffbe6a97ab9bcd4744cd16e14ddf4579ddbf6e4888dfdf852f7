    "\013\010",
    "    local steamStrength=self.config.verified_gas_lift_strengths and\013\010",
    "        self.config.verified_gas_lift_strengths.steam\013\010",
    "    if not finite(steamStrength) or steamStrength<=0 then\013\010",

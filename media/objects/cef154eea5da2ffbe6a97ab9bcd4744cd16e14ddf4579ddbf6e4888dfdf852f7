    "-- Section: Route guidance | Destination acquisition, cruise and arrival control.\010",
    "local Mathx = require(\"avionics.mathx\")\013\010",
    "-- Navigator information AP retry revision v1\013\010",
    "-- Single-entry route execution; storage, guidance and arrival action are\013\010",
    "-- separate so ordered waypoint routes can extend this without changing I/O.\013\010",
    "local Anchor=require(\"avionics.anchor\")\013\010",
    "local Library=require(\"avionics.destinations\")\013\010",
    "local AP={}\013\010",
    "local NavigationSettings=require(\"avionics.navigation_settings\")\013\010",
    "local Controls=require(\"avionics.controls\")\013\010",
    "local finite = Mathx.finite\013\010",
    "local function copy(v) if type(v)~=\"table\" then return v end;local r={};for k,x in pairs(v) do r[k]=copy(x) end;return r end\013\010",
    "local clamp = Mathx.clamp\013\010",
    "-- Section: Route guidance | Destination acquisition, cruise and arrival control.\010",
    "-- Summary: Calculate a normalized compass bearing from horizontal displacement.\010",
    "local function bearing(x,z)\013\010",
    "    local a\013\010",
    "    if math.atan2 then a=math.atan2(x,-z)\013\010",
    "    elseif -z>0 then a=math.atan(x/-z)\013\010",
    "    elseif -z<0 then a=math.atan(x/-z)+(x>=0 and math.pi or -math.pi)\013\010",
    "    else a=x>=0 and math.pi/2 or -math.pi/2 end\013\010",
    "    return math.deg(a)%360\013\010",
    "end\013\010",
    "local function log(self,reason)\013\010",
    "    if self.logged==reason then return end;self.logged=reason\013\010",
    "    if os and type(os.__amaryllisLog)==\"function\" then os.__amaryllisLog(\"Core autopilot: \"..reason,\"core.autopilot\")\013\010",
    "    else print(\"Core autopilot: \"..reason) end\013\010",
    "end\013\010",
    "-- Summary: Construct route guidance with its saved draft and destination-library access.\010",
    "function AP.new(config,storage,deps)\013\010",
    "    deps=deps or {}\013\010",
    "    local self=setmetatable({config=config,storage=storage,deps=deps,library=Library.new(deps),\013\010",
    "        active=false,state=\"OFF\",draft={cruiseSpeed=3},route=nil},{__index=AP})\013\010",
    "    if storage then\013\010",
    "        local ok,value,_,status=pcall(storage.readJson,\"/avionics/data/navigation.json\",deps)\013\010",
    "        if ok and type(value)==\"table\" and value.schemaVersion==1 and self:validDraft(value.destination,false) then\013\010",
    "            self.draft=copy(value.destination)\013\010",
    "            -- \"Destination\" was the earlier default name; such drafts are unnamed and use their coordinates.\013\010",
    "            if self.draft.name==\"Destination\" then self.draft.name=nil end\013\010",
    "        elseif status~=\"missing\" then self.reason=\"SAVED NAVIGATION SETTINGS INVALID\";log(self,self.reason) end\013\010",
    "    end\013\010",
    "    return self\013\010",
    "end\013\010",
    "-- Summary: Validate destination text, coordinates, cruise speed and altitude bounds.\010",
    "function AP:validDraft(d,complete)\013\010",
    "    local c=self.config.cockpit or {};local alt=self.config.altitude_control or {}\013\010",
    "    if type(d)~=\"table\" or (d.name~=nil and (type(d.name)~=\"string\" or #d.name<1 or #d.name>40 or\013\010",
    "        not d.name:match(\"%S\") or d.name:find(\"[%c]\"))) or not finite(d.cruiseSpeed) or d.cruiseSpeed<.1 or\013\010",
    "        d.cruiseSpeed>math.min(30,c.maximum_selected_speed or 30) then return false end\013\010",
    "    for _,key in ipairs({\"x\",\"z\"}) do\013\010",
    "        if d[key]==nil and complete~=false then return false end\013\010",
    "        if d[key]~=nil and (not finite(d[key]) or math.abs(d[key])>30000000) then return false end\013\010",
    "    end\013\010",
    "    if d.altitude==nil then return complete==false end\013\010",
    "    return finite(d.altitude) and d.altitude>=(alt.minimum_world_y or -64) and d.altitude<=2048\013\010",
    "end\013\010",
    "-- Name a destination: its entered name, or \"X, Z\" from its whole-block coordinates when no name is entered.\013\010",
    "function AP.label(d)\013\010",
    "    if type(d)~=\"table\" then return nil end\013\010",
    "    if type(d.name)==\"string\" and d.name:match(\"%S\") then return d.name end\013\010",
    "    if finite(d.x) and finite(d.z) then\013\010",
    "        return string.format(\"%d, %d\",math.floor(d.x+.5),math.floor(d.z+.5))\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Persist a validated navigator destination draft.\010",
    "function AP:saveDraft(candidate)\013\010",
    "    if not self:validDraft(candidate,false) then return false,\"DESTINATION / SPEED / ALTITUDE INVALID\" end\013\010",
    "    if self.storage then\013\010",
    "        local ok,why=self.storage.writeJson(\"/avionics/data/navigation.json\",{schemaVersion=1,destination=candidate},self.deps)\013\010",
    "        if not ok then return false,\"NAVIGATION SETTINGS NOT SAVED: \"..tostring(why) end\013\010",
    "    end\013\010",
    "    self.draft=copy(candidate);return true,\"DESTINATION UPDATED\"\013\010",
    "end\013\010",
    "-- Summary: Apply a permitted destination edit or saved-destination selection.\010",
    "function AP:edit(io,controls,action,now)\013\010",
    "    if self.active then return false,\"DISENGAGE AUTOPILOT BEFORE EDITING DESTINATION\" end\013\010",
    "    local candidate=copy(self.draft)\013\010",
    "    candidate.altitude=candidate.altitude or controls.targets.altitude\013\010",
    "    local v=io.vessel or {};local p=v.position or {}\013\010",
    "    if candidate.x==nil then candidate.x=p.x end;if candidate.z==nil then candidate.z=p.z end\013\010",
    "    if action.type==\"ap_current\" then\013\010",
    "        local sample,why=Anchor.new(self.config):telemetry(io,now)\013\010",
    "        if not sample then return false,why end\013\010",
    "        candidate.x=sample.position.x;candidate.z=sample.position.z\013\010",
    "    elseif action.type==\"ap_edit\" then\013\010",
    "        if action.key~=\"x\" and action.key~=\"z\" and action.key~=\"name\" and action.key~=\"cruiseSpeed\" and action.key~=\"altitude\" then return false,\"UNKNOWN DESTINATION FIELD\" end\013\010",
    "        candidate[action.key]=action.value\013\010",
    "        -- A blank name removes it; the destination is then named by its coordinates.\013\010",
    "        if action.key==\"name\" and (type(action.value)~=\"string\" or not action.value:match(\"%S\")) then candidate.name=nil end\013\010",
    "    elseif action.type==\"destination_select\" then\013\010",
    "        self.library:refresh();local selected=self.library.entries[action.index]\013\010",
    "        if not selected then return false,self.library.reason or \"SELECT A SAVED DESTINATION\" end\013\010",
    "        candidate.name=selected.name;candidate.x=selected.x;candidate.z=selected.z\013\010",
    "    else return false,\"UNKNOWN NAVIGATION ACTION\" end\013\010",
    "    -- A destination altitude above the altitude ceiling is set to the ceiling.\013\010",
    "    local ceiling=Controls.altitudeCeiling(self.config.altitude_control)\013\010",
    "    if finite(candidate.altitude) and finite(ceiling) and candidate.altitude>ceiling then candidate.altitude=ceiling end\013\010",
    "    return self:saveDraft(candidate)\013\010",
    "end\013\010",
    "-- Summary: Check destination, vessel and propulsion readiness for route engagement.\010",
    "function AP:ready(io,controls,now,destination,allowAnchorRelease)\013\010",
    "    if not self:validDraft(destination or self.draft) then return false,\"SET DESTINATION X/Z, CRUISE SPEED AND ALTITUDE\" end\013\010",
    "    if io.positionAnchor and io.positionAnchor.active and not allowAnchorRelease then return false,\"RELEASE ANCHOR BEFORE ENGAGING AUTOPILOT\" end\013\010",
    "    if not io.thrust or (self.config.thrust or {}).enabled~=true then return false,\"ENABLE PROPULSION FIRST\" end\013\010",
    "    local ready,why=io.thrust:activationReady(io,now,controls);if not ready then return false,why end\013\010",
    "    local v,reason=Anchor.new(self.config):telemetry(io,now);if not v then return false,reason end\013\010",
    "    local c=self.config.thrust\013\010",
    "    if not (c.speed_control_enabled or c.speed_control_verified) or not (c.heading_control_enabled or c.heading_control_verified) then return false,\"ENABLE SPEED AND HEADING CONTROL\" end\013\010",
    "    if not finite(v.heading) or not finite(v.forwardSpeed) then return false,\"HEADING / SIGNED SPEED UNAVAILABLE\" end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Capture route-start observations and initialize heading/speed acquisition.\010",
    "function AP:engage(io,controls,now)\013\010",
    "    if self.active then return false,\"AUTOPILOT ALREADY ACTIVE\" end\013\010",
    "    local ready,why=self:ready(io,controls,now);if not ready then return false,why end\013\010",
    "    if io.positionAnchor and io.positionAnchor.active then return false,\"RELEASE ANCHOR BEFORE ENGAGING AUTOPILOT\" end\013\010",
    "    self.route={entries={{name=AP.label(self.draft),x=self.draft.x,z=self.draft.z,arrival=\"anchor\"}},index=1}\013\010",
    "    self.remoteOwner=nil\013\010",
    "    self.cruiseSpeed=self.draft.cruiseSpeed;self.uuid=io.vessel.uuid\013\010",
    "    self.start={x=io.vessel.position.x,z=io.vessel.position.z};self.active=true;self.state=\"ACQ\"\013\010",
    "    self.engagedAt=now;self.updatedAt=nil\013\010",
    "    -- Impacts measured before engagement do not stop this route.\013\010",
    "    self.impactSeqAtEngage=AP.impactSeq(io)\013\010",
    "    do\013\010",
    "        local tx,tz=self.draft.x-self.start.x,self.draft.z-self.start.z\013\010",
    "        self.distance=math.sqrt(tx*tx+tz*tz);self.crossTrack=0\013\010",
    "        self.headingTarget=self.distance>.01 and bearing(tx,tz) or io.vessel.heading\013\010",
    "    end\013\010",
    "    self.reason=nil;self.since=nil;self.recoveryAttempts=0;self.nextRecoveryAttemptAt=nil\013\010",
    "    self.routeHeading=self.headingTarget\013\010",
    "    self.headingBias=0\013\010",
    "    self.acqSince=now\013\010",
    "    self.acqDetail=nil\013\010",
    "    self:resetGuidance(\"ACQ\")\013\010",
    "    local ceiling=Controls.altitudeCeiling(self.config.altitude_control)\013\010",
    "    controls.targets.altitude=finite(ceiling) and math.min(self.draft.altitude,ceiling) or self.draft.altitude\013\010",
    "    io.thrust:resetSpeedLoop();io.thrust:resetHeadingLoop()\013\010",
    "    log(self,\"ENGAGED: \"..AP.label(self.draft));return true,\"AUTOPILOT ENGAGED\"\013\010",
    "end\013\010",
    "function AP:handHeadingToPilot(io,controls)\013\010",
    "    if not (controls and controls.modes and controls.modes.heading==\"SEL\" and finite(self.headingTarget)) then return end\013\010",
    "    controls.targets.heading=self.headingTarget;controls.headingTargetUuid=self.uuid\013\010",
    "    if io.thrust and type(io.thrust.resetHeadingLoop)==\"function\" then io.thrust:resetHeadingLoop() end\013\010",
    "end\013\010",
    "-- Summary: End route guidance and hand live demands back to the pilot's levers at their current position.\010",
    "function AP:cancel(io,controls,reason,brake)\013\010",
    "    -- End a one-off remote command without retaining its destination.\013\010",
    "    if self.remoteOwner then self.route=nil end\013\010",
    "    self.remoteOwner=nil\013\010",
    "    local active=self.active;self.active=false;self.state=\"OFF\";self.since=nil;self.reason=reason\013\010",
    "    self.primaryIdle=false\013\010",
    "    self.captureSettledSeconds=0\013\010",
    "    self:resetDriftTrend()\013\010",
    "    if controls and brake~=false then\013\010",
    "        -- Keep the pilot's selections; only live authority is handed back.\013\010",
    "        -- Levers act at their current position from the next sample.\013\010",
    "        controls.request=0;controls.yaw=0;controls.holds={}\013\010",
    "        if type(controls.noteHandover)==\"function\" then controls:noteHandover() end\013\010",
    "        if controls.lateral then controls.lateral:cancel() end\013\010",
    "        controls.modes.lateral=\"MANUAL\"\013\010",
    "        if active then self:handHeadingToPilot(io,controls) end\013\010",
    "        if io.thrust then\013\010",
    "            io.thrust:resetSpeedLoop();io.thrust:resetHeadingLoop()\013\010",
    "            io.thrust:resetManualAccelerationLoop()\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if active then log(self,reason or \"DISENGAGED; SELECTED MODES RETAINED\") end\013\010",
    "end\013\010",
    "function AP.impactSeq(io)\013\010",
    "    local event=io and io.motionWarnings and io.motionWarnings.lastImpactEvent\013\010",
    "    return event and finite(event.seq) and event.seq or 0\013\010",
    "end\013\010",
    "-- Emergency stop after a measured sudden change in speed or rotation (collision or\013\010",
    "-- similar): the route is cancelled, propulsion demand drops to zero (a SEL speed\013\010",
    "-- target becomes 0) and the pilot takes over once every lever reads neutral.\013\010",
    "-- Summary: Emergency stop after a measured sudden change in speed or rotation (collision or similar): the route is cancelled, propulsion demand drops to zero (a SEL speed target becomes 0) and the pilot takes over once every lever reads neutral.\010",
    "function AP:emergencyStop(io,controls,event)\013\010",
    "    local reason=\"EMERGENCY STOP: POSSIBLE IMPACT (\"..tostring(event.axis or \"MOTION\")..\")\"\013\010",
    "    self:cancel(io,controls,reason)\013\010",
    "    self.route=nil\013\010",
    "    if controls then\013\010",
    "        if controls.modes and controls.modes.throttle==\"SEL\" and controls.targets then controls.targets.speed=0 end\013\010",
    "        controls.requireNeutral=true;controls.neutralCause=\"EMERGENCY STOP\"\013\010",
    "    end\013\010",
    "    log(self,\"ROUTE CANCELLED; \"..tostring(event.detail or \"\"))\013\010",
    "end\013\010",
    "-- Summary: Retain the route and schedule the next counted recovery attempt.\010",
    "function AP:suspend(now,reason)\013\010",
    "    self.since=self.since or now;self.lastAt=nil;self.crossDemand=0;self.reason=reason\013\010",
    "    self.primaryIdle=false\013\010",
    "    self:resetDriftTrend()\013\010",
    "    self.recoveryAttempts=(self.recoveryAttempts or 0)+1\013\010",
    "    self.nextRecoveryAttemptAt=now+2\013\010",
    "    self.state=\"RETRYING (\"..self.recoveryAttempts..\")\"\013\010",
    "    log(self,self.state..\": \"..reason)\013\010",
    "    return nil,reason\013\010",
    "end\013\010",
    "function AP:resetDriftTrend()\013\010",
    "    self.driftFiltered=0\013\010",
    "    self.driftSign=nil\013\010",
    "    self.driftSince=nil\013\010",
    "end\013\010",
    "-- Summary: Restart heading acquisition and route capture from fresh observations.\010",
    "function AP:resetGuidance(state)\013\010",
    "    self.state=state or \"ACQ\"\013\010",
    "    self.primaryIdle=true\013\010",
    "    self.speedTarget=0\013\010",
    "    self.crossDemand=0\013\010",
    "    self.sideways=0\013\010",
    "    self.lastAt=nil\013\010",
    "    self.guidanceAt=nil\013\010",
    "    self.turnSampleAt=nil\013\010",
    "    self.turnHeading=nil\013\010",
    "    self.yawRate=nil\013\010",
    "    self.turnSettledAt=nil\013\010",
    "    self.turnLooseAt=nil\013\010",
    "    self.captureSince=nil\013\010",
    "    self.captureSettledSeconds=0\013\010",
    "    self:resetDriftTrend()\013\010",
    "end\013\010",
    "-- Summary: Copy pilot selections into the current route's transient propulsion demands.\010",
    "function AP:guidanceControls(controls)\013\010",
    "    local proxy={}\013\010",
    "    for key,value in pairs(controls) do proxy[key]=value end\013\010",
    "    proxy.modes=copy(controls.modes)\013\010",
    "    proxy.targets=copy(controls.targets)\013\010",
    "    proxy.modes.heading=\"SEL\"\013\010",
    "    proxy.modes.throttle=self.primaryIdle and \"DIRECT\" or \"SEL\"\013\010",
    "    proxy.targets.heading=self.headingTarget\013\010",
    "    proxy.targets.speed=self.speedTarget\013\010",
    "    proxy.holdPropulsion=false\013\010",
    "    proxy.speedTargetUuid=self.uuid\013\010",
    "    proxy.headingTargetUuid=self.uuid\013\010",
    "    proxy.request=0\013\010",
    "    proxy.yaw=0\013\010",
    "    proxy.sideways=clamp(self.sideways or 0,-1,1)\013\010",
    "    proxy.routeLateralAuthority=true\013\010",
    "    proxy.routeSpeedAuthority=true\013\010",
    "    proxy.apPrimaryIdle=self.primaryIdle==true\013\010",
    "    proxy.apAcquisition=self.state==\"ACQ\"\013\010",
    "    return proxy\013\010",
    "end\013\010",
    "-- Summary: Slew route-normal correction and project it onto the vessel's lateral axis.\010",
    "function AP:updateRouteLateral(v,nx,nz,tuning,dt)\013\010",
    "    local wantedSpeed=clamp(-self.crossTrack*tuning.cross_gain,\013\010",
    "        -tuning.maximum_cross_speed,tuning.maximum_cross_speed)\013\010",
    "    local wanted=clamp(tuning.velocity_gain*(wantedSpeed-self.crossSpeed),-1,1)\013\010",
    "    local previous=self.crossDemand or 0\013\010",
    "    self.crossDemand=clamp(wanted,previous-tuning.output_slew*dt,previous+tuning.output_slew*dt)\013\010",
    "    local forward=v.forwardDirection\013\010",
    "    local length=math.sqrt(forward.x^2+forward.z^2)\013\010",
    "    self.sideways=self.crossDemand*(nx*(-forward.z)+nz*forward.x)/length\013\010",
    "end\013\010",
    "-- The filter time constant is four seconds; its demand deadband is 0.02.\013\010",
    "-- Summary: Learn a rate-limited heading bias from a consistent fresh-sample cruise correction.\010",
    "function AP:updateHeadingBias(v,headingError,yawRate,tuning,dt,newSample)\013\010",
    "    if not newSample then return end\013\010",
    "    if dt<=0 or self.state~=\"CRUISE\" or v.forwardSpeed<tuning.drift_minimum_speed or\013\010",
    "        math.abs(headingError)>3 or not finite(yawRate) or yawRate>.5 or math.abs(self.crossTrack)>4 then\013\010",
    "        self:resetDriftTrend()\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local alpha=1-math.exp(-dt/4)\013\010",
    "    self.driftFiltered=(self.driftFiltered or 0)+alpha*(self.crossDemand-(self.driftFiltered or 0))\013\010",
    "    local signal=self.driftFiltered\013\010",
    "    if math.abs(signal)<=.02 then\013\010",
    "        self.driftSign=nil\013\010",
    "        self.driftSince=nil\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local direction=signal>0 and 1 or -1\013\010",
    "    if direction~=self.driftSign then\013\010",
    "        self.driftSign=direction\013\010",
    "        self.driftSince=v.at\013\010",
    "        return\013\010",
    "    end\013\010",
    "    local qualifiedAt=self.driftSince+tuning.drift_observation_seconds\013\010",
    "    local learningSeconds=math.max(0,v.at-math.max(v.at-dt,qualifiedAt))\013\010",
    "    self.headingBias=clamp((self.headingBias or 0)+direction*tuning.drift_heading_rate*learningSeconds,\013\010",
    "        -tuning.drift_heading_limit,tuning.drift_heading_limit)\013\010",
    "end\013\010",
    "-- Summary: Advance route heading, speed and arrival guidance from fresh vessel observations.\010",
    "function AP:update(io,now,controls)\013\010",
    "    if not self.active then return controls end\013\010",
    "    local impact=io.motionWarnings and io.motionWarnings.lastImpactEvent\013\010",
    "    if impact and AP.impactSeq(io)>(self.impactSeqAtEngage or 0) then\013\010",
    "        self:emergencyStop(io,controls,impact)\013\010",
    "        return nil,self.reason\013\010",
    "    end\013\010",
    "    if self.since and self.nextRecoveryAttemptAt and now<self.nextRecoveryAttemptAt and self.recoveryObservedAt==(io.vessel or {}).at then return nil,self.reason end\013\010",
    "    self.recoveryObservedAt=(io.vessel or {}).at\013\010",
    "    self.updatedAt=now\013\010",
    "    if (self.config.thrust or {}).enabled~=true then self:cancel(io,controls,\"PROPULSION DISABLED\",false);return nil,self.reason end\013\010",
    "    if io.identityReady~=true then return self:suspend(now,\"CORE IDENTITY UNVERIFIED\") end\013\010",
    "    if type(io.routeAllowed)==\"function\" then local ok,why=io:routeAllowed();if not ok then return self:suspend(now,why) end end\013\010",
    "    if type(io.assemblyGate)==\"function\" then\013\010",
    "        local assembled,why,detail=io:assemblyGate(now)\013\010",
    "        if not assembled then\013\010",
    "            if detail and detail.state==\"DISASSEMBLED\" then\013\010",
    "                self:cancel(io,controls,\"VESSEL DISASSEMBLED; RE-ENGAGEMENT REQUIRED\",false)\013\010",
    "                return nil,self.reason\013\010",
    "            end\013\010",
    "            return self:suspend(now,why)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local currentID=(io.vessel or {}).uuid\013\010",
    "    if currentID and self.uuid and currentID~=self.uuid then self:cancel(io,controls,\"VESSEL IDENTITY CHANGED\",false);return nil,self.reason end\013\010",
    "    local v,reason=Anchor.new(self.config):telemetry(io,now);if not v then return self:suspend(now,reason) end\013\010",
    "    if v.uuid~=self.uuid then self:cancel(io,controls,\"VESSEL IDENTITY CHANGED\",false);return nil,self.reason end\013\010",
    "    if not controls or controls.available~=true then return self:suspend(now,\"COCKPIT INPUTS UNAVAILABLE\") end\013\010",
    "    for _,role in ipairs(io.thrust.CONTROLLERS) do local ok,issue=io.thrust:controllerReady(role,now);if not ok then return self:suspend(now,role..\": \"..tostring(issue)) end end\013\010",
    "    for _,role in ipairs(io.thrust.UNITS) do\013\010",
    "        local node=io.thrust.units[role]\013\010",
    "        if not io.thrust:fresh(node,now) or not node.status or node.status.available~=true or #node.status.readings==0 then\013\010",
    "            return self:suspend(now,role..\": SHAFT SPEED TELEMETRY UNAVAILABLE\")\013\010",
    "        end\013\010",
    "        for _,reading in ipairs(node.status.readings) do\013\010",
    "            if not reading.validity or reading.validity.speedRaw~=true or not finite(reading.speedRaw) then\013\010",
    "                return self:suspend(now,role..\": SHAFT SPEED TELEMETRY INVALID\")\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.since or self.state==\"RECOVERING\" then\013\010",
    "        log(self,\"TELEMETRY RECOVERED; REACQUIRING RETAINED ROUTE\")\013\010",
    "        self:resetGuidance(\"ACQ\")\013\010",
    "        self.acqSince=now\013\010",
    "        io.thrust:resetSpeedLoop()\013\010",
    "    end\013\010",

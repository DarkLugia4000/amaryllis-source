    "        snapshot.systemsStartup.phase=\"RESTARTING\"\013\010",
    "        snapshot.systemsStartup.pending=true;snapshot.systemsStartup.complete=false\013\010",
    "        snapshot.systemsStartup.reason=restart.reason\013\010",
    "        snapshot.systemsStartup.abortReason=nil;snapshot.systemsStartup.abortDetails=nil\013\010",
    "    end\013\010",
    "    if self.systemsRun then\013\010",
    "        local s=self.systemsRun\013\010",
    "        local selected=self.controls and self.controls.targets and self.controls.targets.altitude\013\010",
    "        local presentationTarget=self.initialAcquisitionTarget or s.target\013\010",
    "        if finite(selected) and selected~=presentationTarget then self.initialAcquisitionEnded=true end\013\010",
    "        local displayPhase=s.phase\013\010",
    "        if s.phase==\"READY\" then displayPhase=\"READY\"\013\010",
    "        elseif s.phase==\"VENT_IGNITION\" then displayPhase=\"OPENING STEAM VENTS\"\013\010",
    "        elseif s.phase==\"MAIN_LIFT\" then\013\010",

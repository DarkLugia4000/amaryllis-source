    "-- Settings editor definitions, exposed for the registry consistency test.\013\010",
    "Flight._settingsFields=FIELDS\013\010",
    "local function clone(t)\013\010",
    " if type(t)~=\"table\" then return t end\013\010",
    " local out={};for k,v in pairs(t) do out[k]=clone(v) end;return out\013\010",
    "end\013\010",
    "local function readPath(c,path)\013\010",
    " for _,key in ipairs(path) do if type(c)~=\"table\" then return nil end;c=c[key] end;return c\013\010",
    "end\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Validate a settings edit, save its configured value and update the affected live controller.\010",
    "function Flight:setting(io,action,now)\013\010",
    " local holding=self.systemsRun and self.systemsRun.phase==\"READY\"\013\010",
    " if (self.enabled and not holding) or self.tuningRun or self.startupPending or\013\010",
    "  (self.systemsRun and not holding) or self.maintenanceJob then return false,\"DISENGAGE / FINISH LIFT OPERATION FIRST\" end\013\010",
    " if holding then\013\010",
    "  if self.systemsRun.telemetryRecovery then return false,\"WAIT FOR LIFT TELEMETRY RECOVERY\" end\013\010",
    "  local available,reason=self:systemsGuard(io,now,self.systemsRun)\013\010",
    "  if not available then return false,reason end\013\010",
    " end\013\010",
    " if not holding and (io.anchor==\"ANCHORED\" or io.anchor==\"BRAKING\") then return false,\"ANCHOR LOCKS FLIGHT SETTINGS\" end\013\010",
    " local definition\013\010",
    " for _,f in ipairs(FIELDS) do if f.key==action.key then definition=f;break end end\013\010",
    " if not definition or not finite(action.value) or action.value<definition.min or action.value>definition.max then return false,\"SETTING OUT OF RANGE\" end\013\010",
    " if definition.group:match(\"^NAV\") and ((io.autopilot and io.autopilot.active) or\013\010",
    "    (io.positionAnchor and io.positionAnchor.active)) then return false,\"DISENGAGE AP / RELEASE ANCHOR BEFORE TUNING\" end\013\010",
    " local navOk,navReason=NavigationSettings.ensure(io.config)\013\010",
    " if not navOk then return false,navReason end\013\010",
    " local candidate=clone(io.config);local node=candidate\013\010",
    " for i=1,#definition.path-1 do node=node[definition.path[i]];if type(node)~=\"table\" then return false,\"SETTING UNAVAILABLE\" end end\013\010",
    " node[definition.path[#definition.path]]=action.value\013\010",
    " if action.key==\"cockpit_timeout\" then node.maximum_input_gap_seconds=action.value end\013\010",
    " if action.key==\"primary_max_rpm\" then candidate.thrust.direct_max_request=action.value/256 end\013\010",
    "   if action.key==\"speed_target_rate\" then candidate.thrust.speed_target_rate_bps2=action.value end\013\010",
    " if not self.storage then return false,\"CONFIGURATION STORAGE UNAVAILABLE\" end\013\010",
    " local ok,reason=self.storage.validateConfig(candidate);if not ok then return false,reason end\013\010",
    " local changes={{path=definition.path,value=action.value}}\013\010",
    " if action.key==\"cockpit_timeout\" then\013\010",
    "  local p={};for i=1,#definition.path-1 do p[i]=definition.path[i] end\013\010",
    "  p[#p+1]=\"maximum_input_gap_seconds\";changes[#changes+1]={path=p,value=action.value}\013\010",
    " end\013\010",
    " if action.key==\"primary_max_rpm\" then changes[#changes+1]={path={\"thrust\",\"direct_max_request\"},value=action.value/256} end\013\010",
    " if action.key==\"speed_target_rate\" then changes[#changes+1]={path={\"thrust\",\"speed_target_rate_bps2\"},value=action.value} end\013\010",
    " local differed\013\010",
    " if type(self.storage.saveConfigChanges)==\"function\" then\013\010",
    "  ok,reason,differed=self.storage.saveConfigChanges(\"/avionics/config.json\",io.config,changes,self.settingsDependencies)\013\010",
    " else ok,reason=self.storage.writeJson(\"/avionics/config.json\",candidate,self.settingsDependencies) end\013\010",
    " if not ok then return false,\"CONFIGURATION NOT SAVED: \"..tostring(reason) end\013\010",
    " if differed then\013\010",
    "  emitCoreLog(\"Setting \"..tostring(action.key)..\" saved; config.json also holds edits not yet loaded (they apply on reboot)\",\"core.flight.settings\")\013\010",
    " end\013\010",
    " -- Keep existing PID and cockpit references, rather than replacing their tables.\013\010",
    " node=io.config;for i=1,#definition.path-1 do node=node[definition.path[i]] end\013\010",
    " node[definition.path[#definition.path]]=action.value\013\010",
    " if action.key==\"cockpit_timeout\" then node.maximum_input_gap_seconds=action.value end\013\010",
    " if action.key==\"primary_max_rpm\" then io.config.thrust.direct_max_request=action.value/256 end\013\010",
    "   if action.key==\"speed_target_rate\" then io.config.thrust.speed_target_rate_bps2=action.value end\013\010",
    "   -- A cockpit-input change restarts held-input ramps so the new rates\013\010",
    "   -- apply from the next sample; levers keep acting at their current position.\013\010",
    "   local inputSetting=Flight.COCKPIT_INPUT_GROUPS[definition.group]==true\013\010",
    "   if self.controls and inputSetting then\013\010",
    "    self.controls.holds={};self.controls.headingKind=nil\013\010",
    "   end\013\010",
    "   if io.thrust and definition.group:match(\"^PROP\") and action.key~=\"speed_target_rate\" then\013\010",
    "       io.thrust:resetSpeedLoop();io.thrust:resetManualAccelerationLoop();io.thrust:resetHeadingLoop()\013\010",
    "   end\013\010",
    " -- Editing a live HOLD must preserve its acquired support and PID history.\013\010",
    " if not holding and not inputSetting and action.key~=\"speed_target_rate\" then\013\010",
    "  if self.outer then self.outer:reset() end;if self.inner then self.inner:reset() end\013\010",
    " end\013\010",
    " self.maintenanceReview=nil;self.tuningReview=nil\013\010",
    " return true,\"SETTING SAVED\"\013\010",
    "end\013\010",
    "-- Section: Leveling | Chamber-height feedback and retained trim allocation.\010",
    "-- Summary: Evaluate whether the current vessel observations permit a manual fore/aft bias edit.\010",
    "function Flight:manualTrimAvailability(io,now)\013\010",
    " if type(io)~=\"table\" then return false,\"CORE READER UNAVAILABLE\" end\013\010",
    " if not finite(now) and type(io.nowSeconds)==\"function\" then\013\010",
    "  local ok,current=pcall(io.nowSeconds,io);if ok and finite(current) then now=current end\013\010",
    " end\013\010",
    " local routeAllowed,routeReason=true,nil\013\010",
    " if type(io.routeAllowed)==\"function\" then\013\010",
    "  local ok,allowed,reason=pcall(io.routeAllowed,io)\013\010",
    "  routeAllowed=ok and allowed==true;routeReason=ok and reason or allowed\013\010",
    " elseif io.identityReady==false then routeAllowed=false;routeReason=io.identityReason end\013\010",
    " if not routeAllowed then return false,routeReason or \"CORE IDENTITY / ROUTE UNVERIFIED\" end\013\010",
    " local config=io.config and io.config.altitude_control\013\010",
    " local bias=config and config.manual_fore_aft_trim_blocks\013\010",
    " if not finite(bias) or bias<MANUAL_TRIM_MIN or bias>MANUAL_TRIM_MAX then\013\010",
    "  return false,\"MANUAL TRIM CONFIGURATION INVALID\"\013\010",
    " end\013\010",
    " if not self.storage or type(self.storage.validateConfig)~=\"function\" or\013\010",
    "  type(self.storage.writeJson)~=\"function\" then return false,\"CONFIGURATION STORAGE UNAVAILABLE\" end\013\010",
    " local validated,valid,validationReason=pcall(self.storage.validateConfig,io.config)\013\010",
    " if not validated or not valid then\013\010",
    "  return false,\"CONFIGURATION INVALID: \"..tostring(validated and validationReason or valid)\013\010",
    " end\013\010",
    " if self.shutdownJob or self.stopReview then return false,\"STOPPING / STOP REVIEW IN PROGRESS\" end\013\010",
    " if self.tuningRun or self.tuningReview then return false,\"PID TUNING IN PROGRESS\" end\013\010",
    " if self.maintenanceJob or self.maintenanceReview then return false,\"LIFT MAINTENANCE IN PROGRESS\" end\013\010",
    " if self.startupPending then return false,\"VENT STARTUP IN PROGRESS\" end\013\010",
    " if self.emergencyLiftLatched then\013\010",
    "  local kill=self.emergencyLiftJob\013\010",
    "  if not kill or kill.complete~=true then\013\010",
    "   return false,(kill and kill.reason) or \"EMERGENCY LIFT KILL IN PROGRESS\"\013\010",
    "  end\013\010",
    " end\013\010",
    " if self.systemsRun then\013\010",
    "  if self.systemsRun.phase~=\"READY\" then return false,\"AVAILABLE AFTER SYSTEMS READY\" end\013\010",
    "   if self.systemsRun.acquisitionPidActive~=true then\013\010",
    "    return false,\"ALTITUDE CONTROL PLANT INPUTS UNAVAILABLE\"\013\010",
    "   end\013\010",
    "  if not finite(now) then return false,\"FRESH CONTROL STATE UNAVAILABLE\" end\013\010",
    "  local ok,reason=self:systemsGuard(io,now,self.systemsRun)\013\010",
    "  if not ok then return false,reason or \"SYSTEMS HOLD STATE STALE\" end\013\010",
    "  return true,\"READY\"\013\010",
    " end\013\010",
    " if self.enabled then\013\010",
    "  if not finite(now) then return false,\"FRESH CONTROL STATE UNAVAILABLE\" end\013\010",
    "  local ok,reason=self:check(io,now)\013\010",
    "  if not ok then return false,reason or \"ALTITUDE PID HOLD STATE STALE\" end\013\010",
    " end\013\010",
    " return true,\"READY\"\013\010",
    "end\013\010",
    "-- Summary: Apply an accepted fore/aft trim adjustment and persist the selected bias.\010",
    "function Flight:manualTrimRequest(io,action,now)\013\010",
    " local available,reason=self:manualTrimAvailability(io,now)\013\010",
    " if not available then return false,reason end\013\010",
    " local c=io.config and io.config.altitude_control\013\010",
    " local current=c and c.manual_fore_aft_trim_blocks\013\010",
    " if not finite(current) then return false,\"MANUAL TRIM CONFIGURATION INVALID\" end\013\010",
    " local value\013\010",
    " if action.type==\"manual_trim_reset\" then\013\010",
    "  value=0\013\010",
    " elseif action.type==\"manual_trim_adjust\" then\013\010",
    "  local delta=action.delta\013\010",
    "  local validStep=delta==0.1 or delta== -0.1 or delta==0.5 or delta== -0.5\013\010",
    "  if not finite(delta) or not validStep then return false,\"USE A MANUAL TRIM STEP OF 0.1 OR 0.5 BLOCKS\" end\013\010",
    "  local tenths=(current+delta)*10\013\010",
    "  value=(tenths>=0 and math.floor(tenths+0.5) or math.ceil(tenths-0.5))/10\013\010",
    "  if value<MANUAL_TRIM_MIN or value>MANUAL_TRIM_MAX then\013\010",
    "   return false,\"MANUAL TRIM LIMIT IS 2 BLOCKS FORE / AFT\"\013\010",
    "  end\013\010",
    " else\013\010",
    "  return false,\"INVALID MANUAL TRIM ACTION\"\013\010",
    " end\013\010",
    " local candidate=clone(io.config)\013\010",
    " if type(candidate)~=\"table\" or type(candidate.altitude_control)~=\"table\" then\013\010",
    "  return false,\"MANUAL TRIM CONFIGURATION UNAVAILABLE\"\013\010",
    " end\013\010",
    " candidate.altitude_control.manual_fore_aft_trim_blocks=value\013\010",
    " if not self.storage or type(self.storage.validateConfig)~=\"function\" or\013\010",
    "  type(self.storage.writeJson)~=\"function\" then return false,\"CONFIGURATION STORAGE UNAVAILABLE\" end\013\010",
    " local called,valid,validationReason=pcall(self.storage.validateConfig,candidate)\013\010",
    " if not called or not valid then\013\010",
    "  return false,\"CONFIGURATION INVALID: \"..tostring(called and validationReason or valid)\013\010",
    " end\013\010",
    " local writeCalled,saved,saveReason\013\010",
    " if type(self.storage.saveConfigChanges)==\"function\" then\013\010",
    "  writeCalled,saved,saveReason=pcall(self.storage.saveConfigChanges,\"/avionics/config.json\",io.config,\013\010",
    "   {{path={\"altitude_control\",\"manual_fore_aft_trim_blocks\"},value=value}},self.settingsDependencies)\013\010",
    " else\013\010",
    "  writeCalled,saved,saveReason=pcall(self.storage.writeJson,\"/avionics/config.json\",candidate,\013\010",
    "   self.settingsDependencies)\013\010",
    " end\013\010",
    " if not writeCalled then saveReason=saved;saved=false end\013\010",
    " if not saved then return false,\"CONFIGURATION NOT SAVED: \"..tostring(saveReason) end\013\010",
    " c.manual_fore_aft_trim_blocks=value\013\010",
    " if self.config and self.config~=c then self.config.manual_fore_aft_trim_blocks=value end\013\010",
    " emitCoreLog(\"Core manual fore-aft trim bias set to \"..string.format(\"%.1f\",value)..\" world blocks\",\013\010",
    "  \"core.flight.manual-trim\")\013\010",
    " return true,\"MANUAL TRIM BIAS SAVED\"\013\010",
    "end\013\010",
    "function Flight:maintenanceState(io,now)\013\010",
    " local v=io.vessel or {};local c=io.config.maintenance or {}\013\010",
    " local valid=v.valid==true and finite(v.altitude) and finite(v.at) and now>=v.at and now-v.at<=io.config.network.sensor_stale_seconds\013\010",
    " return {threshold=c.restart_altitude_limit or 165,altitude=valid and v.altitude or nil,altitudeValid=valid,\013\010",
    "  locked=not valid or v.altitude>(c.restart_altitude_limit or 165),review=self.maintenanceReview,\013\010",
    "  job=self.maintenanceJob,status=self.maintenanceStatus}\013\010",
    "end\013\010",
    "local function failMaintenance(self,job,status)\013\010",
    " self.maintenanceStatus=status\013\010",
    " self.maintenanceJob=nil\013\010",
    " logOperationIssue(self,\"flight\",\"maintenance\",job.operation..\": \"..status)\013\010",
    "end\013\010",
    "-- Status names for each chamber maintenance operation.\013\010",
    "local MAINTENANCE_NAMES={restart=\"RESTART\",recheck=\"RECHECK\",probe_cycle=\"GAS MIX FIX\"}\013\010",
    "-- Section: Maintenance | Reviewed chamber rechecks and restarts.\010",
    "-- Summary: Validate and stage chamber restart, hardware-recheck or probe-restart maintenance.\010",
    "function Flight:maintenanceRequest(io,action,now)\013\010",
    " local kind=action.type\013\010",
    " if kind==\"maintenance_cancel\" then self.maintenanceReview=nil;return true end\013\010",
    " if self.maintenanceJob or self.startupPending or self.systemsRun or self.tuningRun then return false,\"LIFT OPERATION ALREADY PENDING\" end\013\010",
    " if kind==\"maintenance_review\" or kind==\"maintenance_recheck\" or kind==\"maintenance_probe_cycle\" then\013\010",
    "  local scope=action.scope or \"ALL\";local list={}\013\010",
    "  if scope==\"ALL\" then for _,q in ipairs(QUADS) do list[#list+1]=q end\013\010",
    "  else for _,q in ipairs(QUADS) do if q==scope then list[1]=q end end end\013\010",
    "  if #list==0 then return false,\"INVALID MAINTENANCE SCOPE\" end\013\010",
    "  local boots={};for _,q in ipairs(list) do\013\010",
    "   if not io:nodeFresh(q,now) or not io.nodes[q].boot then return false,\"WAITING FOR LIFT NODE \"..q end\013\010",
    "   boots[q]=io.nodes[q].boot\013\010",
    "  end\013\010",
    "  if kind==\"maintenance_recheck\" or kind==\"maintenance_probe_cycle\" then\013\010",
    "   if self.enabled then return false,\"DISENGAGE ALTITUDE CONTROL FIRST\" end\013\010",
    "   self.coreLogIssues=self.coreLogIssues or {};self.coreLogIssues[issueScope(\"flight\",\"maintenance\")]=nil\013\010",
    "   self.maintenanceJob={operation=kind==\"maintenance_recheck\" and \"recheck\" or \"probe_cycle\",list=list,index=1,boots=boots}\013\010",
    "   self:updateMaintenance(io,now);return true\013\010",
    "  end\013\010",
    "  if self.enabled then return false,\"DISENGAGE ALTITUDE CONTROL FIRST\" end\013\010",
    "  self.reviewSeq=(self.reviewSeq or 0)+1\013\010",
    "  self.maintenanceReview={token=tostring(self.reviewSeq)..\":\"..tostring(now),scope=scope,list=list,boots=boots,\013\010",
    "   expires=now+(io.config.maintenance and io.config.maintenance.confirmation_seconds or 30),override=false}\013\010",
    "  return true,\"REVIEW RESTART\"\013\010",
    " end\013\010",
    " local r=self.maintenanceReview\013\010",
    " if not r or action.token~=r.token or now>r.expires then self.maintenanceReview=nil;return false,\"RESTART REVIEW EXPIRED\" end\013\010",
    " local state=self:maintenanceState(io,now)\013\010",
    " if not state.altitudeValid then return false,\"FRESH CoM ALTITUDE REQUIRED\" end\013\010",
    " if kind==\"maintenance_override\" then r.override=true;return true,\"ONE RESTART OVERRIDE READY; CONFIRM SEPARATELY\" end\013\010",
    " if kind~=\"maintenance_confirm\" then return false,\"INVALID MAINTENANCE ACTION\" end\013\010",
    " if state.locked and not r.override then return false,\"ALTITUDE LOCK: OVERRIDE REQUIRED\" end\013\010",
    " for _,q in ipairs(r.list) do\013\010",
    "  if not io:nodeFresh(q,now) or io.nodes[q].boot~=r.boots[q] then self.maintenanceReview=nil;return false,q..\" NODE CHANGED; REVIEW AGAIN\" end\013\010",
    " end\013\010",
    " self.coreLogIssues=self.coreLogIssues or {};self.coreLogIssues[issueScope(\"flight\",\"maintenance\")]=nil\013\010",
    " self.maintenanceReview=nil;self:stop(\"LIFT RESTART REQUESTED\")\013\010",
    " self.maintenanceJob={operation=\"restart\",list=r.list,index=1,boots=r.boots,override=r.override}\013\010",
    " self:updateMaintenance(io,now);return true,\"RESTART QUEUED\"\013\010",
    "end\013\010",
    "-- Summary: Advance the current chamber maintenance operation through acknowledgement and reconnect.\010",
    "function Flight:updateMaintenance(io,now)\013\010",
    " if self.maintenanceReview and now>self.maintenanceReview.expires then self.maintenanceReview=nil end\013\010",
    " local job=self.maintenanceJob;if not job then return end\013\010",
    " local q=job.list[job.index]\013\010",
    " if not q then\013\010",
    "  self.maintenanceStatus=(MAINTENANCE_NAMES[job.operation] or string.upper(job.operation))..\" COMPLETE\";self.maintenanceJob=nil\013\010",
    "  clearOperationIssue(self,\"flight\",\"maintenance\",\"Core flight maintenance recovered: \"..job.operation..\" complete\")\013\010",
    "  return\013\010",
    " end\013\010",
    " if job.seq then\013\010",
    "  if job.operation==\"restart\" and io:nodeFresh(q,now) and io.nodes[q].boot~=job.boots[q] and\013\010",
    "   io.nodes[q].startReady and io.nodes[q].altitude and io.nodes[q].altitude.valid and\013\010",
    "   io.nodes[q].balloon and io.nodes[q].balloon.hasBalloonValid and io.nodes[q].balloon.hasBalloon then\013\010",
    "   job.index=job.index+1;job.seq=nil;self.maintenanceStatus=q..\" RECONNECTED\";return\013\010",
    "  end\013\010",
    "  if now-job.sentAt>(io.config.maintenance and io.config.maintenance.reconnect_timeout_seconds or 20) then\013\010",
    "   failMaintenance(self,job,q..\" \"..string.upper(job.operation)..\" TIMED OUT; CHECK CONSOLE\")\013\010",
    "  end\013\010",
    "  return\013\010",
    " end\013\010",
    " if job.operation==\"restart\" then\013\010",
    "  local state=self:maintenanceState(io,now)\013\010",
    "  if not state.altitudeValid or (state.locked and not job.override) then\013\010",
    "   failMaintenance(self,job,\"ALTITUDE LOCK CHANGED; REMAINING RESTARTS STOPPED\");return\013\010",
    "  end\013\010",
    " end\013\010",
    " -- Each ALL restart is sent only after the previous node has reconnected.\013\010",
    " if not io:nodeFresh(q,now) or io.nodes[q].boot~=job.boots[q] then\013\010",
    "  failMaintenance(self,job,q..\" NODE CHANGED; OPERATION STOPPED\");return\013\010",
    " end\013\010",
    " local ok,seq=io:sendLiftMaintenance(q,job.operation)\013\010",
    " if not ok then failMaintenance(self,job,q..\" SEND FAILED: \"..tostring(seq));return end\013\010",
    " job.seq=seq;job.sentAt=now;job.quadrant=q\013\010",
    " self.maintenanceStatus=q..(job.operation==\"restart\" and \" WAITING FOR RECONNECT\" or\013\010",
    "  (job.operation==\"probe_cycle\" and \" RESTARTING PROBE\" or \" RECHECKING HARDWARE\"))\013\010",
    "end\013\010",
    "-- Summary: Correlate a chamber maintenance reply with the active operation.\010",
    "function Flight:maintenanceAck(io,sender,message,now)\013\010",
    " local job=self.maintenanceJob\013\010",
    " if not job or type(message)~=\"table\" or message.v~=1 or message.kind~=\"lift_maintenance_ack\" or\013\010",
    "  message.session~=io.session or message.seq~=job.seq or message.operation~=job.operation or\013\010",
    "  message.quadrant~=job.quadrant or message.nodeBoot~=job.boots[job.quadrant] or\013\010",
    "  sender~=io.config.node_ids[job.quadrant] then return false end\013\010",
    " if message.ok~=true then failMaintenance(self,job,job.quadrant..\" FAILED: \"..tostring(message.detail or \"REMOTE OPERATION FAILED\"):sub(1,160))\013\010",
    " elseif job.operation==\"recheck\" or job.operation==\"probe_cycle\" then\013\010",
    "  self.maintenanceStatus=job.quadrant..\" \"..tostring(message.detail or \"DONE\"):sub(1,160)\013\010",
    "  job.index=job.index+1;job.seq=nil\013\010",
    " end\013\010",
    " return true\013\010",
    "end\013\010",
    "\013\010",
    "\013\010",
    "-- Tuning is temporary authority, never permanent commissioning. Tests capture\013\010",
    "-- actual provider ceilings, bypass approval flags only, and keep burner trim fixed.\013\010",
    "-- Section: Bounded tests | Captured baselines, bounded demand and result persistence.\010",
    "-- Summary: Check telemetry, hover stability and vent headroom for a bounded PID test.\010",
    "function Flight:tuningReady(io,now)\013\010",
    " if not io.config.tuning or io.config.tuning.enabled~=true then return false,\"TUNING MODE DISABLED\" end\013\010",
    " if self.enabled or self.maintenanceJob or self.startupPending or self.systemsRun then return false,\"FINISH OTHER LIFT OPERATION FIRST\" end\013\010",
    " if io.anchor==\"ANCHORED\" or io.anchor==\"BRAKING\" then return false,\"RELEASE DIGITAL ANCHOR FIRST\" end\013\010",
    " local ok,reason=self:check(io,now,true);if not ok then return false,reason end\013\010",
    " for _,q in ipairs(QUADS) do\013\010",
    "  local n=io.nodes[q]\013\010",
    "  if not self.tuningRun and (n.armed or n.operationBusy) then return false,q..\" CONTROLLER STILL OPERATING\" end\013\010",
    "  if n.tuningSupported~=true then return false,q..\" LOAD TUNING RECEIVER\" end\013\010",
    "  for _,p in pairs(n.providers) do if p.controlRole==\"bulk\" and\013\010",
    "   (math.floor(p.targetAmount*.95)<p.minimumNonzeroTarget or math.ceil(p.targetAmount*1.05)>p.maxTarget) then\013\010",
    "   return false,q..\" HOVER BASELINE NEEDS +/-5% VENT HEADROOM\"\013\010",
    "  end end\013\010",
    " end\013\010",
    " local baseline={}\013\010",
    " for _,q in ipairs(QUADS) do\013\010",
    "  baseline[q]={}\013\010",
    "  for name,p in pairs(io.nodes[q].providers) do baseline[q][name]=p.targetAmount end\013\010",
    " end\013\010",
    " local within,capReason=self:balancedTargetsFit(io,baseline,now,io.vessel.altitude)\013\010",
    " if not within then return false,capReason end\013\010",
    " return true\013\010",
    "end\013\010",
    "-- Summary: Store the PID test measurements and its baseline-restoration result.\010",
    "function Flight:finishTuning(io,status)\013\010",
    " local t=self.tuningRun;if not t then return end\013\010",
    " for _,q in ipairs(QUADS) do io:cancelTuning(q,t.id) end\013\010",
    " local report={schema_version=1,id=t.id,mode=t.mode,direction=t.direction,status=status,\013\010",
    "  baselineY=t.y,target=t.target,gains=clone(t.gains),baselineCeilings=clone(t.baseline),samples=t.samples,\013\010",
    "  peakError=t.peakError or 0,rmsError=t.count>0 and math.sqrt(t.errorSquares/t.count) or 0,\013\010",
    "  saturationSamples=t.saturationSamples,baselineRestored=t.restored==true}\013\010",
    " self.tuningResult={status=status,peakError=report.peakError,rmsError=report.rmsError,\013\010",
    "  saturationSamples=report.saturationSamples,baselineRestored=report.baselineRestored,mode=t.mode}\013\010",
    " self.tuningRun=nil;self.tuningHoverSince=nil\013\010",
    " if self.storage then\013\010",
    "  local ok,reason=self.storage.writeJson(\"/avionics/data/tuning-last.json\",report,self.settingsDependencies)\013\010",
    "  if not ok then self.tuningResult.saveError=tostring(reason) end\013\010",
    " else self.tuningResult.saveError=\"RECORD STORAGE UNAVAILABLE\" end\013\010",
    " self.reason=\"ALTITUDE TUNING NOT COMMISSIONED\"\013\010",
    " local line=logText(\"PID tuning: \"..status..\"; baseline restored=\"..tostring(report.baselineRestored),240)\013\010",
    " if status:sub(1,9)==\"ABORTED:\" then\013\010",
    "  emitCoreLog(line,logText(\"core.flight.tuning:\"..status,240))\013\010",
    "  self.coreLogIssues=self.coreLogIssues or {}\013\010",
    "  self.coreLogIssues[issueScope(\"flight\",\"tuning\")]=status\013\010",
    " elseif not clearOperationIssue(self,\"flight\",\"tuning\",line) then\013\010",
    "  emitCoreLog(line,logText(\"core.flight.tuning:\"..status,240))\013\010",
    " end\013\010",
    "end\013\010",
    "function Flight:abortTuning(io,reason)\013\010",
    " -- Faults cancel queued/future writes. No blind restoration against stale devices.\013\010",
    " self:finishTuning(io,\"ABORTED: \"..tostring(reason))\013\010",
    "end\013\010",
    "-- Summary: Review, confirm, cancel or stop a bounded PID test.\010",
    "function Flight:tuningRequest(io,action,now)\013\010",
    " if action.type==\"tuning_cancel\" then self.tuningReview=nil;return true end\013\010",
    " if action.type==\"tuning_stop\" then\013\010",
    "  if not self.tuningRun then return false,\"NO ACTIVE TUNING TEST\" end\013\010",
    "  self.tuningRun.phase=\"RESTORING\";self.tuningRun.endReason=\"STOPPED\";self.tuningRun.pending=nil;return true,\"RESTORING CAPTURED CEILINGS\"\013\010",
    " end\013\010",
    " if self.tuningRun then return false,\"TUNING TEST ALREADY ACTIVE\" end\013\010",
    " if action.type==\"tuning_review\" then\013\010",
    "  if action.mode~=\"VS\" and action.mode~=\"ALT\" then return false,\"INVALID TUNING TEST\" end\013\010",
    "  if action.direction~=1 and action.direction~=-1 then return false,\"INVALID TEST DIRECTION\" end\013\010",
    "  local ok,reason=self:tuningReady(io,now);if not ok then return false,reason end\013\010",
    "  if not self.tuningHoverSince or now-self.tuningHoverSince<self.config.hover_capture_seconds then return false,\"WAIT FOR STABLE HOVER BASELINE\" end\013\010",
    "  self.tuningReviewSeq=(self.tuningReviewSeq or 0)+1\013\010",
    "  self.tuningReview={token=\"tune-\"..self.tuningReviewSeq..\":\"..now,expires=now+30,\013\010",
    "   mode=action.mode,direction=action.direction,uuid=io.vessel.uuid,fingerprint=io.hardwareFingerprint,boots={}}\013\010",
    "  for _,q in ipairs(QUADS) do self.tuningReview.boots[q]=io.nodes[q].boot end\013\010",
    "  return true,\"REVIEW BOUNDED PID TEST\"\013\010",
    " end\013\010",
    " local r=self.tuningReview\013\010",
    " if action.type~=\"tuning_confirm\" or not r or r.token~=action.token or now>r.expires then self.tuningReview=nil;return false,\"TUNING REVIEW EXPIRED\" end\013\010",
    " local ok,reason=self:tuningReady(io,now);if not ok then return false,reason end\013\010",
    " if io.vessel.uuid~=r.uuid or io.hardwareFingerprint~=r.fingerprint then self.tuningReview=nil;return false,\"VESSEL CHANGED; REVIEW AGAIN\" end\013\010",
    " if not self.tuningHoverSince or now-self.tuningHoverSince<self.config.hover_capture_seconds\013\010",
    "     or math.abs(io.vessel.verticalSpeed)>self.config.hover_max_vertical_speed then return false,\"WAIT FOR STABLE HOVER BASELINE\" end\013\010",
    " for _,q in ipairs(QUADS) do if io.nodes[q].boot~=r.boots[q] then self.tuningReview=nil;return false,\"LIFT BOOT CHANGED\" end end\013\010",
    " local c=io.config.tuning\013\010",
    " local target=r.mode==\"VS\" and r.direction*c.speed_step or io.vessel.altitude+r.direction*c.altitude_step\013\010",
    " if r.mode==\"ALT\" and (target<self.config.minimum_world_y or target>self.config.altitude_ceiling) then return false,\"TEST TARGET OUTSIDE WORLD Y LIMITS\" end\013\010",
    "  self.coreLogIssues=self.coreLogIssues or {};self.coreLogIssues[issueScope(\"flight\",\"tuning\")]=nil\013\010",
    "  self.tuningRun={id=r.token,mode=r.mode,direction=r.direction,target=target,y=io.vessel.altitude,\013\010",
    "  uuid=r.uuid,fingerprint=r.fingerprint,boots=r.boots,start=now,lastUpdate=now,phase=\"RUNNING\",\013\010",
    "  baseline={},samples={},count=0,errorSquares=0,peakError=0,saturationSamples=0,effort=0,\013\010",
    "  gains={altitude=clone(self.config.altitude_pid),verticalSpeed=clone(self.config.vertical_speed_pid)}}\013\010",
    " for _,q in ipairs(QUADS) do\013\010",
    "  self.tuningRun.baseline[q]={};for name,p in pairs(io.nodes[q].providers) do self.tuningRun.baseline[q][name]=p.targetAmount end\013\010",
    " end\013\010",
    " self.tuningReview=nil;self.maintenanceReview=nil\013\010",
    " self.outer:reset(io.vessel.altitude);self.inner:reset(io.vessel.verticalSpeed)\013\010",
    " -- First writes are the unchanged captured caps; nodes establish a bounded lease.\013\010",
    " self:sendTuningTargets(io,self.tuningRun.baseline,now,true)\013\010",
    " return self.tuningRun~=nil,self.tuningRun and \"TUNING STARTED\" or \"TUNING SEND FAILED\"\013\010",
    "end\013\010",
    "-- Summary: Send the bounded test target maps to their configured chambers.\010",
    "function Flight:sendTuningTargets(io,maps,now,first)\013\010",
    " local t=self.tuningRun\013\010",
    " if not t then return false end\013\010",
    " local within,reason=self:balancedTargetsFit(io,maps,now,io.vessel and io.vessel.altitude)\013\010",
    " if not within then self:abortTuning(io,reason or \"LIFT CAPACITY CHANGED\");return false end\013\010",
    " t.pending={};t.sentAt=now\013\010",
    " for _,q in ipairs(QUADS) do\013\010",
    "  local ok,seq=io:sendTuningCommand(q,maps[q],t.id,t.baseline[q],first)\013\010",
    "  if not ok then self:abortTuning(io,q..\" SEND FAILED: \"..tostring(seq));return false end\013\010",
    "  t.pending[q]={seq=seq,targets=maps[q]}\013\010",
    " end\013\010",
    " return true\013\010",
    "end\013\010",
    "-- Summary: Advance the active PID test and restore its captured provider ceilings.\010",
    "function Flight:updateTuning(io,now)\013\010",
    " if self.tuningReview and now>self.tuningReview.expires then self.tuningReview=nil end\013\010",
    " local ready,reason=self:tuningReady(io,now)\013\010",
    " local t=self.tuningRun\013\010",
    " if not t then\013\010",
    "  if ready and math.abs(io.vessel.verticalSpeed)<=self.config.hover_max_vertical_speed then self.tuningHoverSince=self.tuningHoverSince or now else self.tuningHoverSince=nil end\013\010",
    "  local available=ready and self.tuningHoverSince~=nil and now-self.tuningHoverSince>=self.config.hover_capture_seconds\013\010",
    "  self.tuningSnapshot={available=available,\013\010",
    "   reason=not available and (reason or \"WAIT FOR STABLE HOVER BASELINE\") or nil,review=self.tuningReview,result=self.tuningResult,active=false}\013\010",
    "  return\013\010",
    " end\013\010",
    " local good,fault=self:check(io,now,true)\013\010",
    " if not good then self:abortTuning(io,fault)\013\010",
    " elseif io.vessel.uuid~=t.uuid or io.hardwareFingerprint~=t.fingerprint then self:abortTuning(io,\"VESSEL / SENSOR BINDINGS CHANGED\")\013\010",
    " elseif (((io.inputs or {}).raw or {}).ap_disconnect or 0)>0 then self:abortTuning(io,\"MANUAL DISCONNECT\")\013\010",
    " elseif math.abs(io.vessel.altitude-t.y)>3 or math.abs(io.vessel.verticalSpeed)>.5 or\013\010",
    "  io.vessel.altitude<self.config.minimum_world_y or io.vessel.altitude>self.config.altitude_ceiling then self:abortTuning(io,\"TEST MOTION LIMIT EXCEEDED\")\013\010",
    " else\013\010",
    "  for _,q in ipairs(QUADS) do if io.nodes[q].boot~=t.boots[q] then self:abortTuning(io,\"LIFT BOOT CHANGED\");break end end\013\010",
    " end\013\010",
    " if not self.tuningRun then self.tuningSnapshot={active=false,result=self.tuningResult};return end\013\010",
    " self.tuningSnapshot={active=true,mode=t.mode,phase=t.phase,target=t.target,elapsed=now-t.start,\013\010",
    "  remaining=math.max(0,io.config.tuning.duration_seconds-(now-t.start)),effort=t.effort,\013\010",
    "  sampleCount=t.count,peakError=t.peakError,rmsError=t.count>0 and math.sqrt(t.errorSquares/t.count) or 0}\013\010",
    " if now-t.start>=io.config.tuning.duration_seconds and t.phase==\"RUNNING\" then t.phase=\"RESTORING\";t.endReason=\"COMPLETE\" end\013\010",
    " if t.pending then\013\010",
    "  local applied=true;for _,q in ipairs(QUADS) do if not io:commandWasApplied(q,t.pending[q].seq,t.pending[q].targets) then applied=false end end\013\010",
    "  if not applied then\013\010",
    "   t.lastUpdate=now -- Freeze integration during wired writes, rather than replaying the wait.\013\010",
    "   if now-t.sentAt>15 then self:abortTuning(io,\"COMMAND ACK TIMEOUT\") end\013\010",
    "   return\013\010",
    "  end\013\010",
    "  t.pending=nil\013\010",
    "  if t.restoringSent then t.restored=true;self:finishTuning(io,t.endReason or \"COMPLETE\");self.tuningSnapshot={active=false,result=self.tuningResult};return end\013\010",
    " end\013\010",
    " if t.phase==\"RESTORING\" then t.restoringSent=true;self:sendTuningTargets(io,t.baseline,now,false);return end\013\010",
    " local dt=now-t.lastUpdate;if dt<io.config.network.sample_interval_seconds then return end\013\010",
    " if dt<=0 or dt>3 then self:abortTuning(io,\"CONTROL SAMPLE GAP\");return end\013\010",
    " t.lastUpdate=now\013\010",
    " local limit=math.min(.05,self.config.max_feed_fraction)\013\010",
    " local oldI=self.inner.i;local oldOuterI=self.outer.i\013\010",
    " local verticalTarget=t.mode==\"VS\" and t.target or self.outer:step(t.target,io.vessel.altitude,dt,-.1,.1)\013\010",
    " local effort,saturated=self.inner:step(verticalTarget,io.vessel.verticalSpeed,dt,-limit,limit)\013\010",
    " local bounded=clamp(effort,t.effort-.01*dt,t.effort+.01*dt)\013\010",
    " if bounded~=effort then saturated=true;self.inner.i=oldI;self.outer.i=oldOuterI end\013\010",
    " t.effort=bounded;local maps={}\013\010",
    " for _,q in ipairs(QUADS) do maps[q]={};for name,p in pairs(io.nodes[q].providers) do\013\010",
    "  local base=t.baseline[q][name]\013\010",
    "  maps[q][name]=p.controlRole==\"bulk\" and clamp(math.floor(base*(1+t.effort)+.5),math.ceil(base*.95),math.floor(base*1.05)) or base\013\010",
    " end end\013\010",
    " local error=t.target-(t.mode==\"VS\" and io.vessel.verticalSpeed or io.vessel.altitude)\013\010",
    " t.count=t.count+1;t.errorSquares=t.errorSquares+error*error;t.peakError=math.max(t.peakError,math.abs(error))\013\010",
    " if saturated then t.saturationSamples=t.saturationSamples+1 end\013\010",
    " if #t.samples<200 then\013\010",
    "  local quadrants={}\013\010",
    "  for _,q in ipairs(QUADS) do\013\010",
    "   local node=io.nodes[q];local b=node.balloon\013\010",
    "   quadrants[q]={lift=b.lift,gasAmount=b.gasMixAmount,filledVolume=b.filledVolume,gasOutput=node.totalGasOutput}\013\010",
    "  end\013\010",
    "  t.samples[#t.samples+1]={seconds=now-t.start,y=io.vessel.altitude,verticalSpeed=io.vessel.verticalSpeed,\013\010",
    "   target=t.target,verticalTarget=verticalTarget,effort=t.effort,error=error,saturated=saturated,quadrants=quadrants}\013\010",
    " end\013\010",
    " self:sendTuningTargets(io,maps,now,false)\013\010",
    "end\013\010",
    "\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Validate vessel, cockpit and chamber observations for altitude-control authority.\010",
    "function Flight:check(io,now,tuning)\013\010",
    "    if self.maintenanceJob then return false,\"LIFT MAINTENANCE IN PROGRESS\" end\013\010",
    "    local c=self.config\013\010",
    "    if self.controls and not self.controls.available then return false,self.controls.reason or \"COCKPIT INPUTS UNAVAILABLE\" end\013\010",
    "    if not c or not c.enabled or (not tuning and not c.tuning_confirmed) then return false,\"ALTITUDE TUNING NOT COMMISSIONED\" end\013\010",
    "    if not tuning and (not io.config.commissioning.enabled or not io.config.commissioning.confirm_supported) then\013\010",
    "        return false,\"CORE HARDWARE NOT COMMISSIONED\"\013\010",
    "    end\013\010",
    "    if io.sensorBindingError then return false,\"CORE HARDWARE DISCOVERY: \"..io.sensorBindingError end\013\010",
    "    if self.enabled and self.hardwareFingerprint~=io.hardwareFingerprint then return false,\"CORE SENSOR BINDINGS CHANGED\" end\013\010",
    "    local v=io.vessel\013\010",
    "    if not v or not v.valid or not finite(v.at) or now<v.at or now-v.at>io.config.network.sensor_stale_seconds or\013\010",
    "        not finite(v.altitude) or not finite(v.verticalSpeed) or not v.uuid then return false,\"CoM ALTITUDE / VERTICAL SPEED UNAVAILABLE\" end\013\010",
    "    local inputs=io.inputs\013\010",
    "    if self.controls then\013\010",
    "        local inputFresh,inputReason=self.controls:usable(io,now)\013\010",
    "        if not inputFresh then return false,inputReason or \"COCKPIT CONTROLS UNAVAILABLE\" end\013\010",
    "    elseif not inputs or not inputs.valid or not finite(inputs.at) or now<inputs.at or\013\010",
    "        now-inputs.at>io.config.network.sensor_stale_seconds then return false,\"COCKPIT INPUTS STALE\" end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q]\013\010",
    "        if not io:nodeFresh(q,now) then return false,\"WAITING FOR LIFT NODE \"..q end\013\010",
    "        if not tuning and not n.commissioned then return false,q..\" LIFT NOT COMMISSIONED\" end\013\010",
    "        if not n.altitude or not n.altitude.valid then return false,q..\" SECTION ALTITUDE UNAVAILABLE\" end\013\010",
    "        local b=n.balloon\013\010",
    "        if not b or not b.hasBalloonValid or not b.hasBalloon or not b.gasMixValid or\013\010",
    "            not b.liftValid or not finite(b.lift) or b.lift<=0 then return false,q..\" ENVELOPE COMPOSITION / LIFT UNAVAILABLE\" end\013\010",
    "        local bulk,fine=0,0\013\010",
    "        for _,p in pairs(n.providers) do\013\010",
    "            local parkedFine=p.controlRole==\"fine\" and p.signalStrength==0 and\013\010",
    "                (p.targetAmount==0 or p.targetAmount==(p.minimumNonzeroTarget or 5))\013\010",
    "            if not p.present or not p.writable or not p.targetValid or not finite(p.targetAmount) or\013\010",
    "                not p.signalValid or (not parkedFine and not p.gasTypeValid) or\013\010",
    "                (not parkedFine and\013\010",
    "                 (not p.gasOutputValid or not finite(p.gasOutput) or p.gasOutput<=0 or\013\010",
    "                  p.signalStrength~=15 or not p.attachedValid or not p.attached or\013\010",
    "                  not b.gasMix[p.gasType] or b.gasMix[p.gasType]<=0)) then\013\010",
    "                return false,q..\" PROVIDER TELEMETRY NOT READY\"\013\010",
    "            end\013\010",
    "            if p.targetAmount>0 and not parkedFine and p.activeSupported and (not p.activeValid or not p.active) then return false,q..\" PROVIDER INACTIVE\" end\013\010",
    "            if (p.targetAmount<(p.minimumNonzeroTarget or 1) and not (p.controlRole==\"fine\" and p.targetAmount==0)) or p.targetAmount>p.maxTarget then\013\010",
    "                return false,q..\" PROVIDER TARGET OUT OF BOUNDS\"\013\010",
    "            end\013\010",
    "            if p.controlRole==\"bulk\" and p.gasType==\"steam\" then bulk=bulk+1\013\010",
    "            elseif p.controlRole==\"fine\" and p.gasType==\"default\" then fine=fine+1\013\010",
    "            else return false,q..\" UNVERIFIED GAS / CONTROL ROLE\" end\013\010",
    "        end\013\010",
    "        if bulk~=steamCount(n) or fine~=1 then return false,q..\" EXPECTED CONFIGURED VENTS AND ONE TRIM BURNER\" end\013\010",
    "        if self.enabled and (self.boots[q]~=n.boot or self.uuid~=v.uuid) then return false,\"VESSEL / LIFT BOOT CHANGED\" end\013\010",
    "    end\013\010",
    "    local targetY=self.controls and self.controls.targets and self.controls.targets.altitude or self.target or v.altitude\013\010",
    "    local balanced,balancedReason=self:balancedLiftModel(io,targetY,now)\013\010",
    "    self.balancedLift=balanced\013\010",
    "    if balanced.phase==\"UNAVAILABLE\" or balanced.phase==\"INFEASIBLE\" then\013\010",
    "        return false,balancedReason or balanced.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    if not self.enabled and not self.tuningRun then\013\010",
    "        -- Zero vertical speed alone also describes a ship sitting on terrain.\013\010",
    "        -- Require envelope lift near vessel weight before capturing equilibrium.\013\010",
    "        -- Aeronautics applies -gravity * totalLift * local air pressure.\013\010",
    "        -- CoM pressure estimates envelope pressure; measured motion remains\013\010",
    "        -- the final hover test, because balloon centres may be at different Y.\013\010",
    "        local gravity=v.environment and v.environment.gravity\013\010",
    "        if not finite(v.mass) or v.mass<=0 or not gravity or not finite(gravity.y) or gravity.y>=0 then\013\010",
    "            return false,\"MASS / GRAVITY REQUIRED FOR HOVER CAPTURE\"\013\010",
    "        end\013\010",
    "        local lift=0\013\010",
    "        for _,q in ipairs(QUADS) do lift=lift+io.nodes[q].balloon.lift end\013\010",
    "        if not airPressure(v) then return false,\"AIR PRESSURE REQUIRED FOR HOVER CAPTURE\" end\013\010",
    "        local ratio=lift*airPressure(v)/v.mass\013\010",
    "        if math.abs(ratio-1)>c.lift_balance_tolerance_fraction then\013\010",
    "            return false,\"ENVELOPE LIFT IS NOT NEAR HOVER EQUILIBRIUM\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Disengage altitude feedback while retaining applied provider settings.\010",
    "function Flight:stop(reason)\013\010",
    "    local wasEnabled=self.enabled==true\013\010",
    "    local outcome=logText(reason or \"OPERATOR DISENGAGED\",160)\013\010",
    "    self.enabled=false; self.reason=reason or \"OPERATOR DISENGAGED\"\013\010",
    "    self.pending=nil; self.hoverSince=nil\013\010",
    "    -- Disengagement retains applied caps and activation.\013\010",
    "    -- Retained systems intent governs validated resumption after reboot.\013\010",
    "    if wasEnabled and outcome~=\"OPERATOR DISENGAGED\" then\013\010",
    "        logOperationIssue(self,\"flight\",\"altitude\",outcome)\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Capture a verified hover baseline and engage the altitude PID loops.\010",
    "function Flight:engage(io,now)\013\010",
    "    if self.systemsRun then return false,\"START SYSTEMS SEQUENCE ACTIVE\" end\013\010",
    "    if self.tuningRun then return false,\"PID TUNING IN PROGRESS\" end\013\010",
    "    if self.enabled then return false,\"ALTITUDE ALREADY ENGAGED\" end\013\010",
    "    local ok,reason=self:check(io,now)\013\010",
    "    if not ok then return false,reason end\013\010",
    "    if not self.hoverSince or now-self.hoverSince<self.config.hover_capture_seconds then\013\010",
    "        return false,\"WAIT FOR STABLE HOVER BASELINE\"\013\010",
    "    end\013\010",
    "    self.target=self.controls and self.controls.targets.altitude or io.vessel.altitude\013\010",
    "    self.uuid=io.vessel.uuid; self.hardwareFingerprint=io.hardwareFingerprint\013\010",
    "    self.baseline,self.boots,self.mixBaseline={},{},{}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        self.baseline[q]={}; self.boots[q]=io.nodes[q].boot\013\010",
    "        self.mixBaseline[q]={}\013\010",
    "        for gas,amount in pairs(io.nodes[q].balloon.gasMix) do self.mixBaseline[q][gas]=amount end\013\010",
    "        for name,p in pairs(io.nodes[q].providers) do self.baseline[q][name]=p.targetAmount end\013\010",
    "    end\013\010",
    "    self.outer:reset(io.vessel.altitude); self.inner:reset(io.vessel.verticalSpeed)\013\010",
    "    self.enabled=true; self.reason=nil; self.at=now; self.lastUpdate=now\013\010",
    "    self.pending=nil; self:resetTrim(); self.effort=0\013\010",
    "    clearOperationIssue(self,\"flight\",\"altitude\",\"Core altitude control recovered: altitude hold engaged\")\013\010",
    "    return true\013\010",
    "end\013\010",
    "-- Summary: Cancel lateral guidance, set its manual mode and apply the requested stop lock.\010",
    "function Flight:cancelLateral(locked)\013\010",
    " local controls=self.controls\013\010",
    " if not controls then return end\013\010",
    " controls.lateralStopLock=locked==true\013\010",
    " if controls.lateral then controls.lateral:cancel() end\013\010",
    " if controls.modes then controls.modes.lateral=\"MANUAL\" end\013\010",
    "end\013\010",
    "function Flight:shutdownReview(io,now)\013\010",
    "    self:cancelLateral(true)\013\010",
    "    self.reviewSeq=(self.reviewSeq or 0)+1\013\010",
    "    self.stopReview={token=\"stop:\"..self.reviewSeq..\":\"..now,expires=now+30}\013\010",
    "    return true,\"WARNING: MAIN LIFT OFF; LOW PROBE REMAINS\"\013\010",
    "end\013\010",
    "-- Summary: Send the confirmed probe-preserving shutdown and track each chamber acknowledgement.\010",
    "function Flight:updateShutdown(io,now)\013\010",
    "    local job=self.shutdownJob;if not job then return end\013\010",
    "    local all=true;local missing={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local item=job[q]\013\010",
    "        if not (item.seq and io:shutdownWasApplied(q,item.seq)) then\013\010",
    "            all=false;missing[#missing+1]=q\013\010",
    "            if not item.sentAt or now-item.sentAt>12 or (io.nodes[q] and item.boot~=io.nodes[q].boot) then\013\010",
    "                local sent,seq=io:sendSystemsStop(q,true)\013\010",
    "                item.sentAt=now;item.boot=io.nodes[q] and io.nodes[q].boot\013\010",
    "                item.seq=sent and seq or nil;item.error=not sent and tostring(seq) or nil\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    self.reason=all and \"SYSTEMS STOPPED / LOW PROBE ACTIVE\" or \"STOPPING / PROBE HANDOVER ACK: \"..table.concat(missing,\", \")\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=all and \"STOPPED\" or \"STOPPING\",\013\010",
    "        pending=not all,complete=false,reason=self.reason}\013\010",
    "    if all then\013\010",
    "        self.shutdownJob=nil;self.systemsLastOutcome={phase=\"STOPPED\",reason=self.reason}\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Systems intent: whether the pilot wants lift control running. Only STOP\013\010",
    "-- SYSTEMS and KILL LIFT clear it; reboots, aborts and lease expiry do not.\013\010",
    "-- It survives reboots so control can resume on its own while airborne.\013\010",
    "local SYSTEMS_INTENT_PATH=\"/avionics/data/systems-intent.json\"\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Load and return the persisted operator intent to keep systems running.\010",
    "function Flight:systemsIntent()\013\010",
    "    if self.systemsIntentLoaded then return self.systemsIntentActive==true end\013\010",
    "    self.systemsIntentLoaded=true;self.systemsIntentActive=false\013\010",
    "    if self.storage and type(self.storage.readJson)==\"function\" then\013\010",
    "        local ok,value=pcall(self.storage.readJson,SYSTEMS_INTENT_PATH)\013\010",
    "        if ok and type(value)==\"table\" and value.schemaVersion==1 then self.systemsIntentActive=value.active==true end\013\010",
    "    end\013\010",
    "    return self.systemsIntentActive\013\010",
    "end\013\010",
    "-- Summary: Persist a change to the operator's systems-running intent.\010",
    "function Flight:setSystemsIntent(active)\013\010",
    "    active=active==true\013\010",
    "    if self.systemsIntentLoaded and self.systemsIntentActive==active then return end\013\010",
    "    self.systemsIntentLoaded=true;self.systemsIntentActive=active\013\010",
    "    if self.storage and type(self.storage.writeJson)==\"function\" then\013\010",
    "        pcall(self.storage.writeJson,SYSTEMS_INTENT_PATH,{schemaVersion=1,active=active})\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Resume lift control without pilot action after a core reboot, a lapsed\013\010",
    "-- lease or a fault abort - but only while the pilot's intent is still\013\010",
    "-- \"running\" and the ship is airborne (current lift >= 90% of weight). It\013\010",
    "-- adopts the existing ceilings (no takeoff or build) and retries every 5 s.\013\010",
    "-- Summary: Attempt validated recovery or airborne adoption while retained running intent is active.\010",
    "function Flight:autoResumeSystems(io,now)\013\010",
    "    if self.systemsRun or self.shutdownJob or self.stopReview or self.emergencyLiftLatched or\013\010",
    "        self.tuningRun or self.tuningReview or self.startupPending or self.maintenanceJob or\013\010",
    "        (self.restart and (self.restart.job or self.restart.saved)) then return end\013\010",
    "    if not self:systemsIntent() then return end\013\010",
    "    if self.nextAutoResumeAt and now<self.nextAutoResumeAt then return end\013\010",
    "    self.nextAutoResumeAt=now+5\013\010",
    "    local ok,reason\013\010",
    "    if self.systemsLastOutcome and self.systemsLastOutcome.phase==\"ABORTED\" and\013\010",
    "        type(self.systemsRetainedRun)==\"table\" then\013\010",
    "        ok,reason=self:recoverSystems(io,now)\013\010",
    "    elseif self:systemsAirborneAtStart(io) then\013\010",
    "        ok,reason=self:startSystems(io,now)\013\010",
    "    else\013\010",
    "        reason=\"NOT AIRBORNE; WAITING FOR PILOT START\"\013\010",
    "    end\013\010",
    "    local text=(ok and \"Auto-resume: \" or \"Auto-resume waiting: \")..tostring(reason)\013\010",
    "    if text~=self.lastAutoResumeLog then\013\010",
    "        self.lastAutoResumeLog=text\013\010",
    "        if type(os)==\"table\" and type(os.__amaryllisLog)==\"function\" then pcall(os.__amaryllisLog,text,\"core.systems\")\013\010",
    "        else print(text) end\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Accept the matching stop confirmation and start probe-preserving main-lift shutdown.\010",
    "function Flight:confirmShutdown(io,action,now)\013\010",
    "    local review=self.stopReview\013\010",
    "    if not review or action.token~=review.token or now>review.expires then return false,\"STOP CONFIRMATION EXPIRED\" end\013\010",
    "    self.stopReview=nil\013\010",
    "    self:cancelLateral(true)\013\010",
    "    self:setSystemsIntent(false)\013\010",
    "    self:disablePropulsionForStop(io,now)\013\010",
    "    if self.systemsRun then self:stopSystems(io,\"CONFIRMED SYSTEMS SHUTDOWN\",now) end\013\010",
    "    self:stop(\"STOPPING / MAIN LIFT OFF\")\013\010",
    "    self.tuningRun=nil;self.tuningReview=nil;self.maintenanceJob=nil;self.maintenanceReview=nil\013\010",
    "    self.startupPending=nil;self.trimStatus=nil\013\010",
    "    self.shutdownJob={FL={},FR={},BL={},BR={}}\013\010",
    "    self:updateShutdown(io,now)\013\010",
    "    return true,\"PROBE-PRESERVING SHUTDOWN REQUESTED\"\013\010",
    "end\013\010",
    "-- Section: Emergency lift | Latched operator shutdown and verified disarm.\010",
    "-- Summary: Latch the accepted Kill Lift action and start its dedicated shutdown sequence.\010",
    "function Flight:emergencyKillLift(io,now)\013\010",
    "    self.emergencyLiftDisarmJob=nil\013\010",
    "    self:cancelLateral(true)\013\010",
    "    self:setSystemsIntent(false)\013\010",
    "    self.emergencyLiftLatched=true\013\010",
    "    self.coreLogIssues=self.coreLogIssues or {}\013\010",
    "    self.coreLogIssues[issueScope(\"flight\",\"emergency lift kill\")]=nil\013\010",
    "    -- Persistence protects the explicit-restart interlock after a core reboot.\013\010",
    "    -- A disk error remains visible but never blocks the physical stop packets.\013\010",
    "    self:persistEmergencyLock(true)\013\010",
    "    self.stopReview=nil;self.shutdownJob=nil\013\010",
    "    -- Retire propulsion authority too. The main runtime also suppresses its\013\010",
    "    -- normal renewals while latched, so a held cockpit input cannot re-arm it.\013\010",
    "    if io.thrust and type(io.thrust.stop)==\"function\" then\013\010",
    "        pcall(io.thrust.stop,io.thrust,io,\"EMERGENCY LIFT KILL\")\013\010",
    "    end\013\010",
    "    self.systemsRun=nil;self.systemsAvailable=false;self.systemsBlockedReason=\"EMERGENCY LIFT KILL LATCHED\"\013\010",
    "    self.enabled=false;self.available=false;self.pending=nil;self.hoverSince=nil\013\010",
    "    self.startupPending=nil;self.startupAvailable=false;self.startupReason=\"EMERGENCY LIFT KILL LATCHED\"\013\010",
    "    self.maintenanceJob=nil;self.maintenanceReview=nil;self.tuningRun=nil;self.tuningReview=nil\013\010",
    "    self.trimStatus=nil;self.baseline=nil;self.boots=nil;self.mixBaseline=nil\013\010",
    "    -- Revoke the previous lift PID lease once on operator acceptance. The\013\010",
    "    -- normal update loop skips context renewals while latched, leaving status\013\010",
    "    -- reception, sensors and cockpit selector sampling independent of KILL.\013\010",
    "    if type(io.sendLiftControlContext)==\"function\" then\013\010",
    "        local inactive={selectedAltitude=nil,pidActive=false,inputsActive=false}\013\010",
    "        for _,q in ipairs(QUADS) do pcall(io.sendLiftControlContext,io,q,inactive) end\013\010",
    "    end\013\010",
    "    self.reason=\"EMERGENCY LIFT KILL IN PROGRESS\"\013\010",
    "    self.emergencyLiftJob={requestedAt=now,deadline=now+EMERGENCY_LIFT_KILL_DISCOVERY_SECONDS,quadrants={}}\013\010",
    "    for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "        self.emergencyLiftJob.quadrants[q]={status=\"WAITING_FOR_FRESH_NODE\",attempts=0,\013\010",
    "            nextAt=now,ackReason=\"Waiting for fresh lift-node status\"}\013\010",
    "    end\013\010",
    "    self:updateEmergencyLiftKill(io,now)\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=\"EMERGENCY KILL\",pending=true,complete=false,\013\010",
    "        reason=\"Emergency lift kill is being verified\"}\013\010",
    "    return true,\"EMERGENCY LIFT KILL REQUESTED\"\013\010",
    "end\013\010",
    "-- Summary: Send the active emergency-stop request to each required chamber.\010",
    "function Flight:sendEmergencyLiftKill(io,q,item,now)\013\010",
    "    local node=io.nodes and io.nodes[q]\013\010",
    "    if type(io.nodeFresh)~=\"function\" or not io:nodeFresh(q,now) or not node or type(node.boot)~=\"string\" then\013\010",
    "        item.status=\"WAITING_FOR_FRESH_NODE\";item.ackReason=\"Waiting for fresh lift-node status\"\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    if type(io.sendEmergencyLiftStop)~=\"function\" then\013\010",
    "        item.status=\"FAILED\";item.ackReason=\"Emergency lift-stop interface unavailable\"\013\010",
    "        return false\013\010",
    "    end\013\010",
    "    local ok,seq,boot=io:sendEmergencyLiftStop(q,now)\013\010",
    "    item.attempts=item.attempts+1\013\010",
    "    item.sentAt=now;item.nextAt=now+EMERGENCY_LIFT_KILL_RETRY_SECONDS\013\010",
    "    if ok and finite(seq) and boot==node.boot then\013\010",
    "        item.seq=seq;item.boot=boot;item.status=\"PENDING_ACK\"\013\010",
    "        item.ackReason=\"Waiting for eight bulk-off links and the fine probe floor to read back\"\013\010",
    "        return true\013\010",
    "    end\013\010",
    "    item.status=item.attempts>=EMERGENCY_LIFT_KILL_ATTEMPTS and \"FAILED\" or \"PENDING_ACK\"\013\010",
    "    item.seq=nil;item.boot=node.boot\013\010",
    "    item.ackReason=tostring(seq or \"Emergency lift-stop send failed\")\013\010",
    "    return false\013\010",
    "end\013\010",
    "-- Summary: Retry emergency shutdown and verify each chamber's stop readback.\010",
    "function Flight:updateEmergencyLiftKill(io,now)\013\010",
    "    local job=self.emergencyLiftJob\013\010",
    "    if not job or self.emergencyLiftLatched~=true then return end\013\010",
    "    if job.recovering then\013\010",
    "        local confirmed,pending=0,0\013\010",
    "        local missing={}\013\010",
    "        for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "            local item=job.quadrants[q]\013\010",
    "            local node=io.nodes and io.nodes[q]\013\010",
    "            local fresh=type(io.nodeFresh)==\"function\" and io:nodeFresh(q,now)\013\010",
    "            if fresh and node and type(io.emergencyLiftStopStateVerified)==\"function\" then\013\010",
    "                local verified,why=io:emergencyLiftStopStateVerified(q,node.boot,now)\013\010",
    "                if verified then\013\010",
    "                    item.status=\"CONFIRMED\";item.boot=node.boot;item.seq=node.emergencyStopAppliedSeq\013\010",
    "                    item.ackReason=\"Fresh readbacks confirm BULK OFF / PROBE ON after reboot\"\013\010",
    "                else\013\010",
    "                    item.status=\"FAILED\";item.boot=node.boot\013\010",
    "                    item.ackReason=\"Fresh status cannot verify BULK OFF / PROBE ON: \"..tostring(why)\013\010",
    "                end\013\010",
    "            elseif fresh then\013\010",
    "                item.status=\"FAILED\";item.ackReason=\"Endpoint lacks emergency latch readback; press KILL LIFT to reassert\"\013\010",
    "            else\013\010",
    "                item.status=\"WAITING_FOR_FRESH_NODE\";item.ackReason=\"Waiting for fresh endpoint state after reboot\"\013\010",
    "            end\013\010",
    "            if item.status==\"CONFIRMED\" then confirmed=confirmed+1\013\010",
    "            elseif item.status==\"WAITING_FOR_FRESH_NODE\" then pending=pending+1;missing[#missing+1]=q\013\010",
    "            else missing[#missing+1]=q end\013\010",
    "        end\013\010",
    "        job.complete=confirmed==#EMERGENCY_LIFT_KILL_QUADRANTS\013\010",
    "        job.pending=pending>0\013\010",
    "        job.phase=job.complete and \"KILL CONFIRMED\" or (pending>0 and \"RECHECKING AFTER REBOOT\" or \"KILL INCOMPLETE\")\013\010",
    "        job.reason=job.complete and \"ALL FOUR CHAMBERS REPORTED BULK OFF / PROBE ON AFTER REBOOT\" or\013\010",
    "            (\"RECHECK / REASSERT REQUIRED: \"..table.concat(missing,\", \")..\" (\"..confirmed..\"/4 confirmed)\")\013\010",
    "        self.reason=job.reason\013\010",
    "        self.systemsSnapshot={active=false,available=false,phase=job.phase,pending=job.pending,\013\010",
    "            complete=job.complete,reason=job.reason}\013\010",
    "        if job.phase==\"KILL INCOMPLETE\" then\013\010",
    "            local details=emergencyKillFailureDetails(job)\013\010",
    "            logOperationIssue(self,\"flight\",\"emergency lift kill\",job.reason..(details and \"; \"..details or \"\"))\013\010",
    "        elseif job.phase==\"KILL CONFIRMED\" then\013\010",
    "            clearOperationIssue(self,\"flight\",\"emergency lift kill\",\"Core emergency lift kill recovered: BULK OFF / PROBE ON verified\")\013\010",
    "        end\013\010",
    "        return\013\010",
    "    end\013\010",
    "    for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "        local item=job.quadrants[q]\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local fresh=type(io.nodeFresh)==\"function\" and io:nodeFresh(q,now)\013\010",
    "        if item.status==\"CONFIRMED\" then\013\010",
    "            if not fresh or not node or node.boot~=item.boot then\013\010",
    "                item.status=\"WAITING_FOR_FRESH_NODE\";item.attempts=0;item.seq=nil;item.boot=nil\013\010",
    "                item.nextAt=now;item.ackReason=\"Node boot changed or became stale after BULK OFF / PROBE ON was confirmed\"\013\010",
    "            else\013\010",
    "                local stillOff,why=false,\"Emergency stop readback unavailable\"\013\010",
    "                if item.seq and type(io.emergencyLiftStopWasApplied)==\"function\" then\013\010",
    "                    stillOff,why=io:emergencyLiftStopWasApplied(q,item.seq,item.boot,now)\013\010",
    "                end\013\010",
    "                if not stillOff then\013\010",
    "                    if item.attempts>=EMERGENCY_LIFT_KILL_ATTEMPTS then\013\010",
    "                        item.status=\"FAILED\";item.ackReason=\"BULK OFF / PROBE ON no longer verified after bounded retries: \"..tostring(why)\013\010",
    "                    else\013\010",
    "                        item.status=\"PENDING_ACK\";item.nextAt=now\013\010",
    "                        item.ackReason=\"BULK OFF / PROBE ON changed; reasserting KILL: \"..tostring(why)\013\010",
    "                    end\013\010",
    "                end\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if item.status==\"PENDING_ACK\" then\013\010",
    "            local applied,why=false,\"Emergency stop acknowledgement unavailable\"\013\010",
    "            if item.seq and type(io.emergencyLiftStopWasApplied)==\"function\" then\013\010",
    "                applied,why=io:emergencyLiftStopWasApplied(q,item.seq,item.boot,now)\013\010",
    "            end\013\010",
    "            if applied then\013\010",
    "                item.status=\"CONFIRMED\";item.ackReason=\"Eight bulk links off; fine probe verified at target 5 / signal 15\"\013\010",
    "            else\013\010",
    "                item.ackReason=tostring(why or \"Waiting for emergency stop acknowledgement\")\013\010",
    "                if now>=(item.nextAt or now) then\013\010",
    "                    if item.attempts>=EMERGENCY_LIFT_KILL_ATTEMPTS then\013\010",
    "                        item.status=\"FAILED\";item.ackReason=\"No verified BULK OFF / PROBE ON acknowledgement after bounded retries: \"..item.ackReason\013\010",
    "                    else self:sendEmergencyLiftKill(io,q,item,now) end\013\010",
    "                end\013\010",
    "            end\013\010",
    "        elseif item.status==\"WAITING_FOR_FRESH_NODE\" and now>=(item.nextAt or now) then\013\010",
    "            if fresh then\013\010",
    "                self:sendEmergencyLiftKill(io,q,item,now)\013\010",
    "            elseif now>=job.deadline then\013\010",
    "                item.status=\"FAILED\";item.ackReason=\"No fresh node status before bounded discovery timeout\"\013\010",
    "            else\013\010",
    "                item.ackReason=\"Waiting for fresh lift-node status\"\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local confirmed,pending=0,0\013\010",
    "    local missing={}\013\010",
    "    for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "        local item=job.quadrants[q]\013\010",
    "        if item.status==\"CONFIRMED\" then confirmed=confirmed+1\013\010",
    "        elseif item.status==\"WAITING_FOR_FRESH_NODE\" or item.status==\"PENDING_ACK\" then\013\010",
    "            pending=pending+1;missing[#missing+1]=q\013\010",
    "        else missing[#missing+1]=q end\013\010",
    "    end\013\010",
    "    job.complete=confirmed==#EMERGENCY_LIFT_KILL_QUADRANTS\013\010",
    "    job.pending=pending>0\013\010",
    "    job.phase=job.complete and \"KILL CONFIRMED\" or (pending>0 and \"KILLING\" or \"KILL INCOMPLETE\")\013\010",
    "    job.reason=job.complete and \"ALL FOUR CHAMBERS CONFIRMED BULK OFF / PROBE ON\" or\013\010",
    "        (\"WAITING FOR / FAILED: \"..table.concat(missing,\", \")..\" (\"..confirmed..\"/4 confirmed)\")\013\010",
    "    self.reason=job.reason\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=job.phase,pending=job.pending,complete=job.complete,\013\010",
    "        reason=job.reason}\013\010",
    "    if job.phase==\"KILL INCOMPLETE\" then\013\010",
    "        local details=emergencyKillFailureDetails(job)\013\010",
    "        logOperationIssue(self,\"flight\",\"emergency lift kill\",job.reason..(details and \"; \"..details or \"\"))\013\010",
    "    elseif job.phase==\"KILL CONFIRMED\" then\013\010",
    "        clearOperationIssue(self,\"flight\",\"emergency lift kill\",\"Core emergency lift kill recovered: BULK OFF / PROBE ON verified\")\013\010",
    "    end\013\010",
    "end\013\010",
    "-- Summary: Start the confirmed disarm operation against the retained emergency latch.\010",
    "function Flight:disarmLiftKill(io,now)\013\010",
    "    if not self.emergencyLiftLatched then return false,\"LIFT KILL IS NOT LATCHED\" end\013\010",
    "    if self.emergencyLiftDisarmJob then return true,\"DISARM KILL ALREADY IN PROGRESS\" end\013\010",
    "    if self.restart and (self.restart.job or self.restart.saved) then self.restart:cancel(\"RESTART CANCELLED BY DISARM KILL\") end\013\010",
    "    self:setSystemsIntent(false)\013\010",
    "    self.emergencyLiftDisarmJob={quadrants={},reason=\"WAITING FOR CHAMBER DISARM ACKNOWLEDGEMENTS\"}\013\010",
    "    return true,\"DISARM KILL REQUESTED; SYSTEMS REMAIN STOPPED\"\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Track disarm acknowledgements and clear the completed core latch.\010",
    "function Flight:updateLiftDisarm(io,now)\013\010",
    "    local job=self.emergencyLiftDisarmJob\013\010",
    "    if not job then return end\013\010",
    "    local complete=true\013\010",
    "    for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "        local item=job.quadrants[q] or {};job.quadrants[q]=item\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local fresh=node and io:nodeFresh(q,now)\013\010",
    "        local ack=fresh and item.seq and node.boot==item.boot and\013\010",
    "            node.emergencyDisarmAppliedSeq==item.seq and node.emergencyStopLatched==false\013\010",
    "        item.status=ack and \"DISARMED\" or \"WAITING\"\013\010",
    "        if not ack then\013\010",
    "            complete=false\013\010",
    "            if not item.sentAt or now-item.sentAt>=2 or (fresh and node.boot~=item.boot) then\013\010",
    "                local ok,seq,boot=io:sendEmergencyLiftDisarm(q,now)\013\010",
    "                item.sentAt=now\013\010",
    "                if ok then item.seq=seq;item.boot=boot else item.ackReason=seq end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.emergencyLiftDisarmJob~=job or not self.emergencyLiftLatched or not complete then return end\013\010",
    "    -- The stopped intent must survive reboot before the durable kill interlock\013\010",
    "    -- is released. A cached setSystemsIntent(false) alone is insufficient.\013\010",
    "    if self.storage and type(self.storage.writeJson)==\"function\" then\013\010",
    "        local callOk,saved,reason=pcall(self.storage.writeJson,SYSTEMS_INTENT_PATH,{schemaVersion=1,active=false})\013\010",
    "        if not callOk or not saved then\013\010",
    "            job.reason=\"DISARM STOPPED STATE SAVE FAILED: \"..tostring(callOk and reason or saved)\013\010",
    "            return\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if self.emergencyLiftDisarmJob~=job or not self.emergencyLiftLatched then return end\013\010",
    "    self.systemsIntentLoaded=true;self.systemsIntentActive=false\013\010",
    "    local saved,reason=self:persistEmergencyLock(false)\013\010",
    "    if self.emergencyLiftDisarmJob~=job then\013\010",
    "        if self.emergencyLiftLatched then self:persistEmergencyLock(true) end\013\010",
    "        return\013\010",
    "    end\013\010",
    "    if not saved then job.reason=\"DISARM SAVE FAILED: \"..tostring(reason);return end\013\010",
    "    self.emergencyLiftLatched=false;self.emergencyLiftJob=nil;self.emergencyLiftDisarmJob=nil\013\010",
    "    self.systemsAvailable=false;self.systemsRun=nil;self.enabled=false;self.pending=false\013\010",
    "    self.reason=\"LIFT KILL DISARMED; SYSTEMS STOPPED\"\013\010",
    "    self.systemsSnapshot={active=false,available=false,phase=\"STOPPED\",reason=self.reason}\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Build the current kill, verification and disarm state for displays.\010",
    "function Flight:emergencyLiftState()\013\010",
    "    local disarm=self.emergencyLiftDisarmJob\013\010",
    "    if disarm then return {latched=true,disarming=true,pending=true,phase=\"DISARMING\",\013\010",
    "        reason=disarm.reason,quadrants=clone(disarm.quadrants),persistenceWarning=self.emergencyLiftPersistenceWarning} end\013\010",
    "    local job=self.emergencyLiftJob\013\010",
    "    if not job then return {latched=self.emergencyLiftLatched==true,active=false,complete=false,pending=false,\013\010",
    "        phase=self.emergencyLiftLatched and \"KILL REQUIRED\" or \"IDLE\",reason=self.emergencyLiftLatched and\013\010",
    "        \"DISARM KILL BEFORE START SYSTEMS\" or nil,\013\010",
    "        mode=self.emergencyLiftLatched and \"BULK_OFF_PROBE_ON\" or nil,\013\010",
    "        persistenceWarning=self.emergencyLiftPersistenceWarning,quadrants={}} end\013\010",
    "    local quadrants={}\013\010",
    "    for _,q in ipairs(EMERGENCY_LIFT_KILL_QUADRANTS) do\013\010",
    "        local item=job.quadrants[q] or {}\013\010",
    "        quadrants[q]={status=item.status,ackReason=item.ackReason,attempts=item.attempts or 0,\013\010",
    "            boot=item.boot,seq=item.seq}\013\010",
    "    end\013\010",
    "    return {latched=self.emergencyLiftLatched==true,active=self.emergencyLiftLatched==true and job.complete~=true,\013\010",
    "        complete=job.complete==true,pending=job.pending==true,phase=job.phase or \"KILLING\",\013\010",
    "        reason=job.reason,mode=self.emergencyLiftLatched and \"BULK_OFF_PROBE_ON\" or nil,\013\010",
    "        persistenceWarning=self.emergencyLiftPersistenceWarning,quadrants=quadrants}\013\010",
    "end\013\010",
    "local ASSEMBLY_GATED={start_systems=true,restart_systems=true,recover_systems=true,altitude_engage=true,vent_startup=true,cockpit_mode=true,\013\010",
    "    tuning_review=true,tuning_confirm=true}\013\010",
    "-- Fake IO tables in older tests have no gate; real IO always does.\013\010",
    "function Flight.assemblyGate(io,now)\013\010",
    "    if type(io.assemblyGate)~=\"function\" then return true end\013\010",
    "    return io:assemblyGate(now)\013\010",
    "end\013\010",
    "function Flight:ensureAutopilot(io)\013\010",
    "    io.autopilot=io.autopilot or Autopilot.new(io.config,self.storage,io.navigationDependencies)\013\010",
    "    return io.autopilot\013\010",
    "end\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Validate a pilot action and dispatch it to the corresponding flight operation.\010",
    "function Flight:request(io,action,now)\013\010",
    "    if type(action)~=\"table\" or type(action.type)~=\"string\" then return false,\"INVALID ACTION\" end\013\010",
    "    if action.type==\"debug_mode\" then\013\010",
    "        if not io.debugRecorder or io.debugRecorder.workerAvailable==false then return false,\"DEBUG RECORDER UNAVAILABLE\" end\013\010",
    "        return io.debugRecorder:request(action.enabled)\013\010",
    "    end\013\010",
    "    if action.type==\"ap_disengage\" then\013\010",
    "        if io.autopilot then io.autopilot:cancel(io,self.controls,\"DISENGAGED; SELECTED MODES RETAINED\") end\013\010",
    "        return true,\"AUTOPILOT DISENGAGED; SELECTED MODES RETAINED\"\013\010",
    "    end\013\010",
    "    if action.type==\"ap_engage\" or action.type==\"ap_edit\" or action.type==\"ap_current\" or action.type:match(\"^destination_\") then\013\010",
    "        local ap=self:ensureAutopilot(io)\013\010",
    "        if action.type==\"ap_engage\" then\013\010",
    "            if self.emergencyLiftLatched or self.shutdownJob or self.tuningRun or self.maintenanceJob or\013\010",
    "                (self.restart and (self.restart.job or self.restart.saved)) then return false,\"SYSTEMS OPERATION IN PROGRESS\" end\013\010",
    "            if not self.enabled or (self.systemsRun and self.systemsRun.phase~=\"READY\") then return false,\"ESTABLISH ALTITUDE HOLD BEFORE ENGAGING AUTOPILOT\" end\013\010",
    "            local ok,why=ap:engage(io,self.controls,now)\013\010",
    "            if not ok then logOperationIssue(self,\"flight\",\"autopilot engage\",why) end\013\010",
    "            return ok,why\013\010",
    "        elseif action.type==\"destination_save\" or action.type==\"destination_rename\" or action.type==\"destination_delete\" then\013\010",
    "            local entry={name=action.name or ap.label(ap.draft),x=ap.draft.x,z=ap.draft.z}\013\010",
    "            local operation=action.type:sub(13)\013\010",
    "            local ok,why=ap.library:change(operation,action.index,entry)\013\010",
    "            if not ok then logOperationIssue(self,\"flight\",\"destination library\",why) end\013\010",
    "            return ok,why\013\010",
    "        else\013\010",
    "            local ok,why=ap:edit(io,self.controls,action,now)\013\010",
    "            if not ok then logOperationIssue(self,\"flight\",\"autopilot configuration\",why) end\013\010",
    "            return ok,why\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if action.type==\"cockpit_mode\" and io.autopilot and io.autopilot.active then return false,\"DISENGAGE AUTOPILOT BEFORE CHANGING MODES\" end\013\010",
    "    if action.type==\"anchor_cancel\" then\013\010",
    "        if io.positionAnchor then io.positionAnchor:cancel(self.controls) end\013\010",
    "        if io.thrust then io.thrust:stop(io,\"ANCHOR RELEASED\") end\013\010",
    "        return true,\"ANCHOR RELEASED\"\013\010",
    "    end\013\010",
    "    if action.type==\"anchor_engage\" then\013\010",
    "        if io.autopilot and io.autopilot.active then return false,\"DISENGAGE AUTOPILOT BEFORE ENGAGING ANCHOR\" end\013\010",
    "        if self.emergencyLiftLatched or self.shutdownJob or (self.restart and (self.restart.job or self.restart.saved)) then\013\010",
    "            return false,\"SYSTEMS STOP / RESTART IN PROGRESS\"\013\010",
    "        end\013\010",
    "        if not io.thrust or (io.config.thrust or {}).enabled~=true then return false,\"ENABLE PROPULSION FIRST\" end\013\010",
    "        local ready,why=io.thrust:activationReady(io,now,self.controls)\013\010",
    "        if not ready then logOperationIssue(self,\"flight\",\"anchor engage\",why);return false,why end\013\010",
    "        io.positionAnchor=io.positionAnchor or Anchor.new(io.config)\013\010",
    "        local ok,reason=io.positionAnchor:engage(io,now)\013\010",
    "        if not ok then logOperationIssue(self,\"flight\",\"anchor engage\",reason) end\013\010",
    "        return ok,reason\013\010",
    "    end\013\010",
    "    if action.type==\"propulsion_disable\" then\013\010",
    "        if io.autopilot then io.autopilot:cancel(io,self.controls,\"PROPULSION DISABLED\",false) end\013\010",
    "        if io.positionAnchor then io.positionAnchor:cancel(self.controls,\"PROPULSION DISABLED\") end\013\010",
    "        if not io.thrust then return false,\"PROPULSION CONTROLLER UNAVAILABLE\" end\013\010",
    "        local accepted,reason=io.thrust:setEnabled(io,now,self.controls,false,self.storage,self.settingsDependencies)\013\010",
    "        if not accepted then logOperationIssue(self,\"flight\",\"propulsion disable\",reason) end\013\010",
    "        return accepted,reason\013\010",
    "    end\013\010",
    "    if action.type==\"emergency_kill_lift\" then\013\010",
    "        if io.autopilot then io.autopilot:cancel(io,self.controls,\"KILL LIFT\",false) end\013\010",
    "        if io.positionAnchor then io.positionAnchor:cancel(self.controls,\"KILL LIFT\") end\013\010",
    "        if self.restart then self.restart:cancel(\"RESTART CANCELLED BY KILL LIFT\") end\013\010",
    "        return self:emergencyKillLift(io,now)\013\010",
    "    end\013\010",
    "    if action.type==\"disarm_lift_kill\" then return self:disarmLiftKill(io,now) end\013\010",
    "    if self.emergencyLiftLatched and action.type~=\"restart_systems\" and action.type~=\"setting_update\" and\013\010",
    "        action.type~=\"manual_trim_adjust\" and action.type~=\"manual_trim_reset\" then\013\010",
    "        return false,\"EMERGENCY LIFT KILL LATCHED; DISARM KILL FIRST\"\013\010",
    "    end\013\010",
    "    if action.type==\"systems_stop\" then return self:shutdownReview(io,now) end\013\010",
    "    if action.type==\"systems_stop_cancel\" then\013\010",
    "        if not self.stopReview then return false,\"NO STOP REVIEW TO CANCEL\" end\013\010",
    "        self.stopReview=nil;self:cancelLateral(false);return true,\"STOP CANCELLED\"\013\010",
    "    end\013\010",
    "    if action.type==\"systems_stop_confirm\" then\013\010",
    "        local accepted,reason=self:confirmShutdown(io,action,now)\013\010",
    "        if accepted and io.autopilot then io.autopilot:cancel(io,self.controls,\"STOP SYSTEMS\",false) end\013\010",
    "        if accepted and io.positionAnchor then io.positionAnchor:cancel(self.controls,\"STOP SYSTEMS\") end\013\010",
    "        if accepted and self.restart then self.restart:cancel(\"RESTART CANCELLED BY STOP SYSTEMS\") end\013\010",
    "        return accepted,reason\013\010",
    "    end\013\010",
    "    local routeRequired=action.type==\"recover_systems\" or action.type==\"start_systems\" or action.type==\"restart_systems\" or action.type==\"altitude_engage\" or\013\010",
    "        action.type==\"vent_startup\" or action.type==\"cockpit_mode\" or\013\010",
    "        action.type==\"tuning_confirm\" or action.type==\"tuning_start\" or\013\010",
    "        action.type==\"maintenance_restart\" or action.type==\"maintenance_recheck\" or action.type==\"maintenance_probe_cycle\" or\013\010",
    "        action.type==\"manual_trim_adjust\" or action.type==\"manual_trim_reset\"\013\010",
    "    if routeRequired and type(io.routeAllowed)==\"function\" then\013\010",
    "        local allowed,why=io:routeAllowed()\013\010",
    "        if not allowed then return false,why end\013\010",
    "    elseif routeRequired and io.identityReady==false then\013\010",
    "        return false,io.identityReason or \"CORE IDENTITY UNVERIFIED\"\013\010",
    "    end\013\010",
    "    if self.shutdownJob then return false,\"SHUTDOWN IN PROGRESS\" end\013\010",
    "    -- Assembly gate: anything that could create lift, thrust or cockpit\013\010",
    "    -- authority is refused. Stops, cancels, settings and lift-computer\013\010",
    "    -- maintenance stay available on a disassembled vessel.\013\010",
    "    if ASSEMBLY_GATED[action.type] and not (action.type==\"restart_systems\" and self.emergencyLiftLatched) then\013\010",
    "        local assembled,why=Flight.assemblyGate(io,now)\013\010",
    "        if not assembled then return false,why end\013\010",
    "    end\013\010",
    "    if action.type==\"manual_trim_adjust\" or action.type==\"manual_trim_reset\" then\013\010",
    "        return self:manualTrimRequest(io,action,now)\013\010",
    "    end\013\010",
    "    if action.type==\"recover_systems\" then return self:recoverSystems(io,now) end\013\010",
    "    if action.type==\"level_reset\" then return self:resetLeveling(io,now) end\013\010",
    "    if action.type==\"restart_systems\" then\013\010",
    "        if not self.restart then return false,\"SYSTEMS RESTART UNAVAILABLE\" end\013\010",
    "        if self.emergencyLiftDisarmJob then return false,\"DISARM KILL IN PROGRESS\" end\013\010",
    "        local accepted,reason=self.restart:request(self,io,now)\013\010",
    "        if not accepted then logOperationIssue(self,\"flight\",\"restart\",reason) end\013\010",
    "        return accepted,reason\013\010",
    "    end\013\010",
    "    if action.type==\"propulsion_enable\" then\013\010",
    "        if not io.thrust then return false,\"PROPULSION CONTROLLER UNAVAILABLE\" end\013\010",
    "        io.systemsReady=self.systemsRun~=nil and self.systemsRun.phase==\"READY\"\013\010",
    "        local accepted,reason=io.thrust:setEnabled(io,now,self.controls,true,self.storage,self.settingsDependencies)\013\010",
    "        if not accepted then logOperationIssue(self,\"flight\",\"propulsion enable\",reason) end\013\010",
    "        return accepted,reason\013\010",
    "    end\013\010",
    "    if self.systemsRun then\013\010",
    "        if action.type==\"altitude_disengage\" then return self:shutdownReview(io,now) end\013\010",
    "        if action.type==\"start_systems\" then return false,\"START SYSTEMS ALREADY ACTIVE\" end\013\010",
    "        if action.type==\"cockpit_mode\" and self.controls then\013\010",
    "        local ok,reason=self.controls:mode(io,action,now)\013\010",
    "        if ok and io.controlPresets then\013\010",
    "            io.controlPresets:cancelRestore()\013\010",
    "            -- Persist the explicit selection before its acknowledgement.\013\010",
    "            io.controlPresets:update(io,self,now)\013\010",
    "        end\013\010",
    "        return ok,reason\013\010",
    "    end\013\010",
    "        if action.type==\"setting_update\" and self.systemsRun.phase==\"READY\" then\013\010",
    "            return self:setting(io,action,now)\013\010",
    "        end\013\010",
    "        return false,\"START SYSTEMS SEQUENCE ACTIVE\"\013\010",
    "    end\013\010",
    "    if action.type==\"start_systems\" then\013\010",
    "        local callOk,started,reason=pcall(self.startSystems,self,io,now)\013\010",
    "        if not callOk then\013\010",
    "            reason=\"START SYSTEMS ERROR: \"..tostring(started);started=false\013\010",
    "            logOperationIssue(self,\"flight\",\"systems\",reason)\013\010",
    "        end\013\010",
    "        if started then self:cancelLateral(false) end\013\010",
    "        if not callOk then return false,reason end\013\010",
    "        return started,reason\013\010",
    "    end\013\010",
    "    if type(action.type)==\"string\" and action.type:match(\"^tuning_\") then return self:tuningRequest(io,action,now) end\013\010",
    "    if self.tuningRun and action.type==\"altitude_disengage\" then return self:tuningRequest(io,{type=\"tuning_stop\"},now) end\013\010",
    "    if self.tuningRun then return false,\"PID TUNING IN PROGRESS\" end\013\010",
    "    if action.type==\"setting_update\" then return self:setting(io,action,now) end\013\010",
    "    if type(action.type)==\"string\" and action.type:match(\"^maintenance_\") then return self:maintenanceRequest(io,action,now) end\013\010",
    "    if self.maintenanceJob and action.type~=\"altitude_disengage\" then return false,\"LIFT MAINTENANCE IN PROGRESS\" end\013\010",
    "    if action.type==\"cockpit_mode\" and self.controls then\013\010",
    "        local ok,reason=self.controls:mode(io,action,now)\013\010",
    "        if ok and io.controlPresets then\013\010",
    "            io.controlPresets:cancelRestore()\013\010",
    "            -- Persist the explicit selection before its acknowledgement.\013\010",
    "            io.controlPresets:update(io,self,now)\013\010",
    "        end\013\010",
    "        return ok,reason\013\010",
    "    end\013\010",
    "    if action.type==\"vent_startup\" then return false,\"USE START SYSTEMS\" end\013\010",
    "    if action.type==\"altitude_disengage\" then self:stop(); return true end\013\010",
    "    if action.type==\"altitude_engage\" then return self:engage(io,now) end\013\010",
    "    return false,\"FLIGHT ACTION UNAVAILABLE\"\013\010",
    "end\013\010",
    "-- Minimum-output preparation is a separate, explicitly requested operation.\013\010",
    "-- It cannot grant altitude authority, raise an already operating vent ceiling,\013\010",
    "-- reset the trim probe, or restore itself on boot.\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Build bounded startup provider targets from the configured vent request.\010",
    "function Flight:startupTargets(io,now)\013\010",
    "    if self.tuningRun then return nil,\"PID TUNING IN PROGRESS\" end\013\010",
    "    if self.maintenanceJob then return nil,\"LIFT MAINTENANCE IN PROGRESS\" end\013\010",
    "    if io.config.vent_startup_enabled~=true then return nil,\"VENT STARTUP DISABLED\" end\013\010",
    "    if self.enabled then return nil,\"ALTITUDE CONTROL ALREADY ENGAGED\" end\013\010",
    "    if self.controls and not self.controls:usable(io,now) then return nil,\"COCKPIT CONTROLS UNAVAILABLE\" end\013\010",
    "    if io.anchor==\"ANCHORED\" or io.anchor==\"BRAKING\" then return nil,\"ANCHOR SUPPRESSES STARTUP\" end\013\010",
    "    local v=io.vessel\013\010",
    "    if not v or not v.valid or not v.uuid or not finite(v.at) or now<v.at or\013\010",
    "        now-v.at>io.config.network.sensor_stale_seconds then return nil,\"VESSEL DATA UNAVAILABLE\" end\013\010",
    "    local maps={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local n=io.nodes[q]\013\010",
    "        if not n or not io:nodeFresh(q,now) or not n.startReady or n.armed or n.operationBusy or not n.boot or\013\010",
    "            not n.altitude or not n.altitude.valid then return nil,q..\" STARTUP INTERFACES NOT READY\" end\013\010",
    "        local b=n.balloon\013\010",
    "        if not b or not b.hasBalloonValid or not b.hasBalloon or not b.gasMixValid then return nil,q..\" PROBE ENVELOPE UNAVAILABLE\" end\013\010",
    "        local bulk,fine=0,0;maps[q]={}\013\010",
    "        for name,p in pairs(n.providers) do\013\010",
    "            if not p.present or not p.writable or not p.targetValid or not finite(p.targetAmount) or\013\010",
    "                not p.signalValid or not finite(p.signalStrength) then return nil,q..\" STARTUP PROVIDER INTERFACE INVALID\" end\013\010",
    "            if p.controlRole==\"bulk\" then\013\010",
    "                bulk=bulk+1\013\010",
    "                if p.minimumNonzeroTarget~=50 or p.maxTarget<50 or\013\010",
    "                    (p.signalStrength>1 and p.targetAmount~=50) then return nil,q..\" VENT ALREADY OPERATING / FLOOR INVALID\" end\013\010",
    "                maps[q][name]=50\013\010",
    "            elseif p.controlRole==\"fine\" then\013\010",
    "                fine=fine+1\013\010",
    "                if p.signalStrength~=15 or not p.attachedValid or not p.attached or p.targetAmount<5 then\013\010",
    "                    return nil,q..\" ACTIVE TRIM PROBE REQUIRED\"\013\010",
    "                end\013\010",
    "                maps[q][name]=p.targetAmount\013\010",
    "            else return nil,q..\" PROVIDER ROLE INVALID\" end\013\010",
    "        end\013\010",
    "        if bulk~=steamCount(n) or fine~=1 then return nil,q..\" EXPECTED CONFIGURED VENTS AND ONE PROBE\" end\013\010",
    "    end\013\010",
    "    local model,modelReason=self:balancedLiftModel(io,self.controls and self.controls.targets and\013\010",
    "        self.controls.targets.altitude or v.altitude,now)\013\010",
    "    self.balancedLift=model\013\010",
    "    if model.phase==\"UNAVAILABLE\" or model.phase==\"INFEASIBLE\" then\013\010",
    "        if self:isFloorOnlyTargets(io,maps,false,true) then return maps end\013\010",
    "        return nil,modelReason or model.reason or \"BALANCED LIFT CAPACITY UNAVAILABLE\"\013\010",
    "    end\013\010",
    "    local capped,capReason,limited=self:capBalancedTargets(io,maps,model)\013\010",
    "    if not capped then return nil,capReason end\013\010",
    "    if limited then\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            for name,value in pairs(capped[q]) do\013\010",
    "                if value~=maps[q][name] then return nil,\"BALANCED LIFT LIMIT BELOW VERIFIED STARTUP FLOOR\" end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    maps=capped\013\010",
    "    return maps\013\010",
    "end\013\010",
    "-- START SYSTEMS is an explicit, session-limited route from an idle vessel to\013\010",
    "-- an altitude hold. The controller uses measured balloon lift and vessel\013\010",
    "-- weight; ceiling slew is only a safety limit and does not assume a gas/lift\013\010",
    "-- conversion factor.\013\010",
    "local SYSTEMS_PROBE_RENEW_SECONDS=5\013\010",
    "local SYSTEMS_TARGET_TOLERANCE_BLOCKS=1\013\010",
    "local SYSTEMS_LIFT_PROGRESS_EPSILON=0.005\013\010",
    "-- A separate lower threshold marks response onset. The larger progress epsilon\013\010",
    "-- is for stall detection; using it to time plant lag includes the startup\013\010",
    "-- ceiling ramp and can mistake actuator excitation time for envelope delay.\013\010",
    "local SYSTEMS_LIFT_RESPONSE_ONSET_EPSILON=0.0001\013\010",
    "local SYSTEMS_ACK_TIMEOUT_SECONDS=12\013\010",
    "local SYSTEMS_RECOVERY_RETRY_SECONDS=1.5\013\010",
    "local SYSTEMS_SAMPLE_GAP_SECONDS=3\013\010",
    "local SYSTEMS_ENVELOPE_TIMEOUT_SECONDS=120\013\010",
    "local SYSTEMS_FULL_BOILER_EFFICIENCY=0.95\013\010",
    "-- Startup boiler gate: START SYSTEMS waits this long for every bulk vent\013\010",
    "-- boiler to reach 100%. After the wait it continues with a warning when every\013\010",
    "-- boiler reads at least the minimum, and refuses the start when any boiler is\013\010",
    "-- below the minimum or cannot be read.\013\010",
    "local SYSTEMS_BOILER_WAIT_SECONDS=120\013\010",
    "local SYSTEMS_BOILER_MINIMUM_EFFICIENCY=0.10\013\010",
    "local SYSTEMS_RAMP_FRACTION_PER_SECOND=0.02\013\010",
    "local SYSTEMS_FAST_RAMP_FRACTION_PER_SECOND=0.08\013\010",
    "-- Keep the first ceiling steps small while the envelope is still near its\013\010",
    "-- floor. Measured support and vessel response earn the faster existing rates.\013\010",
    "local SYSTEMS_SOFT_START_RAMP_FRACTION_PER_SECOND=0.002\013\010",
    "local SYSTEMS_FAST_RELEASE_FRACTION_PER_SECOND=0.12\013\010",
    "-- Preserve the proven feedback slew when reducing ceilings. A faster release\013\010",
    "-- caused repeated over-correction in the delayed-fill model and did not\013\010",
    "-- remove lift already accumulated in the envelope.\013\010",
    "local SYSTEMS_RELEASE_RAMP_FRACTION_PER_SECOND=SYSTEMS_RAMP_FRACTION_PER_SECOND\013\010",
    "local SYSTEMS_RATE_STABLE_SAMPLES=3\013\010",
    "local SYSTEMS_FAST_FILL_TAPER_FRACTION=0.8\013\010",
    "local SYSTEMS_FAST_FILL_STOP_FRACTION=0.98\013\010",
    "local SYSTEMS_STARTUP_CONTROL_HORIZON_SECONDS=30\013\010",
    "local SYSTEMS_STARTUP_SPEED_RAMP_SECONDS=60\013\010",
    "local SYSTEMS_MAX_SLEW_CATCHUP_SECONDS=3\013\010",
    "-- Operator-tunable startup shaping (altitude_control.*). Missing or\013\010",
    "-- out-of-range values fall back to the original constants above.\013\010",
    "local function startupSetting(config,key,default,minimum,maximum)\013\010",
    "    local control=type(config)==\"table\" and (type(config.altitude_control)==\"table\" and config.altitude_control or config) or nil\013\010",
    "    local value=control and control[key]\013\010",
    "    if finite(value) and value>=minimum and value<=maximum then return value end\013\010",
    "    return default\013\010",
    "end\013\010",
    "local function startupRampSeconds(config)\013\010",
    "    return startupSetting(config,\"startup_acceleration_seconds\",SYSTEMS_STARTUP_SPEED_RAMP_SECONDS,5,600)\013\010",
    "end\013\010",
    "local function startupLookaheadSeconds(config)\013\010",
    "    return startupSetting(config,\"startup_braking_lookahead_seconds\",SYSTEMS_STARTUP_CONTROL_HORIZON_SECONDS,5,120)\013\010",
    "end\013\010",
    "local function ceilingRiseRates(config)\013\010",
    "    local soft=startupSetting(config,\"ceiling_soft_start_rate\",SYSTEMS_SOFT_START_RAMP_FRACTION_PER_SECOND,0.0005,0.05)\013\010",
    "    local normal=math.max(soft,startupSetting(config,\"ceiling_rise_rate\",SYSTEMS_RAMP_FRACTION_PER_SECOND,0.005,0.1))\013\010",
    "    local fast=math.max(normal,startupSetting(config,\"ceiling_fast_rate\",SYSTEMS_FAST_RAMP_FRACTION_PER_SECOND,0.02,0.25))\013\010",
    "    return soft,normal,fast\013\010",
    "end\013\010",
    "-- Section: Flight lifecycle | Operator actions, runtime gates and cached presentation.\010",
    "-- Summary: Refresh PID measurement history using the observed elapsed sample time.\010",
    "local function observePidMeasurement(pid,measurement,elapsed)\013\010",
    "    if not pid or not finite(measurement) then return end\013\010",
    "    local gains=pid.g\013\010",
    "    if finite(elapsed) and elapsed>0 and elapsed<=SYSTEMS_SAMPLE_GAP_SECONDS and\013\010",
    "        gains and finite(gains.derivative_filter_seconds) and gains.derivative_filter_seconds>=0 and\013\010",
    "        finite(pid.previous) and finite(pid.d) then\013\010",
    "        local alpha=elapsed/(gains.derivative_filter_seconds+elapsed)\013\010",
    "        local rawDerivative=-(measurement-pid.previous)/elapsed\013\010",
    "        pid.d=pid.d+alpha*(rawDerivative-pid.d)\013\010",
    "    else\013\010",
    "        -- Long ACK waits are deliberately not fed to the next PID sample as a\013\010",
    "        -- single derivative or integral interval. Re-anchor to current data.\013\010",
    "        pid.d=0\013\010",
    "    end\013\010",
    "    pid.previous=measurement\013\010",
    "end\013\010",
    "local function systemsStartupControlHorizon(config,onset,sampleSeconds)\013\010",
    "    local sample=finite(sampleSeconds) and math.max(0,sampleSeconds) or 0\013\010",
    "    return math.max(startupLookaheadSeconds(config),\013\010",
    "        finite(onset) and math.max(0,onset)*2 or 0,sample)\013\010",
    "end\013\010",
    "local function systemsStartupEnvelopeHorizon(onset,sampleSeconds)\013\010",
    "    local sample=finite(sampleSeconds) and math.max(0,sampleSeconds) or 0\013\010",
    "    return math.max(6,finite(onset) and math.max(0,onset)*3 or 0,sample)\013\010",
    "end\013\010",
    "local function systemsStartupNominalSpeed(config)\013\010",
    "    local speed=config and config.startup_max_vertical_speed\013\010",
    "    if finite(speed) and speed>0 then return speed end\013\010",
    "    speed=config and config.max_vertical_speed\013\010",
    "    return finite(speed) and speed>0 and speed or 1\013\010",
    "end\013\010",
    "local function systemsStartupSpeedLimit(config)\013\010",
    "    local limit=config and config.startup_vertical_speed_limit\013\010",
    "    if finite(limit) and limit>0 then return limit end\013\010",
    "    local legacy=config and config.max_vertical_speed\013\010",
    "    if not finite(legacy) or legacy<=0 then legacy=1 end\013\010",
    "    return legacy+1\013\010",
    "end\013\010",
    "-- Section: Systems control | Startup, measured dynamics and bounded provider demand.\010",
    "-- Summary: Bound startup acceleration using configured limits and measured command/response delay.\010",
    "local function systemsStartupAcceleration(config,lag,sampleSeconds,ackWaitSeconds)\013\010",
    "    local nominal=systemsStartupNominalSpeed(config)\013\010",
    "    -- Earn nominal startup speed over a fixed conservative physical horizon,\013\010",
    "    -- extended when measured vessel response is slower. Certification dwell\013\010",
    "    -- settings do not determine the takeoff curve.\013\010",
    "    local horizon=math.max(startupRampSeconds(config),\013\010",
    "        finite(lag) and math.max(0,lag)*2 or 0)\013\010",
    "    if finite(sampleSeconds) and sampleSeconds>0 and finite(ackWaitSeconds) and\013\010",
    "        ackWaitSeconds>sampleSeconds*1.5 then\013\010",
    "        -- A command that is only applied after a multi-sample ACK wait cannot\013\010",
    "        -- safely use the fast-ACK acceleration budget. Scale the existing\013\010",
    "        -- ramp horizon by the observed command cadence, bounded by the ACK\013\010",
    "        -- timeout, while leaving nominal and hard vertical-speed limits alone.\013\010",
    "        local cadence=clamp((ackWaitSeconds+sampleSeconds)/sampleSeconds,1,\013\010",
    "            (SYSTEMS_ACK_TIMEOUT_SECONDS+sampleSeconds)/sampleSeconds)\013\010",
    "        horizon=math.max(horizon,startupRampSeconds(config)*cadence)\013\010",
    "    end\013\010",
    "    return nominal/horizon\013\010",
    "end\013\010",
    "local function systemsStartupSpeedRampHorizon(config,lag,sampleSeconds,ackWaitSeconds)\013\010",
    "    local nominal=systemsStartupNominalSpeed(config)\013\010",
    "    local acceleration=systemsStartupAcceleration(config,lag,sampleSeconds,ackWaitSeconds)\013\010",
    "    return math.max(systemsStartupControlHorizon(config,lag,sampleSeconds),nominal/math.max(acceleration,0.0001))\013\010",
    "end\013\010",
    "-- Summary: Project the lift-to-weight support ratio over the measured response horizon.\010",
    "local function systemsProjectedSupportRatio(actual,rate,horizon,supportDemand)\013\010",
    "    if not finite(actual) then return nil end\013\010",
    "    local future=actual\013\010",
    "    if finite(rate) and finite(horizon) and horizon>0 then\013\010",
    "        future=actual+rate*horizon\013\010",
    "        if rate>0 and finite(supportDemand) then\013\010",
    "            -- Let measured fill progress forecast through hover demand, with\013\010",
    "            -- one continuous post-demand ceiling. Capping only while actual\013\010",
    "            -- support is below demand creates a jump at the crossing that\013\010",
    "            -- can flip the speed governor every sample.\013\010",
    "            future=math.max(actual,math.min(future,supportDemand+rate*horizon))\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return future\013\010",
    "end\013\010",
    "-- Summary: Estimate climb distance from current velocity and the observed lift response.\010",
    "local function systemsProjectedClimbDistance(v,state,horizon,gravity,supportDemand)\013\010",
    "    local rise=finite(v and v.verticalSpeed) and math.max(0,v.verticalSpeed) or 0\013\010",
    "    if not finite(horizon) or horizon<=0 then return 0 end\013\010",
    "    local actual=state and state.actualRatio\013\010",
    "    local rate=state and (finite(state.projectedLiftRate) and state.projectedLiftRate or state.liftRate)\013\010",
    "    local drag=state and state.verticalDragEstimate\013\010",
    "    local acceleration\013\010",
    "    if finite(actual) and finite(rate) and finite(gravity) and gravity>0 then\013\010",
    "        local future=systemsProjectedSupportRatio(actual,rate,horizon,supportDemand)\013\010",
    "        local meanSupport=(actual+future)*0.5\013\010",
    "        drag=finite(drag) and math.max(0,drag) or 0\013\010",
    "        acceleration=gravity*(meanSupport-1)-drag*rise\013\010",
    "    elseif state and finite(state.verticalAccelerationRaw) then\013\010",
    "        acceleration=state.verticalAccelerationRaw\013\010",
    "    elseif state and finite(state.verticalAcceleration) then\013\010",
    "        acceleration=state.verticalAcceleration\013\010",
    "    end\013\010",
    "    if not finite(acceleration) then return rise*horizon end\013\010",
    "    local distance=rise*horizon+0.5*acceleration*horizon*horizon\013\010",
    "    if acceleration<0 and rise>0 then\013\010",
    "        local stopTime=rise/(-acceleration)\013\010",
    "        if horizon>=stopTime then\013\010",
    "            -- After the vertical speed reaches zero the vessel does not\013\010",
    "            -- travel the negative portion of the constant-acceleration\013\010",
    "            -- parabola. Keep the full ascent to the peak for any longer\013\010",
    "            -- prediction horizon.\013\010",
    "            distance=rise*rise/(2*-acceleration)\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return math.max(0,distance)\013\010",
    "end\013\010",
    "-- Keep the pure trajectory projection available to deterministic controller\013\010",
    "-- regressions, including stopping-time horizons that outlast the ascent.\013\010",
    "Flight._systemsProjectedClimbDistance=systemsProjectedClimbDistance\013\010",
    "Flight._systemsProjectedSupportRatio=systemsProjectedSupportRatio\013\010",
    "local function systemsSupportProgress(actualRatio,targetRatio)\013\010",
    "    if not finite(actualRatio) or actualRatio<=0 then return 0 end\013\010",
    "    local target=finite(targetRatio) and math.max(targetRatio,0.05) or 1\013\010",
    "    local x=clamp(actualRatio/target,0,1)\013\010",
    "    return x*x*(3-2*x)\013\010",
    "end\013\010",
    "-- Summary: Sum configured bulk-vent ceilings across the selected target maps.\010",
    "local function systemsBulkCeilingSum(maps,nodes)\013\010",
    "    local total=0\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,value in pairs(maps and maps[q] or {}) do\013\010",
    "            local provider=nodes and nodes[q] and nodes[q].providers and nodes[q].providers[name]\013\010",
    "            if provider and provider.controlRole==\"bulk\" and finite(value) then total=total+value end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return total\013\010",
    "end\013\010",
    "-- Summary: Compare the requested bulk-vent target maps with the applied maps.\010",
    "local function systemsBulkTargetsChanged(targets,previous,nodes)\013\010",
    "    if type(previous)~=\"table\" then return true end\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        for name,provider in pairs(nodes and nodes[q] and nodes[q].providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                local nextValue=targets and targets[q] and targets[q][name]\013\010",
    "                local oldValue=previous[q] and previous[q][name]\013\010",
    "                if nextValue~=oldValue then return true end\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return false\013\010",
    "end\013\010",
    "local function copyMaps(maps)\013\010",
    "    local out={}\013\010",
    "    for q,targets in pairs(maps or {}) do out[q]=clone(targets) end\013\010",
    "    return out\013\010",
    "end\013\010",
    "local BALANCED_LIFT_MATCH_FRACTION=0.05\013\010",
    "\013\010",
    "-- Summary: Calculate balanced chamber support bounds from verified provider capacity.\010",
    "function Flight:balancedLiftModel(io,targetY,now)\013\010",
    "    local function unavailable(reason)\013\010",
    "        return {phase=\"UNAVAILABLE\",reason=reason,targetSupportKnown=false,\013\010",
    "            targetUnreachable=false},reason\013\010",
    "    end\013\010",
    "    local strengths=self.config and self.config.verified_gas_lift_strengths\013\010",
    "    if type(strengths)~=\"table\" then\013\010",
    "        return unavailable(\"VERIFIED GAS LIFT STRENGTHS UNAVAILABLE\")\013\010",
    "    end\013\010",
    "    now=now or (io.nowSeconds and io:nowSeconds()) or 0\013\010",
    "    local vessel=io.vessel or {}\013\010",
    "    if not finite(targetY) then targetY=vessel.altitude end\013\010",
    "    local capacities,liftSum={},0\013\010",
    "    local weakest,limiting=nil,nil\013\010",
    "    local maxStrengthByQuadrant={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        if not node or (io.nodeFresh and not io:nodeFresh(q,now)) then\013\010",
    "            return unavailable(q..\" CAPACITY STATUS STALE\")\013\010",
    "        end\013\010",
    "        local balloon=node.balloon or {}\013\010",
    "        if balloon.hasBalloonValid~=true or balloon.hasBalloon~=true then\013\010",
    "            return unavailable(q..\" BALLOON ATTACHMENT NOT VERIFIED\")\013\010",
    "        end\013\010",
    "        if balloon.capacityValid~=true or not finite(balloon.capacity) or balloon.capacity<=0 then\013\010",
    "            return unavailable(q..\" BALLOON CAPACITY UNAVAILABLE\")\013\010",
    "        end\013\010",
    "        if balloon.gasMixValid~=true or type(balloon.gasMix)~=\"table\" or\013\010",
    "            balloon.liftValid~=true or not finite(balloon.lift) then\013\010",
    "            return unavailable(q..\" LIFT / COMPOSITION READBACK UNAVAILABLE\")\013\010",
    "        end\013\010",
    "        local source=type(balloon.source)==\"string\" and node.providers and node.providers[balloon.source]\013\010",
    "        if not source or source.present~=true or source.writable~=true or source.controlRole~=\"bulk\" or\013\010",
    "            source.signalValid~=true or source.signalStrength~=15 or\013\010",
    "            source.attachedValid~=true or source.attached~=true or not source.gasTypeValid or\013\010",
    "            (source.activeSupported==true and (source.activeValid~=true or source.active~=true)) or\013\010",
    "            type(source.gasType)~=\"string\" or not finite(balloon.gasMix[source.gasType]) or\013\010",
    "            balloon.gasMix[source.gasType]<=0 then\013\010",
    "            return unavailable(q..\" WAITING FOR BULK ENVELOPE CAPACITY\")\013\010",
    "        end\013\010",
    "        local expectedLift,gasAmount,positiveGases=0,0,0\013\010",
    "        for gas,amount in pairs(balloon.gasMix) do\013\010",
    "            if type(gas)~=\"string\" or not finite(amount) or amount<0 then\013\010",
    "                return unavailable(q..\" GAS MIX INVALID\")\013\010",
    "            end\013\010",
    "            if amount>0 then\013\010",
    "                local strength=strengths[gas]\013\010",
    "                if not finite(strength) or strength<=0 then\013\010",
    "                    return unavailable(q..\" LIFT STRENGTH UNVERIFIED FOR \"..gas:sub(1,32))\013\010",
    "                end\013\010",
    "                expectedLift=expectedLift+amount*strength\013\010",
    "                gasAmount=gasAmount+amount\013\010",
    "                positiveGases=positiveGases+1\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if gasAmount<=0 or positiveGases==0 or not finite(expectedLift) or expectedLift<=0 then\013\010",
    "            return unavailable(q..\" POSITIVE GAS MIX REQUIRED\")\013\010",
    "        end\013\010",
    "        local tolerance=math.max(1,expectedLift*BALANCED_LIFT_MATCH_FRACTION)\013\010",
    "        if math.abs(balloon.lift-expectedLift)>tolerance then\013\010",
    "            return unavailable(q..\" RAW LIFT DOES NOT MATCH VERIFIED GAS MIX\")\013\010",
    "        end\013\010",
    "        local maxStrength,count,bulk,fine=0,0,0,0\013\010",
    "        local outputSlots,providerOutputMaximum=0,0\013\010",
    "        local rankedOutputs={}\013\010",
    "        for _,provider in pairs(node.providers or {}) do\013\010",
    "            count=count+1\013\010",
    "            if provider.present~=true or provider.writable~=true then\013\010",
    "                return unavailable(q..\" PROVIDER PRESENCE / WRITE CAPABILITY UNAVAILABLE\")\013\010",
    "            end\013\010",
    "            local strength=configuredProviderStrength(self.config,provider)\013\010",
    "            if not finite(strength) then\013\010",
    "                return unavailable(q..\" PROVIDER GAS TYPE UNAVAILABLE\")\013\010",
    "            end\013\010",
    "            if not finite(strength) or strength<=0 then\013\010",
    "                return unavailable(q..\" PROVIDER LIFT STRENGTH UNVERIFIED FOR \"..tostring(provider.gasType):sub(1,32))\013\010",
    "            end\013\010",
    "            maxStrength=math.max(maxStrength,strength)\013\010",
    "            local maximum=provider.maxTarget\013\010",
    "            if not finite(maximum) or maximum<0 then\013\010",
    "                return unavailable(q..\" PROVIDER MAXIMUM TARGET UNAVAILABLE\")\013\010",
    "            end\013\010",
    "            outputSlots=outputSlots+maximum\013\010",
    "            providerOutputMaximum=providerOutputMaximum+maximum*strength\013\010",
    "            rankedOutputs[#rankedOutputs+1]={amount=maximum,strength=strength}\013\010",
    "            if provider.controlRole==\"bulk\" then bulk=bulk+1\013\010",
    "            elseif provider.controlRole==\"fine\" then fine=fine+1\013\010",
    "            else return unavailable(q..\" PROVIDER ROLE UNVERIFIED\") end\013\010",
    "        end\013\010",
    "        if count~=steamCount(node)+1 or bulk~=steamCount(node) or fine~=1 then\013\010",
    "            return unavailable(q..\" EXPECTED CONFIGURED VENTS AND ONE TRIM BURNER\")\013\010",
    "        end\013\010",
    "        table.sort(rankedOutputs,function(a,b)\013\010",
    "            if a.strength==b.strength then return a.amount>b.amount end\013\010",
    "            return a.strength>b.strength\013\010",
    "        end)\013\010",
    "        local remainingCapacity=balloon.capacity\013\010",
    "        local capacityMaximum=0\013\010",
    "        for _,slot in ipairs(rankedOutputs) do\013\010",
    "            if remainingCapacity<=0 then break end\013\010",
    "            local amount=math.min(slot.amount,remainingCapacity)\013\010",
    "            capacityMaximum=capacityMaximum+amount*slot.strength\013\010",
    "            remainingCapacity=remainingCapacity-amount\013\010",
    "        end\013\010",
    "        local maximum=math.min(capacityMaximum,providerOutputMaximum)\013\010",
    "        capacities[q]={capacity=balloon.capacity,rawMaximum=maximum,\013\010",
    "            providerRawMaximum=providerOutputMaximum,currentRawLift=balloon.lift,\013\010",
    "            gasAmount=gasAmount,maxGasStrength=maxStrength}\013\010",
    "        maxStrengthByQuadrant[q]=maxStrength\013\010",
    "        liftSum=liftSum+balloon.lift\013\010",
    "        if not weakest or maximum<weakest then weakest,limiting=maximum,q end\013\010",
    "    end\013\010",
    "    if not finite(weakest) or weakest<=0 then return unavailable(\"BALANCED CAPACITY LIMIT UNAVAILABLE\") end\013\010",
    "    local model={phase=\"READY\",limitingQuadrant=limiting,\013\010",
    "        rawPerQuadrantMaximum=weakest,rawVesselMaximum=weakest*#QUADS,\013\010",
    "        quadrants=capacities,maxGasStrengthByQuadrant=maxStrengthByQuadrant,\013\010",
    "        currentSupportRatio=nil,targetSupportRatio=nil,targetSupportKnown=false,targetUnreachable=false}\013\010",
    "    local pressure=airPressure(vessel)\013\010",
    "    if pressure and finite(vessel.mass) and vessel.mass>0 then\013\010",
    "        model.currentSupportRatio=model.rawVesselMaximum*pressure/vessel.mass\013\010",
    "        model.actualSupportRatio=liftSum*pressure/vessel.mass\013\010",
    "    end\013\010",
    "    local targetPressure,targetPressureError\013\010",
    "    if finite(targetY) and type(io.airPressureAtWorldY)==\"function\" then\013\010",
    "        targetPressure,targetPressureError=io:airPressureAtWorldY(targetY)\013\010",
    "    elseif finite(targetY) and finite(vessel.altitude) and math.abs(targetY-vessel.altitude)<0.001 then\013\010",
    "        targetPressure=pressure\013\010",
    "    end\013\010",
    "    if finite(targetPressure) and targetPressure>0 and finite(vessel.mass) and vessel.mass>0 then\013\010",
    "        model.targetSupportKnown=true\013\010",
    "        model.targetPressure=targetPressure\013\010",
    "        model.targetSupportRatio=model.rawVesselMaximum*targetPressure/vessel.mass\013\010",
    "        if model.targetSupportRatio<1 then\013\010",
    "            model.phase=\"LIMITED\"\013\010",
    "            model.targetUnreachable=true\013\010",
    "            model.reason=\"INSUFFICIENT BALANCED LIFT / TARGET UNREACHABLE: \"..limiting..\013\010",
    "                \" LIMIT \"..string.format(\"%.1f\",weakest)..\" RAW LIFT PER QUADRANT\"\013\010",
    "        end\013\010",
    "    elseif targetPressureError then\013\010",
    "        model.pressureError=tostring(targetPressureError):sub(1,100)\013\010",
    "    end\013\010",
    "    return model\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Clamp requested chamber target maps to the balanced provider bounds.\010",
    "function Flight:capBalancedTargets(io,maps,model)\013\010",
    "    if type(model)~=\"table\" or not finite(model.rawPerQuadrantMaximum) then\013\010",
    "        return nil,\"BALANCED LIFT CAPACITY UNAVAILABLE\",false\013\010",
    "    end\013\010",
    "    local result=copyMaps(maps)\013\010",
    "    local anyLimited=false\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        local targets=result[q]\013\010",
    "        if type(node)~=\"table\" or type(targets)~=\"table\" then\013\010",
    "            return nil,q..\" BALANCED TARGET MAP UNAVAILABLE\",false\013\010",
    "        end\013\010",
    "        local floorLift,totalLift=0,0\013\010",
    "        local entries={}\013\010",
    "        for name,provider in pairs(node.providers or {}) do\013\010",
    "            local amount=targets[name]\013\010",
    "            local strength=configuredProviderStrength(self.config,provider)\013\010",
    "            if not finite(amount) or amount<0 or amount%1~=0 or not finite(strength) or strength<=0 then\013\010",
    "                return nil,q..\" BALANCED PROVIDER TARGET / STRENGTH INVALID\",false\013\010",
    "            end\013\010",
    "            local floor=0\013\010",
    "            if provider.controlRole==\"bulk\" then\013\010",
    "                floor=provider.minimumNonzeroTarget or provider.minTarget or 0\013\010",
    "            elseif amount>0 then\013\010",
    "                floor=provider.minimumNonzeroTarget or provider.minTarget or 0\013\010",
    "            end\013\010",
    "            if amount<floor then return nil,q..\" TARGET BELOW REQUIRED PROVIDER FLOOR\",false end\013\010",
    "            floorLift=floorLift+floor*strength\013\010",
    "            totalLift=totalLift+amount*strength\013\010",
    "            entries[#entries+1]={name=name,amount=amount,floor=floor,strength=strength}\013\010",
    "        end\013\010",
    "        if floorLift>model.rawPerQuadrantMaximum+1e-7 then\013\010",
    "            model.phase=\"INFEASIBLE\"\013\010",
    "            model.reason=\"INSUFFICIENT BALANCED LIFT / PROVIDER FLOORS EXCEED \"..\013\010",
    "                tostring(q)..\" LIMIT \"..string.format(\"%.1f\",model.rawPerQuadrantMaximum)\013\010",
    "            return nil,model.reason,false\013\010",
    "        end\013\010",
    "        if totalLift>model.rawPerQuadrantMaximum+1e-7 then\013\010",
    "            anyLimited=true\013\010",
    "            local discretionary=totalLift-floorLift\013\010",
    "            local scale=discretionary>0 and clamp(\013\010",
    "                (model.rawPerQuadrantMaximum-floorLift)/discretionary,0,1) or 0\013\010",
    "            for _,entry in ipairs(entries) do\013\010",
    "                local amount=entry.floor+math.floor((entry.amount-entry.floor)*scale+1e-9)\013\010",
    "                result[q][entry.name]=amount\013\010",
    "            end\013\010",
    "        end\013\010",
    "    end\013\010",
    "    model.capApplied=anyLimited\013\010",
    "    model.demandLimited=anyLimited\013\010",
    "    if anyLimited and not model.reason then\013\010",
    "        model.reason=\"BALANCED RAW LIFT CAP ACTIVE: \"..tostring(model.limitingQuadrant)..\013\010",
    "            \" LIMIT \"..string.format(\"%.1f\",model.rawPerQuadrantMaximum)..\" PER QUADRANT\"\013\010",
    "    end\013\010",
    "    return result,nil,anyLimited\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Sum the provider target amounts for each chamber.\010",
    "local function systemsProviderTargetTotals(io,maps)\013\010",
    "    local totals={}\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local total=0\013\010",
    "        for name,provider in pairs(io.nodes[q].providers or {}) do\013\010",
    "            if provider.controlRole==\"bulk\" or provider.controlRole==\"fine\" then\013\010",
    "                local amount=maps[q] and maps[q][name]\013\010",
    "                if not finite(amount) then return nil,q..\" INITIAL GAS TARGET MAP INCOMPLETE\" end\013\010",
    "                total=total+amount\013\010",
    "            end\013\010",
    "        end\013\010",
    "        totals[q]=total\013\010",
    "    end\013\010",
    "    return totals\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Allocate a chamber's initial gas request across its permitted providers.\010",
    "local function distributeInitialGasTotal(entries,total)\013\010",
    "    local result={};local minimum=0\013\010",
    "    table.sort(entries,function(a,b) return a.name<b.name end)\013\010",
    "    for _,entry in ipairs(entries) do result[entry.name]=entry.floor;minimum=minimum+entry.floor end\013\010",
    "    local remaining=total-minimum\013\010",
    "    if remaining<0 then return nil,\"INITIAL GAS TARGET BELOW PROVIDER FLOORS\" end\013\010",
    "    while remaining>0 do\013\010",
    "        local active={}\013\010",
    "        for _,entry in ipairs(entries) do\013\010",
    "            if result[entry.name]<entry.maximum then active[#active+1]=entry end\013\010",
    "        end\013\010",
    "        if #active==0 then break end\013\010",
    "        table.sort(active,function(a,b)\013\010",
    "            local av,bv=result[a.name],result[b.name]\013\010",
    "            if av==bv then return a.name<b.name end\013\010",
    "            return av<bv\013\010",
    "        end)\013\010",
    "        local lowest=result[active[1].name]\013\010",
    "        local group={}\013\010",
    "        local nextLevel=math.huge\013\010",
    "        for _,entry in ipairs(active) do\013\010",
    "            local amount=result[entry.name]\013\010",
    "            if amount==lowest then\013\010",
    "                group[#group+1]=entry\013\010",
    "                nextLevel=math.min(nextLevel,entry.maximum)\013\010",
    "            elseif amount>lowest then\013\010",
    "                nextLevel=math.min(nextLevel,amount)\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if #group==0 or not finite(nextLevel) or nextLevel<=lowest then break end\013\010",
    "        local share=math.floor(remaining/#group)\013\010",
    "        if share<=0 then\013\010",
    "            for i=1,math.min(remaining,#group) do\013\010",
    "                result[group[i].name]=result[group[i].name]+1\013\010",
    "            end\013\010",
    "            remaining=0\013\010",
    "        else\013\010",
    "            local increment=math.min(share,nextLevel-lowest)\013\010",
    "            if increment<=0 then break end\013\010",
    "            for _,entry in ipairs(group) do result[entry.name]=result[entry.name]+increment end\013\010",
    "            remaining=remaining-increment*#group\013\010",
    "        end\013\010",
    "    end\013\010",
    "    return result,remaining\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Calculate initial fill targets from configured gas demand and verified capacity.\010",
    "function Flight:systemsStartupGasSeedTargets(io,maps,model,startupState)\013\010",
    "    local requested=self.config.startup_gas_target_m3_per_chamber\013\010",
    "    if not finite(requested) or requested<0 then requested=0 end\013\010",
    "    local info={requestedM3PerChamber=requested,unit=\"m3/chamber\",\013\010",
    "        targetBasis=\"sum of provider target ceilings; not measured gas volume\",\013\010",
    "        limited=false,seeded=false,status=requested>0 and \"PENDING\" or \"DISABLED\"}\013\010",
    "    if requested<=0 then return copyMaps(maps),info end\013\010",
    "    if type(model)~=\"table\" or (model.phase~=\"READY\" and model.phase~=\"LIMITED\") or\013\010",
    "        not finite(model.rawPerQuadrantMaximum) then\013\010",
    "        return nil,info,\"WAITING FOR VERIFIED BALANCED CAPACITY\"\013\010",
    "    end\013\010",
    "    local entriesByQ={};local minimumTotal=0;local maximumTotal=math.huge\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local node=io.nodes and io.nodes[q]\013\010",
    "        if type(node)~=\"table\" then return nil,info,q..\" INITIAL GAS NODE UNAVAILABLE\" end\013\010",
    "        local fineProvider=nil;local fineTarget=nil;local bulkEntries={};local bulkFloor=0;local bulkMax=0\013\010",
    "        local steamStrength=nil\013\010",
    "        for name,provider in pairs(node.providers or {}) do\013\010",
    "            if provider.controlRole==\"fine\" then\013\010",
    "                if fineProvider then return nil,info,q..\" HAS MULTIPLE FINE PROVIDERS\" end\013\010",
    "                fineProvider=provider;fineTarget=maps[q] and maps[q][name]\013\010",
    "            elseif provider.controlRole==\"bulk\" then\013\010",
    "                if provider.gasTypeValid~=true or provider.gasType~=\"steam\" then\013\010",
    "                    return nil,info,q..\" BULK STEAM TYPE NOT VERIFIED\"\013\010",
    "                end\013\010",
    "                local strength=self.config.verified_gas_lift_strengths and\013\010",
    "                    self.config.verified_gas_lift_strengths[provider.gasType]\013\010",
    "                local floor=provider.minimumNonzeroTarget or provider.minTarget\013\010",
    "                if not finite(strength) or strength<=0 or not finite(floor) or floor<1 or\013\010",
    "                    not finite(provider.maxTarget) or provider.maxTarget<floor then\013\010",
    "                    return nil,info,q..\" BULK PROVIDER LIMITS / STRENGTH UNAVAILABLE\"\013\010",
    "                end\013\010",
    "                if steamStrength and math.abs(steamStrength-strength)>1e-9 then\013\010",
    "                    return nil,info,q..\" STEAM STRENGTH READBACK IS INCONSISTENT\"\013\010",
    "                end\013\010",
    "                steamStrength=strength;bulkFloor=bulkFloor+floor;bulkMax=bulkMax+provider.maxTarget\013\010",
    "                bulkEntries[#bulkEntries+1]={name=name,floor=floor,maximum=provider.maxTarget}\013\010",
    "            end\013\010",
    "        end\013\010",
    "        if #bulkEntries~=steamCount(node) or not fineProvider or not finite(fineTarget) or fineTarget<0 or\013\010",
    "            not finite(fineProvider.maxTarget) or fineTarget>fineProvider.maxTarget then\013\010",
    "            return nil,info,q..\" STARTUP GAS PROVIDER MAP INVALID\"\013\010",
    "        end\013\010",
    "        local fineStrength=fineProvider.gasTypeValid and self.config.verified_gas_lift_strengths and\013\010",
    "            self.config.verified_gas_lift_strengths[fineProvider.gasType]\013\010",
    "        if not finite(fineStrength) or fineStrength<=0 then\013\010",
    "            return nil,info,q..\" FINE PROVIDER STRENGTH UNAVAILABLE\"\013\010",
    "        end\013\010",
    "        local fineFloor=fineTarget>0 and (fineProvider.minimumNonzeroTarget or fineProvider.minTarget or 0) or 0\013\010",
    "        if fineTarget<fineFloor then return nil,info,q..\" FINE TARGET BELOW PROVIDER FLOOR\" end\013\010",
    "        local rawForBulk=model.rawPerQuadrantMaximum-fineTarget*fineStrength\013\010",
    "        local capacityBulk=math.floor(math.max(0,rawForBulk)/steamStrength+1e-9)\013\010",
    "        local allowedBulk=math.min(bulkMax,capacityBulk)\013\010",
    "        local lowTotal=fineTarget+bulkFloor\013\010",
    "        local highTotal=fineTarget+allowedBulk\013\010",
    "        if highTotal<lowTotal then return nil,info,q..\" BALANCED CAPACITY IS BELOW PROVIDER FLOORS\" end\013\010",
    "        minimumTotal=math.max(minimumTotal,lowTotal)\013\010",
    "        maximumTotal=math.min(maximumTotal,highTotal)\013\010",
    "        entriesByQ[q]={fineTarget=fineTarget,fineStrength=fineStrength,\013\010",
    "            steamStrength=steamStrength,bulkEntries=bulkEntries}\013\010",
    "    end\013\010",
    "    if maximumTotal<minimumTotal then return nil,info,\"NO COMMON STARTUP GAS TARGET FITS ALL QUADRANTS\" end\013\010",
    "    local effective=clamp(requested,minimumTotal,maximumTotal)\013\010",
    "    if effective~=requested then\013\010",
    "        info.limited=true\013\010",
    "        if requested<minimumTotal then\013\010",
    "            info.limitReason=\"PROVIDER FLOORS REQUIRE AT LEAST \"..tostring(minimumTotal)..\" m3/chamber\"\013\010",
    "        else\013\010",
    "            info.limitReason=\"WEAKEST VERIFIED PROVIDER / BALANCED CAPACITY LIMITS TARGET TO \"..\013\010",
    "                tostring(maximumTotal)..\" m3/chamber\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    if type(startupState)==\"table\" then\013\010",
    "        local vessel=io.vessel or {}\013\010",
    "        local gravity=vessel.environment and vessel.environment.gravity and math.abs(vessel.environment.gravity.y)\013\010",
    "        local pressure=airPressure(vessel)\013\010",
    "        if not finite(vessel.mass) or vessel.mass<=0 or not finite(gravity) or gravity<=0 or not pressure or\013\010",
    "            not finite(vessel.altitude) or not finite(vessel.verticalSpeed) or not finite(startupState.target) then\013\010",
    "            return nil,info,\"INITIAL GAS SEED ALTITUDE DEMAND INPUTS UNAVAILABLE\"\013\010",
    "        end\013\010",
    "        local network=io.config and io.config.network or {}\013\010",
    "        local sampleSeconds=finite(network.sample_interval_seconds) and network.sample_interval_seconds or 0.5\013\010",
    "        local ackWait=math.max(finite(startupState.lastAckWaitSeconds) and startupState.lastAckWaitSeconds or 0,\013\010",
    "            finite(network.commission_ack_seconds) and network.commission_ack_seconds or 0)\013\010",
    "        local acceleration=systemsStartupAcceleration(self.config,startupState.responseLagSeconds,\013\010",
    "            (startupState.dynamics or {}).sampleSeconds or sampleSeconds,ackWait)\013\010",
    "        local remaining=startupState.target-vessel.altitude\013\010",
    "        local maxSpeed=systemsStartupNominalSpeed(self.config)\013\010",
    "        local desiredSpeed=clamp(remaining/startupLookaheadSeconds(self.config),-maxSpeed,maxSpeed)\013\010",
    "        if remaining>0 then\013\010",
    "            desiredSpeed=math.min(desiredSpeed,math.sqrt(2*acceleration*remaining))\013\010",
    "        end\013\010",
    "        local speedHorizon=startupLookaheadSeconds(self.config)\013\010",
    "        local requestedAcceleration=clamp((desiredSpeed-vessel.verticalSpeed)/speedHorizon,\013\010",
    "            -acceleration,acceleration)\013\010",
    "        local dynamics=startupState.dynamics or {}\013\010",
    "        local drag=finite(dynamics.verticalDragEstimate) and math.max(0,dynamics.verticalDragEstimate) or 0\013\010",
    "        local supportDemand=math.max(0,1+(drag*vessel.verticalSpeed+requestedAcceleration)/gravity)\013\010",
    "        local demandCap=math.huge\013\010",
    "        for _,q in ipairs(QUADS) do\013\010",
    "            local qInfo=entriesByQ[q]\013\010",
    "            local rawRequired=vessel.mass*supportDemand/(4*pressure)\013\010",
    "            local bulkRequired=math.floor(math.max(0,rawRequired-qInfo.fineTarget*qInfo.fineStrength)/\013\010",
    "                qInfo.steamStrength+1e-9)\013\010",
    "            demandCap=math.min(demandCap,qInfo.fineTarget+bulkRequired)\013\010",
    "        end\013\010",
    "        info.altitudeDemandSupportRatio=supportDemand\013\010",
    "        info.altitudeDemandMaximumM3PerChamber=demandCap\013\010",
    "        info.altitudeDemandAccelerationLimit=acceleration\013\010",
    "        if effective>demandCap then\013\010",
    "            effective=math.max(minimumTotal,demandCap)\013\010",
    "            info.limited=true;info.altitudeLimited=true\013\010",
    "            info.limitReason=\"STARTUP ALTITUDE / VERTICAL-SPEED DEMAND LIMITS INITIAL TARGET TO \"..\013\010",
    "                tostring(effective)..\" m3/chamber\"\013\010",
    "        end\013\010",
    "    end\013\010",
    "    local result=copyMaps(maps)\013\010",
    "    for _,q in ipairs(QUADS) do\013\010",
    "        local qInfo=entriesByQ[q]\013\010",
    "        local allocated,remaining=distributeInitialGasTotal(qInfo.bulkEntries,effective-qInfo.fineTarget)\013\010",
    "        if not allocated or remaining~=0 then\013\010",
    "            return nil,info,q..\" COULD NOT DISTRIBUTE INITIAL GAS TARGET WITHIN PROVIDER LIMITS\"\013\010",
    "        end\013\010",
    "        for name,value in pairs(allocated) do result[q][name]=value end\013\010",
    "    end\013\010",
    "    info.effectiveRequestedM3PerChamber=effective\013\010",
    "    return result,info\013\010",
    "end\013\010",

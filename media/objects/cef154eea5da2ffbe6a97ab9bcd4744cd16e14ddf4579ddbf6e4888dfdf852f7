    "        snapshot.systemsStartup.displayPhase=displayPhase\013\010",
    "        snapshot.systemsStartup.target=self.systemsRun.target\013\010",
    "        snapshot.systemsStartup.pidActive=(self.systemsRun.phase==\"MAIN_LIFT\" or\013\010",
    "            self.systemsRun.phase==\"READY\") and self.systemsRun.acquisitionPidActive==true\013\010",
    "        snapshot.systemsStartup.initialGasTarget=clone(self.systemsRun.initialGasTarget)\013\010",
    "        local s=self.systemsRun\013\010",
    "        snapshot.systemsStartup.acquisitionStallRecovery=s.acquisitionStallRecovery==true\013\010",
    "        snapshot.systemsStartup.supportCorrectionDirection=s.lastSupportCorrectionDirection\013\010",

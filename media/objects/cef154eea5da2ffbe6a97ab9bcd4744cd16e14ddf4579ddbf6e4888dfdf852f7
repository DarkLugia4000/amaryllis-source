    "    end\013\010",
    "    return state\013\010",
    "end\013\010",
    "\013\010",
    "-- Summary: Serialize and replace a JSON document through its validated storage path.\010",
    "function Storage.writeJson(path, value, dependencies, validate)\013\010",
    "    local key = STATE_SECTIONS[path]\013\010",
    "    if not key then return writeDocument(path, value, dependencies, validate) end\013\010",

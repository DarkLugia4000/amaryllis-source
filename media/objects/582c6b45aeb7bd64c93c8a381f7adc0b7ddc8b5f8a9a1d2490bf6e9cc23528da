    "        value:match(\"^[%w_%.%-:]+$\")~=nil\010",
    "end\010",
    "-- Summary: Validate a requested reboot against the configured core, session and local boot.\010",
    "local function validateRestart(sender,message,receivedProtocol,coreId,session,nodeBoot,targetLabel)\010",
    "    if sender~=coreId or receivedProtocol~=\"amaryllis.v1\" or type(message)~=\"table\" or\010",
    "        message.v~=1 or message.kind~=\"system_restart\" then return false end\010",
    "    if not safeRestartToken(message.session) or message.session~=session then return false end\010",
    "    if not safeRestartToken(message.nodeBoot) or message.nodeBoot~=nodeBoot then return false end\010",
    "    if type(message.targetLabel)~=\"string\" or message.targetLabel~=targetLabel then return false end\010",
    "    if not safeRestartToken(message.bootToken) or not safeRestartToken(message.requestId) then return false end\010",
    "    return true\010",
    "end\010",
    "-- Summary: Acknowledge and execute the validated role restart request.\010",
    "local function handleRestart(sender,message,receivedProtocol,context,sendAck,reboot)\010",
    "    context=context or {seen={},order={}}\010",
    "    context.seen=context.seen or {};context.order=context.order or {}\010",
    "    if not validateRestart(sender,message,receivedProtocol,context.coreId,context.session,\010",
    "        context.nodeBoot,context.targetLabel) or context.seen[message.requestId] then return false end\010",
    "    local ack={v=1,kind=\"system_restart_ack\",session=message.session,\010",
    "        nodeBoot=message.nodeBoot,bootToken=message.bootToken,requestId=message.requestId,\010",
    "        targetLabel=message.targetLabel,accepted=true,detail=\"RESTARTING\"}\010",
    "    local ok,result=pcall(sendAck,context.coreId,ack,\"amaryllis.v1\")\010",
    "    if not ok or result~=true then return false end\010",
    "    if type(context.getSession)==\"function\" then\010",
    "        local sessionOk,currentSession=pcall(context.getSession)\010",
    "        if not sessionOk or currentSession~=message.session then return false end\010",
    "    end\010",
    "    context.seen[message.requestId]=true\010",
    "    context.order[#context.order+1]=message.requestId\010",
    "    if #context.order>32 then context.seen[table.remove(context.order,1)]=nil end\010",
    "    reboot()\010",
    "    return true\010",
    "end\010",
    "\010",
    "-- The small local renderer keeps each heading computer self-contained. It\010",
    "-- draws only local monitor text and never imports or executes core code.\010",
    "local colorValues = {\010",
    "    white = 1, red = 16384, gray = 128, cyan = 512, yellow = 16, green = 32, black = 32768,\010",
    "}\010",
    "local colorDigits = {\010",
    "    [1] = \"0\", [16] = \"4\", [32] = \"5\", [128] = \"7\", [512] = \"9\", [16384] = \"e\", [32768] = \"f\",\010",
    "}\010",
    "local function color(name)\010",
    "    return type(colors) == \"table\" and colors[name] or colorValues[name]\010",
    "end\010",
    "-- Monitors render UTF-8 through the installed unicode mod. DELTA and DEGREE are\010",
    "-- the two multi-byte glyphs this display writes; every other non-ASCII\010",
    "-- character becomes \"?\".\010",
    "local GLYPH = { DELTA = \"\\206\\148\", DEGREE = \"\\194\\176\" }\010",
    "GLYPH.allowed = { [GLYPH.DELTA] = true, [GLYPH.DEGREE] = true }\010",
    "-- Summary: Split text into monitor cells: printable ASCII and the delta and degree glyphs as themselves, any other character as one question mark.\010",
    "function GLYPH.cells(value)\010",
    "    local text, cells, i = tostring(value or \"\"), {}, 1\010",
    "    while i <= #text do\010",
    "        local glyph = string.sub(text, i, i + 1)\010",
    "        if GLYPH.allowed[glyph] then\010",
    "            cells[#cells + 1] = glyph\010",
    "            i = i + 2\010",
    "        else\010",
    "            local character = string.sub(text, i, i)\010",
    "            cells[#cells + 1] = string.match(character, \"^[\\032-\\126]$\") and character or \"?\"\010",
    "            local byte = string.byte(character)\010",
    "            -- A multi-byte character outside the allowed set becomes one \"?\".\010",
    "            i = i + 1\010",
    "            if byte >= 194 and byte <= 244 then\010",
    "                while i <= #text and string.byte(text, i) >= 128 and string.byte(text, i) <= 191 do i = i + 1 end\010",
    "            end\010",
    "        end\010",
    "    end\010",
    "    return cells\010",
    "end\010",
    "local function safeText(value)\010",
    "    return table.concat(GLYPH.cells(value))\010",
    "end\010",
    "function GLYPH.width(text)\010",
    "    return #GLYPH.cells(text)\010",
    "end\010",
    "local function finiteDisplay(value)\010",
    "    return finite(value) and math.abs(value) <= 1000000000\010",
    "end\010",
    "local function shown(value, decimals, signed)\010",
    "    if not finiteDisplay(value) then return \"--\" end\010",
    "    if signed then return string.format(\"%+.\" .. decimals .. \"f\", value) end\010",
    "    return string.format(\"%.\" .. decimals .. \"f\", value)\010",
    "end\010",
    "local function angle(value)\010",
    "    if not finiteDisplay(value) then return nil end\010",
    "    return value % 360\010",
    "end\010",
    "local function sensorValid(vessel, field)\010",
    "    if not finiteDisplay(vessel[field]) then return false end\010",
    "    if type(vessel.validFields) == \"table\" and vessel.validFields[field] == false then return false end\010",
    "    if vessel[field .. \"Valid\"] == false then return false end\010",
    "    return true\010",
    "end\010",
    "local function targetValid(targets, field)\010",
    "    if not finiteDisplay(targets[field]) then return false end\010",
    "    if type(targets.validFields) == \"table\" and targets.validFields[field] == false then return false end\010",
    "    if targets[field .. \"Valid\"] == false then return false end\010",
    "    return true\010",
    "end\010",
    "local function shownSensor(vessel, field, decimals, signed, stale)\010",
    "    if stale or not sensorValid(vessel, field) then return \"--\" end\010",
    "    return shown(vessel[field], decimals, signed)\010",
    "end\010",
    "-- Summary: Allocate a character-cell display surface with foreground and background colours.\010",
    "local function makeSurface(width, height)\010",
    "    local surface = { width = width, height = height, rows = {} }\010",
    "    for y = 1, height do\010",
    "        local row = { chars = {}, fg = {}, bg = {} }\010",
    "        for x = 1, width do\010",
    "            row.chars[x], row.fg[x], row.bg[x] = \" \", color(\"white\"), color(\"black\")\010",
    "        end\010",
    "        surface.rows[y] = row\010",
    "    end\010",
    "    return surface\010",
    "end\010",
    "-- Summary: Write bounded text cells with the selected foreground colour.\010",
    "local function put(surface, x, y, text, tone)\010",
    "    if y < 1 or y > surface.height or x > surface.width then return end\010",
    "    local cells = GLYPH.cells(text)\010",
    "    local fg = color(tone or \"white\")\010",
    "    for i = 1, #cells do\010",
    "        local at = x + i - 1\010",
    "        if at >= 1 and at <= surface.width then\010",
    "            surface.rows[y].chars[at], surface.rows[y].fg[at] = cells[i], fg\010",
    "        end\010",
    "    end\010",
    "end\010",
    "local function center(surface, y, text, tone)\010",
    "    local used = math.min(GLYPH.width(text), surface.width)\010",
    "    put(surface, math.floor((surface.width - used) / 2) + 1, y, text, tone)\010",
    "end\010",
    "local function centerColumn(surface, x, width, y, text, tone)\010",
    "    local cells = GLYPH.cells(text)\010",
    "    local used = math.min(#cells, width)\010",
    "    put(surface, x + math.floor((width - used) / 2), y, table.concat(cells, \"\", 1, used), tone)\010",
    "end\010",
    "-- Summary: Wrap message words to the available character width.\010",
    "local function wrapWords(text, width)\010",
    "    local lines, line = {}, \"\"\010",
    "    for word in string.gmatch(text, \"%S+\") do\010",
    "        while #word > width do\010",
    "            if line ~= \"\" then lines[#lines + 1], line = line, \"\" end\010",
    "            lines[#lines + 1] = string.sub(word, 1, width)\010",
    "            word = string.sub(word, width + 1)\010",
    "        end\010",
    "        if line == \"\" then\010",
    "            line = word\010",
    "        elseif #line + 1 + #word <= width then\010",
    "            line = line .. \" \" .. word\010",
    "        else\010",
    "            lines[#lines + 1], line = line, word\010",
    "        end\010",
    "    end\010",
    "    if line ~= \"\" then lines[#lines + 1] = line end\010",
    "    return lines\010",
    "end\010",
    "-- Summary: Build a bounded error display surface for the current monitor.\010",
    "local function errorSurface(width, height)\010",
    "    local surface = makeSurface(width, height)\010",
    "    if width < 1 or height < 1 then return surface end\010",
    "    local lines = wrapWords(\"ERROR. View Console\", width)\010",
    "    local firstY = math.max(1, math.floor((height - #lines) / 2) + 1)\010",
    "    for index, line in ipairs(lines) do\010",
    "        local y = firstY + index - 1\010",
    "        if y <= height then center(surface, y, line, \"red\") end\010",
    "    end\010",
    "    return surface\010",
    "end\010",
    "-- Assembly screen. Core's snapshot carries `assembly`; anything except\010",
    "-- ASSEMBLED replaces the readings with a dedicated, wrapped message so the\010",
    "-- crew sees why heading/altitude data is withheld. Detail also goes to the\010",
    "-- terminal through the normal issue path.\010",
    "local ASSEMBLY_TITLES = {\010",
    "    DISASSEMBLED = \"VESSEL DISASSEMBLED\", ASSEMBLING = \"VESSEL ASSEMBLING\", UNKNOWN = \"ASSEMBLY UNKNOWN\",\010",
    "}\010",
    "local function assemblyProblem(snapshot)\010",
    "    local assembly = type(snapshot.assembly) == \"table\" and snapshot.assembly or nil\010",
    "    if not assembly or assembly.state == \"ASSEMBLED\" then return nil end\010",
    "    return assembly\010",
    "end\010",
    "-- Summary: Render the current vessel assembly status and its blocked-operation context.\010",
    "local function assemblySurface(width, height, assembly)\010",
    "    local surface = makeSurface(width, height)\010",
    "    local tone = assembly.state == \"ASSEMBLING\" and \"yellow\" or \"red\"\010",
    "    local lines = wrapWords(ASSEMBLY_TITLES[assembly.state] or \"ASSEMBLY UNKNOWN\", width)\010",
    "    local detail = {}\010",
    "    if assembly.reason then detail = wrapWords(assembly.reason, width) end\010",
    "    local footer = wrapWords(\"Flight control blocked\", width)\010",
    "    local function rowCount() return #lines + (#detail > 0 and #detail + 1 or 0) + (#footer > 0 and #footer + 1 or 0) end\010",
    "    -- Small monitors keep the title first; detail stays on the terminal.\010",
    "    if rowCount() > height then footer = {} end\010",
    "    if rowCount() > height then detail = {} end\010",
    "    local rows = rowCount()\010",
    "    local y = math.max(1, math.floor((height - rows) / 2) + 1)\010",
    "    for _, line in ipairs(lines) do if y <= height then center(surface, y, line, tone) end; y = y + 1 end\010",
    "    if #detail > 0 then\010",
    "        y = y + 1\010",
    "        for _, line in ipairs(detail) do if y <= height then center(surface, y, line, \"white\") end; y = y + 1 end\010",
    "    end\010",
    "    if #footer > 0 then y = y + 1 end\010",
    "    for _, line in ipairs(footer) do if y <= height then center(surface, y, line, \"gray\") end; y = y + 1 end\010",
    "    return surface\010",
    "end\010",
    "-- Summary: Render cached fleet startup progress and the current role prerequisite.\010",
    "local function fleetBootSurface(width,height,fleet)\010",
    "    local surface=makeSurface(width,height)\010",
    "    local failed=fleet.phase==\"FAILED\" or fleet.phase==\"CANCELLED\"\010",
    "    local complete=fleet.phase==\"COMPLETE\"\010",
    "    local tone=failed and \"red\" or (complete and \"green\" or \"yellow\")\010",
    "    local title=failed and \"STARTUP CHECK FAILED\" or (complete and \"STARTUP CHECK COMPLETE\" or \"STARTUP CHECK\")\010",
    "    local phase=type(fleet.phase)==\"string\" and string.sub(safeText(fleet.phase),1,64) or \"WAITING\"\010",
    "    local progress=\"FLEET \"..phase\010",
    "    if finite(fleet.completed) and finite(fleet.total) then\010",
    "        progress=progress..\" \"..tostring(math.floor(fleet.completed))..\"/\"..tostring(math.floor(fleet.total))\010",
    "    end\010",
    "    local lines={wrapWords(title,width),wrapWords(progress,width)}\010",
    "    if type(fleet.current)==\"string\" and fleet.current~=\"\" then lines[#lines+1]=wrapWords(string.sub(safeText(fleet.current),1,96),width) end\010",
    "    if type(fleet.reason)==\"string\" and fleet.reason~=\"\" then lines[#lines+1]=wrapWords(string.sub(safeText(fleet.reason),1,128),width) end\010",
    "    local count=0;for _,group in ipairs(lines) do count=count+#group end\010",
    "    local y=math.max(1,math.floor((height-count)/2)+1)\010",
    "    for index,group in ipairs(lines) do\010",
    "        for _,line in ipairs(group) do\010",
    "            if y<=height then center(surface,y,line,index==1 and tone or (index==#lines and failed and \"red\" or \"white\")) end\010",
    "            y=y+1\010",
    "        end\010",
    "    end\010",
    "    return surface\010",
    "end\010",
    "local function nonemptyReason(vessel)\010",
    "    if type(vessel.reason) ~= \"string\" then return nil end\010",
    "    local reason = string.sub(safeText(vessel.reason), 1, 2048)\010",
    "    return string.find(reason, \"%S\") and reason or nil\010",
    "end\010",
    "-- Summary: Resolve the current display availability, assembly or role-status issue.\010",
    "local function displayIssue(snapshot, display, width, height)\010",
    "    if width < 18 or height < 5 then\010",
    "        return string.format(\"monitor is too small (%dx%d); minimum is 18x5\", width, height)\010",
    "    end\010",
    "    local vessel = type(snapshot.vessel) == \"table\" and snapshot.vessel or {}\010",
    "    local reason = nonemptyReason(vessel)\010",
    "    local stale = snapshot.displayStale == true or snapshot.stale == true or snapshot.dataFresh == false\010",
    "    if stale then\010",
    "        local detail = \"CORE UNREACHABLE\"\010",
    "        if reason then detail = detail .. \"; vessel reason: \" .. reason end\010",
    "        return detail\010",
    "    end\010",
    "    local assembly = assemblyProblem(snapshot)\010",
    "    if assembly then\010",
    "        return string.lower(ASSEMBLY_TITLES[assembly.state] or \"assembly unknown\") ..\010",
    "            (assembly.reason and (\": \" .. assembly.reason) or \"\"), assembly\010",
    "    end\010",
    "    local fleet=type(snapshot.fleetBoot)==\"table\" and snapshot.fleetBoot or nil\010",
    "    local assembled=type(snapshot.assembly)==\"table\" and snapshot.assembly.state==\"ASSEMBLED\"\010",
    "    if assembled and fleet and fleet.ready==false then\010",
    "        local phase=type(fleet.phase)==\"string\" and safeText(fleet.phase) or \"WAITING\"\010",
    "        local detail=\"startup check: \"..string.sub(phase,1,48)\010",
    "        if finite(fleet.completed) and finite(fleet.total) then\010",
    "            detail=detail..\" \"..tostring(math.floor(fleet.completed))..\"/\"..tostring(math.floor(fleet.total))\010",
    "        end\010",
    "        if type(fleet.current)==\"string\" and fleet.current~=\"\" then detail=detail..\" (\"..string.sub(safeText(fleet.current),1,64)..\")\" end\010",
    "        if type(fleet.reason)==\"string\" and fleet.reason~=\"\" then detail=detail..\": \"..string.sub(safeText(fleet.reason),1,128) end\010",
    "        return detail,nil,fleet\010",
    "    end\010",
    "\010",
    "    local issues = {}\010",
    "    if reason then issues[#issues + 1] = \"vessel reason: \" .. reason end\010",
    "    if not sensorValid(vessel, \"heading\") then\010",
    "        issues[#issues + 1] = \"required vessel heading is missing or invalid\"\010",
    "    end\010",
    "    if display == \"center\" then\010",
    "        if not sensorValid(vessel, \"altitude\") then\010",
    "            issues[#issues + 1] = \"required center altitude is missing or invalid\"\010",
    "        end\010",
    "        if not sensorValid(vessel, \"verticalSpeed\") then\010",
    "            issues[#issues + 1] = \"required center vertical speed is missing or invalid\"\010",
    "        end\010",
    "    end\010",
    "    if (vessel.valid == false or snapshot.vesselValid == false or snapshot.valid == false) and\010",
    "        not reason then\010",
    "        issues[#issues + 1] = \"vessel telemetry is marked invalid\"\010",
    "    end\010",
    "    if #issues == 0 then return nil end\010",
    "    return table.concat(issues, \"; \")\010",
    "end\010",
    "local function shortestDelta(from, to)\010",
    "    return (to - from + 540) % 360 - 180\010",
    "end\010",
    "-- Summary: Format the compass labels and markers for the observed heading.\010",
    "local function compass(surface, current)\010",
    "    local width = surface.width\010",
    "    local mid = math.floor((width + 1) / 2)\010",
    "    local perColumn = 120 / math.max(1, width - 1)\010",
    "    local leftSpan, rightSpan = (mid - 1) * perColumn, (width - mid) * perColumn\010",
    "    for x = 1, width do\010",
    "        local value = (current + (x - mid) * perColumn) % 360\010",
    "        local mark = math.floor(value / 10 + 0.5) * 10 % 360\010",
    "        local difference = (mark - value + 540) % 360 - 180\010",
    "        local major = math.abs(difference) <= perColumn / 2 and mark % 30 == 0\010",
    "        surface.rows[3].chars[x] = major and \"|\" or \".\"\010",
    "        surface.rows[3].fg[x] = color(major and \"cyan\" or \"gray\")\010",
    "    end\010",
    "    surface.rows[3].chars[mid], surface.rows[3].fg[mid] = \"v\", color(\"cyan\")\010",
    "    for bearing = 0, 330, 30 do\010",
    "        local delta = (bearing - current + 540) % 360 - 180\010",
    "        if delta >= -leftSpan and delta <= rightSpan then\010",
    "            local x = mid + math.floor(delta / perColumn + 0.5)\010",
    "            local text = bearing == 0 and \"N\" or (bearing == 90 and \"E\" or\010",
    "                (bearing == 180 and \"S\" or (bearing == 270 and \"W\" or string.format(\"%03d\", bearing))))\010",
    "            local start = math.max(1, math.min(width - #text + 1, x - math.floor(#text / 2)))\010",
    "            put(surface, start, 4, text, bearing % 90 == 0 and \"cyan\" or \"gray\")\010",
    "        end\010",
    "    end\010",
    "end\010",
    "local function centerLayout(surface)\010",
    "    local altitudeWidth = math.min(14, math.max(6, math.floor(surface.width / 4)))\010",
    "    local headingWidth = surface.width - altitudeWidth - 1\010",
    "    return headingWidth, headingWidth + 2, altitudeWidth\010",
    "end\010",
    "-- Summary: Render the horizontal heading tape and selected-heading marker.\010",
    "local function drawHeadingTape(surface, headingWidth, current, selected, compact, targetY)\010",
    "    local mid = math.floor((headingWidth + 1) / 2)\010",
    "    local perColumn = 120 / math.max(1, headingWidth - 1)\010",
    "    local leftSpan, rightSpan = (mid - 1) * perColumn, (headingWidth - mid) * perColumn\010",
    "    if current then\010",
    "        for x = 1, headingWidth do\010",
    "            local bearing = (current + (x - mid) * perColumn) % 360\010",
    "            local rounded = math.floor(bearing / 10 + 0.5) * 10 % 360\010",
    "            surface.rows[3].chars[x] = math.abs(shortestDelta(bearing, rounded)) <= perColumn / 2 and\010",
    "                rounded % 30 == 0 and \"|\" or \".\"\010",
    "            surface.rows[3].fg[x] = color(\"gray\")\010",
    "        end\010",
    "        surface.rows[3].chars[mid], surface.rows[3].fg[mid] = \"v\", color(\"cyan\")\010",
    "        if not compact then\010",
    "            local occupied = {}\010",
    "            for bearing = 0, 330, 30 do\010",
    "                local delta = shortestDelta(current, bearing)\010",
    "                if delta >= -leftSpan and delta <= rightSpan then\010",
    "                    local label = bearing == 0 and \"N\" or (bearing == 90 and \"E\" or\010",
    "                        (bearing == 180 and \"S\" or (bearing == 270 and \"W\" or string.format(\"%03d\", bearing))))\010",
    "                    local x = mid + math.floor(delta / perColumn + 0.5)\010",
    "                    local first = math.max(1, math.min(headingWidth - #label + 1, x - math.floor(#label / 2)))\010",
    "                    local free = true\010",
    "                    for at = first, first + #label - 1 do\010",
    "                        if occupied[at] then free = false end\010",
    "                    end\010",
    "                    if free then\010",
    "                        put(surface, first, 4, label, \"gray\")\010",
    "                        for at = first, first + #label - 1 do occupied[at] = true end\010",
    "                    end\010",
    "                end\010",
    "            end\010",
    "        end\010",
    "    else\010",
    "        center({ width = headingWidth, height = surface.height, rows = surface.rows }, 3, \"NO HEADING DATA\", \"gray\")\010",
    "    end\010",
    "    if selected then\010",
    "        local delta = current and shortestDelta(current, selected) or nil\010",
    "        local marker, x\010",
    "        if delta and delta < -leftSpan then\010",
    "            marker, x = \"<\", 1\010",
    "        elseif delta and delta > rightSpan then\010",
    "            marker, x = \">\", headingWidth\010",
    "        elseif delta then\010",
    "            marker = \"^\"\010",
    "            x = mid + math.floor(delta / perColumn + 0.5)\010",
    "        end\010",
    "        if marker then put(surface, x, targetY, marker, \"yellow\") end\010",
    "    end\010",
    "end\010",
    "-- Core's altitude ceiling from the snapshot, or nil when core has not sent one.\010",
    "local function altitudeCeiling(snapshot)\010",
    "    local control=type(snapshot.altitudeControl)==\"table\" and snapshot.altitudeControl or {}\010",
    "    return type(control.ceiling)==\"number\" and control.ceiling or nil\010",
    "end\010",
    "-- Summary: Render the altitude scale and selected-altitude marker; levels above the altitude ceiling stay blank.\010",
    "local function drawAltitudeTape(surface, altitudeX, altitudeWidth, top, bottom,\010",
    "    actual, selected, compact, targetTone, ceiling)\010",
    "    if top > bottom then return end\010",
    "    local actualY = math.floor((top + bottom) / 2)\010",
    "    local roundedActual = actual and math.floor(actual / 10 + 0.5) * 10 or nil\010",
    "    for y = top, bottom do\010",
    "        local level = roundedActual and roundedActual + (actualY - y) * 10 or nil\010",
    "        local tickX = altitudeX + 1\010",
    "        -- Levels at or above Y 290 are drawn red: above about Y 300 the air\010",
    "        -- pressure falls ~5% per block and altitude hold gets twitchy.\010",
    "        local high = level and level >= 290\010",
    "        local aboveCeiling = level and ceiling and level > ceiling\010",
    "        surface.rows[y].chars[tickX] = y == actualY and \"|\" or (aboveCeiling and \" \" or \".\")\010",
    "        surface.rows[y].fg[tickX] = color(high and \"red\" or \"gray\")\010",
    "        if not compact and actual and altitudeWidth >= 11 and not aboveCeiling then\010",
    "            local text = string.format(\"%.0f\", level)\010",
    "            text = string.sub(text, 1, altitudeWidth - 5)\010",
    "            put(surface, altitudeX + 3, y, text, high and \"red\" or \"gray\")\010",
    "        end\010",
    "    end\010",
    "    if actual then\010",
    "        put(surface, altitudeX, actualY, \">\", \"cyan\")\010",
    "    end\010",
    "    if selected and actual then\010",
    "        local offset = math.floor((selected - actual) / 10 + 0.5)\010",
    "        local targetY = actualY - offset\010",
    "        local marker = \"<\"\010",
    "        if targetY < top then targetY, marker = top, \"^\" end\010",
    "        if targetY > bottom then targetY, marker = bottom, \"v\" end\010",
    "        if compact and top == bottom and selected ~= actual then\010",
    "            marker = selected > actual and \"^\" or \"v\"\010",
    "        end\010",
    "        put(surface, altitudeX + altitudeWidth - 1, targetY, marker, targetTone or \"yellow\")\010",
    "    end\010",
    "end\010",
    "-- Summary: Resolve the altitude-control indicator from current systems/control state.\010",
    "local function altitudeHoldIndicatorRaw(snapshot, stale)\010",
    "    if stale then return nil end\010",
    "    local systems=type(snapshot.systemsStartup)==\"table\" and snapshot.systemsStartup or nil\010",
    "    local phase=systems and type(systems.phase)==\"string\" and string.upper(systems.phase) or \"\"\010",
    "    if systems and systems.displayPhase==\"READY\" then return \"READY\",\"cyan\" end\010",
    "    if phase==\"ABORTED\" then return \"ABORTED\",\"red\" end\010",
    "    if phase==\"READY\" or phase==\"HOLDING\" then return \"READY\",\"cyan\" end\010",
    "    if phase==\"MAIN_LIFT\" then return \"ACQUIRING\",\"cyan\" end\010",
    "    if systems and systems.active==true then return \"STARTING\",\"cyan\" end\010",
    "    local control=type(snapshot.altitudeControl)==\"table\" and snapshot.altitudeControl or nil\010",
    "    if phase==\"STOPPED\" or phase==\"BLOCKED\" or phase==\"IDLE\" or\010",
    "        (control and control.enabled==false) then return \"ALT OFFLINE\",\"gray\" end\010",
    "    return nil\010",
    "end\010",
    "-- Low air pressure warning on the hold label (ABORTED still wins). From\010",
    "-- about Y 280 the air pressure falls several times faster per block, and\010",
    "-- near Y 310 she runs out of lift with every chamber full of steam.\010",
    "--   Y 285+: LOW PRESS (yellow), steady until she leaves the area (drops back\010",
    "--           below Y 284; the block of hysteresis stops boundary flicker).\010",
    "--   Y 305+: alternates LOW PRESS and DESCEND (both red), a second each.\010",
    "local lowPressureActive=false\010",
    "-- Summary: Format the current altitude-control indicator and its display colour.\010",
    "local function altitudeHoldIndicator(snapshot, stale)\010",
    "    local label,tone=altitudeHoldIndicatorRaw(snapshot,stale)\010",
    "    if stale or label==\"ABORTED\" then return label,tone end\010",
    "    local vessel=type(snapshot.vessel)==\"table\" and snapshot.vessel or {}\010",
    "    if not sensorValid(vessel,\"altitude\") then return label,tone end\010",
    "    if vessel.altitude>=285 then lowPressureActive=true elseif vessel.altitude<284 then lowPressureActive=false end\010",
    "    if not lowPressureActive then return label,tone end\010",
    "    if vessel.altitude>=305 then return math.floor(os.clock())%2==1 and \"DESCEND\" or \"LOW PRESS\",\"red\" end\010",
    "    return \"LOW PRESS\",\"yellow\"\010",
    "end\010",
    "-- Summary: Render the center heading/altitude display from the cached snapshot.\010",
    "local function drawCenter(snapshot, width, height)\010",
    "    local surface = makeSurface(width, height)\010",
    "    local vessel = type(snapshot.vessel) == \"table\" and snapshot.vessel or {}\010",
    "    local targets = type(snapshot.targets) == \"table\" and snapshot.targets or {}\010",
    "    local stale = snapshot.displayStale == true or snapshot.stale == true or snapshot.dataFresh == false\010",
    "    local heading = not stale and sensorValid(vessel, \"heading\") and angle(vessel.heading) or nil\010",
    "    local altitude = not stale and sensorValid(vessel, \"altitude\") and vessel.altitude or nil\010",
    "    local headingTarget = not stale and targetValid(targets, \"heading\") and angle(targets.heading) or nil\010",
    "    local altitudeTarget = not stale and targetValid(targets, \"altitude\") and targets.altitude or nil\010",
    "    local anchored = not stale and snapshot.anchor == \"ANCHORED\"\010",
    "    local holdLabel,holdTone=altitudeHoldIndicator(snapshot,stale)\010",
    "    local targetInactive=holdLabel==\"ABORTED\" or holdLabel==\"ALT OFFLINE\"\010",
    "    local altitudeTargetTone=altitudeTarget and (targetInactive and \"gray\" or \"yellow\") or \"gray\"\010",
    "    local headingWidth, altitudeX, altitudeWidth = centerLayout(surface)\010",
    "    local compact = height < 8\010",
    "    local targetY = compact and height or 5\010",
    "\010",
    "    put(surface, 1, 1, anchored and \"AMARYLLIS / CENTER / ANCHORED\" or \"AMARYLLIS / CENTER\",\010",
    "        anchored and \"yellow\" or \"white\")\010",
    "    if stale then put(surface, 1, 1, \"CORE UNREACHABLE\", \"yellow\") end\010",
    "    local actualHeadingText = heading and string.format(\"%05.1f\", heading) or \"--.-\"\010",
    "    local selectedHeadingText = headingTarget and string.format(\"%05.1f\", headingTarget) or \"--.-\"\010",
    "    put(surface, math.floor((headingWidth - #actualHeadingText) / 2) + 1, 2,\010",
    "        actualHeadingText, heading and \"white\" or \"gray\")\010",
    "    local actualAltitudeText = shown(altitude, 1, false)\010",
    "    centerColumn(surface, altitudeX, altitudeWidth, 2,\010",
    "        actualAltitudeText, altitude and \"white\" or \"gray\")\010",
    "\010",
    "    drawHeadingTape(surface, headingWidth, heading, headingTarget, compact, targetY)\010",
    "    local tapeTop, tapeBottom = 3, height - 2\010",
    "    drawAltitudeTape(surface, altitudeX, altitudeWidth, tapeTop, tapeBottom,\010",
    "        altitude, altitudeTarget, compact, altitudeTargetTone, altitudeCeiling(snapshot))\010",
    "\010",
    "    local selectedRow = compact and 4 or 6\010",
    "    put(surface, math.floor((headingWidth - #selectedHeadingText) / 2) + 1, selectedRow,\010",
    "        selectedHeadingText, headingTarget and \"yellow\" or \"gray\")\010",
    "    local selectedAltitudeText = shown(altitudeTarget, 1, false)\010",
    "    local altitudeRow = compact and 4 or height - 1\010",
    "    centerColumn(surface, altitudeX, altitudeWidth, altitudeRow,\010",
    "        selectedAltitudeText, altitudeTargetTone)\010",
    "    if holdLabel then\010",
    "        if altitudeWidth<8 then\010",
    "            local compactLabels={ABORTED=\"ABORT\",[\"ALT OFFLINE\"]=\"OFF\",[\"LOW PRESS\"]=\"LOW P\",DESCEND=\"DESC\",READY=\"READY\",ACQUIRING=\"ACQ\",STARTING=\"START\"}\010",
    "            holdLabel=compactLabels[holdLabel] or holdLabel\010",
    "        end\010",
    "        centerColumn(surface,altitudeX,altitudeWidth,1,holdLabel,holdTone)\010",
    "    end\010",
    "    if height >= 8 then\010",
    "        local vertical = shownSensor(vessel, \"verticalSpeed\", 2, true, stale)\010",
    "        put(surface, 1, height, \"V/S \" .. vertical, \"white\")\010",
    "    end\010",
    "    local reason = type(vessel.reason) == \"string\" and vessel.reason or nil\010",
    "    if not stale and reason and height >= 9 then\010",
    "        put(surface, 1, height - 1,\010",
    "            \"DATA \" .. string.sub(safeText(reason), 1, math.max(0, headingWidth - 5)), \"red\")\010",
    "    end\010",
    "    return surface\010",
    "end\010",
    "local turnIndicatorPhase,turnIndicatorAt=0,nil\010",
    "-- Summary: Render the wide heading display and its status labels.\010",
    "local function drawHorizontalHeading(snapshot,width,height)\010",
    "    local fullSurface=makeSurface(width,height)\010",
    "    local altitudeX,altitudeWidth\010",
    "    if width>=30 then\010",
    "        local headingWidth\010",
    "        headingWidth,altitudeX,altitudeWidth=centerLayout(fullSurface)\010",
    "        width=headingWidth\010",
    "    end\010",
    "    -- Both instruments share the output rows, but heading layout is confined\010",
    "    -- to its own column so speed and AP markers cannot overwrite altitude.\010",
    "    local surface={width=width,height=height,rows=fullSurface.rows}\010",
    "    local ap=type(snapshot.autopilot)==\"table\" and snapshot.autopilot.active and snapshot.autopilot or nil\010",
    "    local recovering=ap and (ap.state==\"RECOVERING\" or\013\010",
    "        (type(ap.state)==\"string\" and ap.state:match(\"^RETRYING %(%d+%)$\")~=nil))\010",
    "    local vessel=snapshot.vessel or {};local targets=snapshot.targets or {}\010",
    "    local lateral=type(snapshot.lateralControl)==\"table\" and snapshot.lateralControl or {}\010",
    "    local showLateral=not ap and snapshot.displayStale~=true and lateral.mode==\"SEL\" and lateral.active==true\010",
    "    local selected=ap or (snapshot.effectiveModes or snapshot.modes or {}).heading==\"SEL\"\010",
    "    local current=not recovering and sensorValid(vessel,\"heading\") and angle(vessel.heading) or nil\010",
    "    local target=selected and angle(ap and ap.requestedHeading or targets.heading) or nil\010",
    "    local title=ap and (\"AP - \"..safeText(ap.state or \"ACTIVE\")) or (selected and \"SEL HDG\" or \"\")\010",
    "    put(surface,1,1,string.sub(title,1,width),recovering and \"yellow\" or \"cyan\")\010",
    "    local name=ap and safeText(ap.destinationName or \"DESTINATION\") or \"AMARYLLIS\"\010",
    "    local available=width-#title-2\010",
    "    -- Keep the name clear of the centred turn arrow (three cells).\010",
    "    local arrowEnd=math.floor((width-3)/2)+3\010",
    "    available=math.min(available,width-arrowEnd-1)\010",
    "    if available>=4 then\010",
    "        -- A name longer than the space keeps its start and ends in \"..\".\010",
    "        if #name>available then name=string.sub(name,1,available-2)..\"..\" end\010",
    "        put(surface,width-#name+1,1,name,\"cyan\")\010",
    "    end\010",
    "    local headingText=current and shown(current,1,false) or \"HDG --\"\010",
    "    center(surface,2,headingText,\"white\")\010",
    "    local rowTwoRightUsed=false\010",
    "    if ap and target and width>=38 then put(surface,1,2,\"ROUTE \"..shown(target,1,false),\"yellow\") end\010",
    "    -- SEL heading shows the error to the selected heading on the right of row 2.\010",
    "    if not ap and selected and current and target and width>=38 then\010",
    "        local readout=\"HDG \"..GLYPH.DELTA..\" \"..shown(shortestDelta(current,target),1,true)..GLYPH.DEGREE\010",
    "        put(surface,width-GLYPH.width(readout)+1,2,readout,\"white\")\010",
    "        rowTwoRightUsed=true\010",
    "    end\010",
    "    drawHeadingTape(surface,width,current,not recovering and target or nil,height<7,height>=7 and 5 or 4)\010",
    "    -- Actual speed on the right; the requested speed (current AP speed request or the\010",
    "    -- SEL throttle target) on the left as REQ.\010",
    "    local speed=\"SPD \"..shownSensor(vessel,\"forwardSpeed\",1,false,false)..\" b/s\"\010",
    "    local requested\010",
    "    if ap then requested=ap.requestedSpeed\010",
    "    elseif (snapshot.effectiveModes or snapshot.modes or {}).throttle==\"SEL\" and targetValid(targets,\"speed\") then requested=targets.speed end\010",
    "    local req=requested~=nil and (\"REQ \"..shown(requested,1,false)..\" b/s\") or nil\010",
    "    local left=\"\"\010",
    "    if ap then\010",
    "        local deviation=not recovering and ap.crossTrack or nil\010",
    "        local side=finiteDisplay(deviation) and (deviation>0 and \" R\" or (deviation<0 and \" L\" or \"\")) or \"\"\010",
    "        local dev=\"DEV \"..shown(finiteDisplay(deviation) and math.abs(deviation) or nil,1,false)..\" b\"..side\010",
    "        local distance=not recovering and ap.distance or nil\010",
    "        left=\"DIST \"..shown(distance,finiteDisplay(distance) and distance>=100 and 0 or 1,false)..\" b\"\010",
    "        if height>=7 then\010",
    "            local row=6;local mid=math.floor((width+1)/2);local low=3;local high=width-2\010",
    "            for x=low,high do put(surface,x,row,\"-\",\"gray\") end\010",
    "            put(surface,mid,row,\"|\",\"cyan\")\010",
    "            put(surface,1,row,\"L\",\"gray\");put(surface,width,row,\"R\",\"gray\")\010",
    "            if finiteDisplay(deviation) then\010",
    "                local x=mid+math.floor(math.max(-10,math.min(10,deviation))*(high-low)/20+.5)\010",
    "                x=math.max(low,math.min(high,x))\010",
    "                put(surface,x,row,math.abs(deviation)>10 and (deviation>0 and \">\" or \"<\") or \"*\",\"white\")\010",
    "            end\010",
    "            if height>=8 then center(surface,7,dev,\"white\")\010",
    "            else put(surface,1,2,string.sub(dev,1,math.max(0,math.floor(width/2)-7)),\"white\") end\010",
    "        else left=dev end\010",
    "        if recovering and height>=9 then center(surface,8,\"WAITING FOR TELEMETRY\",\"yellow\") end\010",
    "    elseif selected and current and target then\010",
    "        left=\"\"\010",
    "        if height>=7 then center(surface,6,shown(target,1,false),\"yellow\")\010",
    "        elseif height>=6 then center(surface,5,shown(target,1,false),\"yellow\") end\010",
    "    end\010",
    "    -- Animated turn indicator, top row centre (SEL heading and AP): one\010",
    "    -- arrow stepping across three cells in the turn direction. It steps\010",
    "    -- faster the faster the heading loop is commanding her to yaw: 0.6 s per\010",
    "    -- step for a gentle turn, down to 0.25 s (the display refresh) at 10 deg/s.\010",
    "    local turnError=selected and current and target and not recovering and shortestDelta(current,target) or nil\010",
    "    if turnError and math.abs(turnError)>=.5 then\010",
    "        local headingControl=type(snapshot.headingControl)==\"table\" and snapshot.headingControl or {}\010",
    "        local rate=finiteDisplay(headingControl.targetYawRate) and math.abs(headingControl.targetYawRate) or 0\010",
    "        local period=math.max(0.25,0.6-0.035*math.min(rate,10))\010",
    "        local now=os.clock()\010",
    "        local dt=turnIndicatorAt and math.max(0,math.min(1,now-turnIndicatorAt)) or 0\010",
    "        turnIndicatorAt=now\010",
    "        turnIndicatorPhase=(turnIndicatorPhase+dt/period)%3\010",
    "        local frame=math.floor(turnIndicatorPhase)\010",
    "        center(surface,1,turnError>0 and (string.rep(\" \",frame)..\">\"..string.rep(\" \",2-frame)) or\010",
    "            (string.rep(\" \",2-frame)..\"<\"..string.rep(\" \",frame)),\"yellow\")\010",
    "    else turnIndicatorAt=nil end\010",
    "    if showLateral then\010",
    "        local remaining=finiteDisplay(lateral.remaining) and lateral.remaining or nil\010",
    "        local requested=finiteDisplay(lateral.offset) and lateral.offset or nil\010",
    "        local phase=safeText(lateral.state or \"MOVING\")\010",
    "        local text=\"STRAFE \"..shown(requested,1,true)..\"b \"..shown(remaining and math.abs(remaining),1,false)..\"b TO GO\"\010",
    "        if height>=8 then\010",
    "            local row=6;local mid=math.floor((width+1)/2);local low,high=3,width-2\010",
    "            for x=1,width do put(surface,x,row,\" \",\"white\") end\010",
    "            for x=low,high do put(surface,x,row,\"-\",\"gray\") end\010",
    "            put(surface,1,row,\"L\",\"gray\");put(surface,width,row,\"R\",\"gray\")\010",
    "            put(surface,mid,row,\"|\",\"cyan\")\010",
    "            if remaining then\010",
    "                local span=math.max(1,math.abs(requested or 0));local relative=-remaining/span\010",
    "                local x=mid+math.floor(math.max(-1,math.min(1,relative))*(high-low)/2+.5)\010",
    "                x=math.max(low,math.min(high,x))\010",
    "                put(surface,x,row,math.abs(relative)>1 and (relative>0 and \">\" or \"<\") or \"*\",\"yellow\")\010",
    "            end\010",
    "            center(surface,7,text,\"cyan\")\010",
    "            if height>=10 then center(surface,8,phase,phase==\"TURNING\" and \"yellow\" or \"white\")\010",
    "            else left=phase end\010",
    "        else\010",
    "            for x=1,width do put(surface,x,height-1,\" \",\"white\") end\010",
    "            center(surface,height-1,\"STRAFE \"..shown(remaining,1,true)..\"b\",\"cyan\");left=\"\"\010",
    "        end\010",
    "    end\010",
    "    local leftWidth=math.max(0,width-#speed-2)\010",
    "    -- An engaged anchor (braking or anchored) owns the bottom left until it is released.\010",
    "    local anchorOn=snapshot.displayStale~=true and (snapshot.anchor==\"BRAKING\" or snapshot.anchor==\"ANCHORED\")\010",
    "    if anchorOn then\010",
    "        put(surface,1,height,string.sub(\"ANCHORED\",1,leftWidth),\"yellow\")\010",
    "    elseif req then\010",
    "        -- REQ owns the bottom left. Whatever was there (DIST, TURNING, the\010",
    "        -- strafe phase) moves to the free right side of row 2 when it fits,\010",
    "        -- shares the bottom row when both fit, and is otherwise left out.\010",
    "        if left~=\"\" then\010",
    "            local headingEnd=math.floor((width-#headingText)/2)+#headingText\010",
    "            local free=rowTwoRightUsed and 0 or (width-headingEnd-1)\010",
    "            local moved=left\010",
    "            if #moved<=free then put(surface,width-#moved+1,2,moved,\"cyan\");left=req\010",
    "            elseif #req+2+#left<=leftWidth then left=req..\"  \"..left\010",
    "            else left=req end\010",
    "        else left=req end\010",
    "    end\010",
    "    if not anchorOn then put(surface,1,height,string.sub(left,1,leftWidth),\"cyan\") end\010",
    "    put(surface,math.max(1,width-#speed+1),height,speed,\"white\")\010",
    "    if altitudeX then\010",
    "        local actual=sensorValid(vessel,\"altitude\") and vessel.altitude or nil\010",
    "        local selectedAltitude=targetValid(targets,\"altitude\") and targets.altitude or nil\010",
    "        local holdLabel,holdTone=altitudeHoldIndicator(snapshot,false)\010",
    "        local targetTone=(holdLabel==\"ABORTED\" or holdLabel==\"ALT OFFLINE\") and \"gray\" or \"yellow\"\010",
    "        centerColumn(fullSurface,altitudeX,altitudeWidth,1,holdLabel or \"ALTITUDE\",holdTone or \"cyan\")\010",
    "        centerColumn(fullSurface,altitudeX,altitudeWidth,2,shown(actual,1,false),\"white\")\010",
    "        drawAltitudeTape(fullSurface,altitudeX,altitudeWidth,3,height-2,\010",
    "            actual,selectedAltitude,height<8,targetTone,altitudeCeiling(snapshot))\010",
    "        centerColumn(fullSurface,altitudeX,altitudeWidth,height-1,shown(selectedAltitude,1,false),targetTone)\010",
    "        centerColumn(fullSurface,altitudeX,altitudeWidth,height,\010",
    "            \"V/S \"..shownSensor(vessel,\"verticalSpeed\",2,true,false),\"white\")\010",
    "    end\010",
    "    return fullSurface\010",
    "end\010",
    "-- Summary: Build the current bounded display frame from cached status.\010",
    "local function frame(snapshot, display, width, height)\010",
    "    local issue, assembly, fleet = displayIssue(snapshot, display, width, height)\010",
    "    if assembly then return assemblySurface(width, height, assembly), issue end\010",
    "    if fleet then return fleetBootSurface(width,height,fleet),issue end\010",
    "    if issue then return errorSurface(width, height), issue end\010",
    "    if (type(snapshot.autopilot)==\"table\" and snapshot.autopilot.active==true) or\010",
    "        (type(snapshot.lateralControl)==\"table\" and snapshot.lateralControl.mode==\"SEL\" and snapshot.lateralControl.active==true) then\010",
    "        return drawHorizontalHeading(snapshot,width,height),nil\010",
    "    end\010",
    "    if display~=\"center\" or (width>=30 and height<=11) then return drawHorizontalHeading(snapshot,width,height),nil end\010",
    "    if display == \"center\" then return drawCenter(snapshot, width, height), nil end\010",
    "    local surface = makeSurface(width, height)\010",
    "    local vessel = type(snapshot.vessel) == \"table\" and snapshot.vessel or {}\010",
    "    local targets = type(snapshot.targets) == \"table\" and snapshot.targets or {}\010",
    "    local stale = snapshot.displayStale == true\010",
    "    local current = not stale and sensorValid(vessel, \"heading\") and angle(vessel.heading) or nil\010",
    "    local selected = not stale and angle(targets.heading) or nil\010",
    "    local anchor = not stale and snapshot.anchor == \"ANCHORED\"\010",
    "    local title = display == \"center\" and \"AMARYLLIS / CENTER\" or \"AMARYLLIS / HEADING\"\010",
    "    if anchor then title = title .. \" / ANCHORED\" end\010",
    "    put(surface, 1, 1, title, anchor and \"yellow\" or \"white\")\010",
    "    if stale then put(surface, 1, 1, \"CORE UNREACHABLE\", \"yellow\") end\010",
    "    center(surface, 2, current and (\"HDG \" .. string.format(\"%05.1f\", current)) or \"HDG --.-\",\010",
    "        current and \"white\" or \"gray\")\010",
    "    if height >= 5 then\010",
    "        if current then compass(surface, current) else center(surface, 3, \"NO HEADING DATA\", \"gray\") end\010",
    "    end\010",
    "    if height >= 5 then\010",
    "        center(surface, 5, selected and (\"TGT \" .. string.format(\"%05.1f\", selected)) or\010",
    "            \"TGT --.-\", selected and \"yellow\" or \"gray\")\010",
    "    end\010",
    "    local reason = type(vessel.reason) == \"string\" and vessel.reason or nil\010",
    "    if not stale and reason and height >= 7 then\010",
    "        center(surface, height, \"DATA \" .. string.sub(safeText(reason), 1, math.max(0, width - 5)), \"red\")\010",
    "    end\010",
    "    return surface, nil\010",
    "end\010",
    "-- Summary: Build and flush the selected cached display view.\010",
    "local function render(monitor, snapshot, display)\010",
    "    local okSize, width, height = pcall(monitor.getSize)\010",
    "    if not okSize or not finite(width) or not finite(height) or width < 1 or height < 1 then\010",
    "        error(\"monitor getSize() failed: \" .. tostring(width))\010",
    "    end\010",
    "    width, height = math.floor(width), math.floor(height)\010",
    "    return frame(snapshot, display, width, height)\010",
    "end\010",
    "-- Summary: Write one character row through the monitor's plain-text methods.\010",
    "local function drawPlainRow(monitor, row, y)\010",
    "    local setForeground = monitor.setTextColor or monitor.setTextColour\010",
    "    local setBackground = monitor.setBackgroundColor or monitor.setBackgroundColour\010",
    "    local first = 1\010",
    "    while first <= #row.chars do\010",
    "        local foreground, background = row.fg[first], row.bg[first]\010",
    "        local last = first\010",
    "        while last < #row.chars and row.fg[last + 1] == foreground and\010",
    "            row.bg[last + 1] == background do\010",
    "            last = last + 1\010",
    "        end\010",
    "        if type(setForeground) == \"function\" then setForeground(foreground) end\010",
    "        if type(setBackground) == \"function\" then setBackground(background) end\010",
    "        monitor.setCursorPos(first, y)\010",
    "        local text = {}\010",
    "        for x = first, last do text[#text + 1] = row.chars[x] end\010",
    "        monitor.write(table.concat(text))\010",
    "        first = last + 1\010",
    "    end\010",
    "end\010",
    "-- Summary: Write the prepared character frame to the configured monitor.\010",
    "local function drawToMonitor(displayObject, snapshot)\010",
    "    local surface, issue = render(displayObject.monitor, snapshot, displayObject.display)\010",
    "    local resized = not displayObject.previous or\010",
    "        displayObject.previous.width ~= surface.width or displayObject.previous.height ~= surface.height\010",
    "    if resized then\010",
    "        if type(displayObject.monitor.setBackgroundColor) == \"function\" then\010",
    "            displayObject.monitor.setBackgroundColor(color(\"black\"))\010",
    "        end\010",
    "        if type(displayObject.monitor.clear) == \"function\" then displayObject.monitor.clear() end\010",
    "    end\010",
    "    for y = 1, surface.height do\010",
    "        local row = surface.rows[y]\010",
    "        local old = displayObject.previous and displayObject.previous.rows[y]\010",
    "        local text = table.concat(row.chars)\010",
    "        local foreground, background = {}, {}\010",
    "        for x = 1, surface.width do\010",
    "            foreground[x] = colorDigits[row.fg[x]] or \"0\"\010",
    "            background[x] = colorDigits[row.bg[x]] or \"f\"\010",
    "        end\010",
    "        local fg, bg = table.concat(foreground), table.concat(background)\010",
    "        local key = text .. fg .. bg\010",
    "        if resized or not old or old.key ~= key then\010",
    "            -- blit needs one byte per cell; rows holding a multi-byte glyph are written per colour run.\010",
    "            if type(displayObject.monitor.blit) == \"function\" and #text == surface.width then\010",
    "                displayObject.monitor.setCursorPos(1, y)\010",
    "                displayObject.monitor.blit(text, fg, bg)\010",
    "            else\010",
    "                drawPlainRow(displayObject.monitor, row, y)\010",
    "            end\010",
    "        end\010",
    "        row.text, row.key = text, key\010",
    "    end\010",
    "    displayObject.previous = surface\010",
    "    return issue\010",
    "end\010",
    "\010",
    "-- Summary: Render the current display error using the available monitor methods.\010",
    "local function bestEffortErrorFrame(displayObject)\010",
    "    local monitor = displayObject.monitor\010",
    "    local okSize, width, height = pcall(monitor.getSize)\010",
    "    if not okSize or not finite(width) or not finite(height) or width < 1 or height < 1 then\010",
    "        return false\010",
    "    end\010",
    "    width, height = math.floor(width), math.floor(height)\010",
    "    local surface = errorSurface(width, height)\010",
    "    if type(monitor.setBackgroundColor) == \"function\" then\010",
    "        pcall(monitor.setBackgroundColor, color(\"black\"))\010",
    "    end\010",
    "    if type(monitor.clear) == \"function\" then pcall(monitor.clear) end\010",
    "    local wrote = false\010",
    "    for y = 1, height do\010",
    "        local row = surface.rows[y]\010",
    "        local text = table.concat(row.chars)\010",
    "        local foreground, background = {}, {}\010",
    "        for x = 1, width do\010",
    "            foreground[x] = colorDigits[row.fg[x]] or \"0\"\010",
    "            background[x] = colorDigits[row.bg[x]] or \"f\"\010",
    "        end\010",
    "        local fg, bg = table.concat(foreground), table.concat(background)\010",
    "        local positioned = pcall(monitor.setCursorPos, 1, y)\010",
    "        if positioned and type(monitor.blit) == \"function\" then\010",
    "            local ok = pcall(monitor.blit, text, fg, bg)\010",
    "            wrote = wrote or ok\010",
    "        elseif positioned and type(monitor.write) == \"function\" then\010",
    "            if type(monitor.setTextColor) == \"function\" then pcall(monitor.setTextColor, color(\"red\")) end\010",
    "            if type(monitor.setBackgroundColor) == \"function\" then\010",
    "                pcall(monitor.setBackgroundColor, color(\"black\"))\010",
    "            end\010",
    "            local ok = pcall(monitor.write, text)\010",
    "            wrote = wrote or ok\010",
    "        end\010",
    "    end\010",
    "    displayObject.previous = nil\010",
    "    return wrote\010",
    "end\010",
    "\010",
    "local function say(message)\010",
    "    local detail = string.sub(safeText(message), 1, 2048)\010",
    "    if detail ~= lastConsoleIssue then\010",
    "        print(\"Amaryllis heading display: \" .. detail)\010",
    "        lastConsoleIssue = detail\010",
    "    end\010",
    "end\010",
    "\010",
    "-- Summary: Check the reported peripheral type against the requested interface.\010",
    "local function hasType(name, wanted)\010",
    "    if peripheral.hasType then\010",
    "        local ok, result = pcall(peripheral.hasType, name, wanted)\010",
    "        if ok then return result == true end\010",
    "    end\010",
    "    if peripheral.getType then\010",
    "        local ok, result = pcall(peripheral.getType, name)\010",
    "        if not ok then return false end\010",
    "        if type(result) == \"table\" then\010",
    "            for _, item in ipairs(result) do\010",
    "                if item == wanted then return true end\010",
    "            end\010",
    "            return false\010",
    "        end\010",
    "        return result == wanted\010",
    "    end\010",
    "    return false\010",
    "end\010",
    "\010",
    "local function sortedPeripheralNames()\010",
    "    local ok, names = pcall(peripheral.getNames)\010",
    "    if not ok or type(names) ~= \"table\" then return nil, tostring(names) end\010",
    "    table.sort(names)\010",
    "    return names\010",
    "end\010",
    "\010",
    "-- Summary: Select the configured monitor from the attached peripheral inventory.\010",
    "local function findMonitor()\010",
    "    local names, reason = sortedPeripheralNames()\010",
    "    if not names then return nil, \"cannot list attached peripherals: \" .. reason end\010",
    "    local found = {}\010",
    "    if type(config.monitorName) == \"string\" and config.monitorName ~= \"\" then\010",
    "        if not hasType(config.monitorName, \"monitor\") then\010",
    "            return nil, \"configured monitor is not attached: \" .. config.monitorName\010",
    "        end\010",
    "        found[1] = config.monitorName\010",
    "    else\010",
    "        for _, name in ipairs(names) do\010",
    "            if hasType(name, \"monitor\") then found[#found + 1] = name end\010",
    "        end\010",
    "    end\010",
    "    if #found == 0 then return nil, \"no monitor is attached\" end\010",
    "    if #found > 1 then\010",
    "        return nil, \"multiple monitors are attached; set monitorName in config.json\"\010",
    "    end\010",
    "    local ok, object = pcall(peripheral.wrap, found[1])\010",
    "    if not ok or type(object) ~= \"table\" then\010",
    "        return nil, \"could not wrap monitor \" .. found[1] .. \": \" .. tostring(object)\010",
    "    end\010",
    "    return found[1], object\010",
    "end\010",
    "\010",
    "-- Summary: Bind the selected monitor and apply the configured text scale.\010",
    "local function attachMonitor()\010",
    "    local name, object = findMonitor()\010",
    "    if not name then\010",
    "        renderer, monitorName = nil, nil\010",
    "        if lastMonitorError ~= object then\010",
    "            say(tostring(object))\010",
    "            lastMonitorError = object\010",
    "        end\010",
    "        return false\010",
    "    end\010",
    "    if type(object.setTextScale) ~= \"function\" or type(object.getSize) ~= \"function\" or\010",
    "        type(object.setCursorPos) ~= \"function\" or\010",
    "        (type(object.blit) ~= \"function\" and type(object.write) ~= \"function\") then\010",
    "        local reason = \"monitor lacks required getSize/setTextScale/setCursorPos/blit-or-write methods\"\010",
    "        renderer, monitorName = nil, nil\010",
    "        if lastMonitorError ~= reason then\010",
    "            say(reason)\010",
    "            lastMonitorError = reason\010",
    "        end\010",
    "        pcall(bestEffortErrorFrame, { monitor = object, previous = nil })\010",
    "        return false\010",
    "    end\010",
    "    local scaleOk, scaleError = pcall(object.setTextScale, textScale)\010",
    "    if not scaleOk then\010",
    "        local reason = \"could not set monitor text scale: \" .. tostring(scaleError)\010",
    "        renderer, monitorName = nil, nil\010",
    "        if lastMonitorError ~= reason then say(reason) lastMonitorError = reason end\010",
    "        pcall(bestEffortErrorFrame, { monitor = object, previous = nil })\010",
    "        return false\010",
    "    end\010",
    "    renderer = { monitor = object, display = config.display, previous = nil }\010",
    "    monitorName, lastMonitorError = name, nil\010",
    "    return true\010",
    "end\010",
    "\010",
    "-- Summary: Find and open wireless modems for fleet status reception.\010",
    "local function openWirelessModems()\010",
    "    local names, listError = sortedPeripheralNames()\010",
    "    if not names then\010",
    "        say(\"cannot list peripherals while opening wireless modem: \" .. tostring(listError))\010",
    "        return false\010",
    "    end\010",
    "    local foundModem, opened, lastError = false, false, nil\010",
    "    for _, name in ipairs(names) do\010",
    "        if hasType(name, \"modem\") then\010",
    "            foundModem = true\010",
    "            local wrapOk, modem = pcall(peripheral.wrap, name)\010",
    "            if not wrapOk or type(modem) ~= \"table\" then\010",
    "                lastError = \"could not wrap modem \" .. name .. \": \" .. tostring(modem)\010",
    "            elseif type(modem.isWireless) ~= \"function\" then\010",
    "                lastError = \"modem \" .. name .. \" does not provide isWireless()\"\010",
    "            else\010",
    "                local wirelessOk, wireless = pcall(modem.isWireless)\010",
    "                if not wirelessOk then\010",
    "                    lastError = \"could not query modem \" .. name .. \" wireless status: \" .. tostring(wireless)\010",
    "                elseif wireless then\010",
    "                    local openOk, alreadyOpen = pcall(rednet.isOpen, name)\010",
    "                    if openOk and alreadyOpen then\010",
    "                        opened = true\010",
    "                    else\010",
    "                        local callOk, openError = pcall(rednet.open, name)\010",
    "                        if callOk then opened = true end\010",
    "                        if not callOk then lastError = \"could not open modem \" .. name .. \": \" .. tostring(openError) end\010",
    "                    end\010",
    "                end\010",
    "            end\010",
    "        end\010",
    "    end\010",
    "    if not opened then\010",
    "        say(lastError or (foundModem and \"no wireless modem could be opened\" or\010",
    "            \"no wireless modem is attached; core telemetry cannot be received\"))\010",
    "    end\010",
    "    return opened\010",
    "end\010",
    "\010",
    "local function finiteInteger(value, minimum)\010",
    "    return type(value) == \"number\" and value == value and value ~= math.huge and\010",
    "        value ~= -math.huge and value >= minimum and value % 1 == 0\010",
    "end\010",
    "\010",
    "local function cleanNumber(value)\010",
    "    if finiteDisplay(value) then return value end\010",
    "    return nil\010",
    "end\010",
    "\010",
    "-- Summary: Validate and bound the received vessel/display snapshot.\010",
    "local function sanitizeSnapshot(state)\010",
    "    local result = { vessel = {}, targets = {} }\010",
    "    local thrust=type(state.thrust)==\"table\" and state.thrust or {}\010",
    "    if type(thrust.headingControl)==\"table\" then\010",
    "        result.headingControl={targetYawRate=cleanNumber(thrust.headingControl.targetYawRate)}\010",
    "    end\010",
    "    if type(state.autopilot)==\"table\" then\010",
    "        local ap=state.autopilot\010",
    "        result.autopilot={active=ap.active==true}\010",
    "        for _,key in ipairs({\"distance\",\"crossTrack\",\"cruiseSpeed\",\"requestedSpeed\",\"requestedHeading\"}) do\010",
    "            result.autopilot[key]=cleanNumber(ap[key])\010",
    "        end\010",
    "        for _,key in ipairs({\"state\",\"reason\"}) do\010",
    "            if type(ap[key])==\"string\" then result.autopilot[key]=string.sub(safeText(ap[key]),1,160) end\010",
    "        end\010",
    "        local route=type(ap.route)==\"table\" and ap.route or {}\010",
    "        local entry=type(route.entries)==\"table\" and route.entries[route.index or 1] or nil\010",
    "        if type(entry)==\"table\" and type(entry.name)==\"string\" then\010",
    "            result.autopilot.destinationName=string.sub(safeText(entry.name),1,40)\010",
    "        end\010",
    "    end\010",
    "    if type(state.lateralControl)==\"table\" then\010",
    "        local lateral=state.lateralControl\010",
    "        result.lateralControl={active=lateral.active==true,mode=lateral.mode==\"SEL\" and \"SEL\" or \"MANUAL\"}\010",
    "        for _,key in ipairs({\"offset\",\"remaining\",\"sidewaysSpeed\"}) do result.lateralControl[key]=cleanNumber(lateral[key]) end\010",
    "        if type(lateral.state)==\"string\" then result.lateralControl.state=string.sub(safeText(lateral.state),1,24) end\010",
    "    end\010",
    "    local vessel = type(state.vessel) == \"table\" and state.vessel or {}\010",
    "    local targets = type(state.targets) == \"table\" and state.targets or {}\010",
    "    local sensorFields = {\010",
    "        \"altitude\", \"heading\", \"pitch\", \"roll\", \"verticalSpeed\", \"forwardSpeed\", \"mass\",\010",
    "    }\010",
    "    for _, field in ipairs(sensorFields) do\010",
    "        result.vessel[field] = cleanNumber(vessel[field])\010",
    "    end\010",
    "    if type(vessel.valid) == \"boolean\" then result.vessel.valid = vessel.valid end\010",
    "    if type(vessel.reason) == \"string\" then\010",
    "        result.vessel.reason = string.sub(safeText(vessel.reason), 1, 2048)\010",
    "    end\010",
    "    -- Keep core provenance and sample age for Status/Logs without consulting\010",
    "    -- local sensors. Display receipt age and measurement age are distinct.\010",
    "    result.vessel.sampleAgeSeconds=cleanNumber(vessel.sampleAgeSeconds)\010",
    "    for _,field in ipairs({\"altitudeSource\",\"headingSource\",\"altitudeUnit\"}) do\010",
    "        if type(vessel[field])==\"string\" then result.vessel[field]=string.sub(safeText(vessel[field]),1,128) end\010",
    "    end\010",
    "    if type(vessel.validFields) == \"table\" then\010",
    "        result.vessel.validFields = {}\010",
    "        for _, field in ipairs(sensorFields) do\010",
    "            if type(vessel.validFields[field]) == \"boolean\" then\010",
    "                result.vessel.validFields[field] = vessel.validFields[field]\010",
    "            end\010",
    "        end\010",
    "    end\010",
    "    for _, field in ipairs(sensorFields) do\010",
    "        if type(vessel[field .. \"Valid\"]) == \"boolean\" then\010",
    "            result.vessel[field .. \"Valid\"] = vessel[field .. \"Valid\"]\010",
    "        end\010",
    "    end\010",
    "    for _, field in ipairs({ \"altitude\", \"heading\", \"speed\" }) do\010",
    "        result.targets[field] = cleanNumber(targets[field])\010",
    "    end\010",
    "    local systems=type(state.systemsStartup)==\"table\" and state.systemsStartup or nil\010",
    "    if systems then\010",
    "        result.systemsStartup={}\010",
    "        local labels={[\"OPENING STEAM VENTS\"]=true,[\"STATIC INFLATION\"]=true,[\"CAPTURING PITCH ZERO\"]=true,[\"ACQUIRING SEL ALT\"]=true,READY=true}\010",
    "        if labels[systems.displayPhase] then result.systemsStartup.displayPhase=systems.displayPhase end\010",
    "        if type(systems.active)==\"boolean\" then result.systemsStartup.active=systems.active end\010",
    "        local phases={ABORTED=true,HOLDING=true,MAIN_LIFT=true,PROBING=true,\010",
    "            VERIFYING=true,VENT_IGNITION=true,STOPPED=true,STOPPING=true,BLOCKED=true,\010",
    "            READY=true,IDLE=true}\010",
    "        if type(systems.phase)==\"string\" then\010",
    "            local phase=string.upper(safeText(systems.phase))\010",
    "            if phases[phase] then result.systemsStartup.phase=phase end\010",
    "        end\010",
    "        if type(systems.abortReason)==\"string\" then\010",
    "            result.systemsStartup.abortReason=string.sub(safeText(systems.abortReason),1,160)\010",
    "        end\010",
    "    end\010",
    "    local altitudeControl=type(state.altitudeControl)==\"table\" and state.altitudeControl or nil\010",
    "    if altitudeControl and type(altitudeControl.enabled)==\"boolean\" then\010",
    "        result.altitudeControl={enabled=altitudeControl.enabled}\010",
    "    end\010",
    "    if altitudeControl and type(altitudeControl.ceiling)==\"number\" and\010",
    "        altitudeControl.ceiling==altitudeControl.ceiling and math.abs(altitudeControl.ceiling)<=4096 then\010",
    "        result.altitudeControl=result.altitudeControl or {}\010",
    "        result.altitudeControl.ceiling=altitudeControl.ceiling\010",
    "    end\010",
    "    if type(state.assembly) == \"table\" then\010",
    "        local states = { ASSEMBLED = true, ASSEMBLING = true, DISASSEMBLED = true, UNKNOWN = true }\010",
    "        local assembly = state.assembly\010",
    "        result.assembly = { state = states[assembly.state] and assembly.state or \"UNKNOWN\" }\010",
    "        if type(assembly.reason) == \"string\" then\010",
    "            result.assembly.reason = string.sub(safeText(assembly.reason), 1, 160)\010",
    "        end\010",
    "    end\010",
    "    if type(state.fleetBoot)==\"table\" and type(state.fleetBoot.ready)==\"boolean\" then\010",
    "        local fleet=state.fleetBoot\010",
    "        result.fleetBoot={ready=fleet.ready}\010",
    "        local phases={WAITING_ASSEMBLY=true,DISCOVERING=true,ZEROING_PROPULSION=true,\010",
    "            RESTARTING=true,VERIFYING=true,COMPLETE=true,FAILED=true,CANCELLED=true}\010",
    "        if type(fleet.phase)==\"string\" and phases[fleet.phase] then result.fleetBoot.phase=fleet.phase end\010",
    "        if type(fleet.current)==\"string\" then result.fleetBoot.current=string.sub(safeText(fleet.current),1,96) end\010",
    "        if finiteInteger(fleet.completed,0) and fleet.completed<=10000 then result.fleetBoot.completed=fleet.completed end\010",
    "        if finiteInteger(fleet.total,0) and fleet.total<=10000 then result.fleetBoot.total=fleet.total end\010",
    "        if type(fleet.reason)==\"string\" then result.fleetBoot.reason=string.sub(safeText(fleet.reason),1,160) end\010",
    "    end\010",
    "    if type(state.modes) == \"table\" then\010",
    "        result.modes = {}\010",
    "        for _, field in ipairs({ \"heading\", \"throttle\", \"altitude\" }) do\010",
    "            local mode = state.modes[field]\010",
    "            if type(mode) == \"string\" and #mode <= 16 and mode:match(\"^[%w _%-]+$\") then\010",
    "                result.modes[field] = mode\010",
    "            end\010",
    "        end\010",
    "    end\010",
    "    if type(state.effectiveModes)==\"table\" then\010",
    "        result.effectiveModes={}\010",
    "        for _,field in ipairs({\"heading\",\"throttle\",\"altitude\"}) do\010",
    "            local mode=state.effectiveModes[field]\010",
    "            if type(mode)==\"string\" and #mode<=16 and mode:match(\"^[%w _%-]+$\") then\010",
    "                result.effectiveModes[field]=mode\010",
    "            end\010",
    "        end\010",
    "    end\010",
    "    if type(state.anchor) == \"string\" and\010",
    "        (state.anchor == \"OFF\" or state.anchor == \"BRAKING\" or state.anchor == \"ANCHORED\") then\010",
    "        result.anchor = state.anchor\010",
    "    else\010",
    "        result.anchor = \"UNAVAILABLE\"\010",
    "    end\010",
    "    result.authorityReady = state.authorityReady == true\010",
    "    return result\010",
    "end\010",
    "\010",
    "-- Summary: Validate and cache a fresh status packet from the configured core.\010",
    "local function acceptStatus(sender, message)\010",
    "    if sender ~= config.coreId or type(message) ~= \"table\" or\010",
    "        message.v ~= 1 or message.kind ~= \"display_status\" or\010",
    "        type(message.state) ~= \"table\" then\010",
    "        return false\010",
    "    end\010",
    "    local registry=os.__amaryllisFleetRegistry\010",
    "    if not registryIdentity or type(registry)~=\"table\" or message.session~=registry.session then return false end\010",
    "    if type(message.session) ~= \"string\" or #message.session == 0 or #message.session > 128 or\010",
    "        not message.session:match(\"^[%w_%.%-:]+$\") or\010",
    "        not finiteInteger(message.seq, 1) or message.seq > 2147483647 then\010",
    "        return false\010",
    "    end\010",
    "    if message.session == activeSession then\010",
    "        if message.seq <= latestSequence then return false end\010",
    "    elseif retiredSessions[message.session] then\010",
    "        return false\010",
    "    else\010",
    "        if activeSession then\010",
    "            retiredSessions[activeSession] = true\010",
    "            retiredSessionOrder[#retiredSessionOrder + 1] = activeSession\010",
    "            if #retiredSessionOrder > 32 then\010",
    "                retiredSessions[table.remove(retiredSessionOrder, 1)] = nil\010",
    "            end\010",
    "        end\010",
    "        activeSession, latestSequence = message.session, 0\010",
    "    end\010",
    "    latestSequence = message.seq\010",
    "    latestState = sanitizeSnapshot(message.state)\010",
    "    receivedAt = os.clock()\010",
    "    return true\010",
    "end\010",
    "\010",
    "-- Summary: Resolve the current status snapshot and its stale-display treatment.\010",
    "local function displaySnapshot(now, forceStale)\010",
    "    if type(latestState) ~= \"table\" then\010",
    "        return { displayStale = true, dataFresh = false, anchor = \"UNAVAILABLE\" }, false\010",
    "    end\010",
    "    local age = receivedAt and finite(now) and now - receivedAt or math.huge\010",
    "    local fresh = not forceStale and age >= 0 and age <= timeout\010",
    "    local snapshot = {}\010",
    "    for key, value in pairs(latestState) do snapshot[key] = value end\010",
    "    -- Measure snapshot age in seconds from this display computer's receipt time.\010",
    "    snapshot.displayStale = not fresh\010",
    "    snapshot.dataFresh = fresh\010",
    "    snapshot.stale = not fresh\010",
    "    return snapshot, fresh\010",
    "end\010",
    "\010",
    "-- Summary: Render the current view into its configured terminal or monitor.\010",
    "local function draw(forceStale)\010",
    "    local snapshot = displaySnapshot(os.clock(), forceStale)\010",
    "    -- Publish even without an attached monitor so diagnostics can inspect\010",
    "    -- receiver freshness. Receipt age/validity still belongs to this receiver.\010",
    "    os.__amaryllisRuntime = { publishedAt = os.clock(), snapshot = snapshot, running = true, hardwareAvailable = renderer ~= nil, faultSummary = lastDrawError or lastMonitorError }\010",
    "    if not renderer then return end\010",
    "    local ok, issue = pcall(drawToMonitor, renderer, snapshot)\010",
    "    if not ok then\010",
    "        local detail = \"monitor draw failed: \" .. tostring(issue)\010",
    "        if detail ~= lastDrawError then say(detail) end\010",
    "        lastDrawError = detail\010",
    "        pcall(bestEffortErrorFrame, renderer)\010",
    "        return\010",
    "    end\010",
    "    lastDrawError = nil\010",
    "    if issue then\010",
    "        say(issue)\010",
    "    else\010",
    "        lastConsoleIssue = nil\010",
    "    end\010",
    "end\010",
    "\010",
    "-- Summary: Initialize the role and run its configured display/network service.\010",
    "local function run()\010",
    "    syncRegistry()\010",
    "    attachMonitor()\010",
    "    openWirelessModems()\010",
    "    draw()\010",
    "\010",
    "    local timer = os.startTimer(pollInterval)\010",
    "    local wasFresh = false\010",
    "    local heartbeatSeq,nextHeartbeat=0,0\010",
    "    local heartbeatBoot=tostring(config.computerId)..\"-\"..\010",
    "        string.format(\"%.0f\",os.epoch and os.epoch(\"utc\") or os.clock()*1000)\010",
    "    local restartContext={coreId=config.coreId,targetLabel=currentLabel,nodeBoot=heartbeatBoot,\010",
    "        getSession=function()\010",
    "            local _,fresh=displaySnapshot(os.clock())\010",
    "            if fresh then return activeSession end\010",
    "            return nil\010",
    "        end,seen={},order={}}\010",
    "    while true do\010",
    "        local event, first, second, third = os.pullEventRaw()\010",
    "        if event == \"rednet_message\" then\010",
    "            local sender, message, receivedProtocol = first, second, third\010",
    "            restartContext.session=restartContext.getSession()\010",
    "            if sender==config.coreId and receivedProtocol==\"amaryllis.v1\" and type(message)==\"table\" and message.kind==\"fleet_registry\" then\010",
